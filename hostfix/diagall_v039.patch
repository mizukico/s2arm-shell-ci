+        if (!rwv || !rhv || need + bytes > (uint64_t)PRES_BUDGET_B) continue;
+        need += bytes;
+        rw[i] = rwv; rh[i] = rhv; rxo[i] = x0; ryo[i] = y0; rlv[i] = lv; rsl[i] = sl;
+        rbpp[i] = bpp; rrow[i] = (size_t)rwv * bpp;
