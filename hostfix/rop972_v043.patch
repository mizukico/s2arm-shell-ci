+                    if (meth.StartsWith("get_", StringComparison.Ordinal)) continue;   // get_width / get_height…：返回 uint，与元素类型无关
+                    if (meth is not ("read" or "sample")) { safe = false; break; }
+                    if (!spans.Any(x => u.Index >= x.Start && u.Index < x.Close)) { safe = false; break; }   // 还有一处不在 as_type 里的普通读
+                }
+                if (!safe) ok.Remove(name);
+            }
+            var edits = cand.Where(c => ok.ContainsKey(c.Name)).OrderBy(c => c.Start).ToList();
+            if (edits.Count == 0) return msl;
+            // 4：按原串偏移一次拼装，只删 as_type<…>( 与配对 ) 两个定界符
+            var sb = new StringBuilder(msl.Length);
+            int pos = 0;
+            foreach (var c in edits)
+            {
+                if (c.Start < pos) continue;   // 相交已被拒，这里只是保险
+                sb.Append(msl, pos, c.Start - pos);
+                sb.Append(c.Inner);            // 操作数逐字节照留
+                pos = c.Close;                 // 跳过配对的 ')'
+            }
+            sb.Append(msl, pos, msl.Length - pos);
+            string outp = sb.ToString();
+            // 原位只换元素类型，访问限定（, access::sample 之类）照留；声明认不出 → 整支回退（不能只删 as_type 不改类型）
+            foreach (var (name, elem) in ok.Select(kv => (Name: kv.Key, Elem: kv.Value.Elem)).OrderBy(x => x.Name, StringComparer.Ordinal))
+            {
+                var re = R(@"(?<![A-Za-z0-9_])(texture(?:1d|2d|3d|cube)(?:_array)?|texture_buffer)\s*<\s*float\s*((?:,\s*[^>]*)?)>(\s+" + Esc(name) + @"\s*\[\[)");
