+static int alias_pkg_on(void) {
+    static _Atomic int v = -1;
+    int b = atomic_load_explicit(&v, memory_order_relaxed);
+    if (b < 0) {
+        const char *e = getenv("S2A_ALIAS_PKG");
+        long n = e && *e ? strtol(e, NULL, 0) : 1;
+        b = n != 0;
+        atomic_store_explicit(&v, b, memory_order_relaxed);
+    }
+    return b;
+}
+static void alias_key_of(alias_key *k, const tex_t *t) {
+    memset(k, 0, sizeof *k); k->pool = (uint64_t)(uintptr_t)t->pool; k->off = t->off; k->d = t->d; k->d.flags &= ~(uint32_t)ALIAS_USE_FLAGS;
+    if (alias_cls_of(&k->d)) {
+        int bits = alias_tiny_bits();
+        if (bits & ALIAS_TINY_SAMPLES) k->d.samples = k->d.samples ? k->d.samples : 1;
+        if (bits & ALIAS_TINY_LEVELS) k->d.levels = 0;
+        if (bits & ALIAS_TINY_STRIDE) k->d.stride = 0;
+        if (bits & ALIAS_TINY_PKG) k->d.pkg_layout = 0;
+    }
