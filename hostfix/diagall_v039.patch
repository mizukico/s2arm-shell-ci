+        if (rq[i].role == 1 || rq[i].role == 3) {   // 输入：正中 ≤ 480x270 区域（够看有没有画面；整张 × 8 张太重）
+            NSUInteger cw = MIN(w, (NSUInteger)PRES_IN_PX), ch = MIN(h, (NSUInteger)(PRES_IN_PX * 9 / 16));
