+    int cslot = -1;
+    if (g_s285_att_pass == pass)
+        for (int a = 0; a < g_s285_att_n; a++) if (g_s285_att[a].ser == ser) { cslot = g_s285_att[a].slot; break; }
+    pthread_mutex_lock(&g_rmu);
+    for (int st = 0; st < 2; st++) {
+        NvShader *sh = st ? fs : vs;
+        if (!sh) continue;
+        for (int i = 0; i < sh->rf.nb; i++) {
+            const nvn_rbind *b = &sh->rf.b[i];
+            if (b->kind != NVN_RB_TEX) continue;
+            int id_ = (int)(tex_slot_h(S.tex[st], S.img[st], b->reg) & 0xfffff);
+            if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) continue;
+            if (g_treg[id_].t.serial != ser) continue;
+            int dup = 0;
+            for (int q = 0; q < g_s285_nd; q++)
+                if (g_s285_rd[q].frame == frame && g_s285_rd[q].pass == pass && g_s285_rd[q].stage == st
+                    && g_s285_rd[q].reg == b->reg) { dup = 1; break; }
+            if (dup) continue;
+            if (g_s285_nd >= S285_RDR) { g_s285_rdrop++; continue; }
+            s285_rdr *rd = &g_s285_rd[g_s285_nd++];
+            rd->frame = frame; rd->pass = pass; rd->reg = b->reg; rd->stage = st; rd->cslot = cslot;
+            snprintf(rd->key, sizeof rd->key, "%s", sh->key[0] ? sh->key : "-");
+        }
+    }
+    pthread_mutex_unlock(&g_rmu);
+}
+// 帧末（下一帧第一遍之前，和 [bytgt] / [dark2] 同一个点）：先打读者行，再打写者行 + 整张读回统计。
+//   这是 [ser285] 唯一的 GPU 工作：pass 都结束、GPU 已做完、旧队列上一次提交，不在任何 pass 里。
+static void s285_dump(uint64_t frame) {
+    if (!s285_on() || frame == ~0ull) return;
+    uint64_t ser = s285_ser();
+    int nr = 0;   // 0) 读者（每帧 ≤ 4 行）
+    for (int i = 0; i < g_s285_nd && nr < S285_RDR; i++) {
+        const s285_rdr *rd = &g_s285_rd[i];
+        if (rd->frame != frame) continue;
+        char xb[32]; xb[0] = 0;
+        if (rd->cslot >= 0) snprintf(xb, sizeof xb, " c%d", rd->cslot);
+        if (rd->stage == 0) strlcat(xb, " stage=vs", sizeof xb);
+        MLOG("[ser285] frame %llu reader pass=%llu key=%s reg=%u%s", (unsigned long long)frame,
+             (unsigned long long)rd->pass, rd->key, rd->reg, xb);
+        nr++;
+    }
+    if (g_s285_rdrop && frame % 300 == 0) { MLOG("[ser285] frame %llu reader_drop=%d（读到它的遍超过 %d 个，只打前 %d 条）",
+        (unsigned long long)frame, g_s285_rdrop, S285_RDR, S285_RDR); g_s285_rdrop = 0; }
+    g_s285_nd = 0;
+    int best = -1, nw = 0;
+    for (int i = 0; i < g_s285_n; i++) {
+        if (g_s285[i].frame != frame) continue;
+        nw++;
+        if (best < 0 || g_s285[i].pass >= g_s285[best].pass) best = i;   // 最后写它的遍：帧末读它的那张
+    }
+    if (!nw) {   // 这一帧没有颜色附件是目标的遍（确认这段代码在跑）
+        if (!g_s285_none_logged) { g_s285_none_logged = 1;
+            MLOG("[ser285] frame %llu none（这一帧没有颜色附件是 ser=%llu 的遍；先确认壳标记 %s 在，再看 S2A_S285_SER）",
+                 (unsigned long long)frame, (unsigned long long)ser, S2A_SHELL_TAG); }
+        else if (frame % 300 == 0) MLOG("[ser285] frame %llu none", (unsigned long long)frame);
+        return;
+    }
+    id<MTLBuffer> ubuf[S285_MAX], usrc[S285_MAX]; NSUInteger uso[S285_MAX], ulen[S285_MAX];
+    id<MTLTexture> otx = nil; id<MTLBuffer> obuf = nil; size_t orow = 0, obpp = 0; NSUInteger ow = 0, oh = 0;
+    uint64_t need = 0; int ran = 0;
+    for (int i = 0; i < S285_MAX; i++) { ubuf[i] = nil; usrc[i] = nil; uso[i] = ulen[i] = 0; }
+    if (mtl_gpu_halted()) {   // GPU 已安全停：不在这条路上再提交命令缓冲
+        if (!g_s285_halt_logged) { g_s285_halt_logged = 1;
+            MLOG("【红】[ser285] GPU 已安全停：写者的输入 / 输出不再读回（原因看 [gpuerr] 那行）"); }
+    } else {
+        for (int i = 0; i < g_s285_n; i++) {   // UBO：每个写者条目 ≤ 256 B，逐个读
+            const s285_ent *e = &g_s285[i];
+            if (e->frame != frame) continue;
+            if (e->ubo_reg < 0 || !e->ubo_addr || e->ubo_len < 4) continue;
+            void *mb = NULL; uint64_t mo = 0;
+            if (!nvn_be_addr(e->ubo_addr, 4, &mb, &mo) || !mb || (mo & 3)) continue;
+            id<MTLBuffer> sb = (__bridge id<MTLBuffer>)mb;
+            NSUInteger bmax = sb.length;
+            if (mo >= bmax) continue;
+            NSUInteger len = (NSUInteger)MIN(MIN(e->ubo_len, (uint64_t)S285_UBO_MAXB), (uint64_t)(bmax - mo)) & ~(NSUInteger)3;
+            if (len >= 4) { usrc[i] = sb; uso[i] = (NSUInteger)mo; ulen[i] = len; need += len; }
+        }
+        if (best >= 0) {   // 输出：最后写它的那一遍的附件，整张（≤ 64 MB，和 [bytgt] 同口径）
+            id<MTLTexture> t = g_s285_tex[best];
+            if (t && (t.textureType == MTLTextureType2D || t.textureType == MTLTextureType2DArray) && t.sampleCount == 1) {
+                size_t bpp = mtl_pf_bytes(t.pixelFormat);
+                NSUInteger lv = g_s285[best].lv > 0 ? (NSUInteger)g_s285[best].lv : 0;
+                if (bpp && lv <= 16) {
+                    NSUInteger w = MAX(t.width >> lv, (NSUInteger)1), h = MAX(t.height >> lv, (NSUInteger)1);
+                    if ((uint64_t)w * (uint64_t)h * (uint64_t)bpp <= (64ull << 20)) {
+                        otx = t; obpp = bpp; orow = (size_t)w * bpp; ow = w; oh = h;
+                        need += (uint64_t)orow * (uint64_t)h;
+                    }
+                }
+            }
+        }
+        if (need) {
+            for (int i = 0; i < S285_MAX; i++) if (ulen[i]) {
+                ubuf[i] = [g_dev newBufferWithLength:ulen[i] options:MTLResourceStorageModeShared];
+                if (!ubuf[i]) ulen[i] = 0;
+            }
+            if (orow) { obuf = [g_dev newBufferWithLength:orow * (size_t)oh options:MTLResourceStorageModeShared]; if (!obuf) orow = 0; }
+            rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+            mtl_finish_gpu();   // 上一帧的提交必须已经在 GPU 上做完，旧队列的拷贝才读得到这一帧的内容
+            id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+            for (int i = 0; i < S285_MAX; i++) if (ubuf[i] && usrc[i]) enc_b_copy_buffer(b, usrc[i], uso[i], ubuf[i], 0, ulen[i]);
+            if (obuf && otx) {
+                const s285_ent *e = &g_s285[best];
+                [b copyFromTexture:otx sourceSlice:(NSUInteger)(e->sl > 0 ? e->sl : 0)
+                      sourceLevel:(NSUInteger)(e->lv > 0 ? e->lv : 0)
+                      sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(ow, oh, 1)
+                          toBuffer:obuf destinationOffset:0 destinationBytesPerRow:orow
+                 destinationBytesPerImage:orow * (size_t)oh];
+            }
+            [b endEncoding];
+            ran = cb_run(cb);
+            if (!ran && !g_s285_submit_fail) { g_s285_submit_fail = 1;
+                MLOG("【红】[ser285] frame %llu: 帧末读回没提交（GPU 已安全停 / 提交被拒），这一帧的数值不可信", (unsigned long long)frame); }
+        }
+    }
+    for (int i = 0; i < g_s285_n; i++) {   // 写者行（≤ 4 条）+ 输出统计
+        const s285_ent *e = &g_s285[i];
+        if (e->frame != frame) continue;
+        char ib[420]; size_t io = 0; ib[0] = 0;
+        for (int k = 0; k < e->ntex; k++)
+            io += snprintf(ib + io, sizeof ib - io, "%sr%u/%llu/%#x/%ux%u", k ? "," : "",
+                           e->tex[k].reg, (unsigned long long)e->tex[k].ser, (unsigned)e->tex[k].pf,
+                           (unsigned)e->tex[k].w, (unsigned)e->tex[k].h);
+        if (!ib[0]) snprintf(ib, sizeof ib, "-");
+        char vb[200]; size_t vo = 0; vb[0] = 0;
+        if (ran && ubuf[i] && ulen[i]) {
+            NSUInteger nf = ulen[i] / 4; if (nf > 8) nf = 8;
+            for (NSUInteger k = 0; k < nf; k++)
+                vo += snprintf(vb + vo, sizeof vb - vo, "%s%.6g", k ? "," : "", (double)((const float *)ubuf[i].contents)[k]);
+        } else snprintf(vb, sizeof vb, "none");
+        char wb[200]; size_t wo = 0; wb[0] = 0;
+        for (int k = 0; k < e->ncol; k++)
+            wo += snprintf(wb + wo, sizeof wb - wo, "%sc%d:0x%x", k ? "," : "", k, (unsigned)e->col[k].wmask);
+        if (!wb[0]) snprintf(wb, sizeof wb, "-");
+        char bb[200]; size_t bo = 0; bb[0] = 0;
+        for (int k = 0; k < e->ncol; k++)
+            bo += snprintf(bb + bo, sizeof bb - bo, "%sc%d:%u", k ? "," : "", k, (unsigned)e->col[k].blend);
+        if (!bb[0]) snprintf(bb, sizeof bb, "-");
+        MLOG("[ser285] frame %llu writer pass=%llu key=%s c%d fmt=%#x %lux%lu load=%s in=%d [%s] ubo reg=%d len=%llu f0..f7=%s"
+             " wmask=%s blend=%s discard=%d dsrc=%s%s",
+             (unsigned long long)frame, (unsigned long long)e->pass, e->key, e->slot, (unsigned)e->pf,
+             (unsigned long)e->w, (unsigned long)e->h, s285_load(e->load), e->ntex_total, ib,
+             e->ubo_reg, (unsigned long long)e->ubo_len, vb, wb, bb, e->disc == 1 ? 1 : 0, s285_dsrc(e),
+             e->has_draw ? "" : " draws=none");
+        if (i == best) {
+            if (ran && obuf && orow) {
+                uint64_t nz = 0, mx = 0; double mean = 0.0;
+                lit_stats((const uint8_t *)obuf.contents, orow, ow, oh, obpp, otx.pixelFormat, &nz, &mean, &mx);
+                MLOG("[ser285] frame %llu out pass=%llu ser=%llu c%d nonzero=%llu mean=%.1f max=%llu",
+                     (unsigned long long)frame, (unsigned long long)e->pass, (unsigned long long)e->ser, e->slot,
+                     (unsigned long long)nz, mean, (unsigned long long)mx);
+            } else {
+                MLOG("[ser285] frame %llu out pass=%llu ser=%llu c%d readback=none", (unsigned long long)frame,
+                     (unsigned long long)e->pass, (unsigned long long)e->ser, e->slot);
+            }
+        } else {
+            MLOG("[ser285] frame %llu out pass=%llu ser=%llu c%d readback=dup（同一张纹理，整张统计见 pass %llu）",
+                 (unsigned long long)frame, (unsigned long long)e->pass, (unsigned long long)e->ser, e->slot,
+                 (unsigned long long)g_s285[best].pass);
+        }
+    }
+    int keep = 0;   // 交出这一帧的条目（更晚帧的条目留着）
+    for (int i = 0; i < g_s285_n; i++) {
+        if (g_s285[i].frame == frame) { g_s285_tex[i] = nil; continue; }
+        if (keep != i) { g_s285[keep] = g_s285[i]; g_s285_tex[keep] = g_s285_tex[i]; g_s285_tex[i] = nil; }
+        keep++;
+    }
+    g_s285_n = keep;
+    if (g_s285_wdrop && frame % 300 == 0) { MLOG("[ser285] frame %llu writer_drop=%d（颜色附件是它的遍超过 %d 个，只记前 %d 个）",
+        (unsigned long long)frame, g_s285_wdrop, S285_MAX, S285_MAX); g_s285_wdrop = 0; }
+}
+// ---------- S2Arm #427 壳内置诊断 [pres]：上屏遍（写 drawable / ser=1 的那一遍）读到了什么、写出了什么 ----------
+// 已知（前几轮，别重查）：G-buffer 写 / 读正常；整数输出已修（S2A_UMASK）；800x450 场景链 276 / 270 / 271
+//   96–100% 帧非零；深度 / 遮罩 285 是正常白。可是上屏目标（drawable / ser=1）只有 UI：
+//   [litdbg] frame … ser=1 nonzero≈129k mean=2.7 max=255（1920x1080 里 6% 非零，都是 UI）；
+//   上屏遍的 key 历史是 ec8ccd7a1791a3a6_b，[w600x] present_tex idx=0 显示它第一张绑定在
+//   600 / 6 / 203 / 636 / 412 / 43874 之间轮换（fmt 0x46 / 0x98），不是场景色。
+// 这一版把上屏遍摊开（每帧最多 1 组行）：
+//   * 认上屏遍：片元 key 前缀 ec8ccd7a1791a3a6（学到的 key 也认，上屏目标序号轮换时靠它），或这一遍的颜色附件里
+//     就有 drawable（serial 1 / present_now 交上屏的那张）；一帧命中多遍时以最后一遍为准（present 那一遍本来就是最后）；
+//   * 每张输入（≤ 8 张，按 reg 顺序）：绑定槽 / serial / Metal fmt / kind / 尺寸 + 帧末读回（正中区域）的
+//     nonzero / mean / max；这张在本帧还有写者（同 serial 的颜色附件）就记下那个写者；
+//   * 输出：帧末整张读回上屏目标（实际尺寸），打 nonzero / mean / max；
+//   * 两遍：上屏遍的输入里、本帧还有写者的那张（面积大的优先）＝「中间目标」，写它的那一遍按同一格式再打一组
+//     role=mid（输入 / UBO / 写掩码 / 混合 + 它自己的输出统计）。
+// pass 内只读状态 / 附件表，零拷贝、不进命令缓冲、不建纹理；唯一 GPU 拷贝在帧末（下一帧第一遍之前，和
+//   [litdbg] / [ser285] 同一个点）旧队列一次提交，不在任何 pass 里，也不往 Metal 4 回放流里塞拷贝。
+// 开关：S2A_PRES_DEBUG=0 只关本条；S2A_LIT_DEBUG=0 整条关；S2A_PRES_KEY=<前缀> 换认的 key 前缀（默认 ec8ccd7a1791a3a6）。
+enum { PRES_IN = 8, PRES_WR = 16, PRES_UBO_MAXB = 256, PRES_IN_PX = 480,
+       PRES_OUT_MAXB = (32 << 20), PRES_BUDGET_B = (96 << 20) };
+typedef struct {
+    uint64_t frame, pass, ser;
+    int slot, lv, sl, load;            // 颜色附件槽 / mip 级 / 层 / loadAction（0 dontcare、1 load、2 clear）
+    uint32_t pf; NSUInteger w, h;      // 附件的 Metal 像素格式与存储尺寸
+    int has_draw, match;               // 这一遍第一笔片元；match：3 key 前缀、2 学到的 key、1 附件是 drawable
+    char key[28];
+    int ntex, ntex_total;              // 列出来的输入条数 / 这一遍实际绑了几张（> PRES_IN 只列前 PRES_IN 张）
+    struct { unsigned reg; int tid; uint64_t ser; uint32_t pf; uint32_t w, h; char kind[8]; } tex[PRES_IN];
+    int ubo_reg; uint64_t ubo_addr, ubo_len;
+    int ncol;                          // 管线颜色槽（g_pass.cfmt 非 0 的那些）
+    struct { uint8_t slot; uint32_t cfmt, wmask; uint8_t blend; } col[8];
+    int disc, dsrc;                    // 1 有 / 0 没有 / -1 不知道；dsrc：1 json 2 .metal 源文 0 不知道
+} pdbg_ent;
+static pdbg_ent g_pres_ent, g_pres_mid, g_pres_wr[PRES_WR];
+static __strong id<MTLTexture> g_pres_out, g_pres_mid_out, g_pres_wr_mt[PRES_WR];
+static int g_pres_have, g_pres_mid_have, g_pres_wr_n;
+static uint64_t g_pres_wr_frame = ~0ull;
+static int g_pres_on = -1, g_pres_halt_logged, g_pres_submit_fail, g_pres_none_logged, g_pres_trunc_logged;
+static int g_pres_wdrop, g_pres_multi;
+static uint64_t g_pres_pass = ~0ull;                  // draw 钩子：每遍只看第一笔画
+// 开遍时留的候选：这一遍的颜色附件（只拿 pd 里已有的引用，不建、不拷）
+static struct { uint8_t slot; uint64_t ser; uint32_t pf; int lv, sl, load; id<MTLTexture> mt; } g_pres_att[8];
+static int g_pres_att_n; static uint64_t g_pres_att_pass = ~0ull;
+static char g_pres_key[28];                           // 学到的上屏遍片元 key（上屏目标序号轮换时靠它认）
+static const char *pres_kp(void) {
+    static char k[28]; static int done;
+    if (!done) { const char *e = getenv("S2A_PRES_KEY"); snprintf(k, sizeof k, "%s", e && *e ? e : "ec8ccd7a1791a3a6"); done = 1; }
+    return k;
+}
+static int pres_on(void) {
+    if (g_pres_on < 0) {
+        const char *e = getenv("S2A_PRES_DEBUG");
+        g_pres_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_pres_on) MLOG("S2A_PRES_DEBUG=0 / S2A_LIT_DEBUG=0: [pres] 上屏遍诊断关");
+        else MLOG("[pres] 上屏遍（写 drawable / ser=1 的那一遍）诊断：每帧 1 组行 —— pass 行（输入数 / UBO / 写掩码 / 混合 / 输出）"
+                  "+ 每张输入（≤%d，帧末读回正中 %dx%d 区域）的 serial / fmt / kind / 尺寸 / nonzero / mean / max"
+                  "+ 帧末整张读回上屏目标；上屏遍的输入里本帧还有写者的那张 = 中间目标，写它的那一遍打 role=mid"
+                  "（S2A_PRES_DEBUG=0 关；S2A_LIT_DEBUG=0 整条关；S2A_PRES_KEY=<前缀> 换，默认 %s）", PRES_IN, PRES_IN_PX, PRES_IN_PX * 9 / 16, pres_kp());
+    }
+    return g_pres_on;
+}
+static const char *pres_load(int a) { return a == (int)MTLLoadActionClear ? "clear" : a == (int)MTLLoadActionLoad ? "load" : "dontcare"; }
+static const char *pres_dsrc(const pdbg_ent *e) { return e->dsrc == 1 ? "json" : e->dsrc == 2 ? "metal" : "none"; }
+// draw 里（这一遍第一笔画）：把 key / 输入 / UBO / 管线状态填进条目。只读绑定状态与 S，不建纹理、不拷贝、不进命令缓冲。
+static void pres_fill(pdbg_ent *e, NvShader *fs) {
+    e->has_draw = 1; e->ntex = 0; e->ntex_total = 0; e->ncol = 0; e->ubo_reg = -1; e->ubo_addr = e->ubo_len = 0;
+    snprintf(e->key, sizeof e->key, "%s", fs && fs->key[0] ? fs->key : "-");
+    int total = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; fs && i < fs->rf.nb; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind == NVN_RB_CBUF) {   // UBO：该阶段绑定的最大 CBUF（帧末读回前 ≤ 256 B）
+            if (b->reg >= 16) continue;
+            const p_bind_buf *u = &S.ubo[1][b->reg];
+            if (u->addr && u->size && u->size > e->ubo_len) { e->ubo_addr = u->addr; e->ubo_len = u->size; e->ubo_reg = (int)b->reg; }
+            continue;
+        }
+        if (b->kind != NVN_RB_TEX) continue;
+        total++;
+        if (e->ntex >= PRES_IN) continue;
+        int id_ = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+        if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) id_ = -1;   // 没绑 / 没登记：照样列出来（tid=-1 ser=0）
+        const treg_t *r = id_ > 0 ? &g_treg[id_] : NULL;
+        int k = e->ntex++;
+        e->tex[k].reg = b->reg; e->tex[k].tid = id_;
+        if (r) {
+            e->tex[k].ser = r->t.serial;
+            e->tex[k].w = r->t.d.width; e->tex[k].h = r->t.d.height;
+            int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+            uint32_t mpf = 0; uint8_t sw[4];
+            e->tex[k].pf = nvn_fmt_to_mtl(nf, &mpf, sw) ? mpf : 0;
+        }
+        snprintf(e->tex[k].kind, sizeof e->tex[k].kind, "%s", d2_kind(b, r));
+    }
+    pthread_mutex_unlock(&g_rmu);
+    e->ntex_total = total;
+    if (total > PRES_IN && !g_pres_trunc_logged) { g_pres_trunc_logged = 1;
+        MLOG("[pres] key=%s 这一遍绑了 %d 张 NVN_RB_TEX，只列前 %d 张（in= 打的是总数）", e->key, total, PRES_IN); }
+    for (int j = 0; j < 8; j++) {   // 管线状态（和 [dark2] / [ser285] / pso_desc 同一套：合并遍按 lmap 取逻辑槽；片元不声明的输出掩码清零；整数目标不混合）
+        uint32_t fmt = g_pass.cfmt[j];
+        if (!fmt) continue;
+        int l = g_udc_lmap ? g_udc_lmap[j] : j;
+        int unwritten = fs && fs->rf.color_known && !g_udc_fsfn && l != 0xff && l <= 7 && !(fs->rf.color_mask >> l & 1);
+        uint32_t m = (l == 0xff || l > 7) ? 0 : (S.chmask.mask >> (4 * l)) & 0xf;
+        if (unwritten) m = 0;
+        uint32_t bl = (l != 0xff && l <= 7 && (S.color.blend_en >> l & 1) && !unwritten
+                       && !pf_int_kind((MTLPixelFormat)fmt)) ? 1 : 0;
+        if (e->ncol >= 8) break;
+        e->col[e->ncol].slot = (uint8_t)j; e->col[e->ncol].cfmt = fmt;
+        e->col[e->ncol].wmask = m; e->col[e->ncol].blend = (uint8_t)bl;
+        e->ncol++;
+    }
+    if (fs) { e->disc = fs->frag_disc; e->dsrc = fs->frag_disc_src; }
+}
+// 开遍时（和 bytgt_att_note / dark2_att_note / s285_att_note 同一个点）：留这一遍颜色附件的引用，并把「本帧最后一个写
+//   这个 serial 的遍」记进写者表（中间目标的候选）。只读附件表与 R.rt（submit 线程）；不开命令缓冲、不建纹理、不取锁。
+static void pres_att_note(MTL4RenderPassDescriptor *pd, NSUInteger nc) {
+    for (int i = 0; i < 8; i++) g_pres_att[i].mt = nil;   // 上一遍的引用放掉
+    g_pres_att_n = 0;
+    if (!pd || !pres_on()) { g_pres_att_pass = ~0ull; return; }
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    if (f != g_pres_wr_frame) {   // 新的一帧：上一帧的条目已经在 lit_td_note 的帧末 dump 里交过账，这里清掉
+        g_pres_wr_n = 0; g_pres_wr_frame = f;
+        for (int i = 0; i < PRES_WR; i++) g_pres_wr_mt[i] = nil;
+        g_pres_have = 0; g_pres_out = nil; g_pres_mid_have = 0; g_pres_mid_out = nil; g_pres_multi = 0;
+    }
+    for (NSUInteger i = 0; i < nc && i < 8; i++) {
+        id<MTLTexture> mt = pd.colorAttachments[i].texture; if (!mt) continue;
+        const tex_t *tt = i < (NSUInteger)R.rt.n ? R.rt.color[i] : NULL; if (!tt) continue;
+        int k = g_pres_att_n++;
+        g_pres_att[k].slot = (uint8_t)i; g_pres_att[k].ser = tt->serial; g_pres_att[k].pf = (uint32_t)mt.pixelFormat;
+        g_pres_att[k].lv = (int)pd.colorAttachments[i].level;
+        g_pres_att[k].sl = mt.textureType == MTLTextureType2DArray ? (int)pd.colorAttachments[i].slice : 0;
+        g_pres_att[k].load = (int)pd.colorAttachments[i].loadAction;
+        g_pres_att[k].mt = mt;
+        if (!tt->serial) continue;
+        int w = -1;   // 写者表按 serial：同一帧同一个 serial 只留最后一个写它的遍
+        for (int j = 0; j < g_pres_wr_n; j++) if (g_pres_wr[j].frame == f && g_pres_wr[j].ser == tt->serial) { w = j; break; }
+        if (w < 0) { if (g_pres_wr_n >= PRES_WR) { g_pres_wdrop++; continue; } w = g_pres_wr_n++; }
+        pdbg_ent *e = &g_pres_wr[w];
+        memset(e, 0, sizeof *e);
+        e->frame = f; e->pass = g_stat_pass + 1; e->ser = tt->serial; e->slot = (uint8_t)i;
+        e->pf = (uint32_t)mt.pixelFormat; e->w = mt.width; e->h = mt.height;
+        e->lv = g_pres_att[k].lv; e->sl = g_pres_att[k].sl; e->load = g_pres_att[k].load;
+        e->ubo_reg = -1; e->disc = -1;
+        g_pres_wr_mt[w] = mt;
+    }
+    g_pres_att_pass = g_stat_pass + 1;   // 这一遍开遍后 g_stat_pass 才 ++，draw 里看到的就是它
+}
+// draw 里（每一遍的第一笔画，和 [dark2] / [ser285] 同一个时机）：写者表补状态；这一遍是上屏遍就记下来，
+//   并从它的输入里挑「本帧还有写者」的那张当中间目标。只读状态，零拷贝。
+static void pres_note(NvShader *vs, NvShader *fs) {
+    (void)vs;
+    if (!pres_on() || !fs) return;
+    uint64_t pass = g_stat_pass;
+    if (g_pres_pass == pass) return;   // 每遍只看第一笔画（这时的片元绑定 / S 属于这一遍）
+    g_pres_pass = pass;
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    for (int i = 0; i < g_pres_wr_n; i++) {   // 1) 这一遍是本帧某个 serial 的最后写者：补状态（中间目标的候选）
+        pdbg_ent *w = &g_pres_wr[i];
+        if (w->frame != frame || w->pass != pass || w->has_draw) continue;
+        pres_fill(w, fs);
+    }
+    // 2) 这一遍是上屏遍？key 前缀 → 学到的 key → 颜色附件是 drawable（serial 1 / present_now 交上屏的那张）
+    int why = 0;
+    const char *kp = pres_kp();
+    if (fs->key[0] && !strncmp(fs->key, kp, strlen(kp))) why = 3;
+    else if (g_pres_key[0] && !strcmp(fs->key, g_pres_key)) why = 2;
+    else if (g_pres_att_pass == pass) {
+        for (int i = 0; i < g_pres_att_n; i++) {
+            uint64_t s = g_pres_att[i].ser;
+            if (s && (s == 1 || (g_lit_present_seen && s == g_lit_present_ser))) { why = 1; break; }
+        }
+    }
+    if (!why) return;
+    if (g_pres_have && why < g_pres_ent.match) return;   // 已经有一个更可靠的命中：不换
+    if (g_pres_have) g_pres_multi++;
+    pdbg_ent tmp; memset(&tmp, 0, sizeof tmp);
+    tmp.frame = frame; tmp.pass = pass; tmp.match = why; tmp.ubo_reg = -1; tmp.disc = -1;
+    id<MTLTexture> otm = nil;
+    int pick = -1;   // 输出附件：优先 drawable 本身（serial 1 / present 那张），否则第一个带序号的槽
+    if (g_pres_att_pass == pass) {
+        for (int i = 0; i < g_pres_att_n && pick < 0; i++) {
+            uint64_t s = g_pres_att[i].ser;
+            if (s && (s == 1 || (g_lit_present_seen && s == g_lit_present_ser))) pick = i;
+        }
+        for (int i = 0; i < g_pres_att_n && pick < 0; i++) if (g_pres_att[i].ser) pick = i;
+    }
+    if (pick >= 0) {
+        tmp.slot = g_pres_att[pick].slot; tmp.ser = g_pres_att[pick].ser;
+        tmp.pf = g_pres_att[pick].pf; tmp.lv = g_pres_att[pick].lv; tmp.sl = g_pres_att[pick].sl; tmp.load = g_pres_att[pick].load;
+        if (g_pres_att[pick].mt) { tmp.w = g_pres_att[pick].mt.width; tmp.h = g_pres_att[pick].mt.height; otm = g_pres_att[pick].mt; }
+    }
+    pres_fill(&tmp, fs);
+    if (!g_pres_key[0] && fs->key[0]) snprintf(g_pres_key, sizeof g_pres_key, "%s", fs->key);   // 学到（序号轮换时靠它认）
+    // 3) 中间目标：输入里本帧还有写者（同 serial 的颜色附件）的那张；面积大的优先（严格 > 所以同面积先出现的赢）
+    int best = -1; uint64_t bestarea = 0;
+    for (int k = 0; k < tmp.ntex; k++) {
+        uint64_t s = tmp.tex[k].ser;
+        if (!s || s == tmp.ser) continue;
+        int isatt = 0;
+        for (int a = 0; a < g_pres_att_n; a++) if (g_pres_att[a].ser == s) isatt = 1;
+        if (isatt) continue;   // 上屏遍自己的另一个附件：不是中间目标
+        for (int i = 0; i < g_pres_wr_n; i++) {
+            const pdbg_ent *w = &g_pres_wr[i];
+            if (w->frame != frame || w->ser != s || w->pass >= pass) continue;
+            uint64_t area = (uint64_t)w->w * (uint64_t)w->h;
+            if (best < 0 || area > bestarea) { best = i; bestarea = area; }
+        }
+    }
+    if (best >= 0) { g_pres_mid = g_pres_wr[best]; g_pres_mid_out = g_pres_wr_mt[best]; g_pres_mid_have = 1; }
+    else { g_pres_mid_have = 0; g_pres_mid_out = nil; }
+    g_pres_ent = tmp; g_pres_out = otm; g_pres_have = 1;
+}
+// 帧末（下一帧第一遍之前，和 [litdbg] / [ser285] 同一个点）：上屏遍 / 中间目标的 UBO（≤ 256 B）、每张输入（正中区域）、
