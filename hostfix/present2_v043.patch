+            const tex_t *t = &g_treg[tid].t;
+            if (!t->serial || t->d.width < 1280 || t->d.height < 720) continue;
+            int self = 0;
+            for (int a = 0; a < R.rt.n && a < 8; a++) if (R.rt.color[a] && R.rt.color[a]->serial == t->serial) self = 1;
+            if (self) continue;
+            if (!have || (uint64_t)t->d.width * t->d.height > (uint64_t)best.d.width * best.d.height) { best = *t; have = 1; }
+        }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    if (!have) return;
+    id<MTLTexture> st = tex_mtl(&best);
+    if (!st || st.textureType != MTLTextureType2D || st.sampleCount != 1 || st.width < 8 || st.height < 8) return;
+    NSUInteger bpp = mtl_pf_bytes(st.pixelFormat);
+    if (!bpp || bpp > 4) return;   // 中心读回上限 8×8×4B
+    id<MTLBuffer> b = [g_dev newBufferWithLength:P2_BUF_BYTES options:MTLResourceStorageModeShared];
+    if (!b) return;
+    res_add(b);
+    id e = blit();
+    if (!e) { res_remove(b); return; }
+    NSUInteger cw = MIN(st.width, 8), ch = MIN(st.height, 8);
+    enc_b_copy_texture_buffer(e, st, 0, 0, MTLOriginMake((st.width - cw) / 2, (st.height - ch) / 2, 0),
+                              MTLSizeMake(cw, ch, 1), b, P2_IO, cw * bpp, cw * bpp * ch);
+    g_p2.src_buf = b; g_p2.used = 1; g_p2.src_ready = 1;
+    g_p2.dst_buf = nil; g_p2.dst_ready = 0; g_p2.dst_fence = 0;
+    g_p2.frame = f; g_p2.pass = g_stat_pass + 1;
+    g_p2.src_ser = best.serial; g_p2.src_nvn_fmt = best.d.format;
+    g_p2.src_w = (uint32_t)st.width; g_p2.src_h = (uint32_t)st.height;
+    g_p2.src_cw = (uint32_t)cw; g_p2.src_ch = (uint32_t)ch;
+    g_p2.src_bpp = (int)bpp; g_p2.src_mtl_fmt = (uint32_t)st.pixelFormat;
+    g_p2.dst_nvn_fmt = t0->d.format;
+    snprintf(g_p2.key, sizeof g_p2.key, "%s", fs->key);
+    g_p2.src_fence = g_fence + 1;
+}
+// 编码器结束、g_enc = nil 之后：把这一遍的 drawable 颜色附件 8×8 中心拷进 shared 缓冲。
+static void p2_post_end(void) {
+    if (!g_p2.used || g_p2.dst_ready) return;
+    if (g_p2.pass != g_stat_pass) return;   // 不是认下的那一遍
+    id<MTLTexture> t = g_lz_at[0];
+    if (!t || t.textureType != MTLTextureType2D || t.sampleCount != 1) return;
+    NSUInteger lv = (NSUInteger)g_lz_at_lv[0], sl = (NSUInteger)g_lz_at_sl[0];
+    NSUInteger w = MAX(t.width >> lv, 1u), h = MAX(t.height >> lv, 1u);
+    if (w < 8 || h < 8) return;
+    NSUInteger bpp = mtl_pf_bytes(t.pixelFormat);
+    if (!bpp || bpp > 4) return;
+    id<MTLBuffer> b = [g_dev newBufferWithLength:P2_BUF_BYTES options:MTLResourceStorageModeShared];
+    if (!b) return;
+    res_add(b);
+    id e = blit();
+    if (!e) { res_remove(b); return; }
+    NSUInteger row = 8 * bpp;
+    enc_b_copy_texture_buffer(e, t, sl, lv, MTLOriginMake((w - 8) / 2, (h - 8) / 2, 0),
+                              MTLSizeMake(8, 8, 1), b, P2_DST_OFF, row, row * 8);
+    g_p2.dst_buf = b; g_p2.dst_ready = 1;
+    g_p2.dst_ser = g_lz_at_ser[0];
+    g_p2.dst_w = (uint32_t)w; g_p2.dst_h = (uint32_t)h;
+    g_p2.dst_bpp = (int)bpp; g_p2.dst_mtl_fmt = (uint32_t)t.pixelFormat;
+    g_p2.dst_fence = g_fence + 1;
+}
+// 下一次开遍前：两份拷贝都随提交完成（g_done 到位）后读回，打 before / after。
+static void p2_drain(void) {
+    if (!g_p2.used) return;
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (!g_p2.src_ready || !g_p2.dst_ready) { if (g_p2.frame + 2 < f) p2_release(); return; }
+    if (g_p2.src_fence > g_done || g_p2.dst_fence > g_done) {
+        if (g_p2.frame + 2 < f) p2_release();
+        return;
+    }
+    if (g_p2.src_buf && g_p2.src_buf.contents) {
