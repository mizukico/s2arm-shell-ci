+// A buffer texture bound as a plain texture_buffer (not the 2D-row form of a wrapped 1D fetch) at a pool offset the linear-texture alignment refuses
+//   (S2Arm 11-13, FINAL FANTASY RESONANCE: pool offset 0xc8): on an Apple GPU such a view may read from the 16-byte boundary below the offset (measured on
+//   an M4). Copy the whole element range on the GPU into the frame arena and make the view on the copy (offset 0). Returns 1 when it made a copy.
+static int tpa_copy(int tid) {
+    if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok || g_tba_n >= TBA_MAX) return 0;
+    void *tv = NULL; (void)tex_fast_rid(tid, &tv); __unsafe_unretained id<MTLTexture> t = (__bridge id<MTLTexture>)tv;
+    if (!t || t.textureType != MTLTextureTypeTextureBuffer || !t.buffer) return 0;
+    NSUInteger al = linear_align(t.pixelFormat);
+    if (!al || !(t.bufferOffset % al)) return 0;
+    const tex_t *tt = &g_treg[tid].t;
+    if (tba_find(tt->serial, t, 1)) return 0;
+    int bw = 1, bh = 1; uint32_t bpb = (uint32_t)nvn_fmt_bpb(tt->d.format, &bw, &bh);
+    if (!bpb || bw != 1 || bh != 1 || !t.width) return 0;
+    size_t len = (size_t)t.width * bpb;
+    if (g_enc) { g_tba_splits++; PD("M %llu texture buffer aligned copy on the GPU: render pass split here", g_stat_pass); rp_end(); }
+    id<MTLBuffer> ab = nil; size_t off = arena_alloc(len, &ab); if (!ab) return 0;
+    enc_b_copy_buffer(blit(), t.buffer, t.bufferOffset, ab, off, len);
+    g_tba[g_tba_n++] = (tba_ent){tt->serial, t.bufferOffset, t.pixelFormat, t.buffer, ab, off, len, 1};
+    g_tba_copies++; g_tba_bytes += len;
+    if (g_tba_copies == 1 || g_tba_copies % 100000 == 0) MLOG("texture buffer at an unaligned pool offset (%lu, texture ID %d): copied on the GPU into the frame arena before use (%lu bytes; %llu copies so far; plain view)",
+        (unsigned long)t.bufferOffset, tid, (unsigned long)len, (unsigned long long)g_tba_copies);
+    return 1;
+}
+static id<MTLTexture> tpa_view(int tid, id<MTLTexture> t, uint64_t *rid) {
+    if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok || !t) return nil;
+    const tba_ent *ge = tba_find(g_treg[tid].t.serial, t, 1);
+    if (!ge) return nil;
+    NSUInteger al = linear_align(t.pixelFormat); size_t row = ge->len ? ((ge->len + al - 1) / al * al) : 0;
+    MTLTextureDescriptor *d = [MTLTextureDescriptor textureBufferDescriptorWithPixelFormat:t.pixelFormat width:t.width resourceOptions:ge->buf.resourceOptions usage:MTLTextureUsageShaderRead];
+    id<MTLTexture> v = [ge->buf newTextureWithDescriptor:d offset:ge->boff bytesPerRow:row];
+    if (!v) { if (!g_tb2_shadow_fail++) MLOG("【红】 cannot create the aligned shadow view of a texture buffer (texture ID %d)", tid); return nil; }
+    defer_obj_release(v); *rid = v.gpuResourceID._impl; g_tb2_binds++;
+    return v;
+}
