+// Called once per capture: when the pass that drew the fog shell has ended and the next one opens (dh_note), or
+// when the frame has moved on. The capture is released first: whatever happens below, this frame is read once.
+static void dh_emit(void) {
+    g_dh_pend = 0;
+    if (!g_dh_list.count) return;
+    NSArray *e = g_dh_list[0]; id<MTLTexture> t = e[0];
+    uint64_t ser = [e[1] unsignedLongLongValue], pass = g_dh_pass; long fr = g_dh_hit_frame;
+    NSUInteger w = t ? t.width : 0, h = t ? t.height : 0;
+    if (!t || !w || !h) { MLOG("[depthhist] ser=%llu %lux%lu pass=%llu frame=%ld read did not run: the depth attachment has no size", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, fr); [g_dh_list removeAllObjects]; return; }
+    if (g_enc) { MLOG("[depthhist] ser=%llu %lux%lu pass=%llu frame=%ld read did not run: a render encoder is open, the copy cannot be encoded between encoders", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, fr); [g_dh_list removeAllObjects]; return; }
+    if (t.pixelFormat != MTLPixelFormatDepth32Float && t.pixelFormat != MTLPixelFormatDepth32Float_Stencil8) {
+        MLOG("[depthhist] ser=%llu %lux%lu pass=%llu format %lu (%s) is not a 32-bit float depth target; read did not run", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, (unsigned long)t.pixelFormat, dh_fmt_name(t.pixelFormat)); [g_dh_list removeAllObjects]; return; }
+    size_t row = (size_t)w * 4, img = row * (size_t)h;
+    if (img > (size_t)(512ull << 20)) { MLOG("[depthhist] ser=%llu %lux%lu pass=%llu read did not run: %zu bytes is past the 512 MiB ceiling", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, img); [g_dh_list removeAllObjects]; return; }
+    if (!g_commit_blocks) { MLOG("[depthhist] ser=%llu %lux%lu pass=%llu read did not run: this submission keeps no commit blocks (it is not being recorded)", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass); [g_dh_list removeAllObjects]; return; }
+    id<MTLBuffer> buf = [g_dev newBufferWithLength:img options:MTLResourceStorageModeShared];
+    if (!buf) { MLOG("[depthhist] ser=%llu %lux%lu pass=%llu read did not run: no read-back buffer of %zu bytes", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, img); [g_dh_list removeAllObjects]; return; }
+    // A combined depth-stencil is read through a depth-only view: the same storage, the same depth value (the
+    // same view fb_narrow_view makes), while a copy of the combined format to a buffer would need the
+    // MTLBlitOptionDepthFromDepthStencil path. The depth plane is 4 bytes a pixel either way.
+    id<MTLTexture> rd = t;
+    if (t.pixelFormat == MTLPixelFormatDepth32Float_Stencil8) rd = [t newTextureViewWithPixelFormat:MTLPixelFormatDepth32Float textureType:MTLTextureType2D levels:NSMakeRange(0, 1) slices:NSMakeRange(0, 1)];
+    if (!rd) { MLOG("[depthhist] ser=%llu %lux%lu pass=%llu read did not run: no depth-only view of format %lu", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, (unsigned long)t.pixelFormat); [g_dh_list removeAllObjects]; return; }
+    int nb = g_dh_buckets; if (nb < 1) nb = 1; if (nb > 64) nb = 64;
+    const char *fmt = dh_fmt_name(t.pixelFormat);
+    NSMutableArray *keep = [NSMutableArray array];
+    dbl_keep(keep, buf); dbl_keep(keep, rd);
+    enc_b_copy_texture_buffer(blit(), rd, 0, 0, MTLOriginMake(0, 0, 0), MTLSizeMake(w, h, 1), buf, 0, row, img);
+    MLOG("[depthhist] ser=%llu %lux%lu pass=%llu frame=%ld format=%s: the copy is encoded after that pass in the frame's own command buffer (the histogram follows once the GPU is done)", (unsigned long long)ser, (unsigned long)w, (unsigned long)h, (unsigned long long)pass, fr, fmt);
+    [g_dh_list removeAllObjects];
+    [g_commit_blocks addObject:^{
+        dh_stat st;
+        dh_hist((const float *)buf.contents, (uint64_t)w * (uint64_t)h, nb, &st);
+        char bs[900]; size_t bo = 0;
+        for (int k = 0; k < nb && bo < sizeof bs - 12; k++) bo += snprintf(bs + bo, sizeof bs - bo, "%s%llu", k ? "," : "", (unsigned long long)st.buckets[k]);
+        char ls[2048]; size_t lo_ = 0; int lhits = 0;
+        { const float lspan = __builtin_log10f(DH_LOG_HI) - __builtin_log10f(DH_LOG_LO);
+          for (int k = 0; k < DH_LOG_N && lo_ < sizeof ls - 24; k++)
+              if (st.logb[k]) { lo_ += snprintf(ls + lo_, sizeof ls - lo_, "%s%.2e:%llu", lhits++ ? "," : "",
+                                                (double)__builtin_powf(10.f, __builtin_log10f(DH_LOG_LO) + (k + 0.5f) / DH_LOG_N * lspan),
