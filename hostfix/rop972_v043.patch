+                    if (k >= masked.Length || masked[k] != '.') { safe = false; break; }   // 被当值用 / 当参数传出去
+                    int j = k + 1; while (j < masked.Length && char.IsWhiteSpace(masked[j])) j++;
+                    int j0 = j; while (j < masked.Length && (char.IsLetterOrDigit(masked[j]) || masked[j] == '_')) j++;
