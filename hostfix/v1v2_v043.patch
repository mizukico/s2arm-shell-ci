+    for (int i = 0; i < g_p3_ndummy; i++) if (!strcmp(g_p3_dummy_keys[i], pair)) return;
+    if (g_p3_ndummy >= 512) return;
+    snprintf(g_p3_dummy_keys[g_p3_ndummy], sizeof g_p3_dummy_keys[0], "%s", pair);
+    g_p3_ndummy++;
