+        if (!g_ff_nopartner) { g_ff_nopartner = 1;
+            MLOG("【红】[ff] frame %llu pass %llu key=%s 想翻 ser %llu（cond=%s），但没有同尺寸 / 同格式、本帧读之前被写过的另一面：这一遍不翻",
+                 (unsigned long long)frame, (unsigned long long)pass, fs->key, (unsigned long long)g_ff_ser, later ? "later" : "empty"); }
+        return;
+    }
+    if (g_ff_sub_n) return;
+    g_ff_sub[0].from_ser = g_ff_ser; g_ff_sub[0].to_ser = pser; g_ff_sub[0].to_tid = ptid;
+    g_ff_sub[0].partner_pass = ppass; g_ff_sub[0].applied = 0; g_ff_sub_n = 1; g_ff_nflip++;
+    MLOG("[ff] frame %llu reader_pass=%llu key=%s flip ser %llu → %llu（cond=%s，另一面是 pass %llu 写的，原槽 reg=%u tid=%d，累计 %d 次）",
+         (unsigned long long)frame, (unsigned long long)pass, fs->key, (unsigned long long)g_ff_ser,
