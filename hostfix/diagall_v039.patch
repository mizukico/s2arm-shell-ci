+                pthread_mutex_unlock(&g_rmu);
+                if (!t) continue;
+                if (t.textureType != MTLTextureType2D && t.textureType != MTLTextureType2DArray) continue;
+                if (t.sampleCount != 1) continue;
+                size_t bpp = mtl_pf_bytes(t.pixelFormat); if (!bpp) continue;
+                NSUInteger w = MAX(t.width, (NSUInteger)1), h = MAX(t.height, (NSUInteger)1);
+                NSUInteger rwv = MIN(w, (NSUInteger)DA_BI), rhv = MIN(h, (NSUInteger)DA_BI);
+                NSUInteger x0 = (w - rwv) / 2, y0 = (h - rhv) / 2;
+                uint64_t bytes = (uint64_t)rwv * (uint64_t)rhv * (uint64_t)bpp;
+                if (need + bytes > (uint64_t)DA_BUDGET) continue;
+                rq[nrq].t = t; rq[nrq].lv = 0; rq[nrq].sl = 0; rq[nrq].x = x0; rq[nrq].y = y0;
+                rq[nrq].w = rwv; rq[nrq].h = rhv; rq[nrq].bpp = bpp; rq[nrq].row = (size_t)rwv * bpp;
