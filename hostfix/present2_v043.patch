+}
+// 片元常量缓冲：每一个 CBUF 槽一行（最多 2 行），前 64 字节；全 0 = 没上传
+static void lz_print_cb(NvShader *fs) {
+    int shown = 0;
+    for (int i = 0; i < fs->rf.nb && shown < 2; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind != NVN_RB_CBUF || b->reg >= 16) continue;
+        const p_bind_buf *u = &S.ubo[1][b->reg];
+        uint64_t len = u->addr ? u->size : 0; char *head = lz_b_hex;
+        if (!u->addr || !u->size) snprintf(head, sizeof lz_b_hex, "-");
+        else if (pend_hits(u->addr, len) || !lz_buf_hex(u->addr, len, head, sizeof lz_b_hex)) snprintf(head, sizeof lz_b_hex, "P");
+        if (!lz_line_ok(0)) return;
+        MLOG("[lit] cb len=%llu head=%s reg=%d", (unsigned long long)len, head, (int)b->reg);
+        shown++;
+    }
+}
+// 片元缓冲槽表：槽数 + 每槽字节数；len==0（没绑 / 没长度）与内容全 0 的重点标注。
+//   追加 A：把每个槽的地址记进本遍的详细块，下次开遍前（GPU 跑完）读前 64 字节打 [lit] buf（head + nonzero）。
+static void lz_print_buffers(NvShader *fs, lz_slot_t *s) {
+    char *b = lz_b_bufs; size_t o = 0; int nb = 0, len0 = 0, zero = 0;
+    b[0] = 0;
+    for (int i = 0; i < fs->rf.nb && nb < 10; i++) {
+        const nvn_rbind *r = &fs->rf.b[i];
+        const p_bind_buf *u = NULL;
+        if ((r->kind == NVN_RB_CBUF || r->kind == NVN_RB_UBOP) && r->reg < 16) u = &S.ubo[1][r->reg];
+        else if (r->kind == NVN_RB_SBUFP && r->reg < 16) u = &S.ssbo[1][r->reg];
+        else continue;
+        uint64_t len = u->addr ? u->size : 0; const char *mark = "";
