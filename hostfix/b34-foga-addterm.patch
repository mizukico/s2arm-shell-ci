+        // ---- S2A_FOG_A：阶段 A 的雾加性项（只给 6c00eb91 这一支，只在 env=1 时生成）----
+        // 独立于 FsAlphaMs：后者 L1223 有 src.Contains("S2A_AT_ON") -> return src，
+        // 而本支的 MSL 自带 S2A_AT_ON 声明，挂在那里注入会静默失效。
+        // 落点：_671<1.0 块内、65.w 块外（缩进 8、L1136 的 "float _1113 = _963;" 之前）。
+        // 三行加的是全额 c5[125].xyz，之后仍只乘一次 c3[140].y（L1137-1139）。
+        internal const int FOG_SLOT = 31;   // 片元缓冲槽 31：盘上已占 0 / 8 / 13 / 26 / 27 / 28 / 29 / 30，31 空闲
+        internal const string FOG_KEY = "6c00eb91c54f9451";   // Key 恒为 16 位小写十六进制（L86 正则强校验），不含 "_b"
+        internal static string FsFogA(string key, string src)
+        {
+            if (Environment.GetEnvironmentVariable("S2A_FOG_A") != "1") return src;
+            if (!string.Equals(key, FOG_KEY, StringComparison.Ordinal)) return src;
+
+            // ① 入口参数：在参数表尾追加 s2a_fog（签名正则贪婪吞整表，尾上是 s2a_aref [[buffer(30)]]）
+            var sig = Search(@"^((?:\[\[[^\]]*\]\]\s*)*)fragment main0_out main0\((.*)\)\n\{\n", src, RegexOptions.Multiline);
+            if (!sig.Success) { FogARed(key, "main0 signature not found"); return src; }
+            string prm = sig.Groups[2].Value;
+            string ext = (prm.Trim().Length > 0 ? ", " : "") + $"constant float* s2a_fog [[buffer({FOG_SLOT})]]";
+            string outp = src[..sig.Index] + sig.Groups[1].Value + "fragment main0_out main0(" + prm + ext + ")\n{\n"
+                        + src[(sig.Index + sig.Length)..];
+
+            // ② 函数体：锚点只用 L1136 那一行（8 空格缩进），必须唯一命中
+            const string anchor = "\n        float _1113 = _963;";
+            int hit = outp.IndexOf(anchor, StringComparison.Ordinal);
+            if (hit < 0) { FogARed(key, "anchor not found"); return src; }
+            if (outp.IndexOf(anchor, hit + anchor.Length, StringComparison.Ordinal) >= 0) { FogARed(key, "anchor matched more than once"); return src; }
+
+            string fin = outp.Replace(anchor,
+                  "\n        _969 = fma(s2a_fog[0], (*spvDescriptorSet0.fp_c5)._m0[125].x, _969);"
+                + "\n        _965 = fma(s2a_fog[0], (*spvDescriptorSet0.fp_c5)._m0[125].y, _965);"
+                + "\n        _967 = fma(s2a_fog[0], (*spvDescriptorSet0.fp_c5)._m0[125].z, _967);"
+                + anchor);
+
+            // ③ 自检：与入口原文比长度差（相对 src，含 ext 与三行两段增量），且三行必须各在
+            int delta = fin.Length - src.Length, n = 0;
+            for (int i = fin.IndexOf("s2a_fog[0]", StringComparison.Ordinal); i >= 0; i = fin.IndexOf("s2a_fog[0]", i + 1, StringComparison.Ordinal)) n++;
+            if (delta <= 0 || n != 3) { FogARed(key, $"self-check failed (delta={delta}, s2a_fog[0]={n}, want 3)"); return src; }
+
+            Console.Error.WriteLine($"[S2A_FOG_A] fog injected into {key} (slot {FOG_SLOT})");
+            return fin;
+        }
+        // 注入失败一律只打一条红、由调用处 return src：throw 会让整支 shader 翻译失败并带崩游戏
+        static void FogARed(string key, string why)
+        {
+            Console.Error.WriteLine($"[RED] {key}: S2A_FOG_A {why}; fog not injected");
+        }
