+}
+static void da_file_add(const char *rel) {
+    if (g_da_files_n >= DA_FILE_MAX) return;
+    for (int i = 0; i < g_da_files_n; i++) if (!strcmp(g_da_files[i], rel)) return;
+    snprintf(g_da_files[g_da_files_n++], sizeof g_da_files[0], "%s", rel);
+}
+static int da_write(const char *rel, const char *buf, size_t len, int append) {   // 写 <文档根>/padrec/<rel>，成功就记进 zip 清单
+    da_dir_once();
+    if (!g_da_dir[0]) return 0;
+    char p[1500]; s2a_docs_path(p, sizeof p, "padrec/%s", rel);
+    FILE *f = fopen(p, append ? "ab" : "wb");
+    if (!f) { if (!g_da_wfail) { g_da_wfail = 1; MLOG("【红】[diagall] 写不了 %s（errno=%d）：这一份丢掉，后面照写", p, errno); } return 0; }
+    int ok = fwrite(buf, 1, len, f) == len;
+    if (fclose(f)) ok = 0;
+    if (ok) da_file_add(rel);
+    return ok;
+}
+typedef struct { char *p; size_t n, cap; } da_sb;   // 文本行缓冲
+static void da_sb_add(da_sb *b, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void da_sb_add(da_sb *b, const char *fmt, ...) {
+    char tmp[1024];
+    va_list ap; va_start(ap, fmt); int k = vsnprintf(tmp, sizeof tmp, fmt, ap); va_end(ap);
+    if (k < 0) return;
+    size_t need = b->n + (size_t)k + 1;
+    if (need > b->cap) {
+        size_t nc = b->cap ? b->cap : 4096;
+        while (nc < need) nc *= 2;
+        char *np = realloc(b->p, nc);
+        if (!np) return;
+        b->p = np; b->cap = nc;
+    }
+    memcpy(b->p + b->n, tmp, (size_t)k + 1); b->n += (size_t)k;
+}
+static uint32_t da_crc32(const uint8_t *p, size_t n) {
+    static uint32_t tab[256]; static int once;
+    if (!once) { once = 1; for (uint32_t i = 0; i < 256; i++) { uint32_t c = i; for (int k = 0; k < 8; k++) c = (c & 1u) ? (0xedb88320u ^ (c >> 1)) : (c >> 1); tab[i] = c; } }
+    uint32_t c = 0xffffffffu;
+    for (size_t i = 0; i < n; i++) c = tab[(c ^ p[i]) & 0xffu] ^ (c >> 8);
+    return c ^ 0xffffffffu;
+}
+static void da_w16(FILE *f, unsigned v) { uint8_t b[2]; b[0] = (uint8_t)(v & 0xff); b[1] = (uint8_t)((v >> 8) & 0xff); fwrite(b, 1, 2, f); }
+static void da_w32(FILE *f, uint32_t v) { uint8_t b[4]; for (int i = 0; i < 4; i++) b[i] = (uint8_t)((v >> (8 * i)) & 0xff); fwrite(b, 1, 4, f); }
+static uint8_t *da_read_all(const char *path, size_t *n) {   // 整个文件读进内存（zip 用；这些文本都不大）
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END)) { fclose(f); return NULL; }
+    long sz = ftell(f);
+    if (sz < 0 || fseek(f, 0, SEEK_SET)) { fclose(f); return NULL; }
+    uint8_t *p = malloc((size_t)sz + 1);
+    if (p && sz && fread(p, 1, (size_t)sz, f) != (size_t)sz) { free(p); p = NULL; }
+    fclose(f);
+    if (p) *n = (size_t)sz;
+    return p;
+}
+// 打一个 zip（store 方式，不压缩：零依赖、标准 ZIP，资源管理器 / unzip 都认）。失败只打红行并说明原因。
+static void da_zip_now(const char *why) {
+    if (!g_da_files_n) { MLOG("[diagall] zip（%s）：还没有文件，跳过", why); return; }
+    da_dir_once();
+    if (!g_da_dir[0]) { MLOG("【红】[diagall] zip 失败（%s）：没有文档根（S2A_DOCS / $HOME 都没给）", why); return; }
+    time_t t = time(NULL); struct tm tv; localtime_r(&t, &tv);
+    char path[1500];
+    snprintf(path, sizeof path, "%s/diag_all_%04d%02d%02d_%02d%02d%02d.zip", g_da_dir,
+             tv.tm_year + 1900, tv.tm_mon + 1, tv.tm_mday, tv.tm_hour, tv.tm_min, tv.tm_sec);
+    FILE *f = fopen(path, "wb");
+    if (!f) { MLOG("【红】[diagall] zip 失败（%s）：打不开 %s（errno=%d）", why, path, errno); return; }
+    unsigned dt = (unsigned)((((tv.tm_year + 1900) - 1980) & 0x7f) << 9 | ((tv.tm_mon + 1) & 0xf) << 5 | (tv.tm_mday & 0x1f));
+    unsigned tt = (unsigned)((tv.tm_hour & 0x1f) << 11 | (tv.tm_min & 0x3f) << 5 | ((tv.tm_sec / 2) & 0x1f));
+    int kept = 0, miss = 0;
+    uint32_t cd[DA_FILE_MAX], cl[DA_FILE_MAX], cc[DA_FILE_MAX]; int ci[DA_FILE_MAX];
+    for (int i = 0; i < g_da_files_n && kept < DA_FILE_MAX; i++) {
+        char src[1600]; snprintf(src, sizeof src, "%s/%s", g_da_dir, g_da_files[i]);
+        size_t len = 0; uint8_t *data = da_read_all(src, &len);
+        if (!data) { miss++; continue; }
+        uint32_t crc = da_crc32(data, len);
+        long off = ftell(f);
+        if (off < 0) { free(data); miss++; continue; }
+        size_t nl = strlen(g_da_files[i]);
+        da_w32(f, 0x04034b50u); da_w16(f, 20); da_w16(f, 0); da_w16(f, 0); da_w16(f, tt); da_w16(f, dt);
+        da_w32(f, crc); da_w32(f, (uint32_t)len); da_w32(f, (uint32_t)len); da_w16(f, (unsigned)nl); da_w16(f, 0);
+        fwrite(g_da_files[i], 1, nl, f); fwrite(data, 1, len, f);
+        free(data);
+        cd[kept] = (uint32_t)off; cl[kept] = (uint32_t)len; cc[kept] = crc; ci[kept] = i;
+        kept++;
+    }
+    uint32_t cs = (uint32_t)ftell(f);
+    for (int k = 0; k < kept; k++) {
+        const char *nm = g_da_files[ci[k]];
+        size_t nl = strlen(nm);
+        da_w32(f, 0x02014b50u); da_w16(f, 20); da_w16(f, 20); da_w16(f, 0); da_w16(f, 0); da_w16(f, tt); da_w16(f, dt);
+        da_w32(f, cc[k]); da_w32(f, cl[k]); da_w32(f, cl[k]); da_w16(f, (unsigned)nl);
+        da_w16(f, 0); da_w16(f, 0); da_w16(f, 0); da_w16(f, 0); da_w32(f, 0); da_w32(f, cd[k]);
+        fwrite(nm, 1, nl, f);
+    }
+    uint32_t ce = (uint32_t)ftell(f);
+    da_w32(f, 0x06054b50u); da_w16(f, 0); da_w16(f, 0); da_w16(f, (unsigned)kept); da_w16(f, (unsigned)kept);
+    da_w32(f, ce - cs); da_w32(f, cs); da_w16(f, 0);
+    int ok = fflush(f) == 0;
+    long total = ftell(f);
+    if (fclose(f)) ok = 0;
+    if (!ok || !kept) { MLOG("【红】[diagall] zip 失败（%s）：%s（写盘出错 / 没有可读文件；%d 个不在盘上）", why, path, miss); return; }
+    MLOG("[diagall] zip（%s）：%d 个文件，%ld B → %s", why, kept, total, path);
+}
+// ① MSL 源文：先把目录里现成的那 9 份写出去（首行加 dumped 标记）；目录里没有的，等它第一次编译时再写。
+static void da_msl_write(int i, NSString *src) {
+    if (i < 0 || i >= DA_KEY_N || g_da_msl_have[i] || !src) return;
+    da_dir_once(); da_date_once();
+    if (!g_da_dir[0]) return;
+    char dir[1300], path[1500];
+    s2a_docs_path(dir, sizeof dir, "padrec/msl"); mkdir(dir, 0755);
+    snprintf(path, sizeof path, "%s/%s_b.metal", dir, g_da_key[i]);
+    FILE *f = fopen(path, "wb");
+    if (!f) { MLOG("【红】[diagall] 写不了 %s（errno=%d）", path, errno); return; }
+    fprintf(f, "// dumped for #427 %s %s\n", g_da_key[i], g_da_date);
+    fputs(src.UTF8String, f);
+    int ok = fclose(f) == 0;
+    if (!ok) { MLOG("【红】[diagall] MSL 源文没写完：%s", path); return; }
+    g_da_msl_have[i] = 1;
+    char rel[96]; snprintf(rel, sizeof rel, "msl/%s_b.metal", g_da_key[i]);
+    da_file_add(rel);
+}
+static void da_msl_harvest(void) {   // 候选目录与 msl_discard_probe 同口径：库目录、DM_MSL_FALLBACK、DM_MSL_DIR(+ /wire)、wire/<程序号>/shaders
+    da_dir_once();
+    if (!g_da_dir[0]) return;
+    NSMutableArray<NSString *> *ds = [NSMutableArray array];
+    if (g_msl_dir) [ds addObject:g_msl_dir];
+    const char *fb = getenv("DM_MSL_FALLBACK"), *md = getenv("DM_MSL_DIR");
+    if (fb && *fb) [ds addObject:@(fb)];
+    if (md && *md) { [ds addObject:@(md)]; [ds addObject:[@(md) stringByAppendingPathComponent:@"wire"]]; }
+    char wr[1200]; s2a_docs_path(wr, sizeof wr, "wire");
+    for (NSString *sub in [NSFileManager.defaultManager contentsOfDirectoryAtPath:@(wr) error:nil])
+        [ds addObject:[[@(wr) stringByAppendingPathComponent:sub] stringByAppendingPathComponent:@"shaders"]];
+    int got = 0;
+    for (int i = 0; i < DA_KEY_N; i++) {
+        NSString *name = [NSString stringWithFormat:@"%s_b.metal", g_da_key[i]];
+        for (NSString *d in ds) {
+            NSString *src = [NSString stringWithContentsOfFile:[d stringByAppendingPathComponent:name] encoding:NSUTF8StringEncoding error:nil];
+            if (!src) continue;
+            da_msl_write(i, src);
+            break;
+        }
+        got += g_da_msl_have[i];
+    }
+    MLOG("[diagall] MSL：%d/%d 支的 <key>_b.metal 找到并写进 padrec/msl/（其余的等第一次编译时写；真机包里通常只有 .metallib）", got, DA_KEY_N);
+}
+static void diagall_msl_source(NSString *pc, NSString *src) {   // shader_build 的 fallback 分支：源文就在手边，第一次编译时写出去
+    if (!da_on() || !src) return;
+    int i = da_key_idx(pc.UTF8String);
+    if (i < 0 || g_da_msl_have[i]) return;
+    da_msl_write(i, src);
+    if (g_da_msl_have[i]) MLOG("[diagall] MSL：%s 库里没有源文，在它第一次编译时写出了（padrec/msl/%s_b.metal）", g_da_key[i], g_da_key[i]);
+}
+static da_last *da_ls_get(uint64_t ser, int add) {
+    for (int i = 0; i < g_da_nls; i++) if (g_da_ls[i].ser == ser) return &g_da_ls[i];
+    if (!add) return NULL;
+    da_last *l;
+    if (g_da_nls < DA_RET) l = &g_da_ls[g_da_nls++];
+    else { l = &g_da_ls[g_da_ls_rr]; g_da_ls_rr = (g_da_ls_rr + 1) % DA_RET; }
+    memset(l, 0, sizeof *l);
+    l->ser = ser;
+    return l;
+}
+static int da_tgt_find(uint64_t ser) { for (int i = 0; i < g_da_ntg; i++) if (g_da_tg[i].ser == ser) return i; return -1; }
+static int da_tgt_ensure(uint64_t ser) {   // 读者也可能读到本帧还没写过的目标：按跨帧记忆补一条（wr_frame=0 = 本帧没写）
+    int k = da_tgt_find(ser);
+    if (k >= 0) return k;
+    da_last *l = da_ls_get(ser, 0);
+    if (!l || !l->is_tgt || g_da_ntg >= DA_TGT) return -1;
+    k = g_da_ntg++;
+    memset(&g_da_tg[k], 0, sizeof g_da_tg[k]);
+    g_da_tg[k].ser = ser; g_da_tg[k].pf = l->pf; g_da_tg[k].w = l->w; g_da_tg[k].h = l->h;
+    g_da_tgt_mt[k] = nil;
+    return k;
+}
+static int da_size_ok(NSUInteger w, NSUInteger h) { return (w == 800 && h == 450) || (w == 1600 && h == 900); }
+// 开遍时（和 bytgt_att_note / pres_att_note 同一个点）：记这一遍的颜色附件（上屏输出要用），其中 800x450 /
+//   1600x900 的浮点目标进本帧目标表并把 writer 指到这一遍。只读附件表与 R.rt；不建纹理、不拷贝、不进命令缓冲。
+static void da_att(MTL4RenderPassDescriptor *pd, NSUInteger nc) {
+    for (int i = 0; i < 8; i++) g_da_att_mt[i] = nil;
+    g_da_att_n = 0; g_da_att_pass = ~0ull;
+    if (!pd) return;
+    for (NSUInteger i = 0; i < nc && i < 8; i++) {
+        id<MTLTexture> mt = pd.colorAttachments[i].texture; if (!mt) continue;
+        const tex_t *tt = i < (NSUInteger)R.rt.n ? R.rt.color[i] : NULL; if (!tt) continue;
+        int a = g_da_att_n++;
+        g_da_att[a].slot = (uint8_t)i; g_da_att[a].ser = tt->serial; g_da_att[a].pf = (uint32_t)mt.pixelFormat;
+        g_da_att[a].lv = (int)pd.colorAttachments[i].level;
+        g_da_att[a].sl = mt.textureType == MTLTextureType2DArray ? (int)pd.colorAttachments[i].slice : 0;
+        g_da_att_mt[a] = mt;
+        if (!tt->serial) continue;
+        if (mtl_pf_dpf((MTLPixelFormat)g_da_att[a].pf) != NVN_DPF_FLOAT) continue;   // 只要浮点类（Uint / Sint 的 G-buffer 不算）
+        NSUInteger lv = (NSUInteger)g_da_att[a].lv, w = MAX(mt.width >> lv, (NSUInteger)1), h = MAX(mt.height >> lv, (NSUInteger)1);
+        if (!da_size_ok(w, h)) continue;
+        int k = da_tgt_find(tt->serial);
+        if (k < 0) {
+            if (g_da_ntg >= DA_TGT) { if (!g_da_trunc_logged) { g_da_trunc_logged = 1; MLOG("[diagall] 一帧的 800x450/1600x900 目标超过 %d 个，多出来的不记", DA_TGT); } continue; }
+            k = g_da_ntg++;
+            memset(&g_da_tg[k], 0, sizeof g_da_tg[k]);
+            g_da_tg[k].ser = tt->serial;
+        }
+        da_tgt *t = &g_da_tg[k];
+        t->pf = g_da_att[a].pf; t->w = w; t->h = h; t->lv = g_da_att[a].lv; t->sl = g_da_att[a].sl;
+        t->wr_frame = g_da_frame; t->wr_pass = g_stat_pass + 1; t->wr_key[0] = 0;
+        g_da_tgt_mt[k] = mt;
+        da_last *l = da_ls_get(tt->serial, 1);
+        if (l) { l->frame = g_da_frame; l->pass = t->wr_pass; l->pf = t->pf; l->w = w; l->h = h; l->is_tgt = 1; l->key[0] = 0; }
+    }
+    g_da_att_pass = g_stat_pass + 1;
+}
+// 把一支 shader 的纹理绑定抄进清单（只读绑定状态与注册表；不拷贝、不建纹理）
+static void da_fill_texlst(NvShader *sh, int stage, da_texlst *L) {
+    L->n = 0; L->ntot = 0;
+    if (!sh) return;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < sh->rf.nb; i++) {
+        const nvn_rbind *b = &sh->rf.b[i];
+        if (b->kind != NVN_RB_TEX) continue;
+        L->ntot++;
+        if (L->n >= DA_BTEX) continue;
+        int tid = (int)(tex_slot_h(S.tex[stage], S.img[stage], b->reg) & 0xfffff);
+        if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) tid = -1;
+        const treg_t *r = tid > 0 ? &g_treg[tid] : NULL;
+        da_tex *t = &L->t[L->n++];
+        memset(t, 0, sizeof *t);
+        t->reg = b->reg; t->tid = tid;
+        if (r) {
+            t->ser = r->t.serial; t->w = r->t.d.width; t->h = r->t.d.height;
+            int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+            uint32_t mpf = 0; uint8_t sw[4];
+            t->pf = nvn_fmt_to_mtl(nf, &mpf, sw) ? mpf : 0;
+        }
+        snprintf(t->kind, sizeof t->kind, "%s", d2_kind(b, r));
+    }
+    pthread_mutex_unlock(&g_rmu);
+}
+// ③ 顺序证据：69ebe1cc5d7e3c9a_b 每次 encode 一行（每帧 ≤4 行）。written_before=1 表示「本帧更早的一遍已经写过它读的那个
+//   序号」；=0 表示读到的是本帧还没写过的内容（上一帧的 / 被清过的）。last_writer_* 是跨帧记住的最后写者。
+static void da_order_line(NvShader *fs, uint64_t frame, uint64_t pass) {
+    uint64_t sers[4]; int ns = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb && ns < 4; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind != NVN_RB_TEX) continue;
+        int tid = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+        if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+        sers[ns++] = g_treg[tid].t.serial;
+    }
+    pthread_mutex_unlock(&g_rmu);
+    uint64_t rser = 0; int rk = -1;
+    for (int i = 0; i < ns; i++) { int k = da_tgt_find(sers[i]); if (k >= 0) { rser = sers[i]; rk = k; break; } }
+    if (!rser && ns) rser = sers[0];
+    int wb = 0; uint64_t lwp = 0; char lwk[24]; lwk[0] = 0;
+    if (rser) {
+        if (rk >= 0 && g_da_tg[rk].wr_frame == frame && g_da_tg[rk].wr_pass && g_da_tg[rk].wr_pass < pass) wb = 1;
+        da_last *l = da_ls_get(rser, 0);
+        if (l) { lwp = l->pass; snprintf(lwk, sizeof lwk, "%s", l->key[0] ? l->key : "-"); }
+    }
+    char sb[96]; size_t o = 0; sb[0] = 0;
+    for (int i = 0; i < ns; i++) o += snprintf(sb + o, sizeof sb - o, "%s%llu", i ? "," : "", (unsigned long long)sers[i]);
+    if (!sb[0]) snprintf(sb, sizeof sb, "-");
+    snprintf(g_da_ord[g_da_nord++], sizeof g_da_ord[0],
+             "[diagall] order frame=%llu pass=%llu key=%s reads_ser=%s written_before=%d last_writer_pass=%llu last_writer_key=%s\n",
+             (unsigned long long)frame, (unsigned long long)pass, fs->key, sb, wb,
+             (unsigned long long)lwp, lwk[0] ? lwk : "-");
+}
+// draw 里（和 [dark2] / [ser285] / [pres] 同一个时机）：补写者 key；记读者；抓 9 支的最大 CBUF；记 bind / present 的 pass。
+//   只读绑定状态与 S，零拷贝、不进命令缓冲。
+static void diagall_note(NvShader *vs, NvShader *fs) {
+    if (!da_on() || !fs || g_da_frame == ~0ull) return;
+    uint64_t frame = g_da_frame, pass = g_stat_pass;
+    if (da_key_idx(fs->key) == 0 && g_da_nord < DA_ORDER) da_order_line(fs, frame, pass);
+    if (g_da_pass_seen == pass) return;   // 以下每遍只做一次（第一笔画，这时的绑定状态属于这一遍）
+    g_da_pass_seen = pass;
+    for (int i = 0; i < g_da_ntg; i++) {   // 本遍是本帧某个目标的写者：补上片元 key（跨帧表也一起补）
+        da_tgt *t = &g_da_tg[i];
+        if (t->wr_frame != frame || t->wr_pass != pass || t->wr_key[0]) continue;
+        snprintf(t->wr_key, sizeof t->wr_key, "%s", fs->key[0] ? fs->key : "-");
+        da_last *l = da_ls_get(t->ser, 0);
+        if (l && l->pass == pass) snprintf(l->key, sizeof l->key, "%s", t->wr_key);
+    }
+    int reads_tgt = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int stage = 0; stage < 2; stage++) {
+        NvShader *sh = stage ? fs : vs;
+        for (int i = 0; sh && i < sh->rf.nb; i++) {
+            const nvn_rbind *b = &sh->rf.b[i];
+            if (b->kind != NVN_RB_TEX) continue;
+            int tid = (int)(tex_slot_h(S.tex[stage], S.img[stage], b->reg) & 0xfffff);
+            if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+            int k = da_tgt_ensure(g_treg[tid].t.serial);
+            if (k < 0) continue;
+            reads_tgt = 1;
+            da_tgt *t = &g_da_tg[k];
+            int dup = 0;
+            for (int q = 0; q < t->nrd; q++) if (t->rd[q].pass == pass) dup = 1;
+            if (dup || t->nrd >= DA_RD) continue;
+            t->rd[t->nrd].pass = pass;
+            snprintf(t->rd[t->nrd].key, sizeof t->rd[t->nrd].key, "%s", sh->key);
+            t->nrd++;
+        }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    for (int stage = 0; stage < 2; stage++) {   // ④ 9 支各自最大的 CBUF（本帧内取最大；片元优先）
+        NvShader *sh = stage ? fs : vs;
+        int ki = sh ? da_key_idx(sh->key) : -1;
+        if (ki < 0) continue;
+        int reg = -1; uint64_t addr = 0, len = 0;
+        for (int i = 0; i < sh->rf.nb; i++) {
+            const nvn_rbind *b = &sh->rf.b[i];
+            if (b->kind != NVN_RB_CBUF || b->reg >= 16) continue;
+            const p_bind_buf *u = &S.ubo[stage][b->reg];
+            if (u->addr && u->size && u->size > len) { addr = u->addr; len = u->size; reg = (int)b->reg; }
+        }
+        if (len && (!g_da_ubo[ki].len || g_da_ubo[ki].stage != stage || len > g_da_ubo[ki].len)) {
+            g_da_ubo[ki].addr = addr; g_da_ubo[ki].len = len; g_da_ubo[ki].reg = reg; g_da_ubo[ki].stage = stage;
+            g_da_ubo[ki].frame = frame; g_da_ubo[ki].pass = pass;
+            snprintf(g_da_ubo[ki].skey, sizeof g_da_ubo[ki].skey, "%s", sh->key);
+        }
+    }
+    int writes_tgt = 0;
+    for (int i = 0; i < g_da_ntg; i++) if (g_da_tg[i].wr_frame == frame && g_da_tg[i].wr_pass == pass) writes_tgt = 1;
+    int why = (da_key_idx(fs->key) >= 0 || (vs && da_key_idx(vs->key) >= 0)) ? 1 : writes_tgt ? 2 : reads_tgt ? 3 : 0;
+    if (why && g_da_nbind < DA_BIND) {   // ⑤ 相关 pass 的绑定清单（每帧 ≤4 个）
+        da_bind *r = &g_da_bind[g_da_nbind++];
+        r->frame = frame; r->pass = pass; r->reason = why;
+        snprintf(r->key, sizeof r->key, "%s", fs->key[0] ? fs->key : "-");
+        da_fill_texlst(fs, 1, &r->L);
+    }
+    int pw = 0;   // ⑥ 上屏遍：key 前缀命中，或这一遍的颜色附件里就有 drawable（serial 1 / present 交上屏的那张）
+    const char *kp = da_pres_kp();
+    if (fs->key[0] && !strncmp(fs->key, kp, strlen(kp))) pw = 1;
+    if (!pw && g_da_att_pass == pass)
+        for (int i = 0; i < g_da_att_n; i++) {
+            uint64_t s = g_da_att[i].ser;
+            if (s && (s == 1 || (g_lit_present_seen && s == g_lit_present_ser))) { pw = 2; break; }
+        }
+    if (pw) {
+        da_pres *p = &g_da_pres;
+        int pick = -1;
+        if (g_da_att_pass == pass) {
+            for (int i = 0; i < g_da_att_n && pick < 0; i++) {
+                uint64_t s = g_da_att[i].ser;
+                if (s && (s == 1 || (g_lit_present_seen && s == g_lit_present_ser))) pick = i;
+            }
+            for (int i = 0; i < g_da_att_n && pick < 0; i++) if (g_da_att[i].ser) pick = i;
+        }
+        p->have = 1; p->frame = frame; p->pass = pass; p->slot = pick;
+        p->ser = 0; p->pf = 0; p->w = p->h = 0; g_da_pres_out = nil;
+        snprintf(p->key, sizeof p->key, "%s", fs->key[0] ? fs->key : "-");
+        if (pick >= 0 && g_da_att_mt[pick]) {
+            p->ser = g_da_att[pick].ser; p->pf = g_da_att[pick].pf;
+            p->w = g_da_att_mt[pick].width; p->h = g_da_att_mt[pick].height;
+            g_da_pres_out = g_da_att_mt[pick];
+        }
+        da_fill_texlst(fs, 1, &p->L);
+    }
+}
+// 帧末（帧号一变、下一帧第一遍之前；和 [texdump] / [pres] 同一个点）：所有读回拼成一次提交
+//   `rp_end → mtl_finish_gpu → q_cb 一次 blit`，然后 CPU 上统计、写文本、必要时打 zip。pass 内零拷贝。
+static void diagall_dump(uint64_t frame) {
+    if (!da_on() || frame == ~0ull) return;
+    if (g_da_nord) {   // ③ order.txt（纯 CPU，不需要读回）
+        da_sb b; memset(&b, 0, sizeof b);
+        for (int i = 0; i < g_da_nord; i++) da_sb_add(&b, "%s", g_da_ord[i]);
+        if (b.p) da_write("order.txt", b.p, b.n, 1);
+        free(b.p);
+        g_da_nord = 0;
+    }
+    int do_snap = frame >= 120 && frame % 60 == 0 && g_da_snap_n < DA_SNAP;
