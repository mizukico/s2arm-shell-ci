+}
+static void lz_fb_add(const char *k) { lz_key_add(g_lz_fb_key, &g_lz_fb_n, &g_lz_fb_total, k); }
+static void lz_summary(void) {
+    if (g_lz_off || g_lz_sum_n >= 12) return;
+    if (g_lz_cs_n) {
+        char *b = lz_b_sum; size_t o = 0; b[0] = 0;
+        for (int i = 0; i < g_lz_cs_n && o + 30 < sizeof lz_b_sum; i++) o += snprintf(b + o, sizeof lz_b_sum - o, "%s%s", i ? "," : "", g_lz_cs_key[i]);
+        if (lz_line_ok(1)) { MLOG("[cs] summary: n=%llu keys=%s", (unsigned long long)g_lz_cs_total, b); g_lz_sum_n++; }
+    }
+    if (g_lz_fb_n) {
+        char *b = lz_b_sum; size_t o = 0; b[0] = 0;
+        for (int i = 0; i < g_lz_fb_n && o + 30 < sizeof lz_b_sum; i++) o += snprintf(b + o, sizeof lz_b_sum - o, "%s%s", i ? "," : "", g_lz_fb_key[i]);
+        if (lz_line_ok(0)) { MLOG("[fallback] summary: n=%llu keys=%s", (unsigned long long)g_lz_fb_total, b); g_lz_sum_n++; }
+    }
+}
+// 追加 4：passdump.tsv —— 每次抓取（链路写 / 光照输入）在内存里攒一行，写 logs/passdump.tsv（失败退当前目录）；
+//   每行同时按 [pdump] 日志输出（present2 起每帧 ≤ 8 行），导出诊断包只收 diagrun/*.png，日志一定带着。
+//   表头固定；UTF-8 / Tab / LF；最多 200000 行，超出加 "# capped"。
+#define LZ_PD_MAX_LINES 200000
+static char *g_lz_pd; static size_t g_lz_pd_len, g_lz_pd_cap; static int g_lz_pd_lines, g_lz_pd_capped;
+static uint64_t g_lz_pd_frame = ~0ull; static int g_lz_pd_order;
+static uint64_t g_lz_pd_log_frame = ~0ull; static int g_lz_pd_log_n;
+static void lz_pd_row(uint64_t f, uint64_t pass, const char *key, const char *role, uint64_t ser, uint32_t w, uint32_t h, uint32_t fmt, const char *fmtn, double mean, uint32_t mx) {
+    if (g_lz_off) return;
