+static void ap_tm_job(NSDictionary *j) {
+    if (ap_tm_off) return;
+    @try {
+        id<MTLBuffer> b = j[@"buf"]; if (!b) return;
+        const uint8_t *p = (const uint8_t *)b.contents; if (!p) return;
+        long f = (long)[j[@"f"] longValue]; unsigned long long ser = [j[@"ser"] unsignedLongLongValue];
+        unsigned fmt = (unsigned)[j[@"fmt"] unsignedIntValue], bpp = (unsigned)[j[@"bpp"] unsignedIntValue];
