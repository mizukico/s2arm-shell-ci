+static int lz_slot_of(uint64_t pass) { for (int i = 0; i < LZ_SLOT_MAX; i++) if (g_lz_slot[i].used && g_lz_slot[i].pass == pass) return i; return -1; }
+static int lz_slot_free(void) { for (int i = 0; i < LZ_SLOT_MAX; i++) if (!g_lz_slot[i].used) return i; return -1; }
+static int lz_buf_hex(uint64_t addr, uint64_t len, char *out, size_t n) {   // 前 64 字节十六进制；读不到返回 0
+    if (!addr || !len) { snprintf(out, n, "-"); return 1; }
+    void *mb; uint64_t mo; const uint8_t *p;
+    if (!nvn_be_addr(addr, len, &mb, &mo) || !(p = [(__bridge id<MTLBuffer>)mb contents])) return 0;
+    size_t k = len < 64 ? (size_t)len : 64, o = 0;
+    for (size_t i = 0; i < k && o + 3 < n; i++) o += snprintf(out + o, n - o, "%02x", p[mo + i]);
