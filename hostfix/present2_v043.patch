+    g_lz_frame = f; g_lz_nser = 0; g_lz_lines_lit = 0; g_lz_lines_cs = 0; g_lz_lines_dim = 0; g_lz_chain_lines = 0; g_lz_blocks_frame = 0; g_lz_scan_frame = 0; g_lz_best_nin = 0;
