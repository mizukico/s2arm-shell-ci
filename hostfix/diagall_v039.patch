+    } else if (do_snap || do_round) {
+        struct { id<MTLTexture> t; NSUInteger lv, sl, x, y, w, h; size_t bpp, row; int kind, idx, sub; } rq[DA_RQ];
+        id<MTLBuffer> rb[DA_RQ];
