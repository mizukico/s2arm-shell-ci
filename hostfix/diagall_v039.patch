+    }
+    if (csz) cbuf = [g_dev newBufferWithLength:(NSUInteger)csz options:MTLResourceStorageModeShared];
+    if (ssz) sbuf = [g_dev newBufferWithLength:(NSUInteger)ssz options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+    if (ubuf && srcb) enc_b_copy_buffer(b, srcb, soff, ubuf, 0, slen);
+    NSUInteger cox = cube ? (cube.width - cpx) / 2 : 0, coy = cube ? (cube.height - cpx) / 2 : 0;   // 取每面正中 4×4：角落可能是贴图接缝 / 空区域，说明不了 IBL 有没有内容
+    NSUInteger sox = shd ? (shd.width - spx) / 2 : 0, soy = shd ? (shd.height - spx) / 2 : 0;      // 取每层正中 16×16：阴影图角落常在光锥外（清成 1.0），读不出有没有几何
