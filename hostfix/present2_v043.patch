+        tex_t *tc = lz_tc; int ntc = 0;   // 静态：栈上不放大结构体数组
+        pthread_mutex_lock(&g_rmu);
+        for (int i = 0; i < pr->sh[1]->rf.nb && ntc < 12; i++) {
+            int tids[4], nt = lz_tids(&pr->sh[1]->rf.b[i], tids);
+            for (int q = 0; q < nt && ntc < 12; q++) { int tid = tids[q]; if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) continue; tc[ntc++] = g_treg[tid].t; }
+        }
+        pthread_mutex_unlock(&g_rmu);
+        for (int i = 0; i < ntc; i++) {
+            id<MTLTexture> t = tex_mtl(&tc[i]);
+            if (!t || t.textureType != MTLTextureType2D) continue;
+            if ((uint32_t)t.width > g_lz_pk_inw) g_lz_pk_inw = (uint32_t)t.width;
+            if ((uint32_t)t.height > g_lz_pk_inh) g_lz_pk_inh = (uint32_t)t.height;
+            if (pf_is_float(t.pixelFormat)) g_lz_pk_infloat = 1;
+        }
+    }
+    if (lz_slot_of(pass) >= 0) return;                            // 这一遍已经记过
+    NvShader *fs = pr->sh[1];
+    if (!fs->rf.nb) return;
+    const tex_t *t0 = R.rt.n > 0 ? R.rt.color[0] : NULL;
+    if (!t0) return;
+    uint64_t ser0; int lv0, sl0; rt_sub(&R.rt, 0, &ser0, &lv0, &sl0);
+    NSUInteger tw = MAX(t0->d.width >> lv0, 1u), th = MAX(t0->d.height >> lv0, 1u);
+    if (tw < 1280 || th < 720) return;                            // 场景级 target（真机 1600x900）
+    int attslot[LZ_MAX_ATT], natt = 0;
+    for (int i = 0; i < R.rt.n && i < 8 && natt < LZ_MAX_ATT; i++) {
+        if (!R.rt.color[i] || rt_dup_slot(&R.rt, i)) continue;
+        attslot[natt++] = i;
+    }
+    // 候选输入：片元 TEX / TEXU（单句柄与句柄数组），尺寸与本遍 target 一致、不是本遍附件
+    tex_t *cand = lz_cand; int creg[8], ctid[8]; int nc = 0;   // 静态：栈上不放大结构体数组
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb && nc < 8; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        int tids[4], nt = 0;   // 一个绑定 → 1~4 个候选 tid（TEXU 数组按元素取，同 encode_args 的读法）
+        if (b->kind == NVN_RB_TEX) tids[nt++] = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+        else if (b->kind == NVN_RB_TEXU && !b->n) tids[nt++] = ubo_tex_id(ubo_packed(1, b));
+        else if (b->kind == NVN_RB_TEXU && b->n) { for (int k = 0; k < b->n && k < 4; k++) tids[nt++] = ubo_tex_id(ubo_handle(1, b->reg, 8 * k)); }
+        for (int q = 0; q < nt && nc < 8; q++) {
+            int tid = tids[q];
+            if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+            const tex_t *t = &g_treg[tid].t;
+            if (!t->serial || t->d.width != tw || t->d.height != th) continue;
+            int self = 0; for (int r = 0; r < natt; r++) if (R.rt.color[attslot[r]] && R.rt.color[attslot[r]]->serial == t->serial) self = 1;
