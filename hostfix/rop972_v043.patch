+            }
+            regs = edits.Select(c => c.Reg).Distinct().OrderBy(x => x).ToList();
+            lock (s_urLock) UintReadDone++;
+            return UINT_READ_BEGIN + (regs.Count == 0 ? "-" : string.Join(",", regs)) + "\n" + outp;
+        }
