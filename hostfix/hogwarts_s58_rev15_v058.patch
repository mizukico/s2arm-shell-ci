+void dh_note(MTL4RenderPassDescriptor *pd) {
+    (void)pd;
+    if (g_dh_frame == -2) {
+        const char *e = getenv("DM_NVN_DEPTHHIST");
+        g_dh_frame = -1; g_dh_end = -1; g_dh_list = [NSMutableArray array];
+        if (e && *e) {
+            if (!strcmp(e, "selftest")) g_dh_frame = -3;
+            else if (!strcmp(e, "1")) {   // follow the PASSDUMP window: no second frame number to guess
+                const char *ps = getenv("DM_NVN_PASSDUMP");
+                if (ps && *ps) {
+                    long a = atol(ps); const char *dash = strchr(ps, '-'); long b = dash ? atol(dash + 1) : a;
+                    if (a >= 0 && b >= a) { g_dh_frame = a; g_dh_end = b; }
+                }
+                if (g_dh_frame < 0) MLOG("DM_NVN_DEPTHHIST=1 needs DM_NVN_PASSDUMP=<frame> or <start>-<end>; the depth probe is off");
+            } else {
+                const char *c = strchr(e, ':');
+                long f = atol(e); if (f < 0) f = -1;
+                g_dh_frame = f; g_dh_end = f;
+                if (c) { int nb = atoi(c + 1); if (nb > 0) g_dh_buckets = nb; }
+                if (g_dh_frame < 0) MLOG("DM_NVN_DEPTHHIST: %s is not a frame number; the depth probe is off", e);
+            }
+            if (g_dh_frame >= 0) MLOG("depthhist: frame=%ld..%ld buckets=%d logb=[1e-6,1e-2]x128 fine=[0,1e-4]x128 fog=%s -- armed (diagnostic, log only; the game's memory is not written)",
+                                      g_dh_frame, g_dh_end ? g_dh_end : g_dh_frame, g_dh_buckets, DH_FOG_KEY);
+        }
+    }
+    if (g_dh_frame == -3) {   // selftest: {0, 1e-6, 1e-4, 0.5, 1, NaN} -> exact0=1, lt1e-5=1, lt1e-3=1, lt0.1=1, ge0.5=1, ge1=1, nan=1
+        if (g_dh_self++) return;
+        float v[6] = {0.f, 1e-6f, 1e-4f, 0.5f, 1.f, __builtin_nanf("")};
+        dh_stat st;
+        dh_hist(v, 6, 8, &st);
+        char bs[200]; size_t o = 0;
+        for (int k = 0; k < 8; k++) o += snprintf(bs + o, sizeof bs - o, "%s%llu", k ? "," : "", (unsigned long long)st.buckets[k]);
+        char fs[200]; size_t fo = 0; int fhits = 0;
+        for (int k = 0; k < DH_FINE_N; k++) if (st.fine[k]) { fo += snprintf(fs + fo, sizeof fs - fo, "%s%d:%llu", fhits++ ? "," : "", k, (unsigned long long)st.fine[k]); }
