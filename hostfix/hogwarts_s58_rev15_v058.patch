+        MLOG("[depthhist] ser=%llu %lux%lu pass=%llu frame=%ld format=%s exact0=%llu lt1e-5=%llu lt1e-4=%llu lt1e-3=%llu lt0.1=%llu lt0.5=%llu ge0.5=%llu ge1=%llu nan=%llu min=%.9g max=%.9g mean=%.9g coarse[%d]=%s logb[1e-6,1e-2]x%d=%s fine[0,1e-4]x%d=%s",
