+static uint64_t g_lit_present_ser; static int g_lit_present_seen;   // present_now 交上屏的那张：写它的那一遍的片元输入才是场景色
+static uint64_t g_lit_src_ser;   // 学到的上屏源序号（场景色）
+static uint64_t g_lit_src_pass = ~0ull;   // 每一遍只看第一笔画（绑定状态属于这一遍）
+static char g_lit_pkey[24];   // present 那一遍的片元 key：序号匹配到一次之后，后续帧用它认这一遍
+static uint64_t g_lit_frame = ~0ull;   // 正在收集的帧号：帧号一变就是「上一帧已经画完」，在下一帧第一遍开始前读回
+static int g_lit_n;                    // 本帧收到的目标（每个序号一条，后来的覆盖先前的，即取本帧最后一遍）
+static __strong id<MTLTexture> g_lit_tex[LIT_SER_MAX];
+static uint64_t g_lit_tser[LIT_SER_MAX]; static NSUInteger g_lit_lv[LIT_SER_MAX], g_lit_sl[LIT_SER_MAX];
+static int g_lit_slot[LIT_SER_MAX];
+static int g_lit_fail_logged;
