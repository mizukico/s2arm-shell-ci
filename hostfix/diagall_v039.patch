+        ubuf[i] = nil; usrc[i] = nil; uso[i] = ulen[i] = 0;
+        for (int k = 0; k < D2_STAT; k++) { itex[i][k] = nil; ibuf[i][k] = nil; irow[i][k] = ipx[i][k] = 0; ibpp[i][k] = 0; }
