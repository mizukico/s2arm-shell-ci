+static int alias_tiny_bits(void) {
+    static _Atomic int v = -1;
+    int b = atomic_load_explicit(&v, memory_order_relaxed);
+    if (b < 0) {
+        const char *e = getenv("S2A_ALIAS_TINY");
+        long n = e && *e ? strtol(e, NULL, 0) : 1;
+        if (n < 0) n = 0;
+        if (n > 15) n = 15;
+        b = (int)n;
+        atomic_store_explicit(&v, b, memory_order_relaxed);
+    }
+    return b;
+}
+static int alias_cls_of(const nvn_texdesc *d) {
+    if (!d) return ALIAS_CLS_NONE;
+    if (d->width == 1u && d->height == 1u && d->depth <= 1u) return ALIAS_CLS_TINY;
+    if (d->width == 8u && d->height == 8u && d->depth == 64u) return ALIAS_CLS_VOL;
+    if (d->width == 32u && d->height == 32u && d->depth == 32u) return ALIAS_CLS_SKY;
+    return ALIAS_CLS_NONE;
