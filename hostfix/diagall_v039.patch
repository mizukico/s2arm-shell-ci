+        }
+        if (!ubuf && !g_litin_ubo_fail) { g_litin_ubo_fail = 1;
+            MLOG("【红】[litin] ubo reg=%d addr=%#llx len=%llu: 地址不在内存池 / 没 4 字节对齐 / 池尾不够，读不回来（这一类以后不再提示）",
