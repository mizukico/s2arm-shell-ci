+static void dark2_note(NvShader *fs) {
+    if (!dark2_on() || !fs) return;
+    uint64_t pass = g_stat_pass;
+    if (g_d2_pass == pass) return;   // 每遍只看第一笔画（这时的片元绑定 / S 属于这一遍）
+    g_d2_pass = pass;
