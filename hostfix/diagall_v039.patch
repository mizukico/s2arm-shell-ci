+// 交出某一帧的条目（更晚帧的条目留着）
+static void dark2_retire(uint64_t frame) {
+    int keep = 0;
+    for (int i = 0; i < g_d2_n; i++) {
+        if (g_d2[i].frame == frame) { g_d2_out[i] = nil; continue; }
+        if (keep != i) { g_d2[keep] = g_d2[i]; g_d2_out[keep] = g_d2_out[i]; g_d2_out[i] = nil; }
+        keep++;
+    }
+    g_d2_n = keep;
