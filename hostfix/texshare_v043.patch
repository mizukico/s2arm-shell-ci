+        internal static string UintRead(string msl, string key, out List<long> regs, out string fallback)
+        {
+            regs = new List<long>(); fallback = null;
+            if (string.IsNullOrEmpty(msl)) return msl;
+            if (!UintReadDecl()) return msl;   // 2026-11-18 rop972：默认不做「改声明 + 去 as_type」（S2A_UINT_READ_DECL=1 才做）
+            if (msl.StartsWith(UINT_READ_BEGIN, StringComparison.Ordinal))
+            {   // 幂等：已经改写过的（重入 / 源文自带）原样返回，槽表从标记行读回
+                int e = msl.IndexOf('\n');
+                foreach (var x in (e < 0 ? msl[UINT_READ_BEGIN.Length..] : msl[UINT_READ_BEGIN.Length..e]).Split(',', StringSplitOptions.RemoveEmptyEntries))
