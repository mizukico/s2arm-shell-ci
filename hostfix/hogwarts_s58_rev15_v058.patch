+// The band follows the judge, not a guess: this draw is near=0 / main0_z (log depth mode line), which leaves z
+// as it is, so depth = z/w = near/d -- the fog shell lands around 1e-5..1e-4 and the scene around 1e-3. A band
+// around 0.5 covers the main0 convention (0.5z+0.5w) and would read nothing here, so the fine band is
+// LOGARITHMIC over 1e-6..1e-2 at 32 bins per decade (about 3 % wide, enough to separate 1e-5 from 1.05e-5),
+// plus a linear [0,1e-4] band for the "no geometry wrote here" end.
+#define DH_LOG_LO 1e-6f
+#define DH_LOG_HI 1e-2f
+#define DH_LOG_N 128
+#define DH_FINE_LO 0.f
+#define DH_FINE_HI 1e-4f
+#define DH_FINE_N 128
+typedef struct { uint64_t n, zero, one, nan_, lt05, ge05, lt1e5, lt1e4, lt1e3, lt01; float mn, mx; double mean;
+                 uint64_t buckets[64], logb[DH_LOG_N], fine[DH_FINE_N]; } dh_stat;
+
+static void dh_hist(const float *z, uint64_t n, int nb, dh_stat *o) {
+    memset(o, 0, sizeof *o);
+    o->n = n; o->mn = 3.4e38f; o->mx = -3.4e38f; double sum = 0; uint64_t finite = 0;
+    const float logspan = __builtin_log10f(DH_LOG_HI) - __builtin_log10f(DH_LOG_LO);
+    for (uint64_t i = 0; i < n; i++) {
+        float v = z[i];
+        if (v != v) { o->nan_++; continue; }                       // NaN is its own count, not a bucket
+        finite++; sum += v;
+        if (v < o->mn) o->mn = v; if (v > o->mx) o->mx = v;
+        if (v == 0.f) { o->zero++; continue; }                     // the clear value, counted apart
+        if (v >= 1.f) { o->one++; continue; }
+        if (v < 0.5f) o->lt05++; else o->ge05++;                   // the side of 0.5
+        if (v < 1e-5f) o->lt1e5++;                                 // quantile fractions, no preset band to guess
+        if (v < 1e-4f) o->lt1e4++;
+        if (v < 1e-3f) o->lt1e3++;
+        if (v < 0.1f) o->lt01++;
+        int k = (int)(v * (float)nb); if (k < 0) k = 0; if (k >= nb) k = nb - 1;
+        o->buckets[k]++;
+        if (v >= DH_LOG_LO && v <= DH_LOG_HI) {
+            int j = (int)((__builtin_log10f(v) - __builtin_log10f(DH_LOG_LO)) / logspan * DH_LOG_N);
+            if (j < 0) j = 0; if (j >= DH_LOG_N) j = DH_LOG_N - 1;
+            o->logb[j]++;
+        }
+        if (v >= DH_FINE_LO && v <= DH_FINE_HI) {
+            int j = (int)((v - DH_FINE_LO) / ((DH_FINE_HI - DH_FINE_LO) / DH_FINE_N));
+            if (j < 0) j = 0; if (j >= DH_FINE_N) j = DH_FINE_N - 1;
+            o->fine[j]++;
+        }
+    }
+    if (!finite) { o->mn = 0; o->mx = 0; }
+    o->mean = finite ? sum / (double)finite : 0.0;
+}
