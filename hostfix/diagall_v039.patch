+        pthread_mutex_unlock(&g_rmu);
+        // 3) 分配共享缓冲 + 一次 blit 提交（只在帧末，不在任何 pass 里）
+        for (int p = 0; p < np; p++) {
+            if (ulen[p]) { ubuf[p] = [g_dev newBufferWithLength:ulen[p] options:MTLResourceStorageModeShared]; if (!ubuf[p]) ulen[p] = 0; }
+            if (orow[p]) { obuf[p] = [g_dev newBufferWithLength:orow[p] * (size_t)oh[p] options:MTLResourceStorageModeShared]; if (!obuf[p]) orow[p] = 0; }
+            for (int k = 0; k < D2_STAT; k++) if (itex[p][k]) {
+                ibuf[p][k] = [g_dev newBufferWithLength:irow[p][k] * (size_t)ipx[p][k] options:MTLResourceStorageModeShared];
+                if (!ibuf[p][k]) itex[p][k] = nil;
+            }
+        }
