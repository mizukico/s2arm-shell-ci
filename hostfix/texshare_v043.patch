+                              sourceSize:MTLSizeMake(AP_CUBE_SIDE, AP_CUBE_SIDE, 1) toBuffer:rb destinationOffset:(NSUInteger)((size_t)i * face)
+                        destinationBytesPerRow:row destinationBytesPerImage:face];
+                res_add(rb);
+                NSDictionary *j = @{@"buf": rb, @"f": e[4], @"ser": e[1], @"fmt": e[2], @"pf": e[3], @"bpp": @(bpp), @"face": @(face)};
+                [g_commit_blocks addObject:^{ ap_cube_job(j); }];
+            }
+        }
+        if (ap_vol_pend.count && !ap_vol_off) {
+            NSArray *jobs = [ap_vol_pend copy]; [ap_vol_pend removeAllObjects];
+            for (NSArray *e in jobs) {
+                id<MTLTexture> t = e[0]; if (!t) continue;
+                size_t bpp = mtl_pf_bytes(t.pixelFormat); if (!bpp || bpp > 8) { MLOG("[vol] ser=%llu skip: unsupported texel size %lu", [e[1] unsignedLongLongValue], (unsigned long)bpp); continue; }
+                size_t row = 8 * bpp, img = ((row * 8 + 255) / 256) * 256, total = img * 64;
+                id<MTLBuffer> rb = [g_dev newBufferWithLength:total options:MTLResourceStorageModeShared];
+                if (!rb) { MLOG("[vol] ser=%llu skip: newBufferWithLength(%lu) nil", [e[1] unsignedLongLongValue], (unsigned long)total); continue; }
+                id<MTL4ComputeCommandEncoder> enc = blit(); if (!enc) { MLOG("[vol] skip: blitCommandEncoder nil"); continue; }
+                [enc copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(8, 8, 64)
+                            toBuffer:rb destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:img];
+                res_add(rb);
+                NSDictionary *j = @{@"buf": rb, @"f": e[4], @"ser": e[1], @"fmt": e[2], @"pf": e[3], @"bpp": @(bpp), @"img": @(img)};
+                [g_commit_blocks addObject:^{ ap_vol_job(j); }];
+            }
+        }
+        if (ap_tm_pend.count && !ap_tm_off) {
+            NSArray *jobs = [ap_tm_pend copy]; [ap_tm_pend removeAllObjects];
+            for (NSArray *e in jobs) {
+                id<MTLTexture> t = e[0]; if (!t) continue;
+                size_t bpp = mtl_pf_bytes(t.pixelFormat);
+                if (!bpp || bpp > 16) { MLOG("[tonemapin] ser=%llu skip: texel size %lu", [e[1] unsignedLongLongValue], (unsigned long)bpp); continue; }
+                id<MTLBuffer> rb = [g_dev newBufferWithLength:16 options:MTLResourceStorageModeShared];
+                if (!rb) { MLOG("[tonemapin] skip: newBufferWithLength(16) nil"); continue; }
+                id<MTL4ComputeCommandEncoder> enc = blit(); if (!enc) { MLOG("[tonemapin] skip: blitCommandEncoder nil"); continue; }
+                [enc copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(1, 1, 1)
+                            toBuffer:rb destinationOffset:0 destinationBytesPerRow:bpp destinationBytesPerImage:bpp];
+                res_add(rb);
+                NSDictionary *j = @{@"buf": rb, @"f": e[4], @"ser": e[1], @"fmt": e[2], @"bpp": @(bpp)};
+                [g_commit_blocks addObject:^{ ap_tm_job(j); }];
+            }
+        }
+    } @catch (NSException *e) {
+        ap_cube_off = ap_vol_off = ap_tm_off = 1;
+        MLOG("[aplan] dumps disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception");
+    }
+}
