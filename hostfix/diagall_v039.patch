+static const char *d2_kind(const nvn_rbind *b, const treg_t *r) {   // 绑定的形状（日志里的 kind=）
+    if (!r) return "unbound";
+    if (b->dtt == (uint8_t)MTLTextureTypeTextureBuffer) return "texbuf";
+    if (b->f1d) return "tex1d";
+    int tgt = r->has_v && r->v.set_target ? (int)r->v.target : (int)r->t.d.target;
+    switch (tgt) {
+    case NVN_TEXTURE_TARGET_1D: return "1d";
+    case NVN_TEXTURE_TARGET_3D: return "3d";
+    case NVN_TEXTURE_TARGET_1D_ARRAY: return "1darr";
+    case NVN_TEXTURE_TARGET_2D_ARRAY: return "2darr";
+    case NVN_TEXTURE_TARGET_2D_MULTISAMPLE: case NVN_TEXTURE_TARGET_2D_MULTISAMPLE_ARRAY: return "ms";
+    case NVN_TEXTURE_TARGET_RECTANGLE: return "rect";
+    case NVN_TEXTURE_TARGET_CUBEMAP: case NVN_TEXTURE_TARGET_CUBEMAP_ARRAY: return "cube";
+    case NVN_TEXTURE_TARGET_BUFFER: return "buf";
+    default: return "tex";
