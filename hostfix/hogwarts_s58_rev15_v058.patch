+// ---------- DM_NVN_DEPTHHIST=<frame>[:<buckets, default 32>] ----------
+// DM_NVN_TEXDUMP walks the COLOR attachments only (td_note, below), so a depth target never reaches a package
+// and a depth endpoint distribution cannot be read out of one at all (Hogwarts 11-24: 86 [texdump] lines, all
+// "55 color targets": format 260 and ser=5897 zero times). This probe closes that gap with no new shader, no
+// file and no fixed serial: it reads the depth plane of the ONE pass that draws the fog shell
+// (f9d9ae507d9c6935) and counts it into buckets on the CPU, one log line per capture.
+//   DM_NVN_DEPTHHIST=selftest -- buckets a synthetic {0, 0.25, 1, NaN} without touching the GPU, so the
+//   bucketing is proven inside the same run that uses it.
+// Bucket 0 is [0, 1/nb) and bucket nb-1 is [1-1/nb, 1); under this game's reverse-Z (near=0) convention a
+// stored value near 1 is close geometry and near 0 is far, so the two ENDS are what a caller reads.
+//
+// WHEN it reads is the whole probe. Any "first depth of the frame" rule reads the frame's clear: in the S54
+// F3600 case the first 2D depth is 283745 (ser=5897, the clear) and the next different one arrives 8 passes
+// later at 283753 (256x256), while the fog draw is 283793 -- such a reading is almost all clear value 0 and
+// would come back as "the scene wrote no depth", the opposite of the truth. The frame end is no better:
+// ser=5897 is used by 9 more passes after 283793. So the fog draw itself sets the capture (dh_fog_hit) and the
+// read happens when the NEXT pass opens, the only moment at which the depth is what that pass left.
+//
+// HOW it reads: encoded into the frame's own command buffer (blit() on g_cb) right after that pass ended, never
+// into a command buffer of its own -- this runs while the frame is still being recorded, so a separate commit
+// would run before the frame's passes and read the PREVIOUS frame's depth. The counting runs in a commit block
+// once the GPU is done (the same pattern as the double-render checks).
+#define DH_FOG_KEY "f9d9ae507d9c6935"
+static long g_dh_frame = -2, g_dh_end; static int g_dh_buckets = 32; static NSMutableArray *g_dh_list; static int g_dh_self;
+static int g_dh_pend;                 // the fog draw landed: read at the next pass boundary
+static uint64_t g_dh_pass;            // the pass that drew it (one capture per frame)
+static long g_dh_hit_frame = -1;      // one capture per frame (this draw can land more than once in a frame)
+static long g_dh_last_frame = -1;     // the last frame dh_note saw, for the "never landed" line
+static const char *dh_fmt_name(MTLPixelFormat pf) {
+    return pf == MTLPixelFormatDepth32Float_Stencil8 ? "Depth32Float_Stencil8" :
+           pf == MTLPixelFormatDepth32Float ? "Depth32Float" :
+           pf == MTLPixelFormatDepth16Unorm ? "Depth16Unorm" : "other";
+}
