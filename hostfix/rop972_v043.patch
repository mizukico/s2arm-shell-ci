+            var bad = new HashSet<string>(StringComparer.Ordinal);
+            var ord = cand.OrderBy(c => c.Start).ToList();
+            for (int i = 0; i < ord.Count; i++)
+                for (int j = i + 1; j < ord.Count && ord[j].Start < ord[i].Close; j++)
+                    if (ord[i].Start < ord[j].Close && ord[j].Start < ord[i].Close) { bad.Add(ord[i].Name); bad.Add(ord[j].Name); }
