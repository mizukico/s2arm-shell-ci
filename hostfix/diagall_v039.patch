+            MLOG("[ff] key=%s 的片元读 ser %llu，但这一遍自己就是写它的那一遍（颜色附件里就有它）：不换面", fs->key, (unsigned long long)g_ff_ser); }
+        return;
+    }
+    g_ff_flip_frame = frame;   // 这一帧的判定用掉了（没翻成也不再试，避免同一帧里一会儿翻一会儿不翻）
