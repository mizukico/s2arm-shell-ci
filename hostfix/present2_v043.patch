+static int p2_sampled(uint64_t f) { return f >= P2_SAMPLE_EVERY && f % P2_SAMPLE_EVERY == 0; }
+static void p2_release(void) {
+    if (g_p2.src_buf) { res_remove(g_p2.src_buf); g_p2.src_buf = nil; }
+    if (g_p2.dst_buf) { res_remove(g_p2.dst_buf); g_p2.dst_buf = nil; }
+    g_p2.used = 0; g_p2.src_ready = 0; g_p2.dst_ready = 0; g_p2.src_fence = 0; g_p2.dst_fence = 0;
+}
+// draw_pass_state 用：这一笔是不是 present2 认下的上屏那一笔、且 S2A_PRESENT_NODEPTH 打开（只读状态，不改绑定）。
+static int p2_depth_off(NvShader *fs) {
+    if (!p2_on() || !p2_nodepth() || !fs || strncmp(fs->key, P2_KEY, 8)) return 0;
+    if (g_p2_pass_serial != g_pass.serial || g_p2_pass_frame != atomic_load(&g_cur_frame)) return 0;
+    uint64_t f = g_p2_pass_frame;
+    if (S.ds.dt && g_p2_dlog_frame != f) {   // 原来是开着的才提示
+        g_p2_dlog_frame = f;
+        MLOG("[blit] depth test forced off (was cmp=%s)", p2_cmp_name((int)S.ds.df));
+    }
+    if (S.color.blend_en & 1) {
+        static uint64_t bframe = ~0ull;
+        if (bframe != f) { bframe = f; MLOG("[blit] blend on (not forced off; observe first)"); }
+    }
+    return 1;
+}
+static void *p2_ds_ptr(void) {
+    static id<MTLDepthStencilState> ds;
+    if (!ds) {
+        MTLDepthStencilDescriptor *d = [MTLDepthStencilDescriptor new];
+        d.depthCompareFunction = MTLCompareFunctionAlways;
+        d.depthWriteEnabled = NO;
+        ds = [g_dev newDepthStencilStateWithDescriptor:d];
+    }
+    return (__bridge void *)ds;
+}
+// 开遍之前（g_enc == nil）：认这一笔、打状态行、把源纹理 8×8 中心拷进 shared 缓冲（命令流里在这一遍之前）。
+static void p2_detect(__unsafe_unretained NvProg *pr) {
+    if (!p2_on() || g_enc || !pr || !pr->sh[1]) return;
+    NvShader *fs = pr->sh[1];
+    if (strncmp(fs->key, P2_KEY, 8)) return;
+    if (!R.has_rt || R.rt.n <= 0 || !R.rt.color[0]) return;
