+            if (!lz_line_ok(dim ? 2 : 0)) break;
+            if (dim) MLOG("[dim] f=%llu pass=%llu in reg=%d ser=%llu fmt=0x%x(%s) %s", (unsigned long long)s->frame, (unsigned long long)s->pass,
+                          s->in[i].reg, (unsigned long long)s->in[i].ser, s->in[i].nvn_fmt, lz_pf_name((MTLPixelFormat)s->in[i].mtl_fmt), d);
+            else MLOG("[lit] in reg=%d ser=%llu fmt=0x%x mtl=0x%x %s", s->in[i].reg, (unsigned long long)s->in[i].ser, s->in[i].nvn_fmt, s->in[i].mtl_fmt, d);
+            if (!dim) {   // 追加 4：光照遍的输入也进 passdump.tsv（role=IN）
+                NSUInteger ib = mtl_pf_bytes((MTLPixelFormat)s->in[i].mtl_fmt); if (!ib || ib > 16) ib = 4;
+                double im = 0; uint32_t ix = 0; lz_stats((MTLPixelFormat)s->in[i].mtl_fmt, p + LZ_IN_OFF + (size_t)i * LZ_IN_STRIDE, 1, 1, ib, &im, &ix);
+                id<MTLTexture> it = s->in[i].tex;
+                lz_pd_row(s->frame, s->pass, s->key, "IN", s->in[i].ser, it ? (uint32_t)it.width : 0, it ? (uint32_t)it.height : 0,
+                          s->in[i].nvn_fmt, lz_pf_name((MTLPixelFormat)s->in[i].mtl_fmt), im, ix);
+            }
+        }
+        if (p) for (int i = 0; i < s->natt; i++) {
+            if (s->att[i].noread) continue;   // 没拷（格式 >4B/像素 / 尺寸不够 / 没挂上）
+            double mean = 0; uint32_t mx = 0;
+            NSUInteger ab = mtl_pf_bytes((MTLPixelFormat)s->att[i].mtl_fmt); if (!ab || ab > LZ_OUT_MAX_BPP) ab = LZ_OUT_MAX_BPP;
+            lz_stats((MTLPixelFormat)s->att[i].mtl_fmt, p + LZ_OUT_OFF + (size_t)i * LZ_OUT_STRIDE, 8, 8, (NSUInteger)8 * ab, &mean, &mx);
+            if (!lz_line_ok(dim ? 2 : 0)) break;
+            if (dim) MLOG("[dim] f=%llu pass=%llu out ser=%llu fmt=0x%x(%s) mean=%.1f max=%u", (unsigned long long)s->frame, (unsigned long long)s->pass,
+                          (unsigned long long)s->att[i].ser, s->att[i].nvn_fmt, lz_pf_name((MTLPixelFormat)s->att[i].mtl_fmt), mean, mx);
+            else MLOG("[lit] out ser=%llu fmt=0x%x mean=%.1f max=%u store=%s", (unsigned long long)s->att[i].ser, s->att[i].nvn_fmt, mean, mx, s->att[i].dead ? "dontcare" : "store");
+        }
+        // 追加 A：这一遍片元缓冲槽的前 64 字节（本遍提交已跑完，CPU 能读共享存储）
+        if (!dim) for (int i = 0; i < s->nbuf; i++) {
+            char *head = lz_b_hex; uint32_t nz = 0, kb = 0;
+            lz_buf_head(s->buf[i].addr, s->buf[i].len, head, sizeof lz_b_hex, &nz, &kb);
+            if (!lz_line_ok(0)) break;
+            MLOG("[lit] buf reg=%d len=%llu head=%s nonzero=%u/%u", s->buf[i].reg, (unsigned long long)s->buf[i].len, head, nz, kb);
+        }
+        if (s->buf_obj) { res_remove(s->buf_obj); s->buf_obj = nil; }
+        for (int i = 0; i < LZ_MAX_IN; i++) s->in[i].tex = nil;
+        s->used = 0; s->ready = 0; s->nin = 0; s->natt = 0; s->nbuf = 0;
+    }
+    lz_chain_drain();   // 追加 1：链路时间线（每一遍一个数）
+    lz_cs_drain();      // 追加 B：compute 输出缓冲读完的行
+    lz_cs_tex_drain();  // 追加 3：compute 输出纹理的读数（blit + wait）
+    if (!g_lz_off && f >= LZ_FRAME_LO && f % 600 == 0 && f != g_lz_sum_last) { g_lz_sum_last = f; lz_summary(); }   // 追加 B / C：每 600 帧的整局 key 汇总
+}
+// draw 里（一遍的第一笔、开遍之前）：记本帧颜色附件，筛光照那遍并记下详细块的输入 / 附件
+static void lz_detect(__unsafe_unretained NvProg *pr) {
+    if (!lz_on()) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    lz_frame_begin(f);
+    for (int i = 0; i < R.rt.n && i < 8; i++) if (R.rt.color[i]) lz_ser_add(R.rt.color[i]->serial);
