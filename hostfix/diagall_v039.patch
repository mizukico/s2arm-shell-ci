+            mtl_finish_gpu();   // 上一帧的提交必须已经在 GPU 上做完，旧队列的拷贝才读得到这一帧的内容
+            id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+            for (int p = 0; p < np; p++) {
+                if (ubuf[p] && usrc[p]) enc_b_copy_buffer(b, usrc[p], uso[p], ubuf[p], 0, ulen[p]);
+                if (obuf[p] && otex[p]) {
+                    const d2_ent *e = &g_d2[idx[p]];
+                    [b copyFromTexture:otex[p] sourceSlice:(NSUInteger)(e->out_sl > 0 ? e->out_sl : 0)
+                          sourceLevel:(NSUInteger)(e->out_lv > 0 ? e->out_lv : 0)
+                          sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(ow[p], oh[p], 1)
+                              toBuffer:obuf[p] destinationOffset:0 destinationBytesPerRow:orow[p]
+                     destinationBytesPerImage:orow[p] * (size_t)oh[p]];
+                }
+                for (int k = 0; k < D2_STAT; k++) if (ibuf[p][k] && itex[p][k]) {
+                    NSUInteger ox = (itex[p][k].width - ipx[p][k]) / 2, oy = (itex[p][k].height - ipx[p][k]) / 2;   // 正中 4×4
+                    [b copyFromTexture:itex[p][k] sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(ox, oy, 0)
+                          sourceSize:MTLSizeMake(ipx[p][k], ipx[p][k], 1) toBuffer:ibuf[p][k] destinationOffset:0
+                     destinationBytesPerRow:irow[p][k] destinationBytesPerImage:irow[p][k] * (size_t)ipx[p][k]];
+                }
+            }
+            [b endEncoding];
+            ran = cb_run(cb);
+            if (!ran && !g_d2_submit_fail) { g_d2_submit_fail = 1;
+                MLOG("【红】[dark2] frame %llu: 帧末读回没提交（GPU 已安全停 / 提交被拒），这一帧的数值不可信", (unsigned long long)frame); }
+        }
+    }
+    // 4) 打行：主行（输入数 / UBO / 写掩码 / 混合 / discard / 输出）+ 每张输入一行 + 输出统计一行
+    for (int p = 0; p < np; p++) {
+        const d2_ent *e = &g_d2[idx[p]];
+        char vb[200]; size_t vo = 0; vb[0] = 0;
+        if (ran && ubuf[p] && ulen[p]) {
+            NSUInteger nf = ulen[p] / 4; if (nf > 8) nf = 8;
+            for (NSUInteger k = 0; k < nf; k++)
+                vo += snprintf(vb + vo, sizeof vb - vo, "%s%.6g", k ? "," : "", (double)((const float *)ubuf[p].contents)[k]);
+        } else snprintf(vb, sizeof vb, "none");
+        char wb[200]; size_t wo = 0; wb[0] = 0;
+        for (int i = 0; i < e->ncol; i++)
+            wo += snprintf(wb + wo, sizeof wb - wo, "%sc%d:0x%x", i ? "," : "", i, (unsigned)e->col[i].wmask);
+        if (!wb[0]) snprintf(wb, sizeof wb, "-");
+        char bb[200]; size_t bo = 0; bb[0] = 0;
+        for (int i = 0; i < e->ncol; i++)
+            bo += snprintf(bb + bo, sizeof bb - bo, "%sc%d:%u", i ? "," : "", i, (unsigned)e->col[i].blend);
+        if (!bb[0]) snprintf(bb, sizeof bb, "-");
+        char ob[40];
+        if (e->has_out) snprintf(ob, sizeof ob, "%llu:%#x", (unsigned long long)e->out_ser, (unsigned)e->out_pf);
+        else snprintf(ob, sizeof ob, "-");
+        MLOG("[dark2] frame %llu pass %llu key=%s in=%d ubo reg=%d len=%llu f0..f7=%s wmask=%s blend=%s discard=%d dsrc=%s out=%s",
+             (unsigned long long)frame, (unsigned long long)e->pass, e->key, e->ntex_total,
+             e->ubo_reg, (unsigned long long)e->ubo_len, vb, wb, bb,
+             e->disc == 1 ? 1 : 0, e->dsrc == 1 ? "json" : e->dsrc == 2 ? "metal" : "none", ob);
+        if (e->ncol > 1) {   // MRT：主行 out= 只统计第一个带序号的槽，这里把这一遍所有带序号的颜色槽列全（630 / 631 这种一对看这里）
+            char ab[240]; size_t ao = 0; ab[0] = 0; int any = 0;
+            for (int i = 0; i < e->ncol; i++) if (e->col[i].ser) {
+                ao += snprintf(ab + ao, sizeof ab - ao, "%sc%d:%llu:%#x", any ? "," : "", i,
+                               (unsigned long long)e->col[i].ser, (unsigned)e->col[i].cfmt);
+                any = 1;
+            }
+            if (any) MLOG("[dark2] frame %llu pass %llu out_all=%s", (unsigned long long)frame, (unsigned long long)e->pass, ab);
+        }
+        for (int k = 0; k < e->ntex; k++) {
+            char sb[96];
+            int j = jmap[p][k];
+            if (ran && j >= 0 && ibuf[p][j] && itex[p][j]) {
+                uint64_t nz = 0, mx = 0; double mean = 0.0;
+                lit_stats((const uint8_t *)ibuf[p][j].contents, (size_t)irow[p][j], (size_t)ipx[p][j], (size_t)ipx[p][j],
+                          ibpp[p][j], itex[p][j].pixelFormat, &nz, &mean, &mx);
+                snprintf(sb, sizeof sb, "nonzero=%llu mean=%.1f max=%llu", (unsigned long long)nz, mean, (unsigned long long)mx);
+            } else snprintf(sb, sizeof sb, "readback=none");
+            MLOG("[dark2] frame %llu pass %llu in tex reg=%u tid=%d ser=%llu fmt=%#x kind=%s %ux%u %s",
+                 (unsigned long long)frame, (unsigned long long)e->pass, e->tex[k].reg, e->tex[k].tid,
+                 (unsigned long long)e->tex[k].ser, (unsigned)e->tex[k].pf, e->tex[k].kind,
+                 (unsigned)e->tex[k].w, (unsigned)e->tex[k].h, sb);
+        }
+        if (!e->has_out) {
+            MLOG("[dark2] frame %llu pass %llu out=none（这一遍没有带序号的颜色附件）", (unsigned long long)frame, (unsigned long long)e->pass);
+        } else if (ran && obuf[p] && orow[p]) {
+            uint64_t nz = 0, mx = 0; double mean = 0.0;
+            lit_stats((const uint8_t *)obuf[p].contents, orow[p], ow[p], oh[p], obpp[p], otex[p].pixelFormat, &nz, &mean, &mx);
+            MLOG("[dark2] frame %llu pass %llu out ser=%llu nonzero=%llu mean=%.1f max=%llu",
+                 (unsigned long long)frame, (unsigned long long)e->pass, (unsigned long long)e->out_ser,
+                 (unsigned long long)nz, mean, (unsigned long long)mx);
+        } else {
+            MLOG("[dark2] frame %llu pass %llu out ser=%llu readback=none", (unsigned long long)frame,
+                 (unsigned long long)e->pass, (unsigned long long)e->out_ser);
+        }
+    }
+    dark2_retire(frame);
+}
