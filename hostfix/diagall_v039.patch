+    int any = g_da_ntg || g_da_nbind || g_da_pres.have;
+    if (!any) {
+        if (!g_da_none_logged) { g_da_none_logged = 1;
+            MLOG("[diagall] frame %llu none：这一帧没有 800x450/1600x900 浮点颜色目标、也没有相关 pass（先确认壳标记 %s 在）",
+                 (unsigned long long)frame, S2A_SHELL_TAG); }
