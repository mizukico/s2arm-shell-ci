+static int da_key_idx(const char *k) {   // 9 支相关 shader：按前 16 个字符比（key 带 _b / _ft / _se 等后缀）
+    if (!k || !*k) return -1;
+    for (int i = 0; i < DA_KEY_N; i++) if (!strncmp(k, g_da_key[i], 16)) return i;
