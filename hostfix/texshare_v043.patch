+static void ap_cube_job(NSDictionary *j) {
+    if (ap_cube_off || ap_files >= 48) return;
+    @try {
+        id<MTLBuffer> b = j[@"buf"]; if (!b) return;
+        const uint8_t *p = (const uint8_t *)b.contents; if (!p) return;
+        MTLPixelFormat pf = (MTLPixelFormat)[j[@"pf"] intValue];
+        size_t bpp = (size_t)[j[@"bpp"] unsignedLongValue];
+        size_t face = (size_t)[j[@"face"] unsignedLongValue];
+        long f = (long)[j[@"f"] longValue]; unsigned long long ser = [j[@"ser"] unsignedLongLongValue];
+        unsigned fmt = (unsigned)[j[@"fmt"] unsignedIntValue];
+        char *path = (char *)malloc(1200); if (!path) return;
+        for (int i = 0; i < 6; i++) {
+            const uint8_t *q = p + (size_t)i * face;
+            float mean = 0, mx = 0; int nz = 0;
+            p3_stats(pf, q, AP_CUBE_SIDE * AP_CUBE_SIDE, bpp, &mean, &mx, &nz);
+            snprintf(path, 1200, "%s/cube_f%ld_%llu_face%d.png", p3_dir().UTF8String, f, ser, i);
+            if (!ap_gray_png(path, q, pf, bpp, AP_CUBE_SIDE, AP_CUBE_SIDE)) { MLOG("[cube] f=%ld ser=%llu face=%d skip: cannot write %s", f, ser, i, path); continue; }
+            MLOG("[cube] f=%ld ser=%llu fmt=0x%x face=%d mean=%.6g max=%.6g -> %s", f, ser, fmt, i, mean, mx, path);
+            ap_files++;
+        }
+        free(path);
+    } @catch (NSException *e) { ap_cube_off = 1; MLOG("[cube] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+static void ap_vol_job(NSDictionary *j) {
+    if (ap_vol_off) return;
+    @try {
+        id<MTLBuffer> b = j[@"buf"]; if (!b) return;
+        const uint8_t *p = (const uint8_t *)b.contents; if (!p) return;
+        MTLPixelFormat pf = (MTLPixelFormat)[j[@"pf"] intValue];
+        size_t bpp = (size_t)[j[@"bpp"] unsignedLongValue];
+        size_t img = (size_t)[j[@"img"] unsignedLongValue];
+        long f = (long)[j[@"f"] longValue]; unsigned long long ser = [j[@"ser"] unsignedLongLongValue];
+        float sum = 0, mx = 0; int nz = 0;
+        for (int z = 0; z < 64; z++) { float m1 = 0, x1 = 0; int n1 = 0; p3_stats(pf, p + (size_t)z * img, 64, bpp, &m1, &x1, &n1); sum += m1; if (x1 > mx) mx = x1; nz += n1; }
