+        else {
+            void *mb; uint64_t mo; const uint8_t *p; int st = 2;   // 1 全 0 / 0 非 0 / 2 读不到（本提交里 GPU 要写）
+            if (!pend_hits(u->addr, len) && nvn_be_addr(u->addr, len, &mb, &mo) && (p = [(__bridge id<MTLBuffer>)mb contents])) {
+                size_t k = len < 256 ? (size_t)len : 256; st = 1;
+                for (size_t q = 0; q < k; q++) if (p[mo + q]) { st = 0; break; }
+            }
+            if (st == 1) { mark = "!zero"; zero++; } else if (st == 2) mark = "!pend";
+        }
+        o += snprintf(b + o, sizeof lz_b_bufs - o, "%s%d:%llu%s", nb ? "," : "", (int)r->reg, (unsigned long long)len, mark);
+        nb++;
+    }
+    if (!lz_line_ok(0)) return;
+    MLOG("[lit] buffers: n=%d [%s]%s", nb, b, len0 ? "  ← 有缓冲 len=0：光源列表可能为空" : zero ? "  ← 有缓冲内容全 0" : "");
+}
+// 追加 A（读回侧）：一个缓冲前 64 字节的十六进制与其中非零字节数
+static void lz_buf_head(uint64_t addr, uint64_t len, char *out, size_t n, uint32_t *nz, uint32_t *k) {
+    *nz = 0; *k = 0;
+    if (!addr || !len) { snprintf(out, n, "-"); return; }
+    void *mb; uint64_t mo; const uint8_t *p;
+    if (!nvn_be_addr(addr, len, &mb, &mo) || !(p = [(__bridge id<MTLBuffer>)mb contents])) { snprintf(out, n, "P"); return; }
+    size_t kb = len < 64 ? (size_t)len : 64, o = 0;
+    for (size_t i = 0; i < kb && o + 3 < n; i++) { if (p[mo + i]) (*nz)++; o += snprintf(out + o, n - o, "%02x", p[mo + i]); }
+    *k = (uint32_t)kb;
+}
+// 追加 B / C：整局里执行过的 compute key、从 fallback 翻译装载的 shader key（各去重，最多 40 个）；
+//   compute 派发的输出缓冲在 GPU 跑完后读前 64 字节（[cs] 行），每 600 帧打一次 [cs] / [fallback] summary。
+#define LZ_CS_MAX 40
+#define LZ_CS_REC 16
+typedef struct { uint64_t frame, fence, addr, len; int reg; uint32_t gx, gy, gz; char key[24]; } lz_csrec;
