+             (double)st.mn, (double)st.mx, st.mean, nb, bs, DH_LOG_N, lhits ? ls : "(none)", DH_FINE_N, fhits ? fs : "(none)");
+    }];
+    dbl_retire(keep);   // buf and the view live until this submission's GPU work is done (the block above runs first)
+}
