+// ---- small GPU readbacks, logged from the submission's completion callback ----
+static float p3_half(uint16_t h) {
+    int s = (h >> 15) & 1, e = (h >> 10) & 0x1f, m = h & 0x3ff;
+    if (!e) return (s ? -1.0f : 1.0f) * (float)m * (1.0f / 16777216.0f);
+    if (e == 31) return m ? NAN : (s ? -INFINITY : INFINITY);
+    return (s ? -1.0f : 1.0f) * (1.0f + (float)m / 1024.0f) * exp2f((float)e - 15.0f);
+}
+// R11G11B10F is a shared-exponent unsigned float, not unorm: 5-bit exponent (bias 15), R/G 6-bit
+// and B 5-bit mantissa.
+static float p3_ufloat(uint32_t m, uint32_t e, int mbits) {
+    float f = (float)m / (float)(1u << mbits);
+    if (!e) return f * exp2f(-14.0f);
+    if (e == 31) return m ? NAN : INFINITY;
+    return (1.0f + f) * exp2f((float)e - 15.0f);
+}
+static float p3_r11(uint32_t v) { return p3_ufloat(v & 0x3f, (v >> 6) & 0x1f, 6); }
+static float p3_g11(uint32_t v) { return p3_ufloat((v >> 11) & 0x3f, (v >> 17) & 0x1f, 6); }
+static float p3_b10(uint32_t v) { return p3_ufloat((v >> 22) & 0x1f, (v >> 27) & 0x1f, 5); }
+// Per-texel value of a colour / depth sample: the largest RGB component (single-channel formats
+// have only that channel).  mean / max / nz are over the small readback, not the whole texture.
+static float p3_texel(MTLPixelFormat pf, const uint8_t *q) {
+    switch ((int)pf) {
+        case MTLPixelFormatR8Unorm: return (float)q[0] / 255.0f;
+        case MTLPixelFormatR8Snorm: return (float)(int8_t)q[0] / 127.0f;
+        case MTLPixelFormatR16Unorm: case MTLPixelFormatDepth16Unorm: { uint16_t v; memcpy(&v, q, 2); return (float)v / 65535.0f; }
+        case MTLPixelFormatR16Snorm: { int16_t v; memcpy(&v, q, 2); return (float)v / 32767.0f; }
+        case MTLPixelFormatR16Float: { uint16_t v; memcpy(&v, q, 2); return p3_half(v); }
+        case MTLPixelFormatR32Float: case MTLPixelFormatDepth32Float: { float v; memcpy(&v, q, 4); return v; }
+        case MTLPixelFormatRG11B10Float: { uint32_t v; memcpy(&v, q, 4); float r = p3_r11(v), g = p3_g11(v), b = p3_b10(v); return fmaxf(r, fmaxf(g, b)); }
+        case MTLPixelFormatRGBA16Float: { uint16_t v[4]; memcpy(v, q, 8); return fmaxf(p3_half(v[0]), fmaxf(p3_half(v[1]), fmaxf(p3_half(v[2]), p3_half(v[3])))); }
+        case MTLPixelFormatRG16Float: { uint16_t v[2]; memcpy(v, q, 4); return fmaxf(p3_half(v[0]), p3_half(v[1])); }
+        case MTLPixelFormatRG32Float: { float v[2]; memcpy(v, q, 8); return fmaxf(v[0], v[1]); }
+        case MTLPixelFormatRGBA32Float: { float v[4]; memcpy(v, q, 16); return fmaxf(fmaxf(v[0], v[1]), fmaxf(v[2], v[3])); }
+        case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatBGRA8Unorm: return fmaxf((float)q[0], fmaxf((float)q[1], (float)q[2])) / 255.0f;
+        case MTLPixelFormatRGBA8Unorm_sRGB: case MTLPixelFormatBGRA8Unorm_sRGB: return fmaxf((float)q[0], fmaxf((float)q[1], (float)q[2])) / 255.0f;
+        case MTLPixelFormatRG8Unorm: return fmaxf((float)q[0], (float)q[1]) / 255.0f;
+        case MTLPixelFormatRG16Unorm: { uint16_t v[2]; memcpy(v, q, 4); return fmaxf((float)v[0], (float)v[1]) / 65535.0f; }
+        default: { float v; memcpy(&v, q, 4); return v; }
+    }
+}
+static void p3_stats(MTLPixelFormat pf, const uint8_t *p, int n, size_t stride, float *mean, float *mx, int *nz) {
+    double sum = 0; float m = 0; int z = 0;
+    for (int i = 0; i < n; i++) {
+        float v = p3_texel(pf, p + (size_t)i * stride);
+        sum += v; if (v > m) m = v; if (v != 0.0f) z++;
+    }
+    *mean = n ? (float)(sum / n) : 0.0f; *mx = m; *nz = z;
+}
+static int p3_job(NSDictionary *j) {
+    id<MTLBuffer> b = j[@"buf"]; if (!b) return 0;
+    const uint8_t *p = (const uint8_t *)b.contents; if (!p) return 0;
+    int kind = [j[@"kind"] intValue];
+    if (kind == 1 || kind == 2) {
+        MTLPixelFormat pf = (MTLPixelFormat)[j[@"pf"] intValue]; int n = [j[@"n"] intValue]; size_t stride = (size_t)[j[@"stride"] unsignedLongValue];
+        float mean = 0, mx = 0; int nz = 0; p3_stats(pf, p, n, stride, &mean, &mx, &nz);
+        if (kind == 1) MLOG("[hiz] f=%ld reg=%d ser=%llu fmt=0x%x %ux%u lv=%u mean=%.6g max=%.6g nz=%d/%d",
+                            (long)[j[@"f"] longValue], [j[@"reg"] intValue], (unsigned long long)[j[@"ser"] unsignedLongLongValue],
+                            (unsigned)[j[@"fmt"] unsignedIntValue], (unsigned)[j[@"w"] unsignedIntValue], (unsigned)[j[@"h"] unsignedIntValue],
+                            (unsigned)[j[@"lv"] unsignedIntValue], mean, mx, nz, n);
+        else MLOG("[litout] f=%ld pass=%llu key=%s ser=%llu mean=%.6g max=%.6g nz=%d/%d",
+                  (long)[j[@"f"] longValue], (unsigned long long)[j[@"pass"] unsignedLongLongValue], [j[@"key"] UTF8String],
+                  (unsigned long long)[j[@"ser"] unsignedLongLongValue], mean, mx, nz, n);
+        return 1;
+    }
+    // lightbuf: offset-0 u32, first 64 bytes, middle 64 bytes (separate <=64-byte blits)
+    uint64_t len = [j[@"len"] unsignedLongLongValue]; int hn = [j[@"headn"] intValue], mn = [j[@"midn"] intValue];
+    uint32_t count0 = 0; memcpy(&count0, p, 4);
+    char h1[160], h2[160]; int nz = 0;
+    for (int i = 0; i < hn; i++) { unsigned char c = p[4 + i]; snprintf(h1 + 2 * i, 3, "%02x", c); if (c) nz++; }
+    h1[2 * hn] = 0;
+    for (int i = 0; i < mn; i++) { unsigned char c = p[68 + i]; snprintf(h2 + 2 * i, 3, "%02x", c); if (c) nz++; }
+    h2[2 * mn] = 0;
+    MLOG("[lightbuf] f=%ld key=%s len=%llu count0=%u nz=%d/%d head=%s mid=%s", (long)[j[@"f"] longValue], [j[@"key"] UTF8String],
+         (unsigned long long)len, count0, nz, hn + mn, h1, h2);
+    return 1;
+}
+// Encode a tiny texture -> shared buffer copy (<= 8x8 texels, <= 256 bytes) and log it from the
+// submission's completion callback.  level 0, slice 0, centre of the level.
+// crashfix2: the deferred-encoding stand-in (nvn_rec.h DmRecEnc, on by default on iPhone) records the
+// plain copyFromTexture:...toBuffer: form (RO_C_COPY_TB) but has no stand-in for the ...options: form, and
+// forwardingTargetForSelector: answers a missing selector with MDIE -> abort().  That abort is what killed
+// the v1v2 shell at the first frame >= 1800 ([hiz] / [litout] readbacks): the probe called the options form.
+// So: use the plain form (identical for every format but depth-stencil), and skip a depth-stencil readback
+// with one line instead of calling a selector the recording encoder cannot replay.
+static void p3_read_tex_job(NSDictionary *meta, id<MTLTexture> t, int si, NSUInteger x, NSUInteger y, NSUInteger cw, NSUInteger ch, size_t bpp) {
+    (void)si;
+    if (!t || !cw || !ch || !bpp || !g_commit_blocks) return;
+    if (t.pixelFormat == MTLPixelFormatDepth32Float_Stencil8) {   // the one format whose copy needs MTLBlitOptionDepthFromDepthStencil
+        static int once; if (!once++) MLOG("[hiz] skip: depth-stencil readback needs the options copy the deferred encoder cannot replay"); return; }
+    NSUInteger row = cw * bpp, total = row * ch;
+    if (!row || !total) return;
+    id<MTLBuffer> b = [g_dev newBufferWithLength:total options:MTLResourceStorageModeShared];
+    if (!b) { static int once; if (!once++) MLOG("[hiz] skip: newBufferWithLength(%lu) returned nil", (unsigned long)total); return; }
+    id<MTL4ComputeCommandEncoder> e = blit();
+    if (!e) { static int once; if (!once++) MLOG("[hiz] skip: blitCommandEncoder returned nil"); return; }
+    [e copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(x, y, 0) sourceSize:MTLSizeMake(cw, ch, 1)
+              toBuffer:b destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:total];
+    res_add(b);
+    NSMutableDictionary *j = [meta mutableCopy];
+    j[@"buf"] = b; j[@"n"] = @((int)(cw * ch)); j[@"stride"] = @(bpp);
+    [g_commit_blocks addObject:^{ p3_job(j); }];
+}
+static void p3_read_tex(id<MTLTexture> t, NSDictionary *meta) {
+    size_t bpp = t ? mtl_pf_bytes(t.pixelFormat) : 0; if (!bpp) return;
+    NSUInteger lw = t.width, lh = t.height;
+    NSUInteger cw = lw < 8 ? lw : 8, ch = lh < 8 ? lh : 8;
+    while (cw * ch * bpp > 256 && ch > 1) ch--;   // <= 8x8x4B
+    if (!cw || !ch) return;
+    NSUInteger x = lw > cw ? (lw - cw) / 2 : 0, y = lh > ch ? (lh - ch) / 2 : 0;
+    p3_read_tex_job(meta, t, 0, x, y, cw, ch, bpp);
+}
+// ---- the binding helpers (same resolution encode_args uses) ----
+static int p3_tex_tid(int st, const nvn_rbind *b) {
+    if (b->kind == NVN_RB_TEX || b->kind == NVN_RB_TBUF) return (int)(tex_slot_h(S.tex[st], S.img[st], b->reg) & 0xfffff);
+    if (b->kind == NVN_RB_TEXU || b->kind == NVN_RB_TBUFU) return ubo_tex_id(ubo_packed(st, b));
+    return -1;
+}
+static id<MTLTexture> p3_tex_at(int st, const nvn_rbind *b, uint64_t *ser, uint32_t *fmt, uint32_t *w, uint32_t *h) {
+    int tid = p3_tex_tid(st, b);
+    if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) return nil;
+    const tex_t *ct = &g_treg[tid].t; id<MTLTexture> t = tex_mtl(ct);
+    if (ser) *ser = ct->serial; if (fmt) *fmt = ct->d.format; if (w) *w = ct->d.width; if (h) *h = ct->d.height;
+    return t;
+}
+
+// ------------------------------------------------------------------------------------------------
+// [gdraw] / [gbtex] / litout's "sampled the G-buffer" flag
+// ------------------------------------------------------------------------------------------------
+static int g_p3_gdraw_n, g_p3_gd_frame; static long g_p3_draw_frame; static int g_p3_draw_idx;
+static void p3_note_draw(const char *fskey) {
+    if (!p3_on() || !fskey) return;
+    if (!g_enc) { snprintf(g_p3_pend_key_buf, sizeof g_p3_pend_key_buf, "%s", fskey); g_p3_pend_key = g_p3_pend_key_buf; }
+}
+static void p3_scan_gb(NvShader *fs) {
+    if (!g_p3_lit_sampled && g_p3_gbser_n) {
+        pthread_mutex_lock(&g_rmu);
+        for (int i = 0; i < fs->rf.nb; i++) {
+            const nvn_rbind *b = &fs->rf.b[i];
+            if (b->kind != NVN_RB_TEX && b->kind != NVN_RB_TEXU && b->kind != NVN_RB_TBUF) continue;
+            uint64_t ser = 0; id<MTLTexture> t = p3_tex_at(1, b, &ser, NULL, NULL, NULL);
+            if (t && p3_is_gb_ser(ser)) { g_p3_lit_sampled = 1; break; }
+        }
+        pthread_mutex_unlock(&g_rmu);
+    }
+}
+static void p3_after_bind(NvProg *pr, const p_draw *dw, const p_draw_idx *di) {
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f != g_p3_draw_frame) { g_p3_draw_frame = f; g_p3_draw_idx = 0; g_p3_gd_frame = 0; }
+    g_p3_draw_idx++;
+    NvShader *fs = pr ? pr->sh[1] : NULL;
+    if (!p3_on() || !fs || f < 1800) return;
+    if (g_p3_watch_gb) p3_scan_gb(fs);
+    if (!p3_is_gb_writer(fs->key) || g_p3_gdraw_n >= P3_GDRAW_TOTAL || g_p3_gd_frame >= P3_GDRAW_PER_FRAME) return;
+    if (!g_p3_gb_seen) g_p3_gb_seen = [NSMutableIndexSet indexSet];
+    if (!g_p3_gb_pending) g_p3_gb_pending = [NSMutableArray array];
+    static char slots[2048]; size_t o = 0; int nsl = 0, gb = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb && o < sizeof slots - 96; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind != NVN_RB_TEX && b->kind != NVN_RB_TEXU && b->kind != NVN_RB_TBUF) continue;
+        int tid = p3_tex_tid(1, b);
+        int ok = tid > 0 && tid < g_ntreg && g_treg[tid].ok;
+        const tex_t *ct = ok ? &g_treg[tid].t : NULL;
+        id<MTLTexture> t = ct ? tex_mtl(ct) : nil;
+        const char *rn = (ct && t && ct->serial) ? "real" : "dummy";
+        uint64_t ser = ct ? (uint64_t)ct->serial : 0;
+        uint32_t fmt = ct ? ct->d.format : 0, w = ct ? ct->d.width : 0, h = ct ? ct->d.height : 0;
+        if (nsl < 32) { o += (size_t)snprintf(slots + o, sizeof slots - o, "%s%d:%d:%s:%llu:0x%x:%ux%u", nsl ? "," : "", b->reg, tid, rn,
+                                             (unsigned long long)ser, fmt, w, h); nsl++; }
+        // first 8 BC / uncompressed colour textures, not a depth / G-buffer target, one dump each
+        if (ct && t && ser && gb < 8 && g_p3_dumped_gb + g_p3_gb_pending.count < P3_GBTEX_MAX && !mtl_fmt_depth(t.pixelFormat) &&
+            (t.textureType == MTLTextureType2D || t.textureType == MTLTextureType2DArray) &&
+            !p3_is_gb_ser(ser) && !p3_is_rt_ser(ser) && ![g_p3_gb_seen containsIndex:(NSUInteger)ser]) {
+            [g_p3_gb_seen addIndex:(NSUInteger)ser];
+            [g_p3_gb_pending addObject:@[t, @(ser), @(b->reg), @(f), @(g_p3_draw_idx)]];
+            gb++;
+        }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    if (o < sizeof slots) slots[o] = 0;
+    const p_bind_buf *u = &S.ubo[1][0]; float c0[4] = {0, 0, 0, 0};
+    if (u->addr && u->size >= 16) { const uint8_t *p = addr_cpu(u->addr, 16); if (p) memcpy(c0, p, 16); }
+    long inst = dw ? (long)dw->instances : di ? (long)di->instances : 0;
+    const char *vk = pr && pr->sh[0] && pr->sh[0]->src[0] ? pr->sh[0]->src : pr && pr->sh[0] ? pr->sh[0]->key : "-";
+    const char *pk = fs->src[0] ? fs->src : fs->key;
+    MLOG("[gdraw] f=%ld pass=%llu vkey=%s pkey=%s draw=%d inst=%ld slots=[%s] cb0=%g,%g,%g,%g", f, (unsigned long long)g_stat_pass, vk, pk,
+         g_p3_draw_idx, inst, slots, c0[0], c0[1], c0[2], c0[3]);
+    g_p3_gdraw_n++; g_p3_gd_frame++;
+}
+// ------------------------------------------------------------------------------------------------
+// [lightbuf] / [hiz]
+// ------------------------------------------------------------------------------------------------
+static int g_p3_light_n, g_p3_hiz_n, g_p3_lit_n;
+static id<MTLBuffer> p3_shared(NSUInteger n) { id<MTLBuffer> b = [g_dev newBufferWithLength:n options:MTLResourceStorageModeShared]; if (b) res_add(b); return b; }
+static void p3_light_after(NvShader *cs) {
+    if (!p3_on() || !cs || !p3_is_light(cs->key)) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f < 1800 || !g_commit_blocks) return;
+    // ---- [lightbuf] the light list output: the dispatch's read/write storage buffer ----
+    if (g_p3_light_n < P3_LOG_MAX) {
+        const p_bind_buf *u = NULL;
+        for (int i = 0; i < cs->rf.nb; i++) {
+            const nvn_rbind *b = &cs->rf.b[i];
+            if (b->kind != NVN_RB_SBUFP || !b->rw || b->reg >= 16) continue;
+            const p_bind_buf *c = &S.ssbo[5][b->reg];
+            if (c->addr && c->size >= 4) { u = c; break; }
+        }
+        if (u) {
+            void *mb = NULL; uint64_t mo = 0;
+            if (nvn_be_addr(u->addr, u->size, &mb, &mo)) {
+                uint64_t len = u->size;
+                int hn = len < 64 ? (int)len : 64;
+                uint64_t mid = len > 64 ? (len / 2 > 32 ? len / 2 - 32 : 0) : 0;
+                int mn = len > 64 ? (int)((len - mid) < 64 ? (len - mid) : 64) : 0;
+                id<MTLBuffer> rb = p3_shared(4 + 64 + 64);
+                if (rb) {
+                    id<MTL4ComputeCommandEncoder> e = blit();
+                    enc_b_copy_buffer(e, (__bridge id<MTLBuffer>)mb, (NSUInteger)mo, rb, 0, 4);
+                    if (hn > 0) enc_b_copy_buffer(e, (__bridge id<MTLBuffer>)mb, (NSUInteger)mo, rb, 4, (NSUInteger)hn);
+                    if (mn > 0) enc_b_copy_buffer(e, (__bridge id<MTLBuffer>)mb, (NSUInteger)(mo + mid), rb, 68, (NSUInteger)mn);
+                    NSDictionary *j = @{@"kind": @0, @"buf": rb, @"f": @(f), @"key": @(cs->key), @"len": @(len), @"headn": @(hn), @"midn": @(mn)};
+                    [g_commit_blocks addObject:^{ p3_job(j); }];
+                    g_p3_light_n++;
+                }
+            }
+        }
+    }
+    // ---- [hiz] the 800x450 R8 / depth input (mip chain) ----
+    if (g_p3_hiz_n < P3_LOG_MAX) {
+        const nvn_rbind *best = NULL; uint64_t best_ser = 0; int best_reg = 0; uint32_t best_fmt = 0, best_w = 0, best_h = 0; id<MTLTexture> best_t = nil; unsigned best_lv = 0;
+        pthread_mutex_lock(&g_rmu);
+        for (int i = 0; i < cs->rf.nb; i++) {
+            const nvn_rbind *b = &cs->rf.b[i];
+            if (b->kind != NVN_RB_TEX && b->kind != NVN_RB_TEXU && b->kind != NVN_RB_TBUF) continue;
+            uint64_t ser = 0; uint32_t fmt = 0, w = 0, h = 0; id<MTLTexture> t = p3_tex_at(5, b, &ser, &fmt, &w, &h);
+            if (!t || w != 800 || h != 450) continue;
+            int r8 = fmt == NVN_FORMAT_R8, depth = (fmt >= 0x32 && fmt <= 0x36) || mtl_fmt_depth(t.pixelFormat);
+            if (!r8 && !depth) continue;
+            if (!best_t || (t.mipmapLevelCount > 1 && best_t.mipmapLevelCount <= 1)) { best = b; best_ser = ser; best_reg = b->reg; best_fmt = fmt; best_w = w; best_h = h; best_t = t; best_lv = (unsigned)t.mipmapLevelCount; }
+        }
+        pthread_mutex_unlock(&g_rmu);
+        if (best_t) {
+            NSMutableDictionary *j = [@{@"kind": @1, @"f": @(f), @"reg": @(best_reg), @"ser": @(best_ser), @"fmt": @(best_fmt), @"w": @(best_w), @"h": @(best_h),
+                                        @"lv": @(best_lv), @"pf": @((int)best_t.pixelFormat)} mutableCopy];
+            p3_read_tex(best_t, j);
+            g_p3_hiz_n++;
+            (void)best;
+        }
+    }
+}
+// ------------------------------------------------------------------------------------------------
+// pass begin / end: swapchain pre/mid/post, G-buffer target serials, litout
+// ------------------------------------------------------------------------------------------------
+static void p3_pass_begin(MTL4RenderPassDescriptor *pd, NSUInteger nc, const uint64_t *sers) {
+    long f = (long)atomic_load(&g_cur_frame);
+    p3_tick(f);
+    if (!p3_on()) { g_p3_pend_key = NULL; g_p3_prev_kind = 0; g_p3_prev_att = nil; return; }
+    p3_flush_gbtex();
+    p3_flush_prev(f);
+    const char *k = g_p3_pend_key; g_p3_pend_key = NULL;
+    if (p3_is_gb_writer(k)) for (NSUInteger i = 0; i < nc && i < 8; i++) if (R.rt.color[i]) p3_gbser_add((uint64_t)R.rt.color[i]->serial);
+    p3_lit_begin(pd, nc, sers, f, k);
+    int kind = p3_is_composite(k) ? 1 : p3_is_ui(k) ? 2 : 0;
+    if (!kind || !p3_frame_ok(f)) return;   // only the 1800 + n*600 frames (never the loading frame)
+    uint64_t ser = 0; id<MTLTexture> t = p3_swap_att(pd, nc, sers, &ser);
+    if (!t) {
+        static int once;
+        if (!once) MLOG("[dump] %s pass: no 1920x1080 colour attachment (%lu attached), skipped", kind == 1 ? "composite" : "ui", (unsigned long)nc);
+        return;
+    }
+    if (kind == 1 && p3_frame_ok(f) && g_p3_dumped[0] < P3_DUMP_MAX && p3_dump_last[0] != f) {
+        char name[96]; snprintf(name, sizeof name, "rop972_pre_%llu.png", (unsigned long long)ser);
+        MLOG("[dump] f=%ld stage=pre ser=%llu fmt=0x%lx %lux%lu -> %s/%s", f, (unsigned long long)ser,
+             (unsigned long)t.pixelFormat, (unsigned long)t.width, (unsigned long)t.height, p3_dir().UTF8String, name);
+        p3_dump_file(name, t, ser);
+        g_p3_dumped[0]++; p3_dump_last[0] = f;
+    }
+    g_p3_prev_kind = kind; g_p3_prev_frame = f; g_p3_prev_att = t; g_p3_prev_ser = ser;
+}
+static void p3_pass_end(void) {
+    cpuw_flush();   // S2Arm 2026-11-19 p1probe: [cpuwritten] 的 1-texel 读回（这一遍已结束，编码器已关）
+    sharechk_flush();   // S2Arm 2026-11-19 texshare: [sharechk] 的读方 / 写方各 1 texel（同一处）
+    if (!g_p3_watch_gb) return;
+    g_p3_watch_gb = 0;
+    if (!g_p3_lit_cand || !g_p3_lit_tex) { g_p3_lit_cand = 0; g_p3_lit_tex = nil; return; }
+    int sampled = g_p3_lit_sampled || g_p3_gbser_n == 0;   // until a writer pass has been seen, size+format is all we have
+    g_p3_lit_cand = 0;
+    if (!sampled || g_p3_lit_n >= P3_LOG_MAX) { g_p3_lit_tex = nil; return; }
+    MTLPixelFormat pf = g_p3_lit_tex.pixelFormat;
+    if (mtl_pf_bytes(pf)) {
+        NSDictionary *j = @{@"kind": @2, @"f": @(g_p3_lit_frame), @"pass": @(g_p3_lit_pass), @"key": @(g_p3_lit_key), @"ser": @(g_p3_lit_ser), @"pf": @((int)pf)};
+        p3_read_tex(g_p3_lit_tex, j);
+        g_p3_lit_n++;
+    }
+    g_p3_lit_tex = nil;
+}
+// 2026-11-19 p1probe（黑 1）：未注册 / 未解析绑定按 (key, stage, reg) 每条**首次出现**打全字段，总 ≤32 行。
+//   tid / registered / oob / n_ids 四个数就能分清「尚未 Initialize（registered=0 & oob=0 & tid 在池内）」、
+//   「越界（oob=1, tid>=n_ids）」、「登记漏（registered=0 & tid 在池内）」；real_resolve = 该 ID 在落到 dummy
+//   之前 tex_by_id / tex_fast_rid 是否真的解析出 Metal 纹理（1 = 解析到了，但被绑定判定拒绝）。
+//   另补一条红行（对齐 nxnative 的 RED_ONCE(10)，只报第一次）：
+//     【红】texture ID <tid> not registered (stage <n>, slot <r>, shader <key>)
+//   全部调用点都在 encode_args 的绑定循环里，持有 g_rmu。
+static int p3_dummy_lines;   // 已打过的 (key,stage,reg) 行数（≤32）
+static struct { char key[17]; int stage, slot; } g_p3_dummy_done[32];
+static int g_p3_dummy_red;
+static void p3_dummy_note(const char *key, int stage, int slot, int tid, int kind, int real_resolve) {
+    if (!p3_on() || !key || !*key) return;
+    int registered = tid >= 0 && tid < g_ntreg && g_treg[tid].ok;
+    int oob = tid >= g_ntreg;
+    if (oob) g_p3_dummy_oob++; else if (!registered) g_p3_dummy_reg0++;
+    if (tid >= 0 && !registered && !g_p3_dummy_red) {   // tid<0 = 空句柄（不是登记漏），不报红（同 #788 的口径）
+        g_p3_dummy_red = 1;
+        MLOG("【红】texture ID %d not registered (stage %d, slot %d, shader %s)", tid, stage, slot, key);
+    }
+    char pair[24]; snprintf(pair, sizeof pair, "%s:%d", key, slot);   // 每 600 帧的汇总仍按 (key,slot)
+    for (int i = 0; i < g_p3_ndummy; i++) if (!strcmp(g_p3_dummy_keys[i], pair)) return;
+    if (g_p3_ndummy < 512) { snprintf(g_p3_dummy_keys[g_p3_ndummy], sizeof g_p3_dummy_keys[0], "%s", pair); g_p3_ndummy++; }
+    if (p3_dummy_lines >= 32) return;
+    for (int i = 0; i < p3_dummy_lines; i++)
+        if (g_p3_dummy_done[i].stage == stage && g_p3_dummy_done[i].slot == slot && !strcmp(g_p3_dummy_done[i].key, key)) return;
+    snprintf(g_p3_dummy_done[p3_dummy_lines].key, sizeof g_p3_dummy_done[0].key, "%s", key);
+    g_p3_dummy_done[p3_dummy_lines].stage = stage; g_p3_dummy_done[p3_dummy_lines].slot = slot;
+    p3_dummy_lines++;
+    MLOG("[dummy] key=%s st=%d reg=%d tid=%d registered=%d oob=%d n_ids=%d kind=%s real_resolve=%d",
+         key, stage, slot, tid, registered, oob, g_ntreg, kind ? "img" : "tex", real_resolve ? 1 : 0);
+}
