+static const char *da_pres_kp(void) {   // 认上屏遍的片元 key 前缀（历史是 ec8ccd7a1791a3a6_b）
+    static char k[28]; static int done;
+    if (!done) { const char *e = getenv("S2A_DIAG_PRES_KEY"); snprintf(k, sizeof k, "%s", e && *e ? e : "ec8ccd7a1791a3a6"); done = 1; }
+    return k;
