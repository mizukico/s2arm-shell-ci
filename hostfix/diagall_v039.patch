+        g_d2_att[k].lv = (int)pd.colorAttachments[i].level;
+        g_d2_att[k].sl = mt.textureType == MTLTextureType2DArray ? (int)pd.colorAttachments[i].slice : 0;
+        g_d2_att[k].mt = mt;
