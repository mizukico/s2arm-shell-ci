+        if (g_litin_shadow_tid > 0 && g_litin_shadow_tid < g_ntreg && g_treg[g_litin_shadow_tid].ok
+            && g_treg[g_litin_shadow_tid].t.serial == g_litin_shadow_ser) {
+            id<MTLTexture> mt = tex_mtl(&g_treg[g_litin_shadow_tid].t);
+            if (mt && (mt.textureType == MTLTextureType2DArray || mt.textureType == MTLTextureTypeCubeArray)) shd = mt;
+        }
+        pthread_mutex_unlock(&g_rmu);
