+        for (int i = 0; i < DA_RQ; i++) { rq[i].t = nil; rb[i] = nil; rq[i].kind = -1; rq[i].idx = -1; rq[i].sub = -1; }
+        if (do_snap) for (int k = 0; k < g_da_ntg && nrq < DA_RQ; k++) {   // ② 快照：整张（单张 >16 MB 或超预算就读正中一半）
+            id<MTLTexture> t = g_da_tgt_mt[k];
+            if (!t) continue;
