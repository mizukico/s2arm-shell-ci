+    int ran = cb_run(cb);
+    if (!ran && !g_litin_halt_logged) { g_litin_halt_logged = 1;
+        MLOG("【红】[litin] frame %llu: 帧末读回没提交（GPU 已安全停 / 提交被拒），这一帧的输入统计不算", (unsigned long long)f); }
+    if (ran) g_litin_bytes += need;
+    if (ran && ubuf) {   // 常量缓冲前 8 个 float（长度不够就少打几个）
+        NSUInteger nf = slen / 4; if (nf > 8) nf = 8;
+        const float *v = (const float *)ubuf.contents;
+        char lab[16], val[200]; size_t o = 0; val[0] = 0;
+        if (nf == 1) snprintf(lab, sizeof lab, "f0="); else snprintf(lab, sizeof lab, "f0..f%u=", (unsigned)(nf - 1));
