+// The fog shell's draw: remember THAT pass's depth as the capture. Called from draw() once the pass is open and
+// this draw really draws, so R.rt is that pass's targets and this is the depth the fog is tested against.
+static void dh_fog_hit(NvProg *pr) {
+    if (g_dh_frame < 0 || g_dh_frame == -3) return;
+    if (!pr || !pr->sh[1] || !R.rt.depth) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f < g_dh_frame || f > g_dh_end || g_dh_hit_frame == f) return;   // one capture per frame
+    if (strncmp(pr->sh[1]->key, DH_FOG_KEY, sizeof DH_FOG_KEY - 1)) return;
+    id<MTLTexture> t = tex_mtl(R.rt.depth);
+    if (!t) return;
+    uint64_t ser = R.rt.depth->serial;
+    if (t.textureType != MTLTextureType2D) { MLOG("[depthhist] frame=%ld pass=%llu ser=%llu depth is type %lu, not 2D; nothing read", f, (unsigned long long)g_stat_pass, (unsigned long long)ser, (unsigned long)t.textureType); return; }
+    [g_dh_list removeAllObjects];
+    [g_dh_list addObject:@[t, @(ser)]];   // the array holds the texture for us (a raw static would not)
+    g_dh_pass = g_stat_pass; g_dh_hit_frame = f; g_dh_pend = 1;
+    MLOG("depthhist: frame=%ld pass=%llu ser=%llu type=%s %lux%lu clear=%.9g (the fog draw %s landed; its depth is read when this pass ends)",
+         f, (unsigned long long)g_stat_pass, (unsigned long long)ser, dh_fmt_name(t.pixelFormat), (unsigned long)t.width, (unsigned long)t.height, (double)R.cd, pr->sh[1]->key);
+}
