+    if (g_lit_src_idx >= 0 && g_lit_src_idx < g_lit_nser) g_lit_ser[g_lit_src_idx] = ser;   // 场景色换了序号：换掉旧的那项
+    else if (g_lit_nser < LIT_SER_MAX) { g_lit_src_idx = g_lit_nser; g_lit_ser[g_lit_nser++] = ser; }
