+    if (S.has_vp) { vx = S.vp[0][0]; vy = S.vp[0][1]; vw = S.vp[0][2]; vh = S.vp[0][3]; }
+    long sx = 0, sy = 0, sw = (long)tw, sh = (long)th;
+    if (R.has_sc) { sx = R.sc.x; sy = R.sc.y; sw = R.sc.w; sh = R.sc.h; }
+    if (sx < 0) sx = 0; if (sy < 0) sy = 0;
+    if (sw < 0) sw = 0; if (sh < 0) sh = 0;
+    if ((long)tw < sx + sw) sw = (long)tw - sx;
+    if ((long)th < sy + sh) sh = (long)th - sy;
+    char sig[96];
+    snprintf(sig, sizeof sig, "%s/%d%d%d%d%d/%lux%lu/%.0f,%.0f,%.0f,%.0f/%ld,%ld,%ld,%ld",
+             fs->key, bl, src_one, dst_one, (int)S.ds.dt, (int)S.ds.dw, (unsigned long)tw, (unsigned long)th,
+             vx, vy, vw, vh, sx, sy, sw, sh);
+    static char last_sig[96]; static int nlog;
+    if (nlog < 8 || f % P2_SAMPLE_EVERY == 0 || strcmp(sig, last_sig)) {
+        if (nlog < 8) nlog++;
+        snprintf(last_sig, sizeof last_sig, "%s", sig);
+        MLOG("[blit] f=%llu pass=%llu key=%s blend=%d srcRGB=%d dstRGB=%d dt=%d dw=%d cmp=%s vp=%.0f,%.0f,%.0f,%.0f sc=%ld,%ld,%ld,%ld wm=0x%x tgt=%lux%lu fmt=0x%x(%s)",
+             (unsigned long long)f, (unsigned long long)(g_stat_pass + 1), fs->key, bl, src_one, dst_one,
+             (int)S.ds.dt, (int)S.ds.dw, p2_cmp_name((int)S.ds.df), vx, vy, vw, vh, sx, sy, sw, sh, wm,
+             (unsigned long)tw, (unsigned long)th, t0->d.format, lz_pf_name(dpf));
+        MLOG("[blit] bf srcRGB=%d(%s) dstRGB=%d(%s) srcA=%d(%s) dstA=%d(%s) eqRGB=%d eqA=%d",
