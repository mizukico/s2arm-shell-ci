+static const char *p2_bf_name(int f) {
+    switch (f) {
+        case 1: return "ZERO"; case 2: return "ONE"; case 3: return "SRC_COLOR"; case 4: return "ONE_MINUS_SRC_COLOR";
+        case 5: return "SRC_ALPHA"; case 6: return "ONE_MINUS_SRC_ALPHA"; case 7: return "DST_ALPHA"; case 8: return "ONE_MINUS_DST_ALPHA";
+        case 9: return "DST_COLOR"; case 10: return "ONE_MINUS_DST_COLOR"; case 11: return "SRC_ALPHA_SATURATE";
+        case 0x10: return "SRC1_COLOR"; case 0x11: return "ONE_MINUS_SRC1_COLOR"; case 0x12: return "SRC1_ALPHA"; case 0x13: return "ONE_MINUS_SRC1_ALPHA";
+        case 0x61: return "CONSTANT_COLOR"; case 0x62: return "ONE_MINUS_CONSTANT_COLOR"; case 0x63: return "CONSTANT_ALPHA";
