+}
+// encode_args 的纹理槽里调用（持 g_rmu）：这一遍要翻的话，把 S 的绑定换成另一面的 Metal 纹理 / GPU 资源号。
+//   只换这一次绑定用的纹理对象，不改 S、不改序号表、不建纹理、不拷贝。形状 / 格式对不上就不换（applied 不增，遍末会报）。
+static id<MTLTexture> ff_slot_sub(int nvn_stage, int tid, id<MTLTexture> t, uint64_t *rid) {
+    if (nvn_stage != 1 || !g_ff_sub_n || !t || !rid) return t;
+    if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) return t;
+    for (int i = 0; i < g_ff_sub_n; i++) {
+        if (g_treg[tid].t.serial != g_ff_sub[i].from_ser) continue;
+        int to = g_ff_sub[i].to_tid;
+        if (to <= 0 || to >= g_ntreg || !g_treg[to].ok) return t;
+        void *tv = NULL; uint64_t r2 = tex_fast_rid(to, &tv);
+        id<MTLTexture> t2 = (__bridge id<MTLTexture>)tv;
+        if (!t2 || !r2) return t;
+        if (t2.textureType != t.textureType || t2.pixelFormat != t.pixelFormat || t2.width != t.width || t2.height != t.height) return t;
+        *rid = r2; g_ff_sub[i].applied++;
+        return t2;
+    }
+    return t;
+}
+
+// ---------- S2Arm #427 壳内置诊断 [ser285]：定点盯一个 serial（默认 285）的写者 / 输出 / 读者 ----------
+// 上一轮 [dark2] 的结论：69ebe1cc5d7e3c9a_b → ser=276 有 96% 帧非零、ba5f5df42d8f1686_b → 270/271 有 98–99% 非零，
+//   场景链是活的；唯一每帧恒 0 的是 ser=285（197 帧全 0）。之前测的「277 恒 0」是某些无画面段落，结论作废。
+//   这一版不再按 key 前缀，直接按序号盯这一张：
+//   * 写者：开遍时这一遍的颜色附件里就有目标的（含只落 clear、一笔都不画的遍），开遍即建条目（slot / fmt / 尺寸 / load），
+//     这一遍第一笔画时补 key / 输入清单 / UBO / 管线状态（写掩码 / 混合 / discard）；
+//   * 输出：帧末整张读回（≤ 64 MB，和 [bytgt] / [dark2] 同口径）算 nonzero / mean / max；同一张纹理一帧只读一次，
+//     其余写者条目打 readback=dup 指到那一条；
+//   * 读者：任何一遍（片元或顶点阶段）的纹理绑定里出现目标 serial 就打一行（含「它同时是本遍颜色附件」的槽号）。
+//   pass 内只读状态、零拷贝、不进命令缓冲、不建纹理；唯一的 GPU 拷贝在帧末、旧队列一次提交（同 [bytgt] / [dark2]）。
+//   开关：S2A_S285_SER=<n> 换目标序号（默认 285）；S2A_S285_DEBUG=0 只关本条；S2A_LIT_DEBUG=0 整条关。
+//   每帧上限：写者 4 行、输出统计 4 行、读者 4 行；超出的只计数（每 300 帧一行汇总，不刷屏）。
+enum { S285_MAX = 4, S285_IN = 12, S285_RDR = 4, S285_UBO_MAXB = 256 };
+typedef struct {
+    uint64_t frame, pass, ser;
+    int slot, lv, sl, load;            // 颜色附件槽 / mip 级 / 层 / loadAction（0 dontcare、1 load、2 clear）
+    uint32_t pf; NSUInteger w, h;      // 附件的 Metal 像素格式与存储尺寸
+    int has_draw; char key[24];        // 这一遍第一笔片元的 key（一笔都不画时是 "-"）
+    int ntex, ntex_total;              // 列出来的输入条数 / 这一遍实际绑了几张（> S285_IN 只列前 S285_IN 张）
+    struct { unsigned reg; int tid; uint64_t ser; uint32_t pf; uint32_t w, h; char kind[8]; } tex[S285_IN];
+    int ubo_reg; uint64_t ubo_addr, ubo_len;
+    int ncol;                          // 管线颜色槽（g_pass.cfmt 非 0 的那些）
+    struct { uint8_t slot; uint32_t cfmt, wmask; uint8_t blend; } col[8];
+    int disc, dsrc;                    // 1 有 / 0 没有 / -1 不知道；dsrc：1 json 2 .metal 源文 0 不知道
+} s285_ent;
+typedef struct { uint64_t frame, pass; char key[24]; unsigned reg; int stage, cslot; } s285_rdr;
+static s285_ent g_s285[S285_MAX];
+static __strong id<MTLTexture> g_s285_tex[S285_MAX];   // 写者条目的颜色附件（帧末整张读回）
+static int g_s285_n, g_s285_wdrop;
+static s285_rdr g_s285_rd[S285_RDR]; static int g_s285_nd, g_s285_rdrop;
+static uint64_t g_s285_pass = ~0ull;                  // 每遍只看第一笔画
+static int g_s285_on = -1, g_s285_halt_logged, g_s285_submit_fail, g_s285_trunc_logged, g_s285_none_logged;
+static uint64_t g_s285_target = 285; static pthread_once_t g_s285_once = PTHREAD_ONCE_INIT;
+// 开遍时留的候选：这一遍的颜色附件（只拿 pd 里已有的引用，不建、不拷）
+static struct { uint8_t slot; uint64_t ser; uint32_t pf; int lv, sl, load; id<MTLTexture> mt; } g_s285_att[8];
+static int g_s285_att_n; static uint64_t g_s285_att_pass = ~0ull;
+static void s285_init(void) {
+    uint64_t v = 285;
+    const char *e = getenv("S2A_S285_SER");
+    if (e && *e) { char *end = NULL; unsigned long long x = strtoull(e, &end, 0); if (end && *end == 0 && x > 0 && x < (1ull << 62)) v = (uint64_t)x; }
+    g_s285_target = v;
+    MLOG("[ser285] 目标 serial = %llu（%s）：写它的 pass 打输入 / UBO / 写掩码 / 混合 / discard，帧末整张读回打 nonzero/mean/max，"
+         "任何 pass 的纹理绑定里读到它就打 reader 行（S2A_S285_SER=<n> 换序号；S2A_S285_DEBUG=0 关；S2A_LIT_DEBUG=0 整条关）",
+         (unsigned long long)v, e && *e ? "S2A_S285_SER" : "默认 285");
+}
+static int s285_on(void) {
+    if (g_s285_on < 0) {
+        const char *e = getenv("S2A_S285_DEBUG");
+        g_s285_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_s285_on) MLOG("S2A_S285_DEBUG=0 / S2A_LIT_DEBUG=0: [ser285] 定点 serial 诊断关");
+    }
+    return g_s285_on;
+}
+static uint64_t s285_ser(void) { pthread_once(&g_s285_once, s285_init); return g_s285_target; }
+static const char *s285_load(int a) { return a == (int)MTLLoadActionClear ? "clear" : a == (int)MTLLoadActionLoad ? "load" : "dontcare"; }
+static const char *s285_dsrc(const s285_ent *e) { return e->dsrc == 1 ? "json" : e->dsrc == 2 ? "metal" : "none"; }
+// 开遍时（和 bytgt_att_note / dark2_att_note 同一个点）：记这一遍的颜色附件；颜色附件里就有目标的直接建写者条目
+//   （只做 clear、一笔都不画的遍也是写它）。只读附件表与 R.rt（submit 线程）；不开命令缓冲、不建纹理、不取锁。
+static void s285_att_note(MTL4RenderPassDescriptor *pd, NSUInteger nc) {
+    for (int i = 0; i < 8; i++) g_s285_att[i].mt = nil;   // 上一遍的引用放掉
+    g_s285_att_n = 0;
+    if (!s285_on() || !pd) { g_s285_att_pass = ~0ull; return; }
+    uint64_t ser = s285_ser();
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    for (NSUInteger i = 0; i < nc && i < 8; i++) {
+        id<MTLTexture> mt = pd.colorAttachments[i].texture; if (!mt) continue;
+        const tex_t *tt = i < (NSUInteger)R.rt.n ? R.rt.color[i] : NULL; if (!tt) continue;
+        int k = g_s285_att_n++;
+        g_s285_att[k].slot = (uint8_t)i; g_s285_att[k].ser = tt->serial;
+        g_s285_att[k].pf = (uint32_t)mt.pixelFormat;
+        g_s285_att[k].lv = (int)pd.colorAttachments[i].level;
+        g_s285_att[k].sl = mt.textureType == MTLTextureType2DArray ? (int)pd.colorAttachments[i].slice : 0;
+        g_s285_att[k].load = (int)pd.colorAttachments[i].loadAction;
+        g_s285_att[k].mt = mt;
+    }
+    g_s285_att_pass = g_stat_pass + 1;   // 这一遍开遍后 g_stat_pass 才 ++，draw 里看到的就是它
+    for (int i = 0; i < g_s285_att_n; i++) {   // 颜色附件里就有目标：这一遍是写者（MRT 里出现两次时只记第一张）
+        if (!g_s285_att[i].ser || g_s285_att[i].ser != ser) continue;
+        if (g_s285_n >= S285_MAX) { g_s285_wdrop++; break; }
+        s285_ent *e = &g_s285[g_s285_n];
+        memset(e, 0, sizeof *e);
+        e->frame = f; e->pass = g_s285_att_pass; e->ser = ser; e->slot = g_s285_att[i].slot;
+        e->pf = g_s285_att[i].pf; e->lv = g_s285_att[i].lv; e->sl = g_s285_att[i].sl; e->load = g_s285_att[i].load;
+        e->w = g_s285_att[i].mt.width; e->h = g_s285_att[i].mt.height;
+        e->ubo_reg = -1; e->disc = -1;
+        g_s285_tex[g_s285_n] = g_s285_att[i].mt;
+        g_s285_n++;
+        break;
+    }
+}
+// draw 里（每一遍的第一笔画，和 [dark2] 同一个时机）：写者条目补 key / 输入 / UBO / 管线；
+//   任何一遍（片元 / 顶点）的纹理绑定里读到目标就记 reader。只读绑定状态与 S，不建纹理、不拷贝、不进命令缓冲。
+static void s285_note(NvShader *vs, NvShader *fs) {
+    if (!s285_on()) return;
+    uint64_t pass = g_stat_pass;
+    if (g_s285_pass == pass) return;   // 每遍只看第一笔画（这时的片元绑定 / S 属于这一遍）
+    g_s285_pass = pass;
+    uint64_t ser = s285_ser();
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    for (int i = 0; i < g_s285_n; i++) {   // 1) 写者：这一遍的条目（开遍时建的）补状态
+        s285_ent *e = &g_s285[i];
+        if (e->frame != frame || e->pass != pass || e->has_draw) continue;
+        e->has_draw = 1;
+        snprintf(e->key, sizeof e->key, "%s", fs && fs->key[0] ? fs->key : "-");
+        int total = 0;
+        pthread_mutex_lock(&g_rmu);
+        for (int j = 0; fs && j < fs->rf.nb; j++) {
+            const nvn_rbind *b = &fs->rf.b[j];
+            if (b->kind == NVN_RB_CBUF) {   // UBO：该阶段绑定的最大 CBUF（帧末读回前 ≤ 256 B）
+                if (b->reg >= 16) continue;
+                const p_bind_buf *u = &S.ubo[1][b->reg];
+                if (u->addr && u->size && u->size > e->ubo_len) { e->ubo_addr = u->addr; e->ubo_len = u->size; e->ubo_reg = (int)b->reg; }
+                continue;
+            }
+            if (b->kind != NVN_RB_TEX) continue;
+            total++;
+            if (e->ntex >= S285_IN) continue;
+            int id_ = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+            if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) id_ = -1;   // 没绑 / 没登记：照样列出来（tid=-1 ser=0）
+            const treg_t *r = id_ > 0 ? &g_treg[id_] : NULL;
+            int k = e->ntex++;
+            e->tex[k].reg = b->reg; e->tex[k].tid = id_;
+            if (r) {
+                e->tex[k].ser = r->t.serial;
+                e->tex[k].w = r->t.d.width; e->tex[k].h = r->t.d.height;
+                int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+                uint32_t mpf = 0; uint8_t sw[4];
+                e->tex[k].pf = nvn_fmt_to_mtl(nf, &mpf, sw) ? mpf : 0;
+            }
+            snprintf(e->tex[k].kind, sizeof e->tex[k].kind, "%s", d2_kind(b, r));
+        }
+        pthread_mutex_unlock(&g_rmu);
+        e->ntex_total = total;
+        if (total > S285_IN && !g_s285_trunc_logged) { g_s285_trunc_logged = 1;
+            MLOG("[ser285] key=%s 这一遍绑了 %d 张 NVN_RB_TEX，只列前 %d 张（in= 打的是总数）", fs && fs->key[0] ? fs->key : "-", total, S285_IN); }
+        for (int j = 0; j < 8; j++) {   // 管线状态（和 [dark2] / pso_desc 同一套：合并遍按 lmap 取逻辑槽；片元不声明的输出掩码清零；整数目标不混合）
+            uint32_t fmt = g_pass.cfmt[j];
+            if (!fmt) continue;
+            int l = g_udc_lmap ? g_udc_lmap[j] : j;
+            int unwritten = fs && fs->rf.color_known && !g_udc_fsfn && l != 0xff && l <= 7 && !(fs->rf.color_mask >> l & 1);
+            uint32_t m = (l == 0xff || l > 7) ? 0 : (S.chmask.mask >> (4 * l)) & 0xf;
+            if (unwritten) m = 0;
+            uint32_t bl = (l != 0xff && l <= 7 && (S.color.blend_en >> l & 1) && !unwritten
+                           && !pf_int_kind((MTLPixelFormat)fmt)) ? 1 : 0;
+            if (e->ncol >= 8) break;
+            e->col[e->ncol].slot = (uint8_t)j; e->col[e->ncol].cfmt = fmt;
+            e->col[e->ncol].wmask = m; e->col[e->ncol].blend = (uint8_t)bl;
