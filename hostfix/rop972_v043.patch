+static int msl_uint_read_probe(NSString *pc, uint16_t *out, int cap) {
+    if (!pc.length || !out || cap <= 0) return 0;
+    NSMutableArray<NSString *> *dirs = [NSMutableArray array];
+    if (g_msl_dir) [dirs addObject:g_msl_dir];
+    const char *fb = getenv("DM_MSL_FALLBACK"), *md = getenv("DM_MSL_DIR");
+    if (fb && *fb) [dirs addObject:@(fb)];
+    if (md && *md) { [dirs addObject:@(md)]; [dirs addObject:[@(md) stringByAppendingPathComponent:@"wire"]]; }
+    for (NSString *d in dirs) {
+        NSString *src = [NSString stringWithContentsOfFile:[NSString stringWithFormat:@"%@/%@.metal", d, pc] encoding:NSUTF8StringEncoding error:nil];
+        if (!src) continue;
+        for (NSString *ln in [src componentsSeparatedByString:@"\n"]) {
+            if (![ln hasPrefix:@"// s2a:uint-read "]) continue;   // 17 个字符的前缀
+            NSString *t = [[ln substringFromIndex:17] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+            int n = 0;
+            for (NSString *f in [t componentsSeparatedByString:@","]) {
+                const char *q = f.UTF8String; int r = 0, any = 0;
+                while (*q >= '0' && *q <= '9') { r = r * 10 + (*q - '0'); q++; any = 1; if (r > 4096) break; }
+                if (!any || r > 4096) continue;   // "-" 或垃圾
+                int dup = 0; for (int i = 0; i < n; i++) dup |= out[i] == (uint16_t)r;
+                if (!dup && n < cap) out[n++] = (uint16_t)r;
+            }
+            return n;   // 只认第一行（UintRead 保证整份源码只写一行）
+        }
+        return 0;   // 源文在、里面没有这行
+    }
+    return 0;
