+    for (int i = 0; i < g_lit_nser; i++) { size_t o = strlen(g_lit_ser_desc);
+        snprintf(g_lit_ser_desc + o, sizeof g_lit_ser_desc - o, "%s%llu", o ? "," : "", (unsigned long long)g_lit_ser[i]); }
+}
+static void lit_ser_init(void) {
