+        MLOG("【红】[litin] shadow ser=%llu fmt=%#lx: 压缩 / 不认识的格式，不读回", (unsigned long long)g_litin_shadow_ser, (unsigned long)shd.pixelFormat); }
+    NSUInteger cpx = 0, spx = 0; size_t crow = 0, srow = 0; uint64_t csz = 0, ssz = 0;
