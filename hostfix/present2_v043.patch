+// 2026-11-18 present2：先 logs/passdump.tsv，失败再当前工作目录；两次都失败只打一行 [pdump] write failed (errno=..)，
+//   继续跑其它探针（上版 lz_disable("passdump write failed") 因写盘失败把 [lit] / [chain] 全关了）。
+static int lz_pd_flush(const char *dir) {
+    (void)dir;
+    const char *path = "logs/passdump.tsv";
+    mkdir("logs", 0755);
+    FILE *fp = fopen(path, "wb");
+    if (!fp) {
+        int e1 = errno;
+        path = "passdump.tsv";
+        fp = fopen(path, "wb");
+        if (!fp) {
+            int e2 = errno;
+            static int once;
+            if (!once++) MLOG("[pdump] write failed (errno=%d)", e2 ? e2 : e1);
+            return -1;
+        }
+    }
+    fputs("frame\torder\tpass\tkey\trole\tserial\twidth\theight\tfmt\tmean\tmax\tfile\n", fp);
+    if (g_lz_pd_len) fwrite(g_lz_pd, 1, g_lz_pd_len, fp);
+    if (g_lz_pd_capped) fputs("# capped\n", fp);
+    fclose(fp);
+    MLOG("[pdump] wrote %d rows to %s%s", g_lz_pd_lines, path, g_lz_pd_capped ? " (capped)" : "");
+    return g_lz_pd_lines;
+}
+// 追加 3：compute 的输出是纹理时的读数（纹理是 GPU 私有的，只能 blit + wait；每 300 帧一次、一次一行）
+typedef struct { uint64_t frame, fence; int tid; char key[24]; } lz_cstrec;
+static lz_cstrec g_lz_cst[8]; static int g_lz_cst_n;
+static const char *lz_pf_name(MTLPixelFormat pf);
+// 每个 compute 派发：记 key（整局去重表）+ 记下它的输出缓冲（可写的存储缓冲优先），行在下个开遍前打（那时 GPU 跑完、能读）
+static void lz_cs_note(__unsafe_unretained NvShader *cs, const p_dispatch *dp, uint32_t gx, uint32_t gy) {
+    if (!lz_on() || !cs) return;
+    lz_key_add(g_lz_cs_key, &g_lz_cs_n, &g_lz_cs_total, cs->key);
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (f != g_lz_csf_frame) { g_lz_csf_frame = f; g_lz_csf_n = 0; }
+    if (!lz_sample_frame(f)) return;
+    for (int i = 0; i < g_lz_csf_n; i++) if (!strcmp(g_lz_csf[i], cs->key)) return;
+    if (g_lz_csf_n >= 6 || g_lz_csrec_n >= LZ_CS_REC) return;
+    snprintf(g_lz_csf[g_lz_csf_n++], sizeof g_lz_csf[0], "%s", cs->key);
+    int oreg = -1; uint64_t olen = 0, oaddr = 0;
+    for (int i = 0; i < cs->rf.nb; i++) {
+        const nvn_rbind *b = &cs->rf.b[i];
+        if (b->kind != NVN_RB_SBUFP || b->reg >= 16) continue;
+        const p_bind_buf *u = &S.ssbo[5][b->reg];
+        if (!u->addr) continue;
+        if (b->rw) { oreg = b->reg; olen = u->size; oaddr = u->addr; break; }
+        if (oreg < 0) { oreg = b->reg; olen = u->size; oaddr = u->addr; }
+    }
+    if (oreg < 0) {   // 只写图像的核：记下它的图像槽，下个开遍前 blit + wait 读中心（[cs] out tex）
+        int iimg = -1;
+        for (int i = 0; i < cs->rf.nb; i++) { const nvn_rbind *b = &cs->rf.b[i]; if (b->kind == NVN_RB_IMG && b->rw) { iimg = i; oreg = b->reg; break; } }
+        if (iimg >= 0 && g_lz_cst_n < 8) {
+            int tid = img_tid(&cs->rf.b[iimg], 5);
+            if (tid > 0 && tid < g_ntreg && g_treg[tid].ok) {
+                lz_cstrec *r = &g_lz_cst[g_lz_cst_n++];
+                r->frame = f; r->fence = g_fence + 1; r->tid = tid; snprintf(r->key, sizeof r->key, "%s", cs->key);
+            }
+        }
+        if (lz_line_ok(1)) MLOG("[cs] f=%llu key=%s groups=%u,%u,%u out reg=%d len=0 head=- nonzero=0/0", (unsigned long long)f, cs->key, gx, gy, (unsigned)dp->z, oreg);
+        return;
+    }
+    lz_csrec *r = &g_lz_csrec[g_lz_csrec_n++];
+    r->frame = f; r->fence = g_fence + 1; r->addr = oaddr; r->len = olen; r->reg = oreg;
+    r->gx = gx; r->gy = gy; r->gz = (uint32_t)dp->z;
+    snprintf(r->key, sizeof r->key, "%s", cs->key);
+}
+static void lz_cs_drain(void) {
+    for (int i = 0; i < g_lz_csrec_n; ) {
+        lz_csrec *r = &g_lz_csrec[i];
+        if (r->fence > g_done) { i++; continue; }
+        char *head = lz_b_hex; uint32_t nz = 0, k = 0;
+        lz_buf_head(r->addr, r->len, head, sizeof lz_b_hex, &nz, &k);
+        if (lz_line_ok(1)) MLOG("[cs] f=%llu key=%s groups=%u,%u,%u out reg=%d len=%llu head=%s nonzero=%u/%u",
