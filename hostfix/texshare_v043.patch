+                return msl;
+            }
+            string masked = MaskCode(msl);
+            int[] pd = PrefixDepth(masked);
+            var cand = new List<(int Start, int Open, int Close, string Inner, string Name, string Elem, long Reg)>();
+            foreach (Match m in All(@"\bas_type<\s*(uint|int)\s*>\s*\(", masked))
+            {
