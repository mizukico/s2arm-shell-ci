+// S2A_FOG_A (stage A): Dsh.cs FsFogA appends `constant float* s2a_fog [[buffer(31)]]` to 6c00eb91's
+//   fragment entry and adds c5[125].xyz to _969/_965/_967. This is where that pointer gets its value.
+//   env is read once at start-up, 0 or 1 only: any other value is rejected and treated as 0, so the
+//   key can never act as a free float multiplier. 0 = the MSL does not contain the declaration at all.
+//   The value rides the argument table like alpha_ref does (enc_r_args), not a classic binding path.
+static int g_fog_a = -1; static int g_fog_a_applied;
+static int fog_a_on(void) {
+    if (g_fog_a >= 0) return g_fog_a;
+    g_fog_a = 0;
+    const char *e = getenv("S2A_FOG_A");
+    if (e && *e) {
+        char *end = NULL; long v = strtol(e, &end, 10);
+        if (end == e || (end && *end) || (v != 0 && v != 1))
+            MLOG("[S2A_FOG_A] %s rejected (only 0 or 1 accepted): treated as 0", e);
+        else if (v == 1) { g_fog_a = 1; MLOG("[S2A_FOG_A] 1: fog add-term on (fragment slot %d = 1.0)", 31); }
+        else MLOG("[S2A_FOG_A] 0: fog add-term off");
+    }
+    return g_fog_a;
+}
+static void fog_a_bind(id en) {   // called for every draw of the fragment stage; the pointer must be there or the pipeline reads garbage
+    if (!fog_a_on()) return;
+    if (!g_fog_a_applied) { g_fog_a_applied = 1; MLOG("[S2A_FOG_A] bound to fragment slot %d at first draw", 31); }
+    __unsafe_unretained id<MTLBuffer> b; static const float one = 1.0f; size_t o = arena_alloc_u(sizeof one, &b);
+    memcpy((uint8_t *)b.contents + o, &one, sizeof one);
+    enc_r_args(en, MTLRenderStageFragment, b.gpuAddress + o, 31);
+}
