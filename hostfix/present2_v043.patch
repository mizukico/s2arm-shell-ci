+    }
+    if (g_lz_blocks_frame >= 2) return;                    // 每帧最多两个详细块（输入更多的那一遍优先）
+    int k = lz_slot_free();
+    if (k < 0) return;
+    lz_slot_t *s = &g_lz_slot[k];
+    s->used = 0; s->ready = 0; s->kind = 0; s->frame = f; s->pass = pass; s->fence = 0; s->nin = nin; s->natt = natt; s->nbuf = 0;
