+    if (f != g_lz_pd_frame) { g_lz_pd_frame = f; g_lz_pd_order = 0; }
+    char *line = lz_b_pd;   // 栈外：passdump 行缓冲硬上限 512 字节
+    int n = snprintf(line, sizeof lz_b_pd, "%llu\t%d\t%lld\t%s\t%s\t%llu\t%u\t%u\t0x%x(%s)\t%.1f\t%u\t-\n", (unsigned long long)f, g_lz_pd_order++,
+                     (long long)pass, key && key[0] ? key : "-", role, (unsigned long long)ser, w, h, fmt, fmtn ? fmtn : "?", mean, mx);
+    if (n <= 0) return;
+    if (n >= (int)sizeof lz_b_pd) { n = (int)sizeof lz_b_pd - 1; lz_b_pd[n - 1] = '\n'; }   // 截断也仍然是合法的一行
+    // 2026-11-18 present2：每行同时按 [pdump] 写日志（每帧 ≤ 8 行），保证诊断包里一定有（导出只收 diagrun/*.png）。
+    if (f != g_lz_pd_log_frame) { g_lz_pd_log_frame = f; g_lz_pd_log_n = 0; }
+    if (g_lz_pd_log_n < 8) { g_lz_pd_log_n++; MLOG("[pdump] %.*s", n > 0 ? n - 1 : 0, line); }
+    if (g_lz_pd_len + (size_t)n + 1 > g_lz_pd_cap) {
+        size_t nc = g_lz_pd_cap ? g_lz_pd_cap * 2 : (1u << 20);
+        while (nc < g_lz_pd_len + (size_t)n + 1) nc *= 2;
+        char *p = realloc(g_lz_pd, nc);
+        if (!p) { g_lz_pd_capped = 1; return; }
+        g_lz_pd = p; g_lz_pd_cap = nc;
+    }
