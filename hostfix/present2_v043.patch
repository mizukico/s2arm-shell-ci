+static char g_lz_cs_key[LZ_CS_MAX][24]; static int g_lz_cs_n; static uint64_t g_lz_cs_total;
+static char g_lz_fb_key[LZ_CS_MAX][24]; static int g_lz_fb_n; static uint64_t g_lz_fb_total;
+static uint64_t g_lz_csf_frame; static char g_lz_csf[6][24]; static int g_lz_csf_n;   // 本帧已打过的 cs key（每帧 ≤ 6 行）
+static uint64_t g_lz_sum_last; static int g_lz_sum_n;
+static void lz_key_add(char tab[LZ_CS_MAX][24], int *n, uint64_t *total, const char *k) {
+    if (!k || !*k) return;
+    for (int i = 0; i < *n; i++) if (!strcmp(tab[i], k)) return;
+    (*total)++;
+    if (*n >= LZ_CS_MAX) return;
