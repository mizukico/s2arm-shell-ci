+// ---------- S2Arm #427 壳内置诊断 [ff]：读 ser=270 的时机 / 面（顺序验证）+ 乒乓面错的可选修复 ----------
+// 上一轮 [dark2] 在可操作场景（69ebe1cc5d7e3c9a_b 写 277）实测：in reg=128 ser=270 nonzero=0，reg=129 / 130（G-buffer 236 / 237）
+//   有小值，out ser=277 nonzero=0；同一段 ba5f5df42d8f1686_b 写 270 时输出非零（mean 111）。也就是说 69ebe1cc 读到的 270 是
+//   一张空面：要么这一遍跑在写 270 的那一遍之前（帧内顺序），要么 270 是两张同尺寸乒乓面里的「旧面」。这一版只做两件事：
+// 1) 顺序验证（只读，默认开）：69ebe1cc 每一遍读目标 serial（默认 270）时打一行，说明本帧读之前有没有 pass 写过它、
+//    最后写它的是哪一遍（pass 号 + 那遍第一笔片元的 key），以及上一帧写它的是哪一遍（看顺序是不是每帧都稳定地反着）：
+//      [ff] frame <f> reader_pass=<n> reads_ser=<s> written_before=<0/1> last_writer=<pass>:<key> prev_writer=<pass>:<key>
+// 2) 面切换（S2A_FACE_FLIP=<key 前缀>，不给就不翻；默认关）：该 key 的片元读到的 serial S 命中
+//      「本帧稍后会被写」（上一帧写 S 的那一遍排在本遍之后）或「同尺寸 / 同格式的乒乓对里 S 是空面」
+//      （本帧读之前没人写 S，而同尺寸同格式的另一面在本帧读之前被写过）时，把这一个纹理槽改绑到另一面
+//      （同尺寸 + 同格式、本帧读之前最近被写过的那张），并打一行：
+//      [ff] frame <f> reader_pass=<n> key=<k> flip ser <S> → <T>（cond=<later|empty> partner_pass=<p>）
+//    改绑点在 encode_args 的纹理槽里（和「同遍自采样快照替换」同一个位置）：只换这一次绑定用的 Metal 纹理 / GPU 资源号，
+//    不改 S、不改序号表、不建纹理、不拷贝，也不进命令缓冲。判定结果按遍缓存，每帧最多翻一次（S2A_FF_DEBUG=0 时也照翻）。
+//    面切换只对这一个 serial 生效（默认 270；S2A_FF_SER 可换），别的输入一律不碰。
+// 开关：S2A_FF_DEBUG=0 只关第 1 项（诊断行）；S2A_FACE_FLIP=<key 前缀> 开第 2 项；S2A_FF_KEY=<前缀> 换诊断认的片元 key
+//   （默认 69ebe1cc5d7e3c9a）；S2A_FF_SER=<n> 换被读的目标序号（默认 270）。两项都不跟 S2A_LIT_DEBUG 走。
+enum { FF_WR = 64, FF_LINES = 8 };
+typedef struct { uint64_t frame, pass, ser; char key[24]; } ff_wr;
+static ff_wr g_ff_w[FF_WR]; static int g_ff_nw;   // 本帧写者表：serial → 最后写它的那几遍里的最后一遍（pass 号 + 那遍第一笔片元的 key）
+static struct { uint64_t ser, pass; char key[24]; } g_ff_prev[FF_WR]; static int g_ff_nprev;   // 上一帧的写者表（「本帧稍后会被写」的前瞻）
+static uint64_t g_ff_wframe = ~0ull;      // 写者表属于哪一帧
+static uint64_t g_ff_pass = ~0ull;        // draw 钩子：每遍只看第一笔画
+static uint64_t g_ff_flip_frame = ~0ull;  // 面切换：每帧最多判定 / 翻一次
+static int g_ff_lines, g_ff_trunc, g_ff_nflip, g_ff_nopartner;
+static int g_ff_dbg = -1, g_ff_init;
+static uint64_t g_ff_ser = 270;           // 被读的目标 serial
+static char g_ff_key[24];                 // 诊断认的 reader key 前缀
+static char g_ff_flip_key[24];            // S2A_FACE_FLIP：空 = 不翻
+// 这一遍生效的替换（通常 0 或 1 张）：encode_args 的纹理槽里按 from_ser 认得，换成 to_tid 那一面
+static struct { uint64_t from_ser, to_ser, partner_pass; int to_tid, applied; } g_ff_sub[2];
+static int g_ff_sub_n;
+static void ff_init(void) {
+    if (g_ff_init) return;
+    g_ff_init = 1;
+    const char *e = getenv("S2A_FF_SER");
+    if (e && *e) { char *end = NULL; unsigned long long v = strtoull(e, &end, 0); if (end && *end == 0 && v) g_ff_ser = (uint64_t)v; }
+    const char *k = getenv("S2A_FF_KEY");
+    snprintf(g_ff_key, sizeof g_ff_key, "%s", k && *k ? k : "69ebe1cc5d7e3c9a");
+    const char *fk = getenv("S2A_FACE_FLIP");
+    snprintf(g_ff_flip_key, sizeof g_ff_flip_key, "%s", fk ? fk : "");
+    if (!strcmp(g_ff_flip_key, "0") || !strcmp(g_ff_flip_key, "off") || !strcmp(g_ff_flip_key, "none")) g_ff_flip_key[0] = 0;
+    MLOG("[ff] 顺序验证：reader key 前缀 = %s，被读的 serial = %llu；面切换 = %s%s%s"
+         "（S2A_FF_DEBUG=0 关诊断行；S2A_FACE_FLIP=<key 前缀> 开面切换；S2A_FF_KEY / S2A_FF_SER 换 reader / 序号）",
+         g_ff_key, (unsigned long long)g_ff_ser, g_ff_flip_key[0] ? "开 " : "关",
+         g_ff_flip_key[0] ? g_ff_flip_key : "", g_ff_flip_key[0] ? "（每帧最多翻一次）" : "（不给 S2A_FACE_FLIP 就不翻）");
+}
+static int ff_on(void) {
+    if (g_ff_dbg < 0) { const char *e = getenv("S2A_FF_DEBUG"); g_ff_dbg = !(e && !strcmp(e, "0")); }
+    return g_ff_dbg;
+}
+// 找「另一面」（调用方持 g_rmu）：同宽高深 + 同 target + 同 Metal 格式、不是自己这一张、本帧读之前被写过。
+//   多个候选取「最近被写过」的那一张（写它的 pass 号最大）。找不到返回 -1。
+//   不算「本遍现在挂着的颜色附件」：同一遍里既写又读同一张在 Metal 里是读写冲突，换面不能换到这种面上。
+static int ff_partner(int self_tid, uint64_t frame, uint64_t reader_pass, uint64_t *out_ser, uint64_t *out_pass) {
+    if (self_tid <= 0 || self_tid >= g_ntreg || !g_treg[self_tid].ok) return -1;
+    const treg_t *me = &g_treg[self_tid];
+    int mf = me->has_v && me->v.set_format ? (int)me->v.format : (int)me->t.d.format;
+    uint32_t mpf = 0; uint8_t msw[4];
+    if (!mf || !me->t.d.width || !me->t.d.height || !me->t.d.depth) return -1;
+    if (!nvn_fmt_to_mtl(mf, &mpf, msw) || !mpf) return -1;
+    int best = -1; uint64_t bestp = 0, bestser = 0;
+    for (int id_ = 1; id_ < g_ntreg; id_++) {
+        if (id_ == self_tid || !g_treg[id_].ok) continue;
+        const treg_t *q = &g_treg[id_];
+        if (q->t.d.width != me->t.d.width || q->t.d.height != me->t.d.height || q->t.d.depth != me->t.d.depth) continue;
+        if (q->t.d.target != me->t.d.target) continue;
+        int qf = q->has_v && q->v.set_format ? (int)q->v.format : (int)q->t.d.format;
+        uint32_t qpf = 0; uint8_t qsw[4];
+        if (!qf || !nvn_fmt_to_mtl(qf, &qpf, qsw) || qpf != mpf) continue;
+        // 本帧读之前被写过吗？取最后写它的那一遍；本遍自己挂着的附件（本帧最后一个写者是这一遍）不要
+        uint64_t wp = 0; int attached = 0;
+        for (int i = 0; i < g_ff_nw; i++) {
+            if (g_ff_w[i].frame != frame || g_ff_w[i].ser != q->t.serial) continue;
+            if (g_ff_w[i].pass >= reader_pass) attached = 1;
+            else if (g_ff_w[i].pass > wp) wp = g_ff_w[i].pass;
+        }
+        if (attached || !wp) continue;
+        if (best < 0 || wp > bestp) { best = id_; bestp = wp; bestser = q->t.serial; }
+    }
+    if (best < 0) return -1;
+    if (out_ser) *out_ser = bestser;
+    if (out_pass) *out_pass = bestp;
+    return best;
+}
+// 开遍时（和 bytgt_att_note / dark2_att_note / pres_att_note 同一个点）：这一遍的颜色附件记进本帧写者表。
+//   只读附件表与 R.rt（submit 线程）；不开命令缓冲、不建纹理、不取锁。新的一帧先把上一帧的表转成前瞻表。
+static void ff_att_note(MTL4RenderPassDescriptor *pd, NSUInteger nc) {
+    if (g_ff_sub_n) {   // 上一遍的面切换到此为止：一个槽都没换到就说一声（不然会以为翻生效了）
+        for (int i = 0; i < g_ff_sub_n; i++) if (!g_ff_sub[i].applied)
+            MLOG("【红】[ff] 面切换没有落到绑定上：ser %llu → %llu 的那一遍一个纹理槽都没换（先看 [dark2] 的 in tex 里还有没有这个 serial）",
+                 (unsigned long long)g_ff_sub[i].from_ser, (unsigned long long)g_ff_sub[i].to_ser);
+        g_ff_sub_n = 0;
+    }
+    if (!pd) return;
+    ff_init();
+    if (!ff_on() && !g_ff_flip_key[0]) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    if (f != g_ff_wframe) {   // 新的一帧：上一帧的写者表转成前瞻表，本帧清空
+        g_ff_nprev = 0;
+        for (int i = 0; i < g_ff_nw && g_ff_nprev < FF_WR; i++) {
+            g_ff_prev[g_ff_nprev].ser = g_ff_w[i].ser; g_ff_prev[g_ff_nprev].pass = g_ff_w[i].pass;
+            snprintf(g_ff_prev[g_ff_nprev].key, sizeof g_ff_prev[0].key, "%s", g_ff_w[i].key);
+            g_ff_nprev++;
+        }
+        g_ff_nw = 0; g_ff_wframe = f; g_ff_lines = 0; g_ff_pass = ~0ull; g_ff_flip_frame = ~0ull;
+    }
+    uint64_t pass = g_stat_pass + 1;   // 这一遍开遍后 g_stat_pass 才 ++，draw 钩子里看到的就是它
+    for (NSUInteger i = 0; i < nc && i < 8; i++) {
+        id<MTLTexture> mt = pd.colorAttachments[i].texture; if (!mt) continue;
+        const tex_t *tt = i < (NSUInteger)R.rt.n ? R.rt.color[i] : NULL; if (!tt || !tt->serial) continue;
+        int w = -1;   // 同一帧同一个 serial 只留最后一个写它的遍
+        for (int j = 0; j < g_ff_nw; j++) if (g_ff_w[j].frame == f && g_ff_w[j].ser == tt->serial) { w = j; break; }
+        if (w < 0) { if (g_ff_nw >= FF_WR) continue; w = g_ff_nw++; }
+        g_ff_w[w].frame = f; g_ff_w[w].pass = pass; g_ff_w[w].ser = tt->serial; g_ff_w[w].key[0] = 0;
+    }
+}
+// draw 里、绑纹理之前（这一遍的第一笔画）：先把这一遍的 key 补进写者表；这一遍是诊断认的 reader 就打顺序行，
+//   S2A_FACE_FLIP 命中就判一次面切换。只读绑定状态与 S，不建纹理、不拷贝、不进命令缓冲。
+static void ff_pre(NvShader *fs) {
+    if (!fs) return;
+    ff_init();
+    int dbg = ff_on();
+    int rd_key = fs->key[0] && !strncmp(fs->key, g_ff_key, strlen(g_ff_key));
+    int flip_key = g_ff_flip_key[0] && fs->key[0] && !strncmp(fs->key, g_ff_flip_key, strlen(g_ff_flip_key));
+    if (!dbg && !flip_key) return;
+    uint64_t pass = g_stat_pass;
+    if (g_ff_pass == pass) return;   // 每遍只看第一笔画（这时的片元绑定 / S 属于这一遍）
+    g_ff_pass = pass;
+    for (int i = 0; i < g_ff_nw; i++)   // 这一遍是本帧写者：补上它第一笔片元的 key（写者行 / 前瞻表里要打）
+        if (g_ff_w[i].pass == pass && !g_ff_w[i].key[0]) snprintf(g_ff_w[i].key, sizeof g_ff_w[i].key, "%s", fs->key);
+    if (!rd_key && !flip_key) return;
+    uint64_t frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    // 这一遍片元阶段绑的纹理里有目标 serial 吗（同一遍只看第一笔画的绑定，和 [dark2] / [pres] 同口径）
+    int tid_hit = -1; unsigned reg_hit = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind != NVN_RB_TEX) continue;
+        int id_ = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+        if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) continue;
+        if (g_treg[id_].t.serial != g_ff_ser) continue;
+        tid_hit = id_; reg_hit = b->reg; break;
+    }
+    pthread_mutex_unlock(&g_rmu);
+    // 本帧读之前有没有 pass 写过目标 serial：有就记最后那一遍（pass 号 + key）
+    int wb = 0; uint64_t lastwp = 0, prevwp = 0; char lastk[24] = "-", prevk[24] = "-";
+    for (int i = 0; i < g_ff_nw; i++) {
+        if (g_ff_w[i].frame != frame || g_ff_w[i].ser != g_ff_ser) continue;
+        if (g_ff_w[i].pass < pass && g_ff_w[i].pass > lastwp) {
+            lastwp = g_ff_w[i].pass; snprintf(lastk, sizeof lastk, "%s", g_ff_w[i].key[0] ? g_ff_w[i].key : "-");
+        }
+    }
+    wb = lastwp != 0;
+    int self_attached = 0;   // 目标 serial 就是本遍自己挂着的颜色附件（同一遍既写又读）：换面没意义，不翻
+    for (int i = 0; i < g_ff_nw; i++)
+        if (g_ff_w[i].frame == frame && g_ff_w[i].ser == g_ff_ser && g_ff_w[i].pass >= pass) self_attached = 1;
+    for (int i = 0; i < g_ff_nprev; i++)   // 上一帧写它的那一遍（看顺序是不是每帧都稳定地反着：prev_writer > reader_pass 就是「稍后才写」）
+        if (g_ff_prev[i].ser == g_ff_ser && g_ff_prev[i].pass > prevwp) {
+            prevwp = g_ff_prev[i].pass; snprintf(prevk, sizeof prevk, "%s", g_ff_prev[i].key[0] ? g_ff_prev[i].key : "-");
+        }
+    if (dbg && rd_key) {
+        if (g_ff_lines < FF_LINES) {
+            g_ff_lines++;
+            MLOG("[ff] frame %llu reader_pass=%llu reads_ser=%llu written_before=%d last_writer=%llu:%s prev_writer=%llu:%s",
+                 (unsigned long long)frame, (unsigned long long)pass,
+                 (unsigned long long)(tid_hit > 0 ? g_ff_ser : 0ull), wb,
+                 (unsigned long long)lastwp, lastk, (unsigned long long)prevwp, prevk);
+        } else if (!g_ff_trunc) { g_ff_trunc = 1;
+            MLOG("[ff] 本帧的 [ff] 行已到 %d 条：之后只计数不再打（每帧上限 %d；S2A_FF_DEBUG=0 关诊断）", FF_LINES, FF_LINES); }
+    }
+    // 面切换：只对目标 serial 这一个槽生效；每帧最多判定 / 翻一次
+    if (!flip_key || tid_hit <= 0 || g_ff_flip_frame == frame) return;
+    int later = prevwp && prevwp > pass;   // 本帧稍后才写（上一帧写者的位置在本遍之后）
+    int empty = !wb;                       // 本帧读之前没人写它：读到的是上一帧留下的 / 被清掉的那一面
+    if (!later && !empty) return;
