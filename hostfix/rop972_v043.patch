+            var ok = new Dictionary<string, (string Elem, long Reg)>(StringComparer.Ordinal);
+            foreach (var c in cand)
+            {
+                if (bad.Contains(c.Name)) continue;
+                if (ok.TryGetValue(c.Name, out var had) && had.Elem != c.Elem) { ok.Remove(c.Name); bad.Add(c.Name); continue; }
+                ok[c.Name] = (c.Elem, c.Reg);
+            }
+            // 安全阀：该成员全文件除参数块声明外都只做 .read / .sample，且每一处都落在该成员的候选 span 里
+            foreach (var name in ok.Keys.ToList())
+            {
