+        /// 字面量 / 注释里的 as_type 与括号一律不认（旧实现 R2 / R3 的根）。先在 raw 上算偏移，再用同一偏移切 raw</summary>
+        static string MaskCode(string s)
+        {
+            var b = new char[s.Length];
+            int i = 0;
+            while (i < s.Length)
+            {
+                char c = s[i];
+                if (c == '/' && i + 1 < s.Length && s[i + 1] == '/')
+                {   // 行注释：到行尾（换行留着）
+                    while (i < s.Length && s[i] != '\n') { b[i] = ' '; i++; }
+                    continue;
+                }
+                if (c == '/' && i + 1 < s.Length && s[i + 1] == '*')
+                {   // 块注释：到 */（换行留着；没闭合就到文件尾）
+                    b[i] = ' '; if (i + 1 < s.Length) b[i + 1] = ' '; i += 2;
+                    while (i < s.Length && !(s[i] == '*' && i + 1 < s.Length && s[i + 1] == '/'))
+                    {
+                        if (s[i] != '\n') b[i] = ' ';
+                        i++;
+                    }
+                    if (i < s.Length) { b[i] = ' '; i++; if (i < s.Length) { b[i] = ' '; i++; } }
+                    continue;
+                }
+                if (c == '"' || c == '\'')
+                {   // 字符串 / 字符字面量：反斜杠转义跳过两字节，遇换行（未闭合）停
+                    char q = c; b[i] = ' '; i++;
+                    while (i < s.Length)
+                    {
+                        char d = s[i];
+                        if (d == '\\') { b[i] = ' '; i++; if (i < s.Length) { b[i] = ' '; i++; } continue; }
+                        if (d == '\n') break;
+                        b[i] = ' '; i++;
+                        if (d == q) break;
+                    }
+                    continue;
+                }
+                b[i] = c; i++;
+            }
+            return new string(b);
+        }
+
+        /// <summary>open（'(' 的下标）起配对的 ')' 之后；**只数圆括号**，跳过字符串 / 字符字面量与 // 、/* */ 注释。
+        /// 在 depth 0 上遇到 ';'（这条调用没有闭合）或到文件尾 → -1（该候选整个丢弃，不回退整支）</summary>
+        static int AsTypeEnd(string s, int open)
+        {
+            int d = 0;
+            for (int i = open; i < s.Length; i++)
+            {
+                char c = s[i];
+                if (c == '/' && i + 1 < s.Length && s[i + 1] == '/') { while (i < s.Length && s[i] != '\n') i++; continue; }
+                if (c == '/' && i + 1 < s.Length && s[i + 1] == '*')
+                {
+                    i += 2;
+                    while (i < s.Length && !(s[i] == '*' && i + 1 < s.Length && s[i + 1] == '/')) i++;
+                    i++; continue;
+                }
+                if (c == '"' || c == '\'')
+                {
+                    char q = c;
+                    for (i++; i < s.Length; i++)
+                    {
+                        if (s[i] == '\\') { i++; continue; }
+                        if (s[i] == '\n' || s[i] == q) break;
+                    }
+                    continue;
+                }
+                if (c == '(') d++;
+                else if (c == ')') { d--; if (d == 0) return i + 1; }
+                else if (c == ';' && d == 0) return -1;
+            }
+            return -1;
+        }
+
+        /// <summary>pd[i] = 下标 i 之前的圆括号深度（掩码稿上算一次，逐候选 O(1) 查）</summary>
+        static int[] PrefixDepth(string masked)
+        {
+            var pd = new int[masked.Length + 1];
+            int d = 0;
+            for (int i = 0; i < masked.Length; i++)
+            {
+                pd[i] = d;
+                char c = masked[i];
+                if (c == '(') d++;
+                else if (c == ')') d--;
+            }
+            pd[masked.Length] = d;
+            return pd;
+        }
+
+        /// <summary>整条语句内：从 as_type 往前找最近的 ';' / '{' / '}' 得语句起点 st，要求 [st, close] 里圆括号深度始终 ≥ depth(st)
+        /// （不会跨出 st 之前开的那层括号）且 depth(st) 这一层上不出现 ';'（语句没被截断；for(;;) 的分号在更深一层，不算）。
+        /// 允许 as_type 嵌在更外层的调用里（如 float4(as_type&lt;uint&gt;(…))），只要求整条调用落在一条语句里</summary>
+        static bool InOneStatement(string masked, int[] pd, int start, int close)
+        {
+            if (close <= start || close > pd.Length) return false;
+            int st = 0;
+            for (int i = start - 1; i >= 0; i--)
+            {
+                char c = masked[i];
+                if (c == ';' || c == '{' || c == '}') { st = i + 1; break; }
+            }
+            int d0 = pd[st];
+            for (int i = st; i < close; i++)
+            {
+                if (pd[i] < d0) return false;
+                if (masked[i] == ';' && pd[i] == d0) return false;
+            }
+            return pd[close] >= d0;
+        }
+
+        /// <summary>as_type&lt;…&gt;( … ) 里那条约表达式读的是哪张贴图：最后一处 .read( / .sample( 的接收者标识符
+        /// （spvDescriptorSet0.NAME 时取 NAME）。expr 是掩码稿（注释 / 字面量已空）</summary>
+        static string UintReadRecv(string expr)
+        {
+            string name = null;
+            foreach (Match m in All(@"\.\s*(?:read|sample)\s*\(", expr))
+            {
+                int i = m.Index;
+                while (i > 0 && char.IsWhiteSpace(expr[i - 1])) i--;
+                int e = i;
+                while (i > 0 && (char.IsLetterOrDigit(expr[i - 1]) || expr[i - 1] == '_')) i--;
+                if (e > i) name = expr[i..e];
+            }
+            return name;
+        }
+
+        /// <summary>#427 [uint-read]：MSL 里 `as_type&lt;uint|int&gt;(&lt;贴图&gt;.read(…))` 这种「按位取整数」的读法，要的是宿主把整数纹理
+        /// 原样绑上来（apple10 上「整数纹理按 float 声明读」是 UB，读到 0：空之轨迹 the 1st 的 G-buffer 后期光照全黑）。生成 MSL 后做一次
