+// ================================================================================================
+// S2Arm 2026-11-18 v1v2 / crashfix2: 灯列表缓冲（light list）的原始字节，写侧 / 读侧各落一份（只观测，不改渲染）。
+//   at_light   : 光照遍（采样 G-buffer、写 1600×900 浮点目标的那遍，片元 key 前缀 567fcd0c）绑 sbufp 时，
+//                在这一遍结束（编码器已关，blit 合法）时把「这一遍绑的、尺寸最大的可读存储缓冲」抄下来。
+//   after_cull : light_cull（计算 key 前缀 f9def5d9，帧末执行、下一帧读）dispatch 之后立刻抄同一类缓冲（写侧）。
+//   选缓冲不写死地址 / serial / reg：只看当前绑定（S.ssbo[stage][reg]）、反射里的 b->rw 和绑定的字节数，
+//   尺寸最大者优先，同尺寸取 rw（写汇聚）。
+//   crashfix2 的安全规则（v1v2 在第一次 f>=1800 就把进程带走了，原因就是这一段没有边界校验、也没有 nil 出口）：
+//     1) 每次取值先校验：段起点 + 段长不得超过「guest 绑定长度 len」和「Metal 缓冲自身长度」；不足时只读可用部分，
+//        打 `[lightbuf] skip: len=<n> need=<m>`；指针为空直接跳过。
+//     2) newBufferWithLength: / blitCommandEncoder / commandBuffer 任一为 nil：只打一行 `[lightbuf] skip: …`，不解引用。
+//     3) 整段包 @try/@catch：任何 ObjC 异常 → `[lightbuf] disabled after exception: <reason>`，静态标志永久关闭，之后不再尝试。
+//     4) 触发帧 f >= 3600 且 f % 600 == 0（先让 f=3600 的整屏 shot_*.png / 目标 td_*.png 落盘，再读灯字节）；
+//        每个 stage 每局 ≤4 次、导出 ≤4 份、总文件 ≤8（.bin + .png 各算一个）。
+//     5) 不 assert / 不 abort / 不 NSAssert：上面每条失败都只是「跳过」。
+//   落盘：diagrun/lightbuf_f<frame>_<size>_<stage>.bin（源偏移 0x0 起 256 B、0x1000 起 64 B、0x80000 起 64 B 顺序相连，
+//   0..255 / 256..319 / 320..383）；另存一份同字节的 diagrun/lightbuf_f<frame>_<size>_<stage>.png（384×1 灰度，
+//   一个像素一个字节）—— 诊断包只收 *.png，.bin 留在设备 diagrun/ 里，这样这份字节也能随包出来。
+//   栈上最大 129 B 的十六进制串；256 B 段与落盘拼接在 heap；每次读回 ≤256 B（三段各一次 blit，heap 三块 256+64+64）。
+// ================================================================================================
+enum { V2_STAGES = 2, V2_PER_STAGE = 4, V2_DUMPS_MAX = 4, V2_FILES_MAX = 8, V2_LOG_MAX = 64,
+       V2_SEG_A = 256, V2_SEG_B = 64, V2_SEG_C = 64, V2_OFF_B = 0x1000, V2_OFF_C = 0x80000,
+       V2_SEG_ALL = V2_SEG_A + V2_SEG_B + V2_SEG_C };
+static int g_v2_dumps[V2_STAGES], g_v2_queued, g_v2_logs, g_v2_files;
+static int g_v2_off;   // 1 = 永久关闭（异常）：之后不再排任何一份
+static int g_v2_last_frame[V2_STAGES] = {-1, -1};
+static __strong id<MTLBuffer> g_v2_pend_buf;   // at_light 挑中的缓冲：等这一遍结束再抄（读侧）
+static uint64_t g_v2_pend_off, g_v2_pend_len; static long g_v2_pend_frame = -1;
+static int v2_frame_ok(long f) { return f >= 3600 && f % 600 == 0; }
+static void v2_kill(const char *why) {
+    if (g_v2_off) return;
+    g_v2_off = 1; g_v2_pend_buf = nil; g_v2_pend_off = g_v2_pend_len = 0; g_v2_pend_frame = -1;
+    MLOG("[lightbuf] disabled after exception: %s", why && *why ? why : "unknown exception");
+}
+static void v2_kill_e(NSException *e) { v2_kill(e && e.reason ? e.reason.UTF8String : "unknown exception"); }
+// 一行跳过（日志 ≤ V2_LOG_MAX 行）：不改变任何状态，只是不写这一份。
+static void v2_skip(long f, const char *stage, uint64_t len, uint64_t need, const char *why) {
+    if (g_v2_logs >= V2_LOG_MAX) return;
+    MLOG("[lightbuf] f=%ld stage=%s skip: len=%llu need=%llu%s%s", f, stage ? stage : "-", (unsigned long long)len,
+         (unsigned long long)need, why && *why ? " " : "", why && *why ? why : "");
+    g_v2_logs++;
+}
+// 这一阶段绑的 sbufp 里挑尺寸最大的一个（同尺寸取 rw）。b->reg / S.ssbo 都是当前绑定，不看 serial / 地址常量。
+static id<MTLBuffer> v2_pick_sh(NvShader *sh, int st, uint64_t *off, uint64_t *len, int *rwout) {
+    if (!sh || st < 0 || st > 5) return nil;
+    id<MTLBuffer> best = nil; uint64_t boff = 0, blen = 0; int brw = 0;
+    for (int i = 0; i < sh->rf.nb; i++) {
+        const nvn_rbind *b = &sh->rf.b[i];
+        if (b->kind != NVN_RB_SBUFP || b->reg >= 16) continue;
+        const p_bind_buf *u = &S.ssbo[st][b->reg];
+        if (!u->addr || !u->size) continue;
+        void *mb = NULL; uint64_t mo = 0;
+        if (!nvn_be_addr(u->addr, u->size, &mb, &mo)) continue;
+        int rw = b->rw ? 1 : 0;
+        if (!best || u->size > blen || (u->size == blen && rw > brw)) { best = (__bridge id<MTLBuffer>)mb; boff = mo; blen = u->size; brw = rw; }
+    }
+    if (!best) return nil;
+    if (off) *off = boff; if (len) *len = blen; if (rwout) *rwout = brw;
+    return best;
+}
+static id<MTLBuffer> v2_pick_prog(NvProg *pr, uint64_t *off, uint64_t *len, int *rwout) {
+    id<MTLBuffer> best = nil; uint64_t boff = 0, blen = 0; int brw = 0;
+    if (!pr) return nil;
+    for (int st = 0; st < 2; st++) {
+        uint64_t o = 0, l = 0; int rw = 0;
+        id<MTLBuffer> b = v2_pick_sh(pr->sh[st], st, &o, &l, &rw);
+        if (b && (!best || l > blen || (l == blen && rw > brw))) { best = b; boff = o; blen = l; brw = rw; }
+    }
+    if (!best) return nil;
+    if (off) *off = boff; if (len) *len = blen; if (rwout) *rwout = brw;
+    return best;
+}
+static void v2_hex(char *out, const uint8_t *p, int n) {
+    for (int i = 0; i < n; i++) snprintf(out + 2 * i, 3, "%02x", p[i]);
+    out[2 * n] = 0;
+}
+// 384×1 灰度 PNG：一个像素一个字节（三通道写同一个值，解码即得原字节）。诊断包只收 *.png，靠它把同一份字节带出来。
+static int v2_png(const char *path, const uint8_t *p, int n) {
+    if (!path || !path[0] || !p || n <= 0 || n > 4096) return 0;
+    uint8_t *px = (uint8_t *)calloc((size_t)n, 4);   // BGRA8：alpha 跳过，三个颜色通道都写同一个字节
+    if (!px) return 0;
+    for (int i = 0; i < n; i++) { px[4 * i + 0] = p[i]; px[4 * i + 1] = p[i]; px[4 * i + 2] = p[i]; px[4 * i + 3] = 0xff; }
+    CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGContextRef ctx = CGBitmapContextCreate(px, (size_t)n, 1, 8, (size_t)n * 4, cs, kCGImageAlphaNoneSkipLast | kCGBitmapByteOrder32Little);
+    CGImageRef img = ctx ? CGBitmapContextCreateImage(ctx) : NULL;
+    CFURLRef url = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8 *)path, strlen(path), false);
+    CGImageDestinationRef dst = url ? CGImageDestinationCreateWithURL(url, (__bridge CFStringRef)UTTypePNG.identifier, 1, NULL) : NULL;
+    int ok = 0; if (ctx && img && dst) { CGImageDestinationAddImage(dst, img, NULL); ok = CGImageDestinationFinalize(dst); }
+    if (dst) CFRelease(dst); if (url) CFRelease(url); CGImageRelease(img); CGContextRelease(ctx); CGColorSpaceRelease(cs);
+    free(px);
+    return ok;
+}
+// 提交完成回调里跑：两行日志（hex 三段 + off0 的 u32 / f32），然后落盘三段原始字节。整段 @try：异常只关探针。
+static void v2_job(NSDictionary *j) {
+    if (g_v2_off || !j) return;
+    @try {
+        id<MTLBuffer> b0 = j[@"b0"], b1 = j[@"b1"], b2 = j[@"b2"];
+        if (!b0 || !b1 || !b2) return;
+        const uint8_t *p0 = (const uint8_t *)b0.contents, *p1 = (const uint8_t *)b1.contents, *p2 = (const uint8_t *)b2.contents;
+        if (!p0 || !p1 || !p2) return;
+        long f = (long)[j[@"f"] longValue]; uint64_t len = [j[@"len"] unsignedLongLongValue];
+        const char *stage = [j[@"stage"] UTF8String]; if (!stage) stage = "-";
+        char h1[2 * V2_SEG_B + 1], h2[2 * V2_SEG_C + 1];   // 129 B each, stack
+        v2_hex(h1, p1, V2_SEG_B); v2_hex(h2, p2, V2_SEG_C);
+        char *h0 = (char *)malloc(2 * V2_SEG_A + 1);
+        if (!h0) return;
+        v2_hex(h0, p0, V2_SEG_A);
+        if (g_v2_logs + 2 <= V2_LOG_MAX) {
+            MLOG("[lightbuf] f=%ld stage=%s len=%llu off0=%s off1000=%s off80000=%s", f, stage, (unsigned long long)len, h0, h1, h2);
+            uint32_t u[4]; float fl[4]; memcpy(u, p0, sizeof u); memcpy(fl, p0, sizeof fl);
+            MLOG("[lightbuf] f=%ld stage=%s u32[0..3]=%u,%u,%u,%u f32[0..3]=%g,%g,%g,%g", f, stage, u[0], u[1], u[2], u[3], fl[0], fl[1], fl[2], fl[3]);
+            g_v2_logs += 2;
+        }
+        size_t tot = (size_t)V2_SEG_ALL;
+        uint8_t *all = (uint8_t *)malloc(tot);
+        char *path = (char *)malloc(1200);
+        if (!all || !path) { free(all); free(path); free(h0); return; }
+        memcpy(all, p0, V2_SEG_A); memcpy(all + V2_SEG_A, p1, V2_SEG_B); memcpy(all + V2_SEG_A + V2_SEG_B, p2, V2_SEG_C);
+        NSString *dir = p3_dir();
+        if (!dir) { free(all); free(path); free(h0); return; }
+        if (g_v2_files < V2_FILES_MAX) {   // .bin：设备上的 diagrun/
+            snprintf(path, 1200, "%s/lightbuf_f%ld_%llu_%s.bin", dir.UTF8String, f, (unsigned long long)len, stage);
+            FILE *fp = fopen(path, "wb");
+            if (fp) { fwrite(all, 1, tot, fp); fclose(fp); g_v2_files++; }
+            else MLOG("[lightbuf] f=%ld stage=%s cannot write %s", f, stage, path);
+        }
+        if (g_v2_files < V2_FILES_MAX) {   // 同一份字节的 PNG（诊断包只收 *.png）
+            snprintf(path, 1200, "%s/lightbuf_f%ld_%llu_%s.png", dir.UTF8String, f, (unsigned long long)len, stage);
+            if (v2_png(path, all, (int)tot)) { g_v2_files++; MLOG("[lightbuf] f=%ld stage=%s png %s", f, stage, path); }
+            else MLOG("[lightbuf] f=%ld stage=%s cannot write %s", f, stage, path);
+        }
+        free(all); free(path); free(h0);
+    } @catch (NSException *e) { v2_kill_e(e); }
+}
+// 三段各抄一次（每次 ≤256 B）。可用字节 = min(缓冲剩余, guest 绑定剩余)：不足的段只读可用部分，剩下的留 0，并打一行 skip。
+static void v2_read3(id<MTLBuffer> src, uint64_t off, uint64_t len, const char *stage, long f) {
+    if (g_v2_off || !g_commit_blocks || g_v2_queued >= V2_DUMPS_MAX) return;
+    if (!src) { v2_skip(f, stage, len, V2_SEG_ALL, "buffer nil"); return; }
+    @try {
+        uint64_t slen = (uint64_t)src.length;
+        if (off >= slen) { v2_skip(f, stage, len, V2_SEG_A, "offset past the buffer end"); return; }
+        uint64_t room = slen - off;                 // 从 src+off 起真实可读的字节
+        if (len < room) room = len;                 // 且不超过 guest 那边绑定的长度
+        if (!room) { v2_skip(f, stage, len, V2_SEG_A, "no readable bytes"); return; }
+        uint64_t na = room < (uint64_t)V2_SEG_A ? room : (uint64_t)V2_SEG_A;
+        uint64_t nb = (len >= (uint64_t)V2_OFF_B && room > (uint64_t)V2_OFF_B) ? MIN(room - (uint64_t)V2_OFF_B, (uint64_t)V2_SEG_B) : 0;
+        uint64_t nc = (len >= (uint64_t)V2_OFF_C && room > (uint64_t)V2_OFF_C) ? MIN(room - (uint64_t)V2_OFF_C, (uint64_t)V2_SEG_C) : 0;
+        uint64_t need = 0;
+        if (na < (uint64_t)V2_SEG_A) need = V2_SEG_A;
+        else if (nb < (uint64_t)V2_SEG_B) need = (uint64_t)V2_OFF_B + V2_SEG_B;
+        else if (nc < (uint64_t)V2_SEG_C) need = (uint64_t)V2_OFF_C + V2_SEG_C;
+        if (need) v2_skip(f, stage, len, need, "short: reading the available bytes only");
+        id<MTLBuffer> b0 = p3_shared(V2_SEG_A), b1 = p3_shared(V2_SEG_B), b2 = p3_shared(V2_SEG_C);
+        if (!b0 || !b1 || !b2) { v2_skip(f, stage, len, V2_SEG_ALL, "newBufferWithLength returned nil"); return; }
+        uint8_t *q0 = (uint8_t *)b0.contents, *q1 = (uint8_t *)b1.contents, *q2 = (uint8_t *)b2.contents;
+        if (!q0 || !q1 || !q2) { v2_skip(f, stage, len, V2_SEG_ALL, "buffer has no CPU pointer"); return; }
+        memset(q0, 0, V2_SEG_A); memset(q1, 0, V2_SEG_B); memset(q2, 0, V2_SEG_C);
+        if (!g_cb) { v2_skip(f, stage, len, V2_SEG_ALL, "commandBuffer nil"); return; }
+        id<MTL4ComputeCommandEncoder> e = blit();
+        if (!e) { v2_skip(f, stage, len, V2_SEG_ALL, "blitCommandEncoder nil"); return; }
+        enc_b_copy_buffer(e, src, (NSUInteger)off, b0, 0, (NSUInteger)na);
+        if (nb) enc_b_copy_buffer(e, src, (NSUInteger)(off + V2_OFF_B), b1, 0, (NSUInteger)nb);
+        if (nc) enc_b_copy_buffer(e, src, (NSUInteger)(off + V2_OFF_C), b2, 0, (NSUInteger)nc);
+        NSDictionary *j = @{@"b0": b0, @"b1": b1, @"b2": b2, @"f": @(f), @"len": @(len), @"stage": @(stage)};
+        [g_commit_blocks addObject:^{ v2_job(j); }];
+        g_v2_queued++;
+    } @catch (NSException *e) { v2_kill_e(e); }
+}
+static void v2_at_light(NvProg *pr) {
+    if (g_v2_off || !pr || !pr->sh[1]) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (!v2_frame_ok(f) || g_v2_dumps[0] >= V2_PER_STAGE || g_v2_last_frame[0] == f) return;
+    const char *vk = pr->sh[0] ? pr->sh[0]->key : NULL;
+    if (!p3_key_prefix(pr->sh[1]->key, "567fcd0c") && !p3_key_prefix(vk, "567fcd0c")) return;
+    @try {
+        uint64_t off = 0, len = 0;
+        id<MTLBuffer> b = v2_pick_prog(pr, &off, &len, NULL);
+        if (!b || !len) { v2_skip(f, "at_light", len, V2_SEG_A, "no readable sbufp on this pass"); return; }
+        g_v2_pend_buf = b; g_v2_pend_off = off; g_v2_pend_len = len; g_v2_pend_frame = f;
+        g_v2_last_frame[0] = f; g_v2_dumps[0]++;
+    } @catch (NSException *e) { v2_kill_e(e); }
+}
+static void v2_after_cull(NvShader *cs) {
+    if (g_v2_off || !cs || !p3_key_prefix(cs->key, "f9def5d9")) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (!v2_frame_ok(f) || g_v2_dumps[1] >= V2_PER_STAGE || g_v2_last_frame[1] == f) return;
+    @try {
+        uint64_t off = 0, len = 0;
+        id<MTLBuffer> b = v2_pick_sh(cs, 5, &off, &len, NULL);
+        if (!b || !len) { v2_skip(f, "after_cull", len, V2_SEG_A, "no readable sbufp on this dispatch"); return; }
+        g_v2_last_frame[1] = f; g_v2_dumps[1]++;
+        v2_read3(b, off, len, "after_cull", f);
+    } @catch (NSException *e) { v2_kill_e(e); }
+}
+static void v2_pass_end(void) {
+    if (g_v2_off || !g_v2_pend_buf) return;
+    id<MTLBuffer> b = g_v2_pend_buf; uint64_t off = g_v2_pend_off, len = g_v2_pend_len; long f = g_v2_pend_frame;
+    g_v2_pend_buf = nil; g_v2_pend_off = g_v2_pend_len = 0; g_v2_pend_frame = -1;
+    if (f < 0) return;
+    @try { v2_read3(b, off, len, "at_light", f); } @catch (NSException *e) { v2_kill_e(e); }
+}
+
+// ================================================================================================
+// 2026-11-19 p1probe：观测块（[vol] + [cpuwritten]），默认不改变渲染，产物一律落 diagrun/。
+//   [vol]  volumefog clear / injection 两个 compute 之后，把该 dispatch 绑的 8×8×64 3D 体积（froxel 网格）
+//          各读回一次（4096 texel，plain copyFromTexture:…toBuffer: 无 options），打一行 + 落一份 64×64 PNG
+//          （64 张 8×8 切片拼成 64×64 灰度图；诊断包只收 PNG）。触发帧 f>=3600 && f%600==0，每 stage ≤4 帧、
+//          总文件 ≤16。key 名匹配**不写死 key**：第一次用到时扫一遍引擎本来就要读的 shader_map.tsv
+//          （g_shmap_path / DM_NVN_SHMAP），第 4 列 dm_ctl_sha16 → 第 5 列 source 里含
+//          compute_volumefog_clear / compute_volumefog_injection 的 key 学下来，再按 16 位 key 前缀匹配；
+//          拿不到 shader_map（或本作没有这两个名字）就整段不启用、只打一行 —— 绝不猜、绝不写死 serial。
+//   [cpuwritten] 每张 CPU-written 纹理（tex_cpu_written 台账）在**消费点**（绑到纹理槽 / image 槽）登记一次，
+//          pass / dispatch 结束后读回 Metal 首个 texel（≤8B），与 guest 存储首 8B 对照，每 serial 一行、总 ≤16 行。
+//          判据：guest 非 0 而 uploaded 是 0 → 上传/重传丢了；guest 也是 0 → 该由 compute 写，走 dummy / usage 方向。
+//   安全：只在 pass / dispatch 结束、编码器已关时开 copy；每次取值先校验 nil / 长度；整段 @try/@catch，异常只打
+//          一行并永久关闭该探针；不 assert / 不 abort。栈上无 >256B 局部数组（行缓冲 static，路径 heap）。
+// ================================================================================================
+enum { VOL_MAX_KEYS = 2, VOL_MAX_TEX = 2, VOL_MAX_FRAMES = 4, VOL_MAX_FILES = 16,
+       VOL_W = 8, VOL_H = 8, VOL_D = 64, VOL_TEXELS = VOL_W * VOL_H * VOL_D };
+enum { VOL_CLEAR = 0, VOL_INJECTION = 1 };
+static char g_vol_key[VOL_MAX_KEYS][17]; static int g_vol_key_ok[VOL_MAX_KEYS], g_vol_scanned;
+static int g_vol_frames[VOL_MAX_KEYS], g_vol_files, g_vol_off;
+static long g_vol_last[VOL_MAX_KEYS] = {-1, -1};
+static char g_vol_line[4096];
+static int vol_on(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("S2A_VOLPROBE"); v = !(e && *e && !strcmp(e, "0")); }
+    return v;
+}
+static const char *vol_stage_name(int st) { return st == VOL_INJECTION ? "after_injection" : "after_clear"; }
+static int vol_stage_of(const char *key) {
+    if (!key || !*key) return -1;
+    for (int i = 0; i < VOL_MAX_KEYS; i++) if (g_vol_key_ok[i] && !strncmp(key, g_vol_key[i], 16)) return i;
+    return -1;
+}
+static void vol_keys(void) {
+    if (g_vol_scanned) return;
+    g_vol_scanned = 1;
+    shmap_load();   // 引擎本来就要读的 shader_map.tsv（DM_NVN_SHMAP / ../games/<id>/），只读一遍
+    const char *path = g_shmap_path ? g_shmap_path.UTF8String : NULL;
+    if (!path || !*path) { MLOG("[vol] no shader map path: volumefog clear/injection keys unknown, [vol] off"); return; }
+    FILE *fp = fopen(path, "r");
+    if (!fp) { MLOG("[vol] shader map %s unreadable: [vol] off", path); return; }
+    while (fgets(g_vol_line, sizeof g_vol_line, fp)) {
+        if (g_vol_line[0] == '#' || g_vol_line[0] == '\n' || g_vol_line[0] == 'p') continue;   // 注释 / 空行 / 列名
+        char *c[5]; int n = 0; char *q = g_vol_line;
+        c[n++] = q;
+        while (n < 5) { char *t = strchr(q, '\t'); if (!t) break; *t = 0; q = t + 1; c[n++] = q; }
+        if (n < 5) continue;
+        int st = strstr(c[4], "compute_volumefog_clear") ? VOL_CLEAR
+               : strstr(c[4], "compute_volumefog_injection") ? VOL_INJECTION : -1;
+        if (st < 0 || g_vol_key_ok[st] || strlen(c[3]) < 16) continue;
+        snprintf(g_vol_key[st], sizeof g_vol_key[st], "%.16s", c[3]);
+        g_vol_key_ok[st] = 1;
+        MLOG("[vol] key %s = %s (%s)", st == VOL_INJECTION ? "injection" : "clear", g_vol_key[st], c[4]);
+        if (g_vol_key_ok[VOL_CLEAR] && g_vol_key_ok[VOL_INJECTION]) break;
+    }
+    fclose(fp);
+    if (!g_vol_key_ok[VOL_CLEAR] || !g_vol_key_ok[VOL_INJECTION])
+        MLOG("[vol] %s: volumefog clear/injection not both named; missing stage(s) not dumped", path);
+}
+static void vol_kill(const char *why) {
+    if (g_vol_off) return;
+    g_vol_off = 1;
+    MLOG("[vol] disabled after exception: %s", why && *why ? why : "unknown exception");
+}
+// 4096 texel 的 64×64 灰度 PNG：第 z 张 8×8 切片贴到 (z&7, z>>3)；灰度 = p3_texel 的最大 RGB 分量。
+static int vol_png(const char *path, const uint8_t *p, MTLPixelFormat pf, size_t bpp, size_t img) {
+    if (!path || !*path || !p || !bpp || !img) return 0;
+    const int W = VOL_W * VOL_D, H = VOL_H * VOL_D;
+    uint8_t *px = (uint8_t *)calloc((size_t)W * H, 4);
+    if (!px) return 0;
+    for (int z = 0; z < VOL_D; z++) for (int y = 0; y < VOL_H; y++) for (int x = 0; x < VOL_W; x++) {
+        float v = p3_texel(pf, p + (size_t)z * img + ((size_t)y * VOL_W + x) * bpp);
+        int g = (int)(v * 255.0f + 0.5f); if (g < 0) g = 0; if (g > 255) g = 255;
+        uint8_t *q = px + ((size_t)((z >> 3) * VOL_H + y) * W + (z & 7) * VOL_W + x) * 4;
+        q[0] = (uint8_t)g; q[1] = (uint8_t)g; q[2] = (uint8_t)g; q[3] = 255;
+    }
+    CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGContextRef ctx = CGBitmapContextCreate(px, (size_t)W, (size_t)H, 8, (size_t)W * 4, cs, kCGImageAlphaNoneSkipLast | kCGBitmapByteOrder32Little);
+    CGImageRef cgi = ctx ? CGBitmapContextCreateImage(ctx) : NULL;
+    CFURLRef url = CFURLCreateFromFileSystemRepresentation(NULL, (const UInt8 *)path, (long)strlen(path), false);
+    CGImageDestinationRef dst = url ? CGImageDestinationCreateWithURL(url, (__bridge CFStringRef)UTTypePNG.identifier, 1, NULL) : NULL;
+    int ok = 0; if (ctx && cgi && dst) { CGImageDestinationAddImage(dst, cgi, NULL); ok = CGImageDestinationFinalize(dst); }
+    if (dst) CFRelease(dst); if (url) CFRelease(url); CGImageRelease(cgi); CGContextRelease(ctx); CGColorSpaceRelease(cs);
+    free(px);
+    return ok;
+}
+static void vol_job(NSDictionary *j) {
+    if (g_vol_off) return;
+    @try {
+        id<MTLBuffer> b = j[@"buf"]; if (!b) return;
+        const uint8_t *p = (const uint8_t *)b.contents; if (!p) return;
+        MTLPixelFormat pf = (MTLPixelFormat)[j[@"pf"] intValue];
+        size_t bpp = (size_t)[j[@"bpp"] unsignedLongValue];
+        size_t img = (size_t)[j[@"img"] unsignedLongValue];
+        long f = (long)[j[@"f"] longValue];
+        const char *stage = [j[@"stage"] UTF8String]; if (!stage) stage = "-";
+        unsigned long long ser = [j[@"ser"] unsignedLongLongValue];
+        float sum = 0, mean = 0, mx = 0; int nz = 0;
+        for (int z = 0; z < VOL_D; z++) {   // 每张 8×8 切片按 img 的 slice stride 取（bytesPerImage 要对齐 256）
+            float m1 = 0, x1 = 0; int n1 = 0;
+            p3_stats(pf, p + (size_t)z * img, VOL_W * VOL_H, bpp, &m1, &x1, &n1);
+            sum += m1; if (x1 > mx) mx = x1; nz += n1;
+        }
+        mean = sum / (float)VOL_D;
+        char name[96]; snprintf(name, sizeof name, "vol_f%ld_%s_%llu.png", f, stage, ser);
+        char *path = (char *)malloc(1200);
+        if (!path) return;
+        snprintf(path, 1200, "%s/%s", p3_dir().UTF8String, name);
+        if (!vol_png(path, p, pf, bpp, img)) { MLOG("[vol] f=%ld stage=%s ser=%llu skip: cannot write %s", f, stage, ser, path); free(path); return; }
+        MLOG("[vol] f=%ld stage=%s ser=%llu fmt=0x%x 8x8x64 mean=%.6g max=%.6g nz=%d/%d -> %s", f, stage, ser,
+             (unsigned)[j[@"fmt"] unsignedIntValue], mean, mx, nz, VOL_TEXELS, path);
+        free(path);
+    } @catch (NSException *e) { vol_kill(e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+// dispatch 结束处调用（计算编码器还开着，blit() 按既有探针的方式插入 barrier 后开 copy；与 [hiz] 同一条路）
+static void vol_after_dispatch(NvShader *cs) {
+    if (g_vol_off || !cs || !vol_on()) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f < 3600 || (f % 600) != 0) return;
+    vol_keys();
+    int st = vol_stage_of(cs->key);
+    if (st < 0 || g_vol_frames[st] >= VOL_MAX_FRAMES || g_vol_last[st] == f || g_vol_files >= VOL_MAX_FILES) return;
+    @try {
+        __strong id<MTLTexture> vt[VOL_MAX_TEX] = {nil, nil};
+        unsigned long long vser[VOL_MAX_TEX] = {0, 0};
+        unsigned vfmt[VOL_MAX_TEX] = {0, 0};
+        int n = 0;
+        pthread_mutex_lock(&g_rmu);
+        for (int i = 0; i < cs->rf.nb && n < VOL_MAX_TEX; i++) {
+            const nvn_rbind *b = &cs->rf.b[i];
+            int tid = -1;
+            if (b->kind == NVN_RB_TEX || b->kind == NVN_RB_TEXU || b->kind == NVN_RB_TBUF || b->kind == NVN_RB_TBUFU) tid = p3_tex_tid(5, b);
+            else if (b->kind == NVN_RB_IMG || b->kind == NVN_RB_IMGU) tid = img_tid(b, 5);
+            if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+            const tex_t *ct = &g_treg[tid].t;
+            id<MTLTexture> t = tex_mtl(ct);
+            if (!t || t.textureType != MTLTextureType3D || t.width != VOL_W || t.height != VOL_H || t.depth != VOL_D) continue;
+            int dup = 0; for (int k = 0; k < n; k++) if (vser[k] == ct->serial) dup = 1;
+            if (dup) continue;
+            vt[n] = t; vser[n] = ct->serial; vfmt[n] = ct->d.format; n++;
+        }
+        pthread_mutex_unlock(&g_rmu);
+        if (!n) {
+            static int once[VOL_MAX_KEYS];
+            if (!once[st]++) MLOG("[vol] f=%ld stage=%s skip: no 8x8x64 3D volume bound", f, vol_stage_name(st));
+            return;
+        }
+        const char *stage = vol_stage_name(st);
+        g_vol_frames[st]++; g_vol_last[st] = f;
+        for (int k = 0; k < n && g_vol_files < VOL_MAX_FILES; k++) {
+            size_t bpp = mtl_pf_bytes(vt[k].pixelFormat);
+            if (!bpp || bpp > 8) { MLOG("[vol] f=%ld stage=%s ser=%llu skip: unsupported texel size %lu", f, stage, vser[k], (unsigned long)bpp); continue; }
+            if (!g_commit_blocks) return;
+            size_t row = VOL_W * bpp;
+            size_t img = ((row * VOL_H + 255) / 256) * 256;   // bytesPerImage 按 256 对齐（3D 拷贝的要求）
+            size_t total = img * VOL_D;
+            id<MTLBuffer> rb = [g_dev newBufferWithLength:total options:MTLResourceStorageModeShared];
+            if (!rb) { MLOG("[vol] f=%ld stage=%s ser=%llu skip: newBufferWithLength(%lu) nil", f, stage, vser[k], (unsigned long)total); continue; }
+            id<MTL4ComputeCommandEncoder> e = blit();
+            if (!e) { MLOG("[vol] f=%ld stage=%s ser=%llu skip: blitCommandEncoder nil", f, stage, vser[k]); continue; }
+            [e copyFromTexture:vt[k] sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(VOL_W, VOL_H, VOL_D)
+                      toBuffer:rb destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:img];
+            res_add(rb);
+            NSDictionary *j = @{@"buf": rb, @"f": @(f), @"stage": @(stage), @"ser": @(vser[k]), @"fmt": @(vfmt[k]),
+                                @"pf": @((int)vt[k].pixelFormat), @"bpp": @(bpp), @"img": @(img)};
+            [g_commit_blocks addObject:^{ vol_job(j); }];
+            g_vol_files++;
+        }
+    } @catch (NSException *e) { vol_kill(e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+// ---- [cpuwritten]：消费点登记（只入队，不开编码器），pass / dispatch 末尾统一读回 ----
+enum { CPUW_MAX = 16 };
+static int cpuw_on(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("S2A_CPUW"); v = !(e && *e && !strcmp(e, "0")); }
+    return v;
+}
+static uint64_t g_cpuw_seen[CPUW_MAX]; static int g_cpuw_nseen, g_cpuw_queued;
+static NSMutableArray *g_cpuw_pending;
+static void cpuw_job(NSDictionary *j) {
+    @try {
+        id<MTLBuffer> b = j[@"buf"]; if (!b) return;
+        const uint8_t *p = (const uint8_t *)b.contents; if (!p) return;
+        size_t bpp = (size_t)[j[@"bpp"] unsignedLongValue];
+        int n = (int)(bpp < 8 ? bpp : 8);
+        char uh[17]; int uz = 1;
+        for (int i = 0; i < n; i++) { snprintf(uh + 2 * i, 3, "%02x", p[i]); if (p[i]) uz = 0; }
+        uh[2 * n] = 0;
+        MLOG("[cpuwritten] ser=%llu fmt=0x%x %ux%ux%u guest=%s guest_zero=%d as_f32=(%g,%g) uploaded=%s uploaded_zero=%d",
+             (unsigned long long)[j[@"ser"] unsignedLongLongValue], (unsigned)[j[@"fmt"] unsignedIntValue],
+             (unsigned)[j[@"w"] unsignedIntValue], (unsigned)[j[@"h"] unsignedIntValue], (unsigned)[j[@"d"] unsignedIntValue],
+             [j[@"guest"] UTF8String], [j[@"gz"] intValue], [j[@"f0"] floatValue], [j[@"f1"] floatValue], uh, uz);
+    } @catch (NSException *e) { static int once; if (!once++) MLOG("[cpuwritten] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+static void cpuw_note(int stage, int reg, int tid, id<MTLTexture> t) {
+    if (!cpuw_on() || !t || tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) return;
+    const tex_t *ct = &g_treg[tid].t;
+    if (!tex_cpu_written(ct->serial)) return;
+    for (int i = 0; i < g_cpuw_nseen; i++) if (g_cpuw_seen[i] == ct->serial) return;
+    if (g_cpuw_nseen >= CPUW_MAX) return;
+    g_cpuw_seen[g_cpuw_nseen++] = ct->serial;
+    const uint8_t *gp = ct->mem; uint64_t gs = ct->L.size;
+    int gn = gp && gs ? (int)(gs < 8 ? gs : 8) : 0;
+    char gh[17]; int gz = 1; gh[0] = 0;
+    for (int i = 0; i < gn; i++) { snprintf(gh + 2 * i, 3, "%02x", gp[i]); if (gp[i]) gz = 0; }
+    if (!gn) { snprintf(gh, sizeof gh, "-"); gz = 0; } else gh[2 * gn] = 0;
+    float f0 = 0, f1 = 0; if (gn >= 8) { memcpy(&f0, gp, 4); memcpy(&f1, gp + 4, 4); }
+    if (!g_cpuw_pending) g_cpuw_pending = [NSMutableArray array];
+    [g_cpuw_pending addObject:@[t, @(ct->serial), @(ct->d.format), @(ct->d.width), @(ct->d.height), @(ct->d.depth),
+                                @(stage), @(reg), [NSString stringWithUTF8String:gh], @(gz), @(f0), @(f1)]];
+}
+static void cpuw_flush(void) {
+    if (!cpuw_on() || !g_cpuw_pending.count) return;
+    @try {
+        NSArray *jobs = [g_cpuw_pending copy];
+        [g_cpuw_pending removeAllObjects];
+        for (NSArray *e in jobs) {
+            if (g_cpuw_queued >= CPUW_MAX || !g_commit_blocks) break;
+            id<MTLTexture> t = e[0];
+            size_t bpp = t ? mtl_pf_bytes(t.pixelFormat) : 0;
+            if (!t || !bpp || bpp > 16) continue;
+            id<MTLBuffer> b = [g_dev newBufferWithLength:bpp options:MTLResourceStorageModeShared];
+            if (!b) continue;
+            id<MTL4ComputeCommandEncoder> enc = blit();
+            if (!enc) continue;
+            [enc copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(1, 1, 1)
+                        toBuffer:b destinationOffset:0 destinationBytesPerRow:bpp destinationBytesPerImage:bpp];
+            res_add(b);
+            NSDictionary *j = @{@"buf": b, @"ser": e[1], @"fmt": e[2], @"w": e[3], @"h": e[4], @"d": e[5],
+                                @"stage": e[6], @"reg": e[7], @"guest": e[8], @"gz": e[9], @"f0": e[10], @"f1": e[11], @"bpp": @(bpp)};
+            [g_commit_blocks addObject:^{ cpuw_job(j); }];
+            g_cpuw_queued++;
+        }
+    } @catch (NSException *e) {
+        static int once;
+        if (!once++) MLOG("[cpuwritten] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception");
+    }
+}
+
+// ================================================================================================
+// 2026-11-19 aplan：观测 + A 线候选修复（只改宿主 nvn_mtl.m；默认渲染只在 A 线候选修复上不同）。
+//   [imgbind]  每条 image 声明一行（key/stage/decl_idx 去重，总 ≤32）：decl_idx = reg（0 起算）、nvn_reg、
+//              desc_off = c2 里的字节偏移（IMG: C2_IMG + 8*reg；IMGU: 普通缓冲里的 off）、tid/ser/fmt/尺寸/类型/
+//              声明的像素类、real（表里有真纹理）、view（最终绑的是视图不是基纹理）、lookup（img / tex / none，按
+//              S2A_IMGLUT 实际走的那张表）、img_tbl_has（img[reg] 是否有句柄）。
+//   【红】     image 槽拿到块压缩基纹理（mtl_pf_bytes(fmt)==0 或 guest 格式压缩）：只报第一次。
+//   [imglut]  每个 (key, stage) 一次：选表结果；可写 image 槽压缩基纹理“按原样绑”时再一行。
+//   [cs]      每 600 帧一行：所有 compute key 的次数（最多 24 个，按次数降序）。
+//   [cube]    光照遍（567fcd0c）**首次**绑到 512×512 cube（宿主建成 6 层 2D 数组）时把 6 个面各 dump 一次，全局只做 1 次；
+//             整局没遇到 → 会话结束 / exit 时一行 `[cube] never bound a 512 cube at the lighting pass`。
+//   [share]   同存储共享（S2A_TEXSHARE=1）：每个区间一行（≤16）+ 每新增一个共享者一行；[sharechk] 对 post_tonemap / chr_skin 的
+//             1×1（及 8×8×64）各打一次「读方值 vs 写方值」；[imgfit] 在共享 base 上按字节宽建整数视图（RG32Float 8B → RG32Uint）。
+//   [vol]     同一遍绑到 8×8×64 3D 体积时（stage=at_light）各 dump 一次（不是 after_injection）。
+//   [tonemapin] post_tonemap 读的 1×1，每 600 帧一次（≤4 次）：前 4 个 float + zero。
+//   安全：所有读回都在 pass 结束、编码器已关时开；取值先判 nil / 长度；整段 @try/@catch，异常只永久关闭该探针；
+//         不 assert / 不 abort。产物一律 diagrun/。栈数组 ≤256B，小读回缓冲 16B，大 dump 按纹理尺寸（cube 6 面）。
+// ================================================================================================
+enum { AP_IB_MAX = 32, AP_GL_MAX = 24, AP_CUBE_FILES = 8, AP_VOL_FILES = 4, AP_TM_MAX = 4,
+       AP_CUBE_SIDE = 512, AP_CUBE_FACE_BYTES_MAX = AP_CUBE_SIDE * AP_CUBE_SIDE * 4 };
+static char ap_ib_key[AP_IB_MAX][24]; static unsigned char ap_ib_st[AP_IB_MAX]; static short ap_ib_decl[AP_IB_MAX]; static int ap_ib_n;
+static char ap_gl_key[AP_GL_MAX][24]; static unsigned char ap_gl_st[AP_GL_MAX]; static int ap_gl_n;
+static int ap_cube_off, ap_vol_off, ap_tm_off, ap_img_off;
+static int ap_cube_done, ap_vol_done, ap_tm_queued, ap_files;
+static char ap_line[1024];
+static NSMutableArray *ap_cube_pend, *ap_vol_pend, *ap_tm_pend;
+
+static int ap_seen2(char (*tab)[24], unsigned char *sts, int *n, int max, const char *k, int st) {
+    if (!k) k = "-";
+    if (*n >= max) return 1;
+    for (int i = 0; i < *n; i++) if (sts[i] == (unsigned char)st && !strncmp(tab[i], k, 23)) return 1;
+    if (*n < max) { snprintf(tab[*n], 24, "%.23s", k); sts[*n] = (unsigned char)st; (*n)++; }
+    return 0;
+}
+static int ap_ib_seen(const char *k, int st, int decl) {
+    if (!k) k = "-";
+    if (ap_ib_n >= AP_IB_MAX) return 1;   // 总 ≤32 行
+    for (int i = 0; i < ap_ib_n; i++) if (ap_ib_st[i] == (unsigned char)st && ap_ib_decl[i] == (short)decl && !strncmp(ap_ib_key[i], k, 23)) return 1;
+    if (ap_ib_n < AP_IB_MAX) { snprintf(ap_ib_key[ap_ib_n], 24, "%.23s", k); ap_ib_st[ap_ib_n] = (unsigned char)st; ap_ib_decl[ap_ib_n] = (short)decl; ap_ib_n++; }
+    return 0;
+}
+// 红行：压缩基纹理进 image 槽（只报第一次）
+static void ap_img_red_compressed(NvShader *sh, int st, int reg, int tid, id<MTLTexture> base) {
+    if (ap_img_off || !base) return;
+    static int once;
+    if (once++) return;
+    unsigned long long ser = (tid >= 0 && tid < g_ntreg && g_treg[tid].ok) ? (unsigned long long)g_treg[tid].t.serial : 0ull;
+    snprintf(ap_line, sizeof ap_line, "【红】image slot gets a block-compressed texture: key=%s st=%d reg=%d tid=%d fmt=%lu ser=%llu",
+             sh ? sh->key : "-", st, reg, tid, (unsigned long)base.pixelFormat, ser);
+    MLOG("%s", ap_line);
+}
+// 红行：image 槽未绑定（img[reg] 为空；不回退 tex）
+static void ap_img_red_unbound(NvShader *sh, int st, int reg, int tid) {
+    if (ap_img_off) return;
+    static int n;
+    if (n >= 8) return;
+    n++;
+    snprintf(ap_line, sizeof ap_line, "【红】image slot unbound: key=%s st=%d reg=%d tid=%d", sh ? sh->key : "-", st, reg, tid);
+    MLOG("%s", ap_line);
+}
+// 压缩基纹理不能建视图：按原样绑（不是 dummy），每 key 一次
+static void ap_img_compressed_bound(NvShader *sh, int st, int reg, int tid) {
+    if (ap_img_off) return;
+    static char tab[8][24]; static unsigned char sts[8]; static int n;
+    if (ap_seen2(tab, sts, &n, 8, sh ? sh->key : "-", st)) return;
+    MLOG("[imglut] compressed base, bound as is (key %s, stage %d, reg %d, tid %d)", sh ? sh->key : "-", st, reg, tid);
+}
+static void ap_imglut_line(NvShader *sh, int st, const nvn_rbind *b, int chose, int tid, id<MTLTexture> base) {
+    if (ap_img_off || !sh || !b) return;
+    @try {
+    if (ap_seen2(ap_gl_key, ap_gl_st, &ap_gl_n, AP_GL_MAX, sh->key, st)) return;
+    int decl = img_decl_idx((int)b->reg);
+    const tex_t *bt = (tid >= 0 && tid < g_ntreg && g_treg[tid].ok) ? &g_treg[tid].t : NULL;
+    unsigned long long ser = bt ? (unsigned long long)bt->serial : 0ull;
+    unsigned long fmt = base ? (unsigned long)base.pixelFormat : 0;
+    unsigned long w = base ? (unsigned long)base.width : 0, h = base ? (unsigned long)base.height : 0;
+    snprintf(ap_line, sizeof ap_line, "[imglut] key=%s st=%d reg=%d decl_idx=%d chose=%s tid=%d ser=%llu fmt=0x%lx %lux%lu",
+             sh ? sh->key : "-", st, (int)b->reg, decl, chose == 0 ? "img" : chose == 1 ? "tex" : "none", tid, ser, fmt, w, h);
+    MLOG("%s", ap_line);
+    } @catch (NSException *e) { ap_img_off = 1; MLOG("[imglut] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+static void img_probe_bind(NvShader *sh, int st, const nvn_rbind *b, int tid, int chose, id<MTLTexture> base, id<MTLTexture> bound) {
+    if (ap_img_off || !sh || !b) return;
+    @try {
+    int decl = img_decl_idx((int)b->reg);
+    if (ap_ib_seen(sh->key, st, decl)) return;
+    const tex_t *bt = (tid >= 0 && tid < g_ntreg && g_treg[tid].ok) ? &g_treg[tid].t : NULL;
+    unsigned long long ser = bt ? (unsigned long long)bt->serial : 0ull;
+    unsigned long fmt = base ? (unsigned long)base.pixelFormat : (bound ? (unsigned long)bound.pixelFormat : 0);
+    unsigned long w = bound ? (unsigned long)bound.width : base ? (unsigned long)base.width : 0;
+    unsigned long h = bound ? (unsigned long)bound.height : base ? (unsigned long)base.height : 0;
+    unsigned long ty = bound ? (unsigned long)bound.textureType : 0;
+    unsigned desc = b->kind == NVN_RB_IMGU ? (unsigned)b->off : (unsigned)(C2_IMG + 8 * (decl < 0 ? 0 : decl));
+    int tbl = (b->kind == NVN_RB_IMG && b->reg < 32 && S.img[st][b->reg]) ? 1 : 0;
+    snprintf(ap_line, sizeof ap_line,
+             "[imgbind] key=%s st=%d decl_idx=%d nvn_reg=%d desc_off=0x%x tid=%d ser=%llu fmt=0x%lx %lux%lu type=%lu class=%d real=%d view=%d lookup=%s img_tbl_has=%d",
+             sh ? sh->key : "-", st, decl, (int)b->reg, desc, tid, ser, fmt, w, h, ty, (int)b->dpf,
+             base ? 1 : 0, (base && bound && bound != base && bound.parentTexture == base) ? 1 : 0, chose == 0 ? "img" : chose == 1 ? "tex" : "none", tbl);
+    MLOG("%s", ap_line);
+    } @catch (NSException *e) { ap_img_off = 1; MLOG("[imgbind] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+// ---- [sharechk]：共享区间里「读方值 vs 写方值」的一次性核对（post_tonemap / chr_skin；≤8 个区间）----
+//   判据：`[share] +tid=…` 与 `[sharechk] … same=1` 同时出现，且 reader_val 从 0 变成非 0（1×1 角色 / 上屏；8×8×64 房间环境光）。
+//   读回仍在 pass / dispatch 末尾、编码器关掉之后做（与 [cpuwritten] 同一处），不 assert / 不 abort，产物照旧只在日志里。
+enum { SHCHK_MAX = 8 };
+static NSMutableArray *g_shchk_pend;
+static uint64_t g_shchk_span[SHCHK_MAX]; static int g_shchk_n;
+static char g_shk_tm[17], g_shk_skin[17]; static int g_shk_scanned;
+static void shchk_keys(void) {   // 从 shader_map.tsv 认 post_tonemap / chr_skin 的 key（与 [tonemapin] 同源，不写死 serial / key）
+    if (g_shk_scanned) return;
+    g_shk_scanned = 1;
+    shmap_load();
+    const char *path = g_shmap_path ? g_shmap_path.UTF8String : NULL;
+    if (!path || !*path) { MLOG("[sharechk] no shader map path: off"); return; }
+    FILE *fp = fopen(path, "r");
+    if (!fp) { MLOG("[sharechk] shader map %s unreadable: off", path); return; }
+    char ln[4096];
+    while (fgets(ln, sizeof ln, fp)) {
+        if (ln[0] == '#' || ln[0] == '\n' || ln[0] == 'p') continue;
+        char *c[5]; int n = 0; char *q = ln; c[n++] = q;
+        while (n < 5) { char *t = strchr(q, '\t'); if (!t) break; *t = 0; q = t + 1; c[n++] = q; }
+        if (n < 5 || strlen(c[3]) < 16) continue;
+        if (!g_shk_tm[0] && strstr(c[4], "post_tonemap") && !strstr(c[4], "post_tonemap_update")) snprintf(g_shk_tm, sizeof g_shk_tm, "%.16s", c[3]);
+        if (!g_shk_skin[0] && strstr(c[4], "chr_skin")) snprintf(g_shk_skin, sizeof g_shk_skin, "%.16s", c[3]);
+    }
+    fclose(fp);
+    MLOG("[sharechk] keys: post_tonemap=%s chr_skin=%s", g_shk_tm[0] ? g_shk_tm : "-", g_shk_skin[0] ? g_shk_skin : "-");
+}
+static int shchk_want(NvShader *sh) {
+    if (!sh || !sh->key[0]) return 0;
+    shchk_keys();
+    return (g_shk_tm[0] && p3_key_prefix(sh->key, g_shk_tm)) || (g_shk_skin[0] && p3_key_prefix(sh->key, g_shk_skin));
+}
+static void sharechk_note(NvShader *sh, int st, int reg, int tid, id<MTLTexture> t, const tex_t *ct) {
+    if (!t || !ct || g_shchk_n >= SHCHK_MAX) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f <= 0 || (f % 600) != 0) return;
+    if (!shchk_want(sh)) return;
+    int is1 = t.textureType != MTLTextureType3D && t.width == 1 && t.height == 1;
+    int isvol = t.textureType == MTLTextureType3D && t.width == 8 && t.height == 8 && t.depth == 64;
+    if (!is1 && !isvol) return;
+    @try {
+        share_key k; if (!share_span_of(ct, &k)) return;
+        uint64_t tag = ((uint64_t)k.pool * 1315423911ull) ^ ((uint64_t)k.off << 17) ^ k.size;
+        for (int i = 0; i < g_shchk_n; i++) if (g_shchk_span[i] == tag) return;   // 每个区间一次
+        char ids[256]; uint64_t wser = 0; id wt = nil;
+        pthread_mutex_lock(&g_shmu);
+        share_ent *e = share_find(&k);
+        ids[0] = 0;
+        if (e) {
+            wt = share_obj(e->canon);
+            int wi = -1;
+            for (uint32_t i = 0; i < e->n; i++) if ((e->a[i].flags & NVN_TEXTURE_FLAGS_IMAGE) && e->a[i].ser != ct->serial) { wi = (int)i; break; }
+            if (wi < 0) for (uint32_t i = 0; i < e->n; i++) if (e->a[i].ser != ct->serial) wi = (int)i;
+            if (wi >= 0) wser = e->a[wi].ser;
+            size_t o = 0;
+            for (uint32_t i = 0; i < e->n && o < sizeof ids - 40; i++)
+                o += (size_t)snprintf(ids + o, sizeof ids - o, "%s%u:%llu", i ? ", " : "", (unsigned)e->a[i].tid, (unsigned long long)e->a[i].ser);
+        }
+        pthread_mutex_unlock(&g_shmu);
+        if (!ids[0]) snprintf(ids, sizeof ids, "%d:%llu", tid, (unsigned long long)ct->serial);
+        g_shchk_span[g_shchk_n++] = tag;
+        if (!g_shchk_pend) g_shchk_pend = [NSMutableArray array];
+        [g_shchk_pend addObject:@[t, wt ? wt : (id)[NSNull null], @(ct->serial), @(wser), @(k.off), @(k.size), [NSString stringWithUTF8String:ids], @(f)]];
+    } @catch (NSException *ex) { g_shchk_n = SHCHK_MAX; MLOG("[sharechk] disabled after exception: %s", ex.reason ? ex.reason.UTF8String : "unknown exception"); }
+}
+static void shchk_job(NSDictionary *j) {
+    @try {
+        id<MTLBuffer> b = j[@"buf"]; if (!b) return;
+        const uint8_t *p = (const uint8_t *)b.contents; if (!p) return;
+        size_t bpp = (size_t)[j[@"bpp"] unsignedLongValue]; int vol = (int)[j[@"vol"] intValue], same = (int)[j[@"same"] intValue];
+        float rv[2] = {0, 0}, wv[2] = {0, 0};
+        if (bpp >= 8) memcpy(rv, p, 8); else { memcpy(&rv[0], p, bpp); if (vol) memcpy(&rv[1], p + bpp, bpp); }
+        if (same) { wv[0] = rv[0]; wv[1] = rv[1]; }
+        else if (bpp >= 8) memcpy(wv, p + 2 * bpp, 8); else { memcpy(&wv[0], p + 2 * bpp, bpp); if (vol) memcpy(&wv[1], p + 3 * bpp, bpp); }
+        MLOG("[sharechk] span=0x%llx+%llu ser=%llu ids=[%s] reader_val=(%g,%g) writer_ser=%llu writer_val=(%g,%g) same=%d",
+             (unsigned long long)[j[@"off"] unsignedLongLongValue], (unsigned long long)[j[@"size"] unsignedLongLongValue],
+             (unsigned long long)[j[@"ser"] unsignedLongLongValue], [j[@"ids"] UTF8String], rv[0], rv[1],
+             (unsigned long long)[j[@"wser"] unsignedLongLongValue], wv[0], wv[1], same);
+    } @catch (NSException *ex) { static int once; if (!once++) MLOG("[sharechk] disabled after exception: %s", ex.reason ? ex.reason.UTF8String : "unknown exception"); }
+}
+static void sharechk_flush(void) {
+    if (!g_shchk_pend.count || !g_commit_blocks) return;
+    @try {
+        NSArray *jobs = [g_shchk_pend copy]; [g_shchk_pend removeAllObjects];
+        for (NSArray *e in jobs) {
+            id<MTLTexture> rt = e[0]; if (!rt) continue;
+            id wt = (e[1] == [NSNull null]) ? nil : e[1];
+            size_t bpp = mtl_pf_bytes(rt.pixelFormat); if (!bpp || bpp > 8) continue;
+            int vol = rt.textureType == MTLTextureType3D;
+            id<MTLBuffer> b = [g_dev newBufferWithLength:bpp * 4 options:MTLResourceStorageModeShared];
+            if (!b) continue;
+            id<MTL4ComputeCommandEncoder> enc = blit(); if (!enc) continue;
+            [enc copyFromTexture:rt sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(1, 1, 1)
+                        toBuffer:b destinationOffset:0 destinationBytesPerRow:bpp destinationBytesPerImage:bpp];
+            if (vol) [enc copyFromTexture:rt sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 32) sourceSize:MTLSizeMake(1, 1, 1)
+                                 toBuffer:b destinationOffset:bpp destinationBytesPerRow:bpp destinationBytesPerImage:bpp];
+            int same = wt && wt == rt;
+            if (wt && !same) {
+                [enc copyFromTexture:wt sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(1, 1, 1)
+                            toBuffer:b destinationOffset:2 * bpp destinationBytesPerRow:bpp destinationBytesPerImage:bpp];
+                if (vol) [enc copyFromTexture:wt sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 32) sourceSize:MTLSizeMake(1, 1, 1)
+                                     toBuffer:b destinationOffset:3 * bpp destinationBytesPerRow:bpp destinationBytesPerImage:bpp];
+            }
+            res_add(b);
+            NSDictionary *j = @{@"buf": b, @"bpp": @(bpp), @"vol": @(vol), @"same": @(same), @"ser": e[2], @"wser": e[3],
+                                @"off": e[4], @"size": e[5], @"ids": e[6]};
+            [g_commit_blocks addObject:^{ shchk_job(j); }];
+        }
+    } @catch (NSException *ex) { g_shchk_n = SHCHK_MAX; MLOG("[sharechk] disabled after exception: %s", ex.reason ? ex.reason.UTF8String : "unknown exception"); }
+}
+// ---- [cs]：compute key 计数（每 600 帧一行，最多列 24 个）----
+static struct { char key[24]; unsigned long n; } ap_cs[64]; static int ap_cs_n; static unsigned long long ap_cs_total; static long ap_cs_f = -1; static int ap_cs_off;
+static void cs_count(NvShader *cs) {
+    if (ap_cs_off || !cs) return;
+    @try {
+    int i = 0; for (; i < ap_cs_n; i++) if (!strncmp(ap_cs[i].key, cs->key, 23)) break;
+    if (i == ap_cs_n) { if (ap_cs_n >= 64) return; snprintf(ap_cs[ap_cs_n].key, 24, "%.23s", cs->key); ap_cs[ap_cs_n].n = 0; ap_cs_n++; }
+    ap_cs[i].n++; ap_cs_total++;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f <= 0 || (f % 600) != 0 || f == ap_cs_f || !ap_cs_n) return;
+    ap_cs_f = f;
+    int idx[64]; for (int k = 0; k < ap_cs_n; k++) idx[k] = k;
+    int top = ap_cs_n < 24 ? ap_cs_n : 24;
+    for (int a = 0; a < top; a++) for (int c = a + 1; c < ap_cs_n; c++)
+        if (ap_cs[idx[c]].n > ap_cs[idx[a]].n) { int t = idx[a]; idx[a] = idx[c]; idx[c] = t; }
+    static char ln[2048]; size_t o = 0; ln[0] = 0;
+    for (int a = 0; a < top && o < sizeof ln - 40; a++)
+        o += (size_t)snprintf(ln + o, sizeof ln - o, "%s%.23s:%lu", a ? ", " : "", ap_cs[idx[a]].key, ap_cs[idx[a]].n);
+    MLOG("[cs] f=%ld total=%llu top=%s", f, ap_cs_total, ln);
+    } @catch (NSException *e) { ap_cs_off = 1; MLOG("[cs] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+// ---- S2A_OVR145：白色 cube（6 面全 (1,1,1,1)）----
+static id<MTLTexture> ovr_white_cube(void) {
+    static __strong id<MTLTexture> t;
+    if (t) return t;
+    @try {
+        MTLTextureDescriptor *d = [MTLTextureDescriptor textureCubeDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm size:1 mipmapped:NO];
+        if (!d) return nil;
+        d.usage = MTLTextureUsageShaderRead; d.storageMode = MTLStorageModeShared;
+        t = [g_dev newTextureWithDescriptor:d];
+        if (!t) { static int once; if (!once++) MLOG("[ovr] white cube creation failed"); return nil; }
+        uint8_t px[4] = {255, 255, 255, 255};
+        for (int i = 0; i < 6; i++) [t replaceRegion:MTLRegionMake3D(0, 0, 0, 1, 1, 1) mipmapLevel:0 slice:(NSUInteger)i withBytes:px bytesPerRow:4 bytesPerImage:4];
+        res_add(t);
+    } @catch (NSException *e) { MLOG("[ovr] white cube failed: %s", e.reason ? e.reason.UTF8String : "exception"); return nil; }
+    return t;
+}
+// ---- 光照遍：512×512 cube / 8×8×64 体积排队（pass 结束再读回）----
+static int ap_tex_tid(const nvn_rbind *b, int st) {
+    switch (b->kind) {
+        case NVN_RB_TEX: case NVN_RB_TBUF: return (int)(tex_slot_h(S.tex[st], S.img[st], b->reg) & 0xfffff);
+        case NVN_RB_TEXU: case NVN_RB_TBUFU: return ubo_tex_id(ubo_packed(st, b));
+        case NVN_RB_IMG: case NVN_RB_IMGU: return img_tid(b, st);
+        default: return -1;
+    }
+}
+// 光照遍的 512×512 cube：宿主把 NVN cube 建成了 6 层 2D 数组（tex_desc target 8），原来判 `textureType==Cube` 永远不成立 → 整局 0 行。
+//   现在认 cube / cube array / 6 层以上 2D 数组，并且着色器声明的是 cube（dtt），**首次遇到就排队 dump**（不再等 f>=3600），全局只做 1 次。
+static int ap_cube512(id<MTLTexture> t, const nvn_rbind *b) {
+    if (!t || t.width != AP_CUBE_SIDE || t.height != AP_CUBE_SIDE) return 0;
+    int cube_decl = b && ((MTLTextureType)b->dtt == MTLTextureTypeCube || (MTLTextureType)b->dtt == MTLTextureTypeCubeArray);
+    if (!cube_decl) return 0;
+    return t.textureType == MTLTextureTypeCube || t.textureType == MTLTextureTypeCubeArray
+        || (t.textureType == MTLTextureType2DArray && t.arrayLength >= 6);
+}
+static void ap_note_light(NvProg *pr) {
+    if (ap_cube_off && ap_vol_off) return;
+    if (!pr || (!pr->sh[0] && !pr->sh[1])) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    int vol_due = !ap_vol_off && f >= 3600 && (f % 1800) == 0;   // [vol] 的节奏不变
+    if (ap_cube_done && !vol_due) return;
+    const char *k0 = pr->sh[0] ? pr->sh[0]->key : NULL, *k1 = pr->sh[1] ? pr->sh[1]->key : NULL;
+    if (!p3_key_prefix(k1, "567fcd0c") && !p3_key_prefix(k0, "567fcd0c")) return;
+    @try {
+        for (int si = 0; si < 2; si++) {
+            NvShader *sh = pr->sh[si]; if (!sh) continue;
+            for (int i = 0; i < sh->rf.nb; i++) {
+                const nvn_rbind *b = &sh->rf.b[i];
+                int tid = ap_tex_tid(b, si); if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+                const tex_t *ct = &g_treg[tid].t; id<MTLTexture> t = tex_mtl(ct); if (!t) continue;
+                if (!ap_cube_done && !ap_cube_off && ap_cube512(t, b)) {   // 首次遇到就 dump（见 ap_cube512）
+                    if (!ap_cube_pend) ap_cube_pend = [NSMutableArray array];
+                    [ap_cube_pend addObject:@[t, @((unsigned long long)ct->serial), @((unsigned)ct->d.format), @((int)t.pixelFormat), @(f)]];
+                    ap_cube_done = 1;
+                }
+                if (vol_due && !ap_vol_done && t.textureType == MTLTextureType3D && t.width == 8 && t.height == 8 && t.depth == 64) {
+                    if (!ap_vol_pend) ap_vol_pend = [NSMutableArray array];
+                    int dup = 0; for (NSArray *e in ap_vol_pend) if ([e[1] unsignedLongLongValue] == (unsigned long long)ct->serial) { dup = 1; break; }
+                    if (!dup && ap_vol_pend.count < 2) [ap_vol_pend addObject:@[t, @((unsigned long long)ct->serial), @((unsigned)ct->d.format), @((int)t.pixelFormat), @(f)]];
+                }
+            }
+        }
+        if (ap_vol_pend.count) ap_vol_done = 1;
+    } @catch (NSException *e) {
+        ap_cube_off = ap_vol_off = 1;
+        MLOG("[cube] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception");
+    }
+}
+// 会话结束 / exit 时一行：整局都没遇到 512 cube；以及共享汇总（spans / reused / upgrades / cannot）
+static void ap_finish_report(void) {
+    static int once;
+    if (once++) return;
+    if (!ap_cube_done && !ap_cube_off) MLOG("[cube] never bound a 512 cube at the lighting pass");
+    if (share_on()) MLOG("[share] done: spans=%u reused=%u upgrades=%u cannot=%u", g_share_spans, g_share_reused, g_share_upgrades, g_share_bad_lines);
+}
+// ---- [tonemapin]：post_tonemap 读的 1×1 ----
+static char ap_tm_key[17]; static int ap_tm_scanned;
+static void ap_tonemap_key(void) {
+    if (ap_tm_scanned) return;
+    ap_tm_scanned = 1;
+    shmap_load();
+    const char *path = g_shmap_path ? g_shmap_path.UTF8String : NULL;
+    if (!path || !*path) { MLOG("[tonemapin] no shader map path: off"); ap_tm_off = 1; return; }
+    FILE *fp = fopen(path, "r");
+    if (!fp) { MLOG("[tonemapin] shader map %s unreadable: off", path); ap_tm_off = 1; return; }
+    char ln[4096];
+    while (fgets(ln, sizeof ln, fp)) {
+        if (ln[0] == '#' || ln[0] == '\n' || ln[0] == 'p') continue;
+        char *c[5]; int n = 0; char *q = ln;
+        c[n++] = q;
+        while (n < 5) { char *t = strchr(q, '\t'); if (!t) break; *t = 0; q = t + 1; c[n++] = q; }
+        if (n < 5 || !strstr(c[4], "post_tonemap") || strstr(c[4], "post_tonemap_update")) continue;
+        if (strlen(c[3]) >= 16) { snprintf(ap_tm_key, sizeof ap_tm_key, "%.16s", c[3]); MLOG("[tonemapin] key %s = %s", ap_tm_key, c[4]); }
+        break;
+    }
+    fclose(fp);
+    if (!ap_tm_key[0]) { MLOG("[tonemapin] post_tonemap not named in %s: off", path); ap_tm_off = 1; }
+}
+static void ap_note_tonemap(NvProg *pr) {
+    if (ap_tm_off || ap_tm_queued >= AP_TM_MAX || !pr || !pr->sh[1]) return;
+    long f = (long)atomic_load(&g_cur_frame);
+    if (f < 3600 || (f % 600) != 0) return;
+    @try {
+    ap_tonemap_key();
+    if (ap_tm_off || !ap_tm_key[0] || !p3_key_prefix(pr->sh[1]->key, ap_tm_key)) return;
+        NvShader *sh = pr->sh[1];
+        for (int i = 0; i < sh->rf.nb && ap_tm_queued < AP_TM_MAX; i++) {
+            const nvn_rbind *b = &sh->rf.b[i];
+            int tid = ap_tex_tid(b, 1); if (tid < 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+            const tex_t *ct = &g_treg[tid].t; id<MTLTexture> t = tex_mtl(ct);
+            if (!t || t.width != 1 || t.height != 1 || t.textureType == MTLTextureType3D) continue;
+            if (!ap_tm_pend) ap_tm_pend = [NSMutableArray array];
+            for (NSArray *e in ap_tm_pend) if ([e[1] unsignedLongLongValue] == (unsigned long long)ct->serial && [e[4] longValue] == f) return;   // one per frame
+            [ap_tm_pend addObject:@[t, @((unsigned long long)ct->serial), @((unsigned)ct->d.format), @((int)t.pixelFormat), @(f)]];
+            ap_tm_queued++;
+            break;
+        }
+    } @catch (NSException *e) { ap_tm_off = 1; MLOG("[tonemapin] disabled after exception: %s", e.reason ? e.reason.UTF8String : "unknown exception"); }
+}
+// 512×512 灰度 PNG（p3_texel 解码；cube 每个面一张）
+static int ap_gray_png(const char *path, const uint8_t *p, MTLPixelFormat pf, size_t bpp, int W, int H) {
+    if (!path || !*path || !p || !bpp || W <= 0 || H <= 0) return 0;
+    uint8_t *px = (uint8_t *)calloc((size_t)W * H, 4);
+    if (!px) return 0;
+    for (int y = 0; y < H; y++) for (int x = 0; x < W; x++) {
+        float v = p3_texel(pf, p + ((size_t)y * W + x) * bpp);
+        int g = (int)(v * 255.0f + 0.5f); if (g < 0) g = 0; if (g > 255) g = 255;
+        uint8_t *q = px + ((size_t)y * W + x) * 4; q[0] = q[1] = q[2] = (uint8_t)g; q[3] = 255;
+    }
+    CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
