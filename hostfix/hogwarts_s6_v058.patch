+                if (adot && asl && adot < asl) adot = NULL;
+                if (adot) { strlcpy(aext, adot, sizeof aext); *adot = 0; }
+                char atail[64]; snprintf(atail, sizeof atail, "_a%s", aext); strlcat(apath, atail, sizeof apath);
+                shot(o, apath, 0, NULL);
+            }
+        }
+    }
     td_clear(0);
 }
