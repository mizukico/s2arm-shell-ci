+static uint32_t g_lz_pk_inw, g_lz_pk_inh; static int g_lz_pk_infloat;   // 本遍输入的边长（最大的一张）与是否有浮点 / HDR 输入
+static void lz_chain_cap(void) {
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (!lz_on() || !lz_sample_frame(f)) return;
+    for (int i = 0; i < 8; i++) {
+        uint64_t ser = g_lz_at_ser[i];
+        if (!ser || g_lz_chain_n >= LZ_CHAIN_MAX) continue;
+        id<MTLTexture> t = g_lz_at[i];
+        if (!t || t.sampleCount != 1) continue;
+        NSUInteger lv = (NSUInteger)g_lz_at_lv[i], sl = (NSUInteger)g_lz_at_sl[i];
+        NSUInteger w = MAX(t.width >> lv, 1u), h = MAX(t.height >> lv, 1u);
+        NSUInteger bpp = mtl_pf_bytes(t.pixelFormat);
+        if (!bpp || bpp > LZ_OUT_MAX_BPP) continue;   // 中心读回上限 8×8×4B：更宽的格式不采
+        NSUInteger cw = MIN(w, (NSUInteger)8), ch = MIN(h, (NSUInteger)8);
+        id<MTLBuffer> b = [g_dev newBufferWithLength:(NSUInteger)(8 * 8 * LZ_OUT_MAX_BPP) options:MTLResourceStorageModeShared];
+        if (!b) { lz_disable("buffer alloc failed"); return; }
+        res_add(b);
+        id e = blit();
+        if (!e) { lz_disable("blit failed"); res_remove(b); return; }
+        enc_b_copy_texture_buffer(e, t, sl, lv, MTLOriginMake((w - cw) / 2, (h - ch) / 2, 0), MTLSizeMake(cw, ch, 1), b, 0, cw * bpp, cw * bpp * ch);
+        lz_chainrec *r = &g_lz_chain[g_lz_chain_n++];
+        r->frame = f; r->pass = g_stat_pass; r->ser = ser; r->fence = g_fence + 1; r->fmt = (uint32_t)t.pixelFormat;
+        r->w = (uint32_t)w; r->h = (uint32_t)h; r->buf = b; r->inw = g_lz_pk_inw; r->inh = g_lz_pk_inh;
+        r->exp = w <= 8 && h <= 8;
+        r->bloom = g_lz_pk_infloat && g_lz_pk_inw && g_lz_pk_inh && (w * 2 <= g_lz_pk_inw || h * 2 <= g_lz_pk_inh);
+        snprintf(r->key, sizeof r->key, "%s", g_lz_pk_pass == g_stat_pass && g_lz_pk_key[0] ? g_lz_pk_key : "-");
+    }
+}
+static void lz_chain_drain(void) {
+    if (!g_lz_chain_n) return;
+    for (int i = 0; i < g_lz_chain_n; i++) if (g_lz_chain[i].fence > g_done) return;   // 整轮都跑完再打（同一帧的先后顺序才有意义）
+    int first = g_lz_chain_n > LZ_CHAIN_LINE_MAX ? g_lz_chain_n - LZ_CHAIN_LINE_MAX : 0;
+    if (first && lz_line_ok(0)) MLOG("[chain] clip: 本帧写了 %d 个颜色附件，只打最后 %d 个（帧尾合成链才是压暗发生的地方）", g_lz_chain_n, g_lz_chain_n - first);
+    for (int i = first; i < g_lz_chain_n; i++) {
+        lz_chainrec *r = &g_lz_chain[i];
+        double mean = 0; uint32_t mx = 0;
+        NSUInteger bpp = mtl_pf_bytes((MTLPixelFormat)r->fmt); if (!bpp || bpp > LZ_OUT_MAX_BPP) bpp = LZ_OUT_MAX_BPP;
+        NSUInteger cw = MIN((NSUInteger)r->w, (NSUInteger)8), ch = MIN((NSUInteger)r->h, (NSUInteger)8);
+        lz_stats((MTLPixelFormat)r->fmt, (const uint8_t *)r->buf.contents, cw, ch, cw * bpp, &mean, &mx);
+        lz_pd_row(r->frame, r->pass, r->key, "ATT", r->ser, r->w, r->h, r->fmt, lz_pf_name((MTLPixelFormat)r->fmt), mean, mx);   // 追加 4：passdump.tsv
+        if (lz_chain_ok()) MLOG("[chain] f=%llu pass=%llu ser=%llu key=%s fmt=0x%x(%s) %ux%u mean=%.1f max=%u", (unsigned long long)r->frame, (unsigned long long)r->pass,
+                                (unsigned long long)r->ser, r->key, r->fmt, lz_pf_name((MTLPixelFormat)r->fmt), r->w, r->h, mean, mx);
+        if (r->exp && lz_line_ok(0)) MLOG("[exp] f=%llu key=%s out ser=%llu %ux%u mean=%.1f", (unsigned long long)r->frame, r->key, (unsigned long long)r->ser, r->w, r->h, mean);
+        if (r->bloom && lz_line_ok(0)) MLOG("[bloom] f=%llu key=%s in=%ux%u out=%ux%u outMean=%.1f", (unsigned long long)r->frame, r->key, r->inw, r->inh, r->w, r->h, mean);
+    }
+    for (int i = 0; i < g_lz_chain_n; i++) { res_remove(g_lz_chain[i].buf); g_lz_chain[i].buf = nil; }
+    g_lz_chain_n = 0;
+}
+// 一个片元纹理绑定 → 1~4 个候选 tid（TEX 槽 / TEXU 单句柄 / TEXU 句柄数组，读法同 encode_args）
+static int lz_tids(const nvn_rbind *b, int tids[4]) {
+    int nt = 0;
+    if (b->kind == NVN_RB_TEX) tids[nt++] = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+    else if (b->kind == NVN_RB_TEXU && !b->n) tids[nt++] = ubo_tex_id(ubo_packed(1, b));
+    else if (b->kind == NVN_RB_TEXU && b->n) { for (int k = 0; k < b->n && k < 4; k++) tids[nt++] = ubo_tex_id(ubo_handle(1, b->reg, 8 * k)); }
+    return nt;
+}
+// 追加 3：compute 的输出是纹理时的读数（纹理是 GPU 私有的，只能 blit + wait；每 300 帧一次、一次一行）
+static void lz_cs_tex_drain(void) {
+    for (int i = 0; i < g_lz_cst_n; ) {
+        if (g_lz_off) return;
+        lz_cstrec *r = &g_lz_cst[i];
+        if (r->fence > g_done) { i++; continue; }
+        tex_t cp; int ok = 0;
+        pthread_mutex_lock(&g_rmu);
+        if (r->tid > 0 && r->tid < g_ntreg && g_treg[r->tid].ok) { cp = g_treg[r->tid].t; ok = 1; }
+        pthread_mutex_unlock(&g_rmu);
+        id<MTLTexture> t = ok ? tex_mtl(&cp) : nil;
+        if (t && t.sampleCount == 1 && t.width && t.height) {
+            NSUInteger cw = MIN(t.width, (NSUInteger)8), ch = MIN(t.height, (NSUInteger)8);
+            NSUInteger bpp = mtl_pf_bytes(t.pixelFormat);
+            if (!bpp || bpp > LZ_OUT_MAX_BPP) {   // 中心读回上限 8×8×4B：更宽的格式不采
+                g_lz_cst[i] = g_lz_cst[--g_lz_cst_n];
+                continue;
+            }
+            id<MTLBuffer> b = [g_dev newBufferWithLength:(NSUInteger)(8 * 8 * LZ_OUT_MAX_BPP + 16) options:MTLResourceStorageModeShared];
+            if (!b) { lz_disable("buffer alloc failed"); return; }
+            res_add(b);
+            mtl_finish_gpu();
+            id<MTLCommandBuffer> cb = q_cb();
+            if (!cb) { lz_disable("blit failed"); res_remove(b); return; }
+            id<MTLBlitCommandEncoder> be = [cb blitCommandEncoder];
+            if (!be) { lz_disable("blit failed"); res_remove(b); return; }
+            [be copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake((t.width - cw) / 2, (t.height - ch) / 2, 0)
+                         sourceSize:MTLSizeMake(cw, ch, 1) toBuffer:b destinationOffset:0 destinationBytesPerRow:cw * bpp destinationBytesPerImage:cw * bpp * ch];
+            [be endEncoding]; [cb commit]; [cb waitUntilCompleted];
+            if (cb.status != MTLCommandBufferStatusCompleted) {   // 读回失败 / 超时：立刻关全部探针
+                lz_disable(cb.status == MTLCommandBufferStatusError ? "readback failed" : "readback timeout");
+                res_remove(b); return;
+            }
+            double mean = 0; uint32_t mx = 0;
+            lz_stats((MTLPixelFormat)t.pixelFormat, (const uint8_t *)b.contents, cw, ch, cw * bpp, &mean, &mx);
+            if (lz_line_ok(1)) MLOG("[cs] out tex ser=%llu fmt=0x%x(%s) %ux%u mean=%.1f max=%u", (unsigned long long)cp.serial, cp.d.format,
+                                   lz_pf_name(t.pixelFormat), (unsigned)(t.width), (unsigned)(t.height), mean, mx);
+            res_remove(b);
+        }
+        g_lz_cst[i] = g_lz_cst[--g_lz_cst_n];
+    }
+}
+// 像素格式名（[dim] 行里 fmt=0x..(名) 用；只列诊断里会碰到的）
+static const char *lz_pf_name(MTLPixelFormat pf) {
+    switch (pf) {
+        case MTLPixelFormatDepth32Float: return "Depth32Float";
+        case MTLPixelFormatDepth16Unorm: return "Depth16Unorm";
+        case MTLPixelFormatDepth32Float_Stencil8: return "Depth32F_S8";
+        case MTLPixelFormatR8Unorm: return "R8Unorm"; case MTLPixelFormatR8Uint: return "R8Uint";
+        case MTLPixelFormatR16Unorm: return "R16Unorm"; case MTLPixelFormatR16Float: return "R16Float";
+        case MTLPixelFormatRG8Unorm: return "RG8Unorm"; case MTLPixelFormatRG16Unorm: return "RG16Unorm";
+        case MTLPixelFormatRG16Float: return "RG16Float";
+        case MTLPixelFormatRGBA8Unorm: return "RGBA8Unorm"; case MTLPixelFormatRGBA8Uint: return "RGBA8Uint";
+        case MTLPixelFormatRGBA8Snorm: return "RGBA8Snorm";
+        case MTLPixelFormatRGBA16Unorm: return "RGBA16Unorm"; case MTLPixelFormatRGBA16Float: return "RGBA16Float";
+        case MTLPixelFormatRGBA32Float: return "RGBA32Float";
+        case MTLPixelFormatBGRA8Unorm: return "BGRA8Unorm";   // present2：上屏目标本作 0x46(BGRA8Unorm)
+        case MTLPixelFormatBGRA8Unorm_sRGB: return "BGRA8Unorm_sRGB";
+        default: return "?";
+    }
+}
+// 1x1 值：深度打 val=<float>，其余交给 lz_desc（px=(...) / u=(...)）
+static void lz_val_desc(MTLPixelFormat pf, const uint8_t *p, char *out, size_t n) {
+    if (pf == MTLPixelFormatDepth32Float || pf == MTLPixelFormatDepth32Float_Stencil8) {
+        float v; memcpy(&v, p, 4); snprintf(out, n, "val=%.5f", (double)v); return;
+    }
+    if (pf == MTLPixelFormatDepth16Unorm) { uint16_t v; memcpy(&v, p, 2); snprintf(out, n, "val=%.5f", v / 65535.0); return; }
+    lz_desc(pf, p, out, n);
+}
+static void lz_att_begin(int slot, id<MTLTexture> t, NSUInteger lv, NSUInteger sl, uint64_t ser) {
+    if (slot < 0 || slot >= 8) return;
+    g_lz_at[slot] = t; g_lz_at_lv[slot] = (int)lv; g_lz_at_sl[slot] = (int)sl; g_lz_at_ser[slot] = ser;
+}
+static void lz_att_clear(void) {
+    for (int i = 0; i < 8; i++) { g_lz_at[i] = nil; g_lz_at_lv[i] = 0; g_lz_at_sl[i] = 0; g_lz_at_ser[i] = 0; }
+}
+// 遍末、sd_finish 之前：把本遍附件的 g_sd 下标记下来（store 决定在 sd_finish 里写回 g_sd，之后 g_nsd 清零）
+static void lz_pre_end(void) {
+    if (!lz_on()) return;
+    for (int k = 0; k < LZ_SLOT_MAX; k++) {
+        lz_slot_t *s = &g_lz_slot[k];
+        if (!s->used || s->pass != g_stat_pass) continue;
+        for (int i = 0; i < s->natt; i++) {
+            int sdi = -1;
+            for (int j = 0; j < g_nsd; j++) if (!g_sd[j].depth && g_sd[j].idx == s->att[i].slot) { sdi = j; break; }
+            s->att[i].sdi = sdi;
+            if (sdi >= 0) { s->att[i].wrote = g_sd[sdi].wrote; s->att[i].load = g_sd[sdi].load; }
+        }
+    }
+}
+// 编码器结束之后：G-buffer 输入各拷 1x1 中心、颜色附件拷 8x8 中心到 shared 缓冲，记下这次提交的栅栏号
+static void lz_post_end(void) {
+    if (!lz_on() || g_lz_post_busy) return;   // 重入哨兵：blit 绝不能再把 rp_end 调回来（否则无限递归）
+    g_lz_post_busy = 1;
+    lz_chain_cap();   // 追加 1：本遍所有颜色附件（不筛编号），结束时拷中心区
+    if (g_lz_off) { g_lz_post_busy = 0; return; }
+    for (int k = 0; k < LZ_SLOT_MAX; k++) {
+        if (g_lz_off) break;
+        lz_slot_t *s = &g_lz_slot[k];
+        if (!s->used || s->ready || s->pass != g_stat_pass) continue;
+        if (!s->buf_obj) {
+            s->buf_obj = [g_dev newBufferWithLength:LZ_BUF_BYTES options:MTLResourceStorageModeShared];
+            if (!s->buf_obj) { lz_disable("buffer alloc failed"); s->used = 0; continue; }
+            res_add(s->buf_obj);
+        }
+        id e = blit();   // 纹理拷贝：先放 barrier，并把「全写」记进账，后面的绘制会等它
+        if (!e) { lz_disable("blit failed"); s->used = 0; continue; }
+        memset((void *)s->buf_obj.contents, 0, LZ_BUF_BYTES);   // 没拷成的槽读回 0，不冒充上一次的数
+        for (int i = 0; i < s->nin; i++) {
+            id<MTLTexture> t = s->in[i].tex;
+            if (!t || t.textureType != MTLTextureType2D || t.sampleCount != 1) continue;
+            NSUInteger x = (t.width - 1) / 2, y = (t.height - 1) / 2;
+            enc_b_copy_texture_buffer(e, t, 0, 0, MTLOriginMake(x, y, 0), MTLSizeMake(1, 1, 1),
+                                      s->buf_obj, LZ_IN_OFF + (NSUInteger)i * LZ_IN_STRIDE, LZ_IN_STRIDE, LZ_IN_STRIDE);
+        }
+        for (int i = 0; i < s->natt; i++) {
+            lz_atte *a = &s->att[i];
+            a->noread = 0;
+            id<MTLTexture> t = a->slot >= 0 && a->slot < 8 ? g_lz_at[a->slot] : nil;
+            if (!t || t.sampleCount != 1) { a->noread = 1; continue; }
+            NSUInteger lv = a->slot >= 0 && a->slot < 8 ? (NSUInteger)g_lz_at_lv[a->slot] : 0;
+            NSUInteger sl = a->slot >= 0 && a->slot < 8 ? (NSUInteger)g_lz_at_sl[a->slot] : 0;
+            NSUInteger w = MAX(t.width >> lv, 1u), h = MAX(t.height >> lv, 1u);
+            if (w < 8 || h < 8) { a->noread = 1; continue; }
+            NSUInteger bpp = mtl_pf_bytes(t.pixelFormat);
+            if (!bpp || bpp > LZ_OUT_MAX_BPP) { a->noread = 1; continue; }   // 中心读回上限 8×8×4B
+            a->lv = (int)lv; a->sl = (int)sl; a->mtl_fmt = (uint32_t)t.pixelFormat;
+            a->dead = (a->sdi >= 0 && g_sd[a->sdi].state == 2) || (udc_on() && a->load && !a->wrote);
+            NSUInteger row = 8 * bpp;
+            enc_b_copy_texture_buffer(e, t, sl, lv, MTLOriginMake((w - 8) / 2, (h - 8) / 2, 0), MTLSizeMake(8, 8, 1),
+                                      s->buf_obj, LZ_OUT_OFF + (NSUInteger)i * LZ_OUT_STRIDE, row, row * 8);
+        }
+        s->ready = 1; s->fence = g_fence + 1;
+    }
+    g_lz_post_busy = 0;
+}
+// 下一次开遍前：这次提交已完成（g_done 到位）就把上一帧光照那遍的拷贝读回打 in / out
+static void lz_drain(void) {
+    if (!lz_on()) return;
+    uint64_t f = atomic_load(&g_cur_frame);
+    for (int k = 0; k < LZ_SLOT_MAX; k++) {
+        if (g_lz_off) break;
+        lz_slot_t *s = &g_lz_slot[k];
+        if (!s->used) continue;
+        if (!s->ready) { if (s->frame + 2 < f) { for (int i = 0; i < LZ_MAX_IN; i++) s->in[i].tex = nil; s->used = 0; } continue; }   // 那一遍没结束：两帧后丢掉，不占槽
+        if (s->fence > g_done) continue;   // 还没跑完：等下一次开遍
+        const uint8_t *p = s->buf_obj ? (const uint8_t *)s->buf_obj.contents : NULL;
+        int dim = s->kind == 1;
+        if (p) for (int i = 0; i < s->nin; i++) {
+            char *d = lz_b_dim;
+            if (dim) lz_val_desc((MTLPixelFormat)s->in[i].mtl_fmt, p + LZ_IN_OFF + (size_t)i * LZ_IN_STRIDE, d, sizeof lz_b_dim);
