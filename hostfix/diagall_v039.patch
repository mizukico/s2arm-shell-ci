+            if (need + bytes > (uint64_t)DA_BUDGET) continue;
+            rq[nrq].t = t; rq[nrq].lv = lv; rq[nrq].sl = sl; rq[nrq].x = x0; rq[nrq].y = y0;
+            rq[nrq].w = rwv; rq[nrq].h = rhv; rq[nrq].bpp = bpp; rq[nrq].row = (size_t)rwv * bpp;
+            rq[nrq].kind = 0; rq[nrq].idx = k; rq[nrq].sub = 0;
+            rb[nrq] = [g_dev newBufferWithLength:rq[nrq].row * (size_t)rhv options:MTLResourceStorageModeShared];
+            if (!rb[nrq]) { rq[nrq].t = nil; continue; }
+            need += bytes; nrq++;
+        }
+        if (do_snap) for (int i = 0; i < DA_KEY_N && nrq < DA_RQ; i++) {   // ④ UBO：前 64 个 float（69ebe1cc 另要完整 1280 字节）
+            da_ubo *u = &g_da_ubo[i];
+            if (!u->len || u->frame != frame || u->len < 4) continue;
+            void *mb = NULL; uint64_t mo = 0;
