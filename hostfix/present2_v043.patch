+// ====================================================================================================================
+#define S2A_FMT_BITS_LIST(X) \
+    X(R8Unorm, 8) X(R8Unorm_sRGB, 8) X(R8Snorm, 8) X(R8Uint, 8) X(R8Sint, 8) \
+    X(RG8Unorm, 16) X(RG8Snorm, 16) X(RG8Uint, 16) X(RG8Sint, 16) \
+    X(RGBA8Unorm, 32) X(RGBA8Unorm_sRGB, 32) X(RGBA8Snorm, 32) X(RGBA8Uint, 32) X(RGBA8Sint, 32) \
+    X(BGRA8Unorm, 32) X(BGRA8Unorm_sRGB, 32) \
+    X(R16Unorm, 16) X(R16Snorm, 16) X(R16Uint, 16) X(R16Sint, 16) X(R16Float, 16) \
+    X(RG16Unorm, 32) X(RG16Snorm, 32) X(RG16Uint, 32) X(RG16Sint, 32) X(RG16Float, 32) \
+    X(RGBA16Unorm, 64) X(RGBA16Snorm, 64) X(RGBA16Uint, 64) X(RGBA16Sint, 64) X(RGBA16Float, 64) \
+    X(R32Uint, 32) X(R32Sint, 32) X(R32Float, 32) \
+    X(RG32Uint, 64) X(RG32Sint, 64) X(RG32Float, 64) \
+    X(RGBA32Uint, 128) X(RGBA32Sint, 128) X(RGBA32Float, 128) \
+    X(RGB10A2Unorm, 32) X(RGB10A2Uint, 32)
+#define S2A_FMT_BITS_ENUM(nm, bits) S2A_FMTBITS_##nm = bits,
+enum { S2A_FMT_BITS_LIST(S2A_FMT_BITS_ENUM) };
+#undef S2A_FMT_BITS_ENUM
+// bit-per-pixel 表（唯一的宽度来源）；表外格式 → 0
+static int s2a_fmt_bits(uint32_t pf) {
+    switch (pf) {
+#define S2A_FMT_BITS_CASE(nm, bits) case MTLPixelFormat##nm: return bits;
+        S2A_FMT_BITS_LIST(S2A_FMT_BITS_CASE)
+#undef S2A_FMT_BITS_CASE
+        default: return 0;
+    }
+}
