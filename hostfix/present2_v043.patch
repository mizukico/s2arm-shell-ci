+    uint64_t pass = g_stat_pass + 1;
+    g_lz_pk_pass = pass; snprintf(g_lz_pk_key, sizeof g_lz_pk_key, "%s", pr->sh[1]->key);   // 本遍第一笔的片元 key（链路 / 压暗行用）
+    if (!lz_sample_frame(f)) return;                              // 采样按每 300 帧一次
+    // 本遍的输入画像（[bloom] 判据，全按尺寸 / 格式，不看编号）：最大输入边长 + 是否有浮点 / HDR 输入
+    g_lz_pk_inw = g_lz_pk_inh = 0; g_lz_pk_infloat = 0;
