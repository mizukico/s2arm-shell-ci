+static float lit_h2f(uint16_t h) {
+    uint32_t s = (uint32_t)(h >> 15) & 1u, e = (uint32_t)(h >> 10) & 0x1fu, m = (uint32_t)h & 0x3ffu, f;
+    if (!e) { if (!m) f = s << 31; else { int sh = 0; while (!(m & 0x400u)) { m <<= 1; sh++; } m &= 0x3ffu; f = (s << 31) | ((uint32_t)(127 - 15 - sh) << 23) | (m << 13); } }
+    else if (e == 31) f = (s << 31) | 0x7f800000u | (m << 13);
+    else f = (s << 31) | ((e + 112u) << 23) | (m << 13);
+    float r; memcpy(&r, &f, sizeof r); return r;
+}
+static uint8_t lit_f8(float v) {   // 浮点通道 → 8 位（诊断只看「有没有内容」：NaN / 负数按 0）
+    if (!(v == v)) return 0;
+    float x = v * 255.0f;
+    return (uint8_t)(x <= 0.0f ? 0 : x >= 255.0f ? 255 : (int)(x + 0.5f));
+}
+// 一个像素的 RGB → 8 位（alpha 不计）；认不出的格式按原始字节（宁可粗糙也不静默）
+static void lit_px8(const uint8_t *s, size_t bpp, MTLPixelFormat pf, uint8_t q[3]) {
+    q[0] = q[1] = q[2] = 0;
+    size_t eb = mtl_pf_bytes(pf);
+    if (!bpp || (eb && bpp < eb)) return;
+    switch (pf) {
+    case MTLPixelFormatR8Unorm: case MTLPixelFormatR8Uint: q[0] = q[1] = q[2] = s[0]; return;
+    case MTLPixelFormatRG8Unorm: case MTLPixelFormatRG8Uint: q[0] = s[0]; q[1] = s[1]; return;
+    case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatRGBA8Unorm_sRGB: case MTLPixelFormatRGBA8Uint:
+        q[0] = s[0]; q[1] = s[1]; q[2] = s[2]; return;
+    case MTLPixelFormatBGRA8Unorm: case MTLPixelFormatBGRA8Unorm_sRGB: q[0] = s[2]; q[1] = s[1]; q[2] = s[0]; return;
+    case MTLPixelFormatRGB10A2Unorm: {
+        uint32_t v; memcpy(&v, s, 4);
+        q[0] = (uint8_t)((v & 0x3ffu) >> 2); q[1] = (uint8_t)(((v >> 10) & 0x3ffu) >> 2); q[2] = (uint8_t)(((v >> 20) & 0x3ffu) >> 2); return; }
+    case MTLPixelFormatR16Unorm: case MTLPixelFormatR16Uint: { uint16_t v; memcpy(&v, s, 2); q[0] = q[1] = q[2] = (uint8_t)(v >> 8); return; }
+    case MTLPixelFormatR16Float: { uint16_t v; memcpy(&v, s, 2); q[0] = q[1] = q[2] = lit_f8(lit_h2f(v)); return; }
+    case MTLPixelFormatRG16Unorm: case MTLPixelFormatRG16Uint: {
+        uint16_t a, c2; memcpy(&a, s, 2); memcpy(&c2, s + 2, 2); q[0] = (uint8_t)(a >> 8); q[1] = (uint8_t)(c2 >> 8); return; }
+    case MTLPixelFormatRG16Float: {
+        uint16_t a, c2; memcpy(&a, s, 2); memcpy(&c2, s + 2, 2); q[0] = lit_f8(lit_h2f(a)); q[1] = lit_f8(lit_h2f(c2)); return; }
+    case MTLPixelFormatRGBA16Unorm: case MTLPixelFormatRGBA16Uint: {
+        uint16_t v[3]; memcpy(v, s, 6); q[0] = (uint8_t)(v[0] >> 8); q[1] = (uint8_t)(v[1] >> 8); q[2] = (uint8_t)(v[2] >> 8); return; }
+    case MTLPixelFormatRGBA16Float: {
+        uint16_t v[3]; memcpy(v, s, 6); q[0] = lit_f8(lit_h2f(v[0])); q[1] = lit_f8(lit_h2f(v[1])); q[2] = lit_f8(lit_h2f(v[2])); return; }
+    case MTLPixelFormatR32Float: { float f; memcpy(&f, s, 4); q[0] = q[1] = q[2] = lit_f8(f); return; }
+    case MTLPixelFormatRG32Float: { float f[2]; memcpy(f, s, 8); q[0] = lit_f8(f[0]); q[1] = lit_f8(f[1]); return; }
+    case MTLPixelFormatRGBA32Float: { float f[3]; memcpy(f, s, 12); q[0] = lit_f8(f[0]); q[1] = lit_f8(f[1]); q[2] = lit_f8(f[2]); return; }
+    default: q[0] = s[0]; q[1] = bpp > 1 ? s[1] : 0; q[2] = bpp > 2 ? s[2] : 0; return;
+    }
+}
+// 一张 2D 图（可低于一级）的 RGB 8 位统计：nonzero = RGB 样本里非 0 的个数，mean / max 都是 0..255
+static void lit_stats(const uint8_t *p, size_t row, size_t w, size_t h, size_t bpp, MTLPixelFormat pf,
+                      uint64_t *nz, double *mean, uint64_t *mx) {
+    uint64_t n = 0, sum = 0, m = 0, z = 0;
+    for (size_t y = 0; y < h; y++) for (size_t x = 0; x < w; x++) {
+        uint8_t q[3]; lit_px8(p + y * row + x * bpp, bpp, pf, q);
+        for (int c = 0; c < 3; c++) { n++; sum += q[c]; if (q[c]) z++; if (q[c] > m) m = q[c]; }
+    }
+    *nz = z; *mean = n ? (double)sum / (double)n : 0.0; *mx = m;
+}
+// 帧末（下一帧第一遍之前）：这一帧收到的每个目标各拷一次到共享缓冲，CPU 上算 RGB 统计并打行，然后丢掉纹理引用。
+// 这是本诊断唯一的 GPU 拷贝，位置与 td_dump / gbuf_drain 相同（pass 都结束、GPU 已做完），不在任何 pass 里。
+static void lit_dump(void) {
+    if (!g_lit_n) return;
+    int n = g_lit_n; uint64_t f = g_lit_frame;
+    if (mtl_gpu_halted()) {   // GPU 已经安全停：不在这条路上再提交命令缓冲
+        if (!g_lit_fail_logged) { g_lit_fail_logged = 1; MLOG("【红】[litdbg] GPU 已安全停：帧末统计不再读回（原因看 [gpuerr] 那行）"); }
+        for (int i = 0; i < n; i++) g_lit_tex[i] = nil;
+        g_lit_n = 0; return;
+    }
+    rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+    mtl_finish_gpu();   // 上一帧的提交必须已经在 GPU 上做完，旧队列的拷贝才读得到这一帧的内容
+    size_t rows[LIT_SER_MAX], bpp[LIT_SER_MAX]; id<MTLBuffer> bufs[LIT_SER_MAX];
+    id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+    for (int i = 0; i < n; i++) {
+        rows[i] = 0; bpp[i] = 0; bufs[i] = nil;
+        id<MTLTexture> t = g_lit_tex[i]; if (!t) continue;
+        if (t.textureType != MTLTextureType2D && t.textureType != MTLTextureType2DArray) continue;
+        bpp[i] = mtl_pf_bytes(t.pixelFormat); if (!bpp[i]) continue;
+        NSUInteger lv = g_lit_lv[i], w = MAX(t.width >> lv, (NSUInteger)1), h = MAX(t.height >> lv, (NSUInteger)1);
+        if ((uint64_t)w * (uint64_t)h * (uint64_t)bpp[i] > (64ull << 20)) { bpp[i] = 0; continue; }   // 单张 > 64 MB 不进统计
+        rows[i] = (size_t)w * bpp[i];
+        bufs[i] = [g_dev newBufferWithLength:rows[i] * h options:MTLResourceStorageModeShared];
+        if (bufs[i]) [b copyFromTexture:t sourceSlice:g_lit_sl[i] sourceLevel:lv sourceOrigin:MTLOriginMake(0, 0, 0)
+                              sourceSize:MTLSizeMake(w, h, 1) toBuffer:bufs[i] destinationOffset:0
+                       destinationBytesPerRow:rows[i] destinationBytesPerImage:rows[i] * h];
+    }
+    [b endEncoding];
+    int ran = cb_run(cb);
+    for (int i = 0; i < n; i++) {
+        id<MTLTexture> t = g_lit_tex[i];
+        uint64_t ser = g_lit_tser[i]; int slot = g_lit_slot[i];
+        if (!t) MLOG("【红】[litdbg] frame %llu ser=%llu c%d: 这一帧没有可读的附件", (unsigned long long)f, (unsigned long long)ser, slot);
+        else if (t.textureType != MTLTextureType2D && t.textureType != MTLTextureType2DArray)
+            MLOG("【红】[litdbg] frame %llu ser=%llu c%d: 纹理类型 %lu 不读回（只读 2d / 2darray）",
+                 (unsigned long long)f, (unsigned long long)ser, slot, (unsigned long)t.textureType);
+        else if (!bpp[i]) MLOG("【红】[litdbg] frame %llu ser=%llu c%d fmt=%#lx: 不认识的格式 / 单张过大，不读回",
+                               (unsigned long long)f, (unsigned long long)ser, slot, (unsigned long)t.pixelFormat);
+        else if (!ran || !bufs[i]) MLOG("【红】[litdbg] frame %llu ser=%llu c%d: 帧末读回失败（nonzero 不可信）",
+                                        (unsigned long long)f, (unsigned long long)ser, slot);
+        else {
+            NSUInteger lv = g_lit_lv[i], w = MAX(t.width >> lv, (NSUInteger)1), h = MAX(t.height >> lv, (NSUInteger)1);
+            uint64_t nz = 0, mx = 0; double mean = 0.0;
+            lit_stats((const uint8_t *)bufs[i].contents, rows[i], w, h, bpp[i], t.pixelFormat, &nz, &mean, &mx);
+            MLOG("[litdbg] frame %llu ser=%llu nonzero=%llu mean=%.1f max=%llu rgb_only=1",
+                 (unsigned long long)f, (unsigned long long)ser, (unsigned long long)nz, mean, (unsigned long long)mx);
+        }
+        g_lit_tex[i] = nil;
+    }
+    g_lit_n = 0;
+}
+// ---------- S2Arm #427 壳内置诊断 [litin]：光照遍的输入（常量缓冲 / IBL cube / 阴影 array） ----------
+// 背景（上一轮结论）：G-buffer 写侧正常（[gbufdbg] 236/237/238/273/274/275 nonzero>0），但场景色（自动学到的上屏源，如 ser=276/623/271）
+//   统计 mean 0.1–0.2、nonzero 只有几千 → 几乎全黑；DM_NVN_FB_SNAP=0 关掉同遍反馈也一样。所以要看光照遍自己读到了什么：
+//   常量缓冲是不是 0、IBL / 环境 cube 是不是黑、阴影 array 是不是空。
+//   识别光照遍（每一遍只看第一笔画，挂点在 draw 里 litin_note(pr->sh[1])）：
+//     (a) 片元 key 的前 16 位 hash 命中已知「读 G-buffer」的那几个（567fcd0c97a29418 / f46313c22380f38f / ba5f5df42d8f1686，
+//         后缀 _b / _bf / _u 一律不管）；
+//     (b) 该遍片元槽里绑定了 ≥ 2 张整数格式（Uint / Sint）纹理，且还绑了 cube 或 2D 数组纹理（G-buffer 就是整数格式；
+//         后缀 / 序号变了、已知 key 对不上时靠这条兜底，多一个 cube / 阴影的条件是为了不让别的遍先占掉本帧的名额）。
+//   每帧最多命中 1 个光照遍；命中后每类只取一个：
+//     UBO   = 该阶段（fragment）绑定最大的 NVN_RB_CBUF（通常是光照常量），帧末读回前 ≤ 256 字节，打前 8 个 float；
+//     cube  = 该遍绑定的 cube 纹理（IBL / 环境，target 8 / 9，也认面数组视图），帧末读回 mip0 每面正中 4×4 像素；
+//     array = 该遍绑定的 2D 数组纹理（阴影，优先深度格式、层数多的那个），帧末读回每层正中 16×16 像素。
+//   位置和 [litdbg] / [texdump] 完全相同：帧号一变（下一帧第一遍开遍之前，td_note 里）rp_end → mtl_finish_gpu →
+//   旧队列 q_cb 一次 blit 到共享缓冲 → CPU 统计并打行。pass 内零拷贝、不进任何命令缓冲、不建私有纹理。
+//   预算：每帧 ≤ 256 B UBO + 6 面×4×4 + 16 层×16×16 像素；累计上限 256 MB（S2A_LIT_DEBUG=0 整条关；S2A_LITIN_DEBUG=0 只关本条）。
+enum { LITIN_UBO_MAXB = 256, LITIN_CUBE_PX = 4, LITIN_SHADOW_PX = 16, LITIN_SHADOW_MAXL = 16, LITIN_BUDGET_MB = 256 };
+static int g_litin_on = -1;
+static uint64_t g_litin_pass = ~0ull;    // 命中的那一遍的编号（只用来打行；每遍只看第一笔画）
+static uint64_t g_litin_frame = ~0ull;   // 正在收集的帧号（帧末那行打的就是它）
+static int g_litin_hit;                  // 本帧已经命中 1 个光照遍（每帧最多 1 个）
+static char g_litin_key[24];             // 本帧命中的片元 key
+static char g_litin_last_key[24];        // 上一次认出来的光照遍 key（变了才打识别行）
+static char g_litin_nofind_key[24];      // 认出来了却没有可读目标的那一遍（同一 key 只提示一次）
+static int g_litin_ubo_reg = -1; static uint64_t g_litin_ubo_addr, g_litin_ubo_len;
+// cube / 阴影只记 tid + 序号 + 尺寸（不在这里取 MTLTexture：那可能触发上传，会动到正在编码的这一遍的编码器；
+//   帧末没有 pass 打开时再 tex_mtl，这时上传是安全的，而且那一遍早就把纹理建好了）
+static int g_litin_cube_tid = -1, g_litin_shadow_tid = -1;
+static uint64_t g_litin_cube_ser, g_litin_shadow_ser;
+static uint64_t g_litin_bytes;           // 累计读回的字节数（预算 LITIN_BUDGET_MB）
+static int g_litin_budget_logged, g_litin_halt_logged, g_litin_ubo_fail, g_litin_cube_fail, g_litin_shd_fail;
+static void litin_clear(void) {   // 帧末读回后清掉本帧记下的目标
+    g_litin_ubo_reg = -1; g_litin_ubo_addr = 0; g_litin_ubo_len = 0;
+    g_litin_cube_tid = -1; g_litin_cube_ser = 0;
+    g_litin_shadow_tid = -1; g_litin_shadow_ser = 0;
+}
+static int litin_on(void) {   // 跟 [litdbg] 一起开关：S2A_LIT_DEBUG=0 全关，S2A_LITIN_DEBUG=0 只关 [litin]
+    if (g_litin_on < 0) {
+        const char *e = getenv("S2A_LITIN_DEBUG");
+        g_litin_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_litin_on) MLOG("S2A_LITIN_DEBUG=0 / S2A_LIT_DEBUG=0: [litin] 光照输入统计关");
+    }
+    return g_litin_on;
+}
+static int litin_key_hit(const char *k) {   // 已知「读 G-buffer」的光照片元 key：只比前 16 位 hash，后缀（_b / _bf / _u）不管
+    static const char *keys[3] = { "567fcd0c97a29418", "f46313c22380f38f", "ba5f5df42d8f1686" };
+    if (!k || strlen(k) < 16) return 0;
+    for (int i = 0; i < 3; i++) if (!strncmp(k, keys[i], 16)) return 1;
+    return 0;
+}
+static int litin_tex_int(const treg_t *r) {   // 这张纹理按整数（Uint / Sint）读吗：视图改了格式就按视图的
+    int f = (r->has_v && r->v.set_format) ? (int)r->v.format : (int)r->t.d.format;
+    uint32_t pf = 0; uint8_t sw[4];
+    if (!f || !nvn_fmt_to_mtl(f, &pf, sw) || !pf) return 0;
+    return mtl_pf_dpf((MTLPixelFormat)pf) != NVN_DPF_FLOAT;
+}
+// draw 里（每一遍的第一笔画）：认这一遍是不是光照遍；是就记下要读的 UBO 地址 / cube / 阴影 array（只读绑定状态，不拷贝、不进命令缓冲）
+// 先只按 registry 里的 tex_t 挑候选（不建 MTLTexture、不触发上传）；确认是光照遍之后才取那 1～2 张的 MTLTexture。
+static void litin_note(NvShader *fs) {
+    if (!litin_on() || !fs || g_litin_hit) return;
+    uint64_t pass = g_stat_pass;
+    if (g_litin_pass == pass) return;   // 每遍只看第一笔画：这时的片元绑定属于这一遍
+    g_litin_pass = pass;
+    int bykey = litin_key_hit(fs->key), nint = 0;
+    int ubo_reg = -1; uint64_t ubo_addr = 0, ubo_len = 0;
+    int cube_tid = -1, shd_tid = -1; uint64_t cube_ser = 0, shd_ser = 0, cube_px = 0, shd_score = 0;
+    uint32_t cube_w = 0, cube_h = 0, shd_w = 0, shd_h = 0, shd_d = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind == NVN_RB_CBUF) {   // 光照常量：取 fragment 阶段绑定的最大的那个
+            if (b->reg >= 16) continue;
+            const p_bind_buf *u = &S.ubo[1][b->reg];
+            if (u->addr && u->size && u->size > ubo_len) { ubo_addr = u->addr; ubo_len = u->size; ubo_reg = (int)b->reg; }
+            continue;
+        }
+        if (b->kind != NVN_RB_TEX) continue;
+        int id_ = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+        if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) continue;
+        const treg_t *r = &g_treg[id_];
+        if (!r->t.serial) continue;
+        if (litin_tex_int(r)) nint++;
+        int tgt = (r->has_v && r->v.set_target) ? (int)r->v.target : (int)r->t.d.target;
+        uint64_t px = (uint64_t)r->t.d.width * (uint64_t)r->t.d.height;
+        if (tgt == NVN_TEXTURE_TARGET_CUBEMAP) {   // IBL / 环境：取分辨率最大的那张
+            if (!px || px <= cube_px) continue;
+            cube_tid = id_; cube_ser = r->t.serial; cube_px = px; cube_w = r->t.d.width; cube_h = r->t.d.height;
+        } else if (tgt == NVN_TEXTURE_TARGET_2D_ARRAY && r->t.d.depth) {   // 阴影：优先深度格式，其次层数多的
+            uint32_t pf = 0; uint8_t sw[4];
+            int dep = nvn_fmt_to_mtl((int)r->t.d.format, &pf, sw) && pf && mtl_fmt_depth((MTLPixelFormat)pf);
+            uint64_t score = ((uint64_t)(dep ? 1 : 0) << 40) | ((uint64_t)r->t.d.depth << 20) | px;
+            if (shd_tid >= 0 && score <= shd_score) continue;
+            shd_tid = id_; shd_ser = r->t.serial; shd_score = score;
+            shd_w = r->t.d.width; shd_h = r->t.d.height; shd_d = r->t.d.depth;
+        }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    if (!bykey && !(nint >= 2 && (cube_tid >= 0 || shd_tid >= 0))) return;   // 兜底：至少 2 张整数格式纹理 + 一张 cube / 2D 数组，才算光照遍（免得别的遍先占掉本帧的名额）
+    if (ubo_reg < 0 && cube_tid < 0 && shd_tid < 0) {   // 认出来了却没东西可读：不占本帧的名额（本帧后面的遍还有机会）
+        if (bykey && strcmp(g_litin_nofind_key, fs->key)) {
+            snprintf(g_litin_nofind_key, sizeof g_litin_nofind_key, "%s", fs->key);
+            MLOG("[litin] 光照遍 key=%s 认出来了，但这一遍没有 UBO / cube / 2D 数组纹理可读（跳过；本帧后面的遍还有机会）", fs->key);
+        }
+        return;
+    }
+    g_litin_hit = 1;
+    snprintf(g_litin_key, sizeof g_litin_key, "%s", fs->key);
+    if (strcmp(g_litin_last_key, fs->key)) {
+        snprintf(g_litin_last_key, sizeof g_litin_last_key, "%s", fs->key);
+        MLOG("[litin] 光照遍：fragment %s（按%s认；整数格式纹理 %d 张）| ubo reg=%d len=%llu | cube ser=%llu %ux%u | shadow ser=%llu %ux%u depth=%u",
+             fs->key, bykey ? "已知 G-buffer key" : "≥2 张整数格式纹理 + cube / 数组", nint,
+             ubo_reg, (unsigned long long)ubo_len,
+             (unsigned long long)cube_ser, (unsigned)cube_w, (unsigned)cube_h,
+             (unsigned long long)shd_ser, (unsigned)shd_w, (unsigned)shd_h, (unsigned)shd_d);
+    }
+    if (ubo_reg >= 0) { g_litin_ubo_reg = ubo_reg; g_litin_ubo_addr = ubo_addr; g_litin_ubo_len = ubo_len; }
+    if (cube_tid >= 0) { g_litin_cube_tid = cube_tid; g_litin_cube_ser = cube_ser; }
+    if (shd_tid >= 0) { g_litin_shadow_tid = shd_tid; g_litin_shadow_ser = shd_ser; }
+}
+// 帧末（下一帧第一遍之前，和 [litdbg] 同一个点）：这一帧记下的 UBO / cube / 阴影 array 各拷一次到共享缓冲，CPU 上统计并打行。
+// 这是 [litin] 唯一的 GPU 工作：pass 都结束、GPU 已做完、旧队列上一次提交，不在任何 pass 里。
+static void litin_dump(void) {
+    if (g_litin_ubo_reg < 0 && g_litin_cube_tid < 0 && g_litin_shadow_tid < 0) return;
+    uint64_t f = g_litin_frame, pass = g_litin_pass;
+    if (mtl_gpu_halted()) {   // GPU 已经安全停：不在这条路上再提交命令缓冲
