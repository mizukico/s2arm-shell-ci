+            jb[j] = [g_dev newBufferWithLength:jrow[j] * px options:MTLResourceStorageModeShared];
+            if (!jb[j]) jt[j] = nil;
+        }
+        id<MTLBuffer> usrc[LITB_LEVEL_MAX]; NSUInteger uso[LITB_LEVEL_MAX];
+        for (int lv = 0; lv < LITB_LEVEL_MAX; lv++) { usrc[lv] = nil; uso[lv] = 0; }
+        for (int lv = 0; lv < nlv; lv++) {
+            const litb_snap *sp = &g_litb_snap[lsnap[lv]];
+            if (sp->ubo_reg < 0 || !sp->ubo_addr || sp->ubo_len < 4) continue;
+            uint64_t un = MIN(sp->ubo_len, (uint64_t)LITB_UBO_MAXB);
+            void *mb = NULL; uint64_t mo = 0;
+            if (!nvn_be_addr(sp->ubo_addr, 4, &mb, &mo) || !mb || (mo & 3)) continue;
+            id<MTLBuffer> sb = (__bridge id<MTLBuffer>)mb;
+            NSUInteger bmax = (NSUInteger)sb.length;
+            if (mo >= bmax) continue;
+            NSUInteger len = (NSUInteger)MIN(un, (uint64_t)bmax - mo) & ~(NSUInteger)3;
+            if (len < 4) continue;
+            ub[lv] = [g_dev newBufferWithLength:len options:MTLResourceStorageModeShared];
+            if (ub[lv]) { ubl[lv] = len; usrc[lv] = sb; uso[lv] = (NSUInteger)mo; }
+        }
+        id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        for (int lv = 0; lv < nlv; lv++) if (ub[lv] && usrc[lv])
+            enc_b_copy_buffer(b, usrc[lv], uso[lv], ub[lv], 0, ubl[lv]);
+        for (int j = 0; j < nj; j++) if (jb[j] && jt[j]) {
+            NSUInteger ox = (jt[j].width - jpx[j]) / 2, oy = (jt[j].height - jpx[j]) / 2;   // 取正中 4×4：角落可能是空区域
+            [b copyFromTexture:jt[j] sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(ox, oy, 0)
+                    sourceSize:MTLSizeMake(jpx[j], jpx[j], 1) toBuffer:jb[j] destinationOffset:0
+             destinationBytesPerRow:jrow[j] destinationBytesPerImage:jrow[j] * jpx[j]];
+        }
+        [b endEncoding];
+        ran = cb_run(cb);
+        if (!ran && !g_litb_fail_logged) { g_litb_fail_logged = 1;
+            MLOG("【红】[litback] frame %llu: 帧末读回没提交（GPU 已安全停 / 提交被拒），这一帧的数值不可信", (unsigned long long)f); }
+        if (ran) {
+            for (int lv = 0; lv < nlv; lv++) copied += ubl[lv];
+            for (int j = 0; j < nj; j++) if (jb[j] && jt[j]) copied += (uint64_t)jrow[j] * jpx[j];
+            g_litb_bytes += copied;
+        }
+    }
+    uint64_t jnz[LITB_JOB_MAX], jmx[LITB_JOB_MAX]; double jmean[LITB_JOB_MAX];
+    for (int j = 0; j < LITB_JOB_MAX; j++) { jnz[j] = 0; jmx[j] = 0; jmean[j] = 0.0; }
+    if (ran) for (int j = 0; j < nj; j++) if (jb[j] && jt[j])
+        lit_stats((const uint8_t *)jb[j].contents, (size_t)jrow[j], (size_t)jpx[j], (size_t)jpx[j],
+                  jbpp[j], jt[j].pixelFormat, &jnz[j], &jmean[j], &jmx[j]);
+    // 4) 打行：writer 一行（第 0 级），每级一行 level=…（含 UBO 前 8 个 float），整数输入各一行 nonzero/mean/max
+    MLOG("[litback] writer ser=%llu pass=%llu key=%s c%d fmt=%#lx", (unsigned long long)lser[0],
+         (unsigned long long)lpass[0], g_litb_snap[lsnap[0]].key, lslot[0], (unsigned long)lpf[0]);
+    for (int lv = 0; lv < nlv; lv++) {
+        const litb_snap *sp = &g_litb_snap[lsnap[lv]];
+        char lab[24], val[240];
+        if (ran && ub[lv]) litb_ubo_floats(ub[lv], ubl[lv], lab, sizeof lab, val, sizeof val);
+        else { snprintf(lab, sizeof lab, "ubo=skip"); val[0] = 0; }
+        MLOG("[litback] level=%d ser=%llu pass=%llu key=%s c%d fmt=%#lx ubo reg=%d len=%llu %s%s ntex=%d nint=%d",
+             lv, (unsigned long long)lser[lv], (unsigned long long)lpass[lv], sp->key, lslot[lv], (unsigned long)lpf[lv],
+             sp->ubo_reg, (unsigned long long)sp->ubo_len, lab, val, sp->ntex, lint[lv]);
+        int show = g_litb_all || strcmp(g_litb_sig[lv], sp->key) || g_litb_sig_n[lv] != sp->ntex + lint[lv] * 100;
+        if (show) {   // 纹理清单 / 结论只在链形态变了时重打（S2A_LITBACK_ALL=1 每帧都打）
+            snprintf(g_litb_sig[lv], sizeof g_litb_sig[lv], "%s", sp->key);
+            g_litb_sig_n[lv] = sp->ntex + lint[lv] * 100;
+            for (int i = 0; i < sp->ntex; i++) {
+                const litb_tex *e = &sp->tex[i];
+                MLOG("[litback] level=%d tex reg=%u ser=%llu fmt=%#lx kind=%s type=%s int=%d %ux%u",
+                     lv, (unsigned)e->reg, (unsigned long long)e->ser, (unsigned long)e->pf,
+                     e->kind == NVN_RB_IMG ? "img" : "tex", litb_ttype((int)e->tt), (int)e->isint,
+                     (unsigned)e->w, (unsigned)e->h);
+            }
+            if (lint[lv] > 0) MLOG("[litback] level=%d verdict=has_int（这一遍读 G-buffer = 真正写场景色的那一遍）", lv);
+            else if (lnx[lv]) MLOG("[litback] level=%d verdict=post_process（输入没有整数纹理）next ser=%llu", lv, (unsigned long long)lnx[lv]);
+            else MLOG("[litback] level=%d verdict=no_int_no_writer（输入没有整数纹理，且没有可回退的写者）", lv);
+        }
+        for (int i = 0; i < sp->ntex; i++) {
+            const litb_tex *e = &sp->tex[i];
+            if (!e->isint) continue;
+            int j = jmap[lv][i];
+            if (j >= 0 && ran && jb[j] && jt[j])
+                MLOG("[litback] level=%d int ser=%llu reg=%u fmt=%#lx nonzero=%llu mean=%.1f max=%llu sample=%ux%u",
+                     lv, (unsigned long long)e->ser, (unsigned)e->reg, (unsigned long)e->pf,
+                     (unsigned long long)jnz[j], jmean[j], (unsigned long long)jmx[j], (unsigned)jpx[j], (unsigned)jpx[j]);
+            else
+                MLOG("[litback] level=%d int ser=%llu reg=%u fmt=%#lx readback=none（未取到纹理 / 格式读不回 / 预算用尽）",
+                     lv, (unsigned long long)e->ser, (unsigned)e->reg, (unsigned long)e->pf);
+        }
+    }
+}
+// ---------- S2Arm #427 壳内置诊断 [intsweep]：枚举本帧所有绑定整数纹理的 render pass 与 compute dispatch ----------
+// 背景（上一轮 [litin] 的结论）：固定的已知 key 名单只抓到两个遍，UBO 一看都不是延迟光照遍（一个是单位矩阵，一个是 1/屏幕尺寸）。
+//   这一版不再猜 key：任意 pass 的片元阶段只要绑定了 ≥1 张整数像素格式纹理（Uint / Sint，即 NVN_DPF_UINT / NVN_DPF_SINT；
+//   普通 UNORM / 浮点不算），就算命中。每帧最多记 8 个 pass + 8 个 dispatch（按 pass 号 / 派发去重；超出的只计数）。
+//   帧末（下一帧第一遍开遍之前）每帧最多打 INTS_SHOW(2) 个条目（int≥1 且读回 nonzero>0 的最优先），其余只计数；
+//   最后**无条件**一行汇总：
+//     [intsweep] frame <f> hits=<本帧命中的 pass + dispatch 总数> shown=<实际打出的条目数>
+//   每个命中的 pass 打一行（帧末，UBO 走 q_cb 拷回后）：
+//     [intsweep] frame <f> pass <n> key=<fs key> int=<数量> ubo reg=<r> len=<bytes> f0..f7=<v0,…,v7> out=<c0:ser:fmt,…>
+//   其中 UBO = 该阶段（fragment）绑定最大的 NVN_RB_CBUF 的前 8 个 float；out = 该 pass 的颜色附件（槽:序号:格式）。
+//   再对该 pass 的第一张整数纹理做一次 4×4 帧末读回：
+//     [intsweep] frame <f> pass <n> int tex reg=<r> ser=<s> fmt=0x.. nonzero=<n> mean=<v> max=<v> sample=4x4
+//   位置和安全约束与 [litdbg] / [litin] / [litback] 完全相同：帧号一变（下一帧第一遍开遍之前）rp_end → mtl_finish_gpu →
+//   旧队列 q_cb 一次 blit 到共享缓冲 → CPU 统计；pass 内只读绑定状态，零拷贝、不进任何命令缓冲、不建私有纹理。
+//   预算：每帧 ≤ (8 pass + 8 dispatch) × 256 B + 8 × 4×4 像素，累计上限 256 MB（S2A_LIT_DEBUG=0 整条关；S2A_INTSWEEP_DEBUG=0 只关本条）。
+enum { INTS_MAX = 16, INTS_PASS_MAX = 8, INTS_DISP_MAX = 8, INTS_COL_MAX = 8, INTS_SHOW = 2, INTS_UBO_MAXB = 256, INTS_PX = 4, INTS_BUDGET_MB = 256 };
+typedef struct {
+    uint64_t frame, pass;   // pass: render pass 号；dispatch 条目里是发生时的当前 pass 号
+    char key[24];
+    int nint;
+    int kind;               // 0 = render pass（片元阶段 1）/ 1 = compute dispatch（阶段 5）
+    uint64_t disp;          // kind 1：本帧第几次派发
+    int ubo_reg; uint64_t ubo_addr, ubo_len;
+    int int_reg, int_tid; uint64_t int_ser; uint32_t int_pf;
+    int ncol;
+    struct { uint64_t ser; uint32_t pf; uint8_t slot; } col[INTS_COL_MAX];
+    int nimg;               // kind 1：这个派发的整数 image 槽（out_img=）
+    struct { uint8_t reg; uint64_t ser; uint32_t pf; } img[INTS_COL_MAX];
+} ints_ent;
+static ints_ent g_ints[INTS_MAX];
+static int g_ints_n;                 // 本帧已记的 pass 数（帧末用完由 lit_td_note 清 0）
+static int g_ints_total;             // 本帧命中的 pass 总数（可能 > INTS_PASS_MAX，只计数）
+static int g_ints_np;                // 本帧已记的 pass 条目数
+static int g_ints_nd;                // 本帧已记的 dispatch 条目数
+static int g_ints_disp_total;        // 本帧命中的 dispatch 总数（可能 > INTS_DISP_MAX，只计数）
+static uint64_t g_ints_disp_n;       // 本帧 dispatch 序号
+static uint64_t g_ints_frame = ~0ull;   // 正在收集的帧号
+static uint64_t g_ints_bytes;        // 累计读回的字节数（预算 INTS_BUDGET_MB）
+static int g_ints_on = -1, g_ints_ovf, g_ints_budget_logged, g_ints_halt_logged, g_ints_submit_fail;
+static int intsweep_on(void) {   // 跟 [litdbg] / [litin] 一起开关：S2A_LIT_DEBUG=0 全关，S2A_INTSWEEP_DEBUG=0 只关本条
+    if (g_ints_on < 0) {
+        const char *e = getenv("S2A_INTSWEEP_DEBUG");
+        g_ints_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_ints_on) MLOG("S2A_INTSWEEP_DEBUG=0 / S2A_LIT_DEBUG=0: [intsweep] 整数纹理遍枚举关");
+    }
+    return g_ints_on;
+}
+static uint32_t ints_pf(int nvnfmt) {   // NVN 格式 → Metal 格式（认不出返回 0；只用来分类 / 打印）
+    uint32_t pf = 0; uint8_t sw[4];
+    if (!nvn_fmt_to_mtl(nvnfmt, &pf, sw) || !pf) return 0;
+    return pf;
+}
+// draw 里（每一遍的每一笔画都看，按 pass 号去重）：片元阶段 ≥1 张整数纹理就算命中，记下 UBO / 第一张整数纹理 / 颜色附件
+static void intsweep_note(NvShader *fs) {
+    if (!intsweep_on() || !fs) return;
+    uint64_t pass = g_stat_pass;
+    for (int i = 0; i < g_ints_n; i++) if (g_ints[i].kind == 0 && g_ints[i].pass == pass) return;   // 这个 pass 已经记过（去重按 pass 号；compute 条目不算）
+    int has_tex = 0;
+    for (int i = 0; i < fs->rf.nb; i++) { const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind == NVN_RB_TEX || b->kind == NVN_RB_IMG) { has_tex = 1; break; } }
+    if (!has_tex) return;   // 便宜路径：片元阶段没绑纹理的遍直接走开（每笔一次 O(rf.nb)，不取锁）
+    int nint = 0, first_reg = -1, first_tid = -1; uint64_t first_ser = 0; uint32_t first_pf = 0;
+    int ubo_reg = -1; uint64_t ubo_addr = 0, ubo_len = 0;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind == NVN_RB_CBUF) {   // 该阶段最大的常量缓冲（和 [litin] / [litback] 取法一样）
+            if (b->reg >= 16) continue;
+            const p_bind_buf *u = &S.ubo[1][b->reg];
+            if (u->addr && u->size && u->size > ubo_len) { ubo_addr = u->addr; ubo_len = u->size; ubo_reg = (int)b->reg; }
+            continue;
+        }
+        if (b->kind != NVN_RB_TEX && b->kind != NVN_RB_IMG) continue;   // 只看纹理槽（image 槽也认，kind 只影响取法）
+        uint64_t h = b->kind == NVN_RB_IMG ? (b->reg < 32 ? S.img[1][b->reg] : 0) : tex_slot_h(S.tex[1], S.img[1], b->reg);
+        int id_ = (int)(h & 0xfffff);
+        if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) continue;
+        const treg_t *r = &g_treg[id_];
+        if (!r->t.serial) continue;
+        int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+        uint32_t mpf = ints_pf(nf);
+        if (!mpf || mtl_pf_dpf((MTLPixelFormat)mpf) == NVN_DPF_FLOAT) continue;   // 只要整数像素格式（Uint / Sint）
+        nint++;
+        if (first_tid < 0) { first_reg = (int)b->reg; first_tid = id_; first_ser = r->t.serial; first_pf = mpf; }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    if (nint < 1) return;   // 这一遍没有整数纹理：不记（同一 pass 的下一笔画还会再看）
+    g_ints_total++;
+    if (g_ints_np >= INTS_PASS_MAX) {
+        if (!g_ints_ovf) { g_ints_ovf = 1;
+            MLOG("[intsweep] 本帧整数纹理 pass 已记满 %d 个：之后的只计数、不再记（帧末给总命中数）", INTS_PASS_MAX); }
+        return;
+    }
+    g_ints_np++;
+    ints_ent *e = &g_ints[g_ints_n++];
+    memset(e, 0, sizeof *e);
+    e->kind = 0;
+    e->frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    e->pass = pass; e->nint = nint; e->ubo_reg = ubo_reg; e->ubo_addr = ubo_addr; e->ubo_len = ubo_len;
+    e->int_reg = first_reg; e->int_tid = first_tid; e->int_ser = first_ser; e->int_pf = first_pf;
+    snprintf(e->key, sizeof e->key, "%s", fs->key);
+    for (int i = 0; i < R.rt.n && i < INTS_COL_MAX; i++) {   // 该 pass 的颜色附件（serial + 槽 + 格式）：判断这个遍写的是不是场景色
+        const tex_t *t = R.rt.color[i]; if (!t || !t->serial) continue;
+        int k = e->ncol++;
+        e->col[k].ser = t->serial; e->col[k].slot = (uint8_t)i;
+        int nf = R.rt.has_cview[i] && R.rt.cview[i].set_format ? (int)R.rt.cview[i].format : (int)t->d.format;
+        e->col[k].pf = ints_pf(nf);
+    }
+}
+// 帧末（下一帧第一遍之前，和 [litdbg] / [litin] / [litback] 同一个点）：每遍的 UBO 前 256 B + 第一张整数纹理正中 4×4
+// 一次性拷到共享缓冲，CPU 统计后打行。这是 [intsweep] 唯一的 GPU 工作：pass 都结束、GPU 已做完、旧队列上一次提交。
+// compute 派发（阶段 5）：和片元那套同一个口径，只是纹理槽换成 image / 采样 binding。
+//   命中（整数纹理 ≥ 1）就记一条 kind=1 的条目：UBO 取 S.ubo[5] 里最大的 CBUF，out_img= 列整数 image 槽。
+//   和 pass 条目共用 [intsweep] 的帧末读回：dispatch 条目只读 UBO（不做纹理 4×4），每帧最多 INTS_DISP_MAX 条。
+static void intsweep_disp_note(NvShader *cs) {
+    if (!intsweep_on() || !cs) return;
+    uint64_t d = ++g_ints_disp_n;   // 本帧 dispatch 序号（含没有纹理的派发，和 GPU 上的顺序一致）
+    int has = 0;
+    for (int i = 0; i < cs->rf.nb; i++) { const nvn_rbind *b = &cs->rf.b[i];
+        if (b->kind == NVN_RB_IMG || b->kind == NVN_RB_IMGU || b->kind == NVN_RB_TEX || b->kind == NVN_RB_TEXU || b->kind == NVN_RB_TBUF) { has = 1; break; } }
+    if (!has) return;   // 便宜路径：这个派发不读 / 不写任何纹理
+    int nint = 0, nimg = 0, ubo_reg = -1; uint64_t ubo_addr = 0, ubo_len = 0;
+    int first_reg = -1, first_tid = -1; uint64_t first_ser = 0; uint32_t first_pf = 0;
+    int img_reg[INTS_COL_MAX]; uint64_t img_ser[INTS_COL_MAX]; uint32_t img_pf[INTS_COL_MAX];
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < cs->rf.nb; i++) {
+        const nvn_rbind *b = &cs->rf.b[i];
+        if (b->kind == NVN_RB_CBUF) {   // 该阶段最大的常量缓冲（和片元那套取法一样）
+            if (b->reg >= 16) continue;
+            const p_bind_buf *u = &S.ubo[5][b->reg];
+            if (u->addr && u->size && u->size > ubo_len) { ubo_addr = u->addr; ubo_len = u->size; ubo_reg = (int)b->reg; }
+            continue;
+        }
+        int tid = -1;
+        if (b->kind == NVN_RB_IMG || b->kind == NVN_RB_IMGU) tid = img_tid(b, 5);
+        else if (b->kind == NVN_RB_TEX) tid = (int)(tex_slot_h(S.tex[5], S.img[5], b->reg) & 0xfffff);
+        else if (b->kind == NVN_RB_TEXU && !b->n) tid = ubo_tex_id(ubo_packed(5, b));
+        else continue;
+        if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+        const treg_t *r = &g_treg[tid];
+        if (!r->t.serial) continue;
+        int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+        uint32_t mpf = ints_pf(nf);
+        if (!mpf || mtl_pf_dpf((MTLPixelFormat)mpf) == NVN_DPF_FLOAT) continue;   // 只要整数像素格式（Uint / Sint）
+        nint++;
+        if (first_tid < 0) { first_reg = (int)b->reg; first_tid = tid; first_ser = r->t.serial; first_pf = mpf; }
+        if ((b->kind == NVN_RB_IMG || b->kind == NVN_RB_IMGU) && nimg < INTS_COL_MAX) {
+            img_reg[nimg] = (int)b->reg; img_ser[nimg] = r->t.serial; img_pf[nimg] = mpf; nimg++; }
+    }
+    pthread_mutex_unlock(&g_rmu);
+    if (nint < 1) return;
+    g_ints_disp_total++;
+    if (g_ints_nd >= INTS_DISP_MAX) return;   // 记满了：只计数（帧末给总数）
+    g_ints_nd++;
+    ints_ent *e = &g_ints[g_ints_n++];
+    memset(e, 0, sizeof *e);
+    e->kind = 1; e->disp = d;
+    e->frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    e->nint = nint; e->ubo_reg = ubo_reg; e->ubo_addr = ubo_addr; e->ubo_len = ubo_len;
+    e->int_reg = first_reg; e->int_tid = -1; e->int_ser = first_ser; e->int_pf = first_pf;   // dispatch 不做 4×4 读回
+    snprintf(e->key, sizeof e->key, "%s", cs->key);
+    e->nimg = nimg;
+    for (int k = 0; k < nimg; k++) { e->img[k].reg = (uint8_t)img_reg[k]; e->img[k].ser = img_ser[k]; e->img[k].pf = img_pf[k]; }
+}
+static void intsweep_dump(void) {
+    if (!intsweep_on() || g_ints_frame == ~0ull) return;   // 关掉本条 / 还没有上一帧：一行都不打
+    int n = g_ints_n;
+    int hits = g_ints_total + g_ints_disp_total;   // 本帧命中的 pass + dispatch 总数（含没记进条目表的）
+    if (n <= 0) {   // 这一帧没有命中：只打汇总（无条件一行，用来确认这段代码在跑）
+        MLOG("[intsweep] frame %llu hits=%d shown=0", (unsigned long long)g_ints_frame, hits);
+        return;
+    }
+    if (mtl_gpu_halted()) {
+        if (!g_ints_halt_logged) { g_ints_halt_logged = 1;
+            MLOG("【红】[intsweep] GPU 已安全停：整数纹理遍不再读回（原因看 [gpuerr] 那行）"); }
+        MLOG("[intsweep] frame %llu hits=%d shown=0", (unsigned long long)g_ints_frame, hits);
+        return;
+    }
+    // 1) 规划：每遍 UBO 前 256 B + 第一张整数纹理正中 4×4（纹理类型 / 格式不支持就不读，不影响打行）
+    id<MTLTexture> jt[INTS_MAX]; id<MTLBuffer> jb[INTS_MAX], ub[INTS_MAX], usrc[INTS_MAX];
+    NSUInteger jpx[INTS_MAX], jrow[INTS_MAX], ubl[INTS_MAX], uso[INTS_MAX];
+    size_t jbpp[INTS_MAX];
+    for (int i = 0; i < INTS_MAX; i++) {
+        jt[i] = nil; jb[i] = nil; jpx[i] = jrow[i] = ubl[i] = uso[i] = 0; jbpp[i] = 0; ub[i] = usrc[i] = nil;
+    }
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < n; i++) {
+        const ints_ent *e = &g_ints[i];
+        if (e->kind) continue;   // dispatch 条目只读 UBO
+        if (e->int_tid <= 0 || e->int_tid >= g_ntreg || !g_treg[e->int_tid].ok) continue;
+        if (g_treg[e->int_tid].t.serial != e->int_ser) continue;   // 同帧释放 / 序号变了：不读
+        id<MTLTexture> mt = tex_mtl(&g_treg[e->int_tid].t);   // 帧末没有 pass 打开，这里建 / 上传是安全的
+        if (!mt) continue;
+        MTLTextureType tt = mt.textureType;
+        if (tt == MTLTextureType2D || tt == MTLTextureType2DArray || tt == MTLTextureTypeCube
+            || tt == MTLTextureTypeCubeArray || tt == MTLTextureType3D) jt[i] = mt;
+    }
+    pthread_mutex_unlock(&g_rmu);
+    uint64_t need = 0;
+    for (int i = 0; i < n; i++) {
+        const ints_ent *e = &g_ints[i];
+        if (jt[i]) {
+            size_t bpp = mtl_pf_bytes(jt[i].pixelFormat);
+            NSUInteger px = MIN((NSUInteger)INTS_PX, MIN(jt[i].width, jt[i].height));
+            if (bpp && px) { jbpp[i] = bpp; jpx[i] = px; jrow[i] = (NSUInteger)((size_t)px * bpp);
+                             need += (uint64_t)jrow[i] * (uint64_t)px; }
+            else jt[i] = nil;   // 压缩 / 不认识的格式 / 尺寸为 0：这一遍只打清单
+        }
+        if (e->ubo_reg >= 0 && e->ubo_addr && e->ubo_len >= 4) {
+            void *mb = NULL; uint64_t mo = 0;
+            if (!nvn_be_addr(e->ubo_addr, 4, &mb, &mo) || !mb || (mo & 3)) continue;
+            id<MTLBuffer> sb = (__bridge id<MTLBuffer>)mb;
+            NSUInteger bmax = (NSUInteger)sb.length;
+            if (mo >= bmax) continue;
+            NSUInteger len = (NSUInteger)MIN(MIN(e->ubo_len, (uint64_t)INTS_UBO_MAXB), (uint64_t)(bmax - mo)) & ~(NSUInteger)3;
+            if (len < 4) continue;
+            usrc[i] = sb; uso[i] = (NSUInteger)mo; ubl[i] = len; need += len;
+        }
+    }
+    int do_read = need > 0 && g_ints_bytes + need <= ((uint64_t)INTS_BUDGET_MB << 20);
+    if (need > 0 && !do_read && !g_ints_budget_logged) { g_ints_budget_logged = 1;
+        MLOG("[intsweep] 读回预算 %d MB 用尽：之后只打 pass / 附件清单，不再读回（S2A_INTSWEEP_DEBUG=0 关）", INTS_BUDGET_MB); }
+    int ran = 0; uint64_t copied = 0;
+    if (do_read) {
+        rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+        mtl_finish_gpu();   // 上一帧的提交必须已经在 GPU 上做完，旧队列的拷贝才读得到这一帧的内容
+        for (int i = 0; i < n; i++) {
+            if (jt[i]) {
+                jb[i] = [g_dev newBufferWithLength:jrow[i] * jpx[i] options:MTLResourceStorageModeShared];
+                if (!jb[i]) jt[i] = nil;
+            }
+            if (ubl[i]) { ub[i] = [g_dev newBufferWithLength:ubl[i] options:MTLResourceStorageModeShared]; if (!ub[i]) ubl[i] = 0; }
+        }
+        id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        for (int i = 0; i < n; i++) {
+            if (ub[i] && usrc[i]) enc_b_copy_buffer(b, usrc[i], uso[i], ub[i], 0, ubl[i]);
+            if (jb[i] && jt[i]) {
+                NSUInteger ox = (jt[i].width - jpx[i]) / 2, oy = (jt[i].height - jpx[i]) / 2;   // 正中 4×4：角落可能是空区域
+                [b copyFromTexture:jt[i] sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(ox, oy, 0)
+                        sourceSize:MTLSizeMake(jpx[i], jpx[i], 1) toBuffer:jb[i] destinationOffset:0
+                 destinationBytesPerRow:jrow[i] destinationBytesPerImage:jrow[i] * jpx[i]];
+            }
+        }
+        [b endEncoding];
+        ran = cb_run(cb);
+        if (!ran && !g_ints_submit_fail) { g_ints_submit_fail = 1;
+            MLOG("【红】[intsweep] frame %llu: 帧末读回没提交（GPU 已安全停 / 提交被拒），这一帧的数值不可信",
+                 (unsigned long long)g_ints_frame); }
+        if (ran) {
+            for (int i = 0; i < n; i++) { if (ubl[i]) copied += ubl[i]; if (jb[i] && jt[i]) copied += (uint64_t)jrow[i] * (uint64_t)jpx[i]; }
+            g_ints_bytes += copied;
+        }
+    }
+    // 2) 打分：先按读回结果给每个条目排档（2 = int≥1 且读回 nonzero>0 最重要；1 = compute 派发（整数纹理必有，
+    //    但这一版不做读回）；0 = 其它），每帧只打最高档的前 INTS_SHOW(2) 个，其余只计数。
+    uint64_t nz[INTS_MAX], mx[INTS_MAX]; double mn[INTS_MAX]; int score[INTS_MAX];
+    for (int i = 0; i < n; i++) {
+        const ints_ent *e = &g_ints[i];
+        nz[i] = 0; mx[i] = 0; mn[i] = 0.0; score[i] = 0;
+        if (e->kind) { score[i] = 1; continue; }   // dispatch 条目没有纹理读回
+        if (ran && jb[i] && jt[i]) {
+            lit_stats((const uint8_t *)jb[i].contents, (size_t)jrow[i], (size_t)jpx[i], (size_t)jpx[i],
+                      jbpp[i], jt[i].pixelFormat, &nz[i], &mn[i], &mx[i]);
+            if (e->nint >= 1 && nz[i] > 0) score[i] = 2;
+        }
+    }
+    // 3) 打行：最多 INTS_SHOW(2) 个条目（按档从高到低），pass 条目两行（清单 + 4×4 读回），dispatch 条目一行
+    int shown = 0;
+    for (int rank = 2; rank >= 0 && shown < INTS_SHOW; rank--)
+    for (int i = 0; i < n && shown < INTS_SHOW; i++) {
+        const ints_ent *e = &g_ints[i];
+        if (score[i] != rank) continue;
+        shown++;
+        char vb[200]; size_t vo = 0; vb[0] = 0;
+        if (ran && ub[i] && ubl[i]) {
+            NSUInteger nf = ubl[i] / 4; if (nf > 8) nf = 8;
+            for (NSUInteger k = 0; k < nf; k++)
+                vo += snprintf(vb + vo, sizeof vb - vo, "%s%.6g", k ? "," : "", (double)((const float *)ub[i].contents)[k]);
+        } else snprintf(vb, sizeof vb, "none");
+        if (e->kind) {   // compute 派发：一行（UBO 前 8 个 float + 整数 image 槽清单），不做纹理读回
+            char ib[176]; size_t io = 0; ib[0] = 0;
+            for (int k = 0; k < e->nimg; k++)
+                io += snprintf(ib + io, sizeof ib - io, "%s%d:%llu:%#lx", k ? "," : "", (int)e->img[k].reg,
+                               (unsigned long long)e->img[k].ser, (unsigned long)e->img[k].pf);
+            if (!ib[0]) snprintf(ib, sizeof ib, "-");
+            MLOG("[intsweep] frame %llu dispatch %llu key=%s int=%d ubo reg=%d len=%llu f0..f7=%s out_img=%s",
+                 (unsigned long long)e->frame, (unsigned long long)e->disp, e->key, e->nint,
+                 e->ubo_reg, (unsigned long long)e->ubo_len, vb, ib);
+            continue;
+        }
+        char ob[176]; size_t oo = 0; ob[0] = 0;
+        for (int k = 0; k < e->ncol; k++)
+            oo += snprintf(ob + oo, sizeof ob - oo, "%sc%d:%llu:%#lx", k ? "," : "", (int)e->col[k].slot,
+                           (unsigned long long)e->col[k].ser, (unsigned long)e->col[k].pf);
+        if (!ob[0]) snprintf(ob, sizeof ob, "-");
+        MLOG("[intsweep] frame %llu pass %llu key=%s int=%d ubo reg=%d len=%llu f0..f7=%s out=%s",
+             (unsigned long long)e->frame, (unsigned long long)e->pass, e->key, e->nint,
+             e->ubo_reg, (unsigned long long)e->ubo_len, vb, ob);
+        if (ran && jb[i] && jt[i])
+            MLOG("[intsweep] frame %llu pass %llu int tex reg=%d ser=%llu fmt=%#lx nonzero=%llu mean=%.1f max=%llu sample=%ux%u",
+                 (unsigned long long)e->frame, (unsigned long long)e->pass, e->int_reg, (unsigned long long)e->int_ser,
+                 (unsigned long)jt[i].pixelFormat, (unsigned long long)nz[i], mn[i], (unsigned long long)mx[i],
+                 (unsigned)jpx[i], (unsigned)jpx[i]);
+        else
+            MLOG("[intsweep] frame %llu pass %llu int tex reg=%d ser=%llu fmt=%#lx readback=none（未取到纹理 / 类型不支持 / 格式读不回 / 预算用尽）",
+                 (unsigned long long)e->frame, (unsigned long long)e->pass, e->int_reg, (unsigned long long)e->int_ser,
+                 (unsigned long)e->int_pf);
+    }
+    // 4) 帧末汇总（无条件一行）：hits = 本帧命中的 pass + dispatch 总数，shown = 实际打出的条目数（≤2）
+    MLOG("[intsweep] frame %llu hits=%d shown=%d", (unsigned long long)g_ints_frame, hits, shown);
+}
+// ---------- S2Arm #427 壳内置诊断 [nobuf]：着色器声明了常量缓冲，实际却没绑 ----------
+// 背景：关键 pass 7d5ddb44c99c335d_b 在 [intsweep] 里是 ubo reg=-1 len=0。这一块不再猜 key，而是把
+//   片元 / compute 着色器反射里 kind==NVN_RB_CBUF 的每一个槽与当前绑定表 S.ubo[stage][reg] 逐个对上：
+//     [nobuf] frame <f> pass <n> key=<k> want_cbuf reg=<r> size=<n> got=none
+//     [nobuf] frame <f> dispatch <n> key=<k> want_cbuf reg=<r> size=<n> got=none
+//     [nobuf] frame <f> pass <n> key=<k> want_cbuf reg=<r> size=<n> got=len<L> want=<n>
+//   size = cb_extent.tsv 里该槽能读到的字节数（NvShader.cb_ext；0 = 表里没有这一项 → -1，未知）。
+//   got=none：S.ubo[stage][reg] 没有地址或长度 0（游戏没绑 / 解绑了）；got=len<L>：绑了但比期望短。
+//   每帧最多 NOBUF_SHOW(8) 条明细（超出只计数）；帧末（和 [writer600] / [intsweep] 同一个点）**无条件**一行汇总：
+//     [nobuf] frame <f> scanned=<本帧检查过的 draw/compute 数> missing_ubo=<本帧缺 / 绑短的槽数>
+//   scanned 每笔一次（含不读常量缓冲的着色器），所以「这一行在、scanned>0」就说明这段代码真的在跑。
+//   只读绑定状态：不拷贝、不进命令缓冲、不建纹理；每个 pass（按 key）每槽每帧一次。
+enum { NOBUF_SEEN = 512, NOBUF_SHOW = 8 };
+typedef struct { uint64_t frame, id, id2; int reg, kind; } nobuf_seen;
+static nobuf_seen g_nobuf_seen[NOBUF_SEEN];
+static int g_nobuf_seen_i;
+static uint64_t g_nobuf_frame = ~0ull;
+static int g_nobuf_on = -1, g_nobuf_lines, g_nobuf_disp_n, g_nobuf_scan, g_nobuf_miss;
+static int nobuf_on(void) {
+    if (g_nobuf_on < 0) {
+        const char *e = getenv("S2A_NOBUF_DEBUG");
+        g_nobuf_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_nobuf_on) MLOG("S2A_NOBUF_DEBUG=0 / S2A_LIT_DEBUG=0: [nobuf] 常量缓冲缺失检查关");
+    }
+    return g_nobuf_on;
+}
+static int nobuf_seen_q(uint64_t f, uint64_t id, uint64_t id2, int kind, int reg) {
+    for (int i = 0; i < NOBUF_SEEN; i++) { const nobuf_seen *s = &g_nobuf_seen[i];
+        if (s->frame == f && s->id == id && s->id2 == id2 && s->kind == kind && s->reg == reg) return 1; }
+    nobuf_seen *s = &g_nobuf_seen[g_nobuf_seen_i]; g_nobuf_seen_i = (g_nobuf_seen_i + 1) % NOBUF_SEEN;
+    s->frame = f; s->id = id; s->id2 = id2; s->kind = kind; s->reg = reg; return 0;
+}
+static void nobuf_note(NvShader *sh, int stage) {
+    if (!nobuf_on() || !sh) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    if (f != g_nobuf_frame) { g_nobuf_frame = f; g_nobuf_lines = 0; g_nobuf_disp_n = 0; g_nobuf_scan = 0; g_nobuf_miss = 0; }
+    g_nobuf_scan++;   // 本帧检查过的 draw / compute 数（每笔一次，含不读常量缓冲的）：汇总行用它证明这段代码在跑
+    int any = 0;
+    for (int i = 0; i < sh->rf.nb; i++) if (sh->rf.b[i].kind == NVN_RB_CBUF) { any = 1; break; }
+    if (!any) return;   // 便宜路径：这个着色器不读常量缓冲（每笔都只扫一遍 rf，不做去重查表）
+    int disp = stage == 5;
+    if (disp) g_nobuf_disp_n++;
+    uint64_t shp = (uint64_t)(size_t)sh;
+    uint64_t id = disp ? 0 : g_stat_pass;   // pass 条目按 (pass, 着色器, 槽) 去重；compute 按 (着色器, 槽) 每帧一次
+    const char *k = sh->key[0] ? sh->key : "?";
+    for (int i = 0; i < sh->rf.nb; i++) {
+        const nvn_rbind *b = &sh->rf.b[i];
+        if (b->kind != NVN_RB_CBUF || b->reg >= 16) continue;
+        const p_bind_buf *u = &S.ubo[stage][b->reg];
+        int want = sh->cb_ext[b->reg] ? (int)sh->cb_ext[b->reg] : -1;
+        int missing = !u->addr || !u->size;
+        int shortb = !missing && want > 0 && u->size < (uint64_t)want;
+        if (!missing && !shortb) continue;   // 正常绑定：每笔直接走开，不查去重表
+        if (nobuf_seen_q(f, id, shp, disp, (int)b->reg)) continue;
+        g_nobuf_miss++;   // 缺 / 绑短的槽数（含本帧超出 8 条没打出来的）
+        if (g_nobuf_lines >= NOBUF_SHOW) continue;   // 每帧最多 8 条明细，其余只进汇总行的 missing_ubo
+        g_nobuf_lines++;
+        if (missing) {
+            if (disp) MLOG("[nobuf] frame %llu dispatch %d key=%s want_cbuf reg=%d size=%d got=none",
+                           (unsigned long long)f, g_nobuf_disp_n, k, (int)b->reg, want);
+            else MLOG("[nobuf] frame %llu pass %llu key=%s want_cbuf reg=%d size=%d got=none",
+                      (unsigned long long)f, (unsigned long long)g_stat_pass, k, (int)b->reg, want);
+        } else {
+            if (disp) MLOG("[nobuf] frame %llu dispatch %d key=%s want_cbuf reg=%d size=%d got=len<%llu> want=%d",
+                           (unsigned long long)f, g_nobuf_disp_n, k, (int)b->reg, want, (unsigned long long)u->size, want);
+            else MLOG("[nobuf] frame %llu pass %llu key=%s want_cbuf reg=%d size=%d got=len<%llu> want=%d",
+                      (unsigned long long)f, (unsigned long long)g_stat_pass, k, (int)b->reg, want, (unsigned long long)u->size, want);
+        }
+    }
+}
+// 帧末（和 [intsweep] / [writer600] 同一个点，lit_td_note 里帧号一变就调）：**无条件**一行汇总。
+// scanned = 本帧 nobuf_note 被调用的次数（每笔 draw / 每次 compute 派发一次），missing_ubo = 本帧缺 / 绑短的槽数。
+// 这一行在、scanned>0 → 说明 [nobuf] 这段代码确实跑到了；missing_ubo=0 → 这一帧没有缺失（不是代码没跑）。
+static void nobuf_dump(uint64_t frame) {
+    if (!nobuf_on() || frame == ~0ull) return;   // ~0 = 还没有上一帧（第一遍之前）
+    int scan = 0, miss = 0;
+    if (g_nobuf_frame == frame) {   // 这一帧的计数还在：打出来并交账（下一帧从 0 重新计）
+        scan = g_nobuf_scan; miss = g_nobuf_miss;
+        g_nobuf_frame = 0; g_nobuf_scan = 0; g_nobuf_miss = 0; g_nobuf_lines = 0; g_nobuf_disp_n = 0;
+    }
+    MLOG("[nobuf] frame %llu scanned=%d missing_ubo=%d", (unsigned long long)frame, scan, miss);
+}
+// ---------- S2Arm #427 壳内置诊断 [w600x]：serial 600 的跨帧写者 / 提交序号对齐 / 上屏到底读了谁 ----------
+// 上一轮的结论和它对不上的地方：
+//   [writer600] 每帧 writers=0 kinds=-（600 在本帧没有 replay 可见的写者），可是 [litdbg] 学到上屏源就是 600 / 6，
+//   [intsweep] 里那个写整数纹理的后期 pass（7d5ddb44c99c335d_b 等）写的是 278 / 279 / 273 这类小目标。三者对不上：
+//   要么「写 600 的那一下」不在本帧（上一帧写的、下一帧上屏），要么 600 只是被采样 / 是别的纹理的别名。只加诊断：
+//   1) 写者从「本帧」扩到「最近 8 帧」（环形缓冲），每帧一行（帧末，和 [writer600] 同一个点，**无条件**打）：
+//        [w600x] frame <f> this_frame=<本帧写者数> recent=<最近 8 帧内的写者总数> last=<frame>:<kind>:<pass>:<key>
+//      recent=0 打 last=none。last = 窗口内最近一次写；frame > f 的（下一帧先跑的 compute）不算进这一帧。
+//   2) 提交序号对齐（present_now 里，一帧一行）：
+//        [w600x] frame <f> write_submit=<写 600 那次提交的栅栏号> present_submit=<上屏这一刻已提交的栅栏号> skew=<差> wframe=<写者所在帧> ser=<这次上屏的纹理序号>
+//      skew = present_submit − write_submit：0 = 写它的那次提交已经交出去（这帧的写赶在这次上屏之前）；
+//      -1 = 上屏跑在这一帧还在录制的时候（屏上还是上一帧）。还没记到任何写者时打 write_submit=none … skew=none。
+//      序号 = nvn_be_sub_commit 里 `++g_fence` 的那个栅栏号（段切不推进它），g_w6x_subseq 存最近一次已提交的值；
+//      写者侧记「正在录制的这次提交」= g_fence + 1（本文件里 gbufdbg 的 e->fence 就是这个口径）。copy / clear 的
+//      即时拷贝是另交的一条命令缓冲（q_cb + cb_put，g_fence 不推进它），那种写者的 write_submit 只能当近似值。
+//   3) 上屏读的到底是谁（present_now 里；绑定内容变了才打一组，最多 8 行；S2A_W6X_ALL=1 每帧都打）：
+//        [w600x] frame <f> present_tex idx=<i> reg=<r> ser=<s> fmt=0x.. kind=<2d|2darr|3d|cube|...> pser=<快照是给哪张记的> pf=<快照帧> pp=<那一遍>
+//      = 写「刚上屏那张」的那一遍，开遍时片元阶段绑的**全部** NVN_RB_TEX（按反射顺序，不只是第一个）。这直接回答
+//      「lit_src_note 取第一个绑定有没有取错」——它取的是第一条，取错了 [litdbg] 学到的「上屏源」就不是场景色。
+//      槽没绑 / 句柄无效也记一行（ser=0），那正是 lit_src_note 会跳过的位置。idx 是反射顺序的下标（0 = 第一个）。
+//      上屏源轮换（600 / 6）时快照不丢：下一帧有任何一次上屏就把它打出来，pser 说明它属于哪张。
+//   安全约束和 [writer600] 一样：pass 内只读绑定表 / 附件表，零拷贝、不进命令缓冲、不建纹理（kind / fmt 全从
+//   NVN 描述符算，不碰 tex_mtl）。锁只有 g_w6x_mu（写者每帧几笔、上屏每帧一次，代价可忽略）。
+//   S2A_LIT_DEBUG=0 整条关（横幅照打）；S2A_W6X_DEBUG=0 只关本条；序号跟 S2A_W600_SER 走（w600_ser()，和 [writer600] 同一个）。
+enum { W6X_RING = 8, W6X_TEX = 8 };
+typedef struct {   // 8 帧环形：frame % 8 那一格（frame 号对不上就是旧数据，不算）
+    uint64_t frame, n;                            // 这一帧的写者数
+    uint64_t last_frame, last_pass, last_sub;     // 这一帧最后一次写：帧 / pass / 提交栅栏
+    char last_kind[8], last_key[24];
+} w6x_fr;
+static w6x_fr g_w6x_ring[W6X_RING];
+static uint64_t g_w6x_last_frame = ~0ull, g_w6x_last_pass, g_w6x_last_sub;   // 全场最近一次写（present 的 skew 用）
+static char g_w6x_last_kind[8] = "-", g_w6x_last_key[24] = "-";
+typedef struct {   // present_now 要打的那一组：写「上屏那张」的那一遍片元阶段绑的纹理
+    uint64_t frame, pass, present_ser; int n, fresh;
+    struct { int reg; uint64_t ser; uint32_t fmt; const char *kind; } t[W6X_TEX];
+} w6x_snap;
+static w6x_snap g_w6x_snap;
+static pthread_mutex_t g_w6x_mu = PTHREAD_MUTEX_INITIALIZER;   // 写者在 submit 线程、上屏在显示链路线程：只护这一小块
+static int g_w6x_on = -1; static uint64_t g_w6x_pscan_pass = ~0ull;
+static int w6x_on(void) {
+    if (g_w6x_on < 0) {
+        const char *e = getenv("S2A_W6X_DEBUG");
+        g_w6x_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_w6x_on) MLOG("S2A_W6X_DEBUG=0 / S2A_LIT_DEBUG=0: [w600x] 跨帧写者 / 提交对齐 / 上屏源清单关");
+        for (int i = 0; i < W6X_RING; i++) g_w6x_ring[i].frame = ~0ull;   // 空环（帧 0 放进来的 0 不能当数据）
+    }
+    return g_w6x_on;
+}
+static const char *w6x_dtt_name(unsigned dtt) {   // 槽没绑时按反射声明的 Metal 纹理类型给个短名
+    switch ((MTLTextureType)dtt) {
+        case MTLTextureType1D: return "1d";
+        case MTLTextureType2D: return "2d";
+        case MTLTextureType3D: return "3d";
+        case MTLTextureType2DArray: return "2darr";
+        case MTLTextureTypeCube: return "cube";
+        case MTLTextureTypeCubeArray: return "cubearr";
+        case MTLTextureTypeTextureBuffer: return "buf";
+        default: return "?";
+    }
+}
+// 一次「新」写入（w600_rec 去重之后调）：更新环形格 + 全场最后一次。sub = 正在录制的这次提交的栅栏号。
+static void w6x_hist(uint64_t f, const char *kind, uint64_t pass, const char *key, uint64_t sub) {
+    pthread_mutex_lock(&g_w6x_mu);
+    w6x_fr *s = &g_w6x_ring[f % W6X_RING];
+    if (s->frame != f) { s->frame = f; s->n = 0; }
+    s->n++;
+    s->last_frame = f; s->last_pass = pass; s->last_sub = sub;
+    snprintf(s->last_kind, sizeof s->last_kind, "%s", kind);
+    snprintf(s->last_key, sizeof s->last_key, "%s", key && key[0] ? key : "-");
+    g_w6x_last_frame = f; g_w6x_last_pass = pass; g_w6x_last_sub = sub;
+    snprintf(g_w6x_last_kind, sizeof g_w6x_last_kind, "%s", kind);
+    snprintf(g_w6x_last_key, sizeof g_w6x_last_key, "%s", key && key[0] ? key : "-");
+    pthread_mutex_unlock(&g_w6x_mu);
+}
+// 开遍时 key 还不知道（render / clear 条目先建后补）：补进最近那一格，好让 last= 带上 key
+static void w6x_hist_key(uint64_t f, const char *kind, uint64_t pass, const char *key) {
+    if (!key || !key[0]) return;
+    pthread_mutex_lock(&g_w6x_mu);
+    if (g_w6x_last_frame == f && g_w6x_last_pass == pass && !strcmp(g_w6x_last_kind, kind))
+        snprintf(g_w6x_last_key, sizeof g_w6x_last_key, "%s", key);
+    w6x_fr *s = &g_w6x_ring[f % W6X_RING];
+    if (s->frame == f && s->last_frame == f && s->last_pass == pass && !strcmp(s->last_kind, kind))
+        snprintf(s->last_key, sizeof s->last_key, "%s", key);
+    pthread_mutex_unlock(&g_w6x_mu);
+}
+// 帧末（和 [writer600] / [nobuf] / [intsweep] 同一个点，frame = 刚收尾的那一帧）：**无条件**一行。
+static void w6x_dump(uint64_t frame) {
+    if (!w6x_on() || frame == ~0ull) return;
+    uint64_t this_n = 0, recent = 0, lf = 0, lp = 0; int have = 0;
+    char lk[8] = "-", lkp[24] = "-";
+    pthread_mutex_lock(&g_w6x_mu);
+    for (int i = 0; i < W6X_RING; i++) {
+        const w6x_fr *s = &g_w6x_ring[i];
+        if (s->frame == ~0ull || s->frame > frame || frame - s->frame >= (uint64_t)W6X_RING) continue;
+        if (s->frame == frame) this_n = s->n;
+        recent += s->n;
+        if (!have || s->last_frame > lf) {
+            have = 1; lf = s->last_frame; lp = s->last_pass;
+            snprintf(lk, sizeof lk, "%s", s->last_kind);
+            snprintf(lkp, sizeof lkp, "%s", s->last_key);
+        }
+    }
+    pthread_mutex_unlock(&g_w6x_mu);
+    if (!have)
+        MLOG("[w600x] frame %llu this_frame=%llu recent=%llu last=none",
+             (unsigned long long)frame, (unsigned long long)this_n, (unsigned long long)recent);
+    else
+        MLOG("[w600x] frame %llu this_frame=%llu recent=%llu last=%llu:%s:%llu:%s",
+             (unsigned long long)frame, (unsigned long long)this_n, (unsigned long long)recent,
+             (unsigned long long)lf, lk, (unsigned long long)lp, lkp);
+}
+// present_now 里调：提交序号对齐（同一帧一行）+ 上屏源清单（有新的快照才打一组）。
+// 只读：t 是 present_now 正在交出去的那张，不取 MTLTexture、不建纹理、不进命令缓冲。
+static void w6x_present_note(const tex_t *t) {
+    if (!w6x_on() || !t) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    uint64_t ps = atomic_load_explicit(&g_w6x_subseq, memory_order_relaxed);   // 上屏这一刻已提交到的栅栏号
+    static uint64_t align_f = ~0ull;
+    if (f != align_f) {   // 一帧一行（同一帧多次上屏不重复刷）
+        align_f = f;
+        uint64_t wf = 0, ws = 0; int have = 0;
+        pthread_mutex_lock(&g_w6x_mu); have = g_w6x_last_frame != ~0ull; wf = g_w6x_last_frame; ws = g_w6x_last_sub; pthread_mutex_unlock(&g_w6x_mu);
+        if (!have) MLOG("[w600x] frame %llu write_submit=none present_submit=%llu skew=none ser=%llu",
+                        (unsigned long long)f, (unsigned long long)ps, (unsigned long long)t->serial);
+        else MLOG("[w600x] frame %llu write_submit=%llu present_submit=%llu skew=%lld wframe=%llu ser=%llu",
+                  (unsigned long long)f, (unsigned long long)ws, (unsigned long long)ps,
+                  (long long)(ps - ws), (unsigned long long)wf, (unsigned long long)t->serial);
+    }
+    w6x_snap sn; int take = 0;
+    pthread_mutex_lock(&g_w6x_mu);
+    if (g_w6x_snap.fresh) { take = 1; g_w6x_snap.fresh = 0; sn = g_w6x_snap; }
+    pthread_mutex_unlock(&g_w6x_mu);
+    if (!take) return;   // 没有新快照：这一帧不上屏源清单（pser 说明快照是给哪张纹理记的）
+    // 内容没变就不重复刷（上一轮 [intsweep] 一局 1.9 万行的教训）；S2A_W6X_ALL=1 每帧都打
+    static int all = -1; static uint64_t sig; static int sig_n;
+    if (all < 0) { const char *e = getenv("S2A_W6X_ALL"); all = e && !strcmp(e, "1"); }
+    uint64_t ns = (uint64_t)sn.n * 1099511628211ull;
+    for (int i = 0; i < sn.n; i++)
+        ns = (ns ^ (uint64_t)sn.t[i].reg ^ (sn.t[i].ser << 8) ^ ((uint64_t)sn.t[i].fmt << 40)) * 1099511628211ull;
+    if (!all && ns == sig && sn.n == sig_n) return;
+    sig = ns; sig_n = sn.n;
+    for (int i = 0; i < sn.n; i++)
+        MLOG("[w600x] frame %llu present_tex idx=%d reg=%d ser=%llu fmt=%#x kind=%s pser=%llu pf=%llu pp=%llu",
+             (unsigned long long)f, i, sn.t[i].reg, (unsigned long long)sn.t[i].ser, (unsigned)sn.t[i].fmt,
+             sn.t[i].kind, (unsigned long long)sn.present_ser, (unsigned long long)sn.frame, (unsigned long long)sn.pass);
+}
+// draw 里（每一遍的第一笔画，和 lit_src_note 同一套认法）：这一遍写的是上屏那张（或按学到的片元 key 认）→ 把它
+//   片元阶段绑的全部 NVN_RB_TEX（按反射顺序，最多 8 个）记进快照，present_now 打。只读绑定表，零拷贝、不建纹理。
+static void w6x_present_scan(NvShader *fs) {
+    if (!w6x_on() || !fs) return;
+    uint64_t pass = g_stat_pass;
+    if (pass == g_w6x_pscan_pass) return;   // 每遍只看第一笔画：这时的纹理绑定属于这一遍
+    g_w6x_pscan_pass = pass;
+    if (!g_lit_present_seen) return;        // 还没交过上屏：不知道 present 那张的序号
+    int byser = 0;
+    for (int i = 0; i < R.rt.n && i < 8; i++)
+        if (R.rt.color[i] && R.rt.color[i]->serial == g_lit_present_ser) byser = 1;
+    if (!byser && !(g_lit_pkey[0] && !strcmp(fs->key, g_lit_pkey))) return;
+    w6x_snap sn; memset(&sn, 0, sizeof sn);
+    sn.frame = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    sn.pass = pass; sn.present_ser = g_lit_present_ser;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb && sn.n < W6X_TEX; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind != NVN_RB_TEX) continue;
+        int idx = sn.n++;
+        sn.t[idx].reg = (int)b->reg;
+        int tid = (int)(tex_slot_h(S.tex[1], S.img[1], b->reg) & 0xfffff);
+        if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok || !g_treg[tid].t.serial) {   // 没绑：lit_src_note 就是在这里 continue 的
+            sn.t[idx].ser = 0; sn.t[idx].fmt = 0; sn.t[idx].kind = w6x_dtt_name(b->dtt);
+            continue;
+        }
+        const treg_t *r = &g_treg[tid];
+        int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+        int tt = r->has_v && r->v.set_target ? (int)r->v.target : (int)r->t.d.target;
+        sn.t[idx].ser = r->t.serial;
+        sn.t[idx].fmt = ints_pf(nf);
+        sn.t[idx].kind = litb_ttype(tt);
+    }
+    pthread_mutex_unlock(&g_rmu);
+    if (!sn.n) return;
+    pthread_mutex_lock(&g_w6x_mu); g_w6x_snap = sn; g_w6x_snap.fresh = 1; pthread_mutex_unlock(&g_w6x_mu);
+}
+// ---------- S2Arm #427 壳内置诊断 [writer600]：这一帧谁写了 serial 600 ----------
+// 上屏源是 serial 600 / 6，但写它们的链没被 [litdbg] / [litback] 覆盖到（可能含 compute）。这一块把 render pass 的
+//   颜色附件（开遍时）、它的第一笔片元 key（draw 里补）、compute 的 image store（rw 的 IMG / IMGU）、copy 目的地、
+//   纹理 clear 全部对上 600（S2A_W600_SER 可改，默认 600）。帧末（和 [nobuf] / [intsweep] 同一个点）**无条件**一行汇总：
+//     [writer600] frame <f> writers=<本帧写者数> kinds=<出现过的种类，按 render,compute,copy,clear 顺序；没有写者时 kinds 打一个横杠>
+//   有写者时最多再列 W600_SHOW(4) 条明细（超出的只计数）：
+//     [writer600] frame <f> kind=<render|compute|copy|clear> pass=<n> key=<k>
+//   pass 对 compute / copy / clear 是发生时的当前 pass 号；key 对 copy / clear 是 `-`。只读状态，零拷贝。
+enum { W600_MAX = 32, W600_SHOW = 4 };
+typedef struct { uint64_t frame, pass, ser; char kind[8], key[24]; } w600_ent;
+static w600_ent g_w600[W600_MAX];
+static int g_w600_n, g_w600_ovf, g_w600_on = -1;
+static uint64_t g_w600_ser;
+static uint64_t w600_ser(void) {
+    if (!g_w600_ser) { const char *e = getenv("S2A_W600_SER"); g_w600_ser = e && *e ? strtoull(e, NULL, 0) : 600; if (!g_w600_ser) g_w600_ser = 600; }
+    return g_w600_ser;
+}
+static int w600_on(void) {
+    if (g_w600_on < 0) { const char *e = getenv("S2A_W600_DEBUG");
+        g_w600_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_w600_on) MLOG("S2A_W600_DEBUG=0 / S2A_LIT_DEBUG=0: [writer600] 写者记录关");
+    }
+    return g_w600_on;
+}
+// 记一个写者（按 frame + kind + pass + serial 去重；render 条目开遍时 key 未知、由第一笔 draw 补上）
+static void w600_rec(const char *kind, uint64_t pass, const char *key, uint64_t ser) {
+    if (!w600_on() || ser != w600_ser()) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    for (int i = 0; i < g_w600_n; i++) { w600_ent *e = &g_w600[i];
+        if (e->frame != f || e->pass != pass || e->ser != ser || strcmp(e->kind, kind)) continue;
+        if (key && key[0] && !e->key[0]) { snprintf(e->key, sizeof e->key, "%s", key); w6x_hist_key(f, kind, pass, key); }   // S2Arm #427 [w600x]：开遍时缺的 key 也补进 8 帧环
+        return; }
+    if (g_w600_n >= W600_MAX) { g_w600_ovf++; w6x_hist(f, kind, pass, key, g_fence + 1); return; }   // S2Arm #427 [w600x]：溢出的写者照样进 8 帧环（[writer600] 的 writers 已经把它算进总数）
+    w600_ent *e = &g_w600[g_w600_n++];
+    e->frame = f; e->pass = pass; e->ser = ser;
+    snprintf(e->kind, sizeof e->kind, "%s", kind);
+    snprintf(e->key, sizeof e->key, "%s", key && key[0] ? key : "-");
+    w6x_hist(f, kind, pass, key, g_fence + 1);   // S2Arm #427 [w600x]：最近 8 帧的写者 / 最后一次写（g_fence + 1 = 正在录制的这次提交）
+}
+static void w600_rec_att(uint64_t ser, int clear, uint64_t pass) { w600_rec(clear ? "clear" : "render", pass, "", ser); }
+// draw 里（每遍每一笔都看，按 pass 去重）：这一遍的颜色附件里有 600 就把片元 key 补进开遍时记下的那条
+static void w600_draw_scan(NvShader *fs) {
+    if (!w600_on()) return;
+    for (int i = 0; i < R.rt.n && i < 8; i++) { const tex_t *t = R.rt.color[i];
+        if (t && t->serial) w600_rec("render", g_stat_pass, fs ? fs->key : "", t->serial); }
+}
+// compute：rw 的 image 槽（IMG / IMGU）指向的纹理序号是 600 就是 compute 写者
+static void w600_dispatch_scan(NvShader *cs) {
+    if (!w600_on() || !cs) return;
+    int rw = 0;
+    for (int i = 0; i < cs->rf.nb; i++) { const nvn_rbind *b = &cs->rf.b[i];
+        if (b->rw && ((b->kind == NVN_RB_IMG && b->reg < 32) || b->kind == NVN_RB_IMGU)) { rw = 1; break; } }
+    if (!rw) return;
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < cs->rf.nb; i++) { const nvn_rbind *b = &cs->rf.b[i];
+        if (!b->rw || (b->kind != NVN_RB_IMG && b->kind != NVN_RB_IMGU)) continue;
+        int tid = img_tid(b, 5);
+        if (tid <= 0 || tid >= g_ntreg || !g_treg[tid].ok) continue;
+        uint64_t ser = g_treg[tid].t.serial;
+        if (ser) w600_rec("compute", g_stat_pass, cs->key, ser); }
+    pthread_mutex_unlock(&g_rmu);
+}
+static void w600_copy_hook(uint64_t ser, const char *kind) { w600_rec(kind, g_stat_pass, "", ser); }
+// 帧末（和 [nobuf] / [intsweep] 同一个点，lit_td_note 里帧号一变就调 frame=刚收尾的那一帧）：先无条件打一行汇总，
+//   有写者时再最多列 W600_SHOW(4) 条明细。帧内若有 compute 先于下一帧第一遍开跑，它的条目 frame 更大，留到下一次汇总。
+static void w600_dump(uint64_t frame) {
+    if (!w600_on() || frame == ~0ull) return;   // ~0 = 还没有上一帧（第一遍之前）
+    static const char *KIND[4] = { "render", "compute", "copy", "clear" };
+    int per[4] = { 0, 0, 0, 0 }, tot = 0, keep = 0, shown = 0;
+    for (int i = 0; i < g_w600_n; i++) {
+        const w600_ent *e = &g_w600[i];
+        if (e->frame > frame) { g_w600[keep++] = g_w600[i]; continue; }   // 下一帧的条目留着
+        tot++;
+        for (int k = 0; k < 4; k++) if (!strcmp(e->kind, KIND[k])) per[k]++;
+    }
+    tot += g_w600_ovf; g_w600_ovf = 0;   // 超过 W600_MAX 没记下来的写者也并进总数（种类就不知道了）
+    char kb[48]; size_t ko = 0; kb[0] = 0;
+    for (int k = 0; k < 4; k++) if (per[k]) ko += snprintf(kb + ko, sizeof kb - ko, "%s%s", ko ? "," : "", KIND[k]);
+    if (!kb[0]) snprintf(kb, sizeof kb, "-");
+    MLOG("[writer600] frame %llu writers=%d kinds=%s", (unsigned long long)frame, tot, kb);
+    for (int i = 0; i < g_w600_n && shown < W600_SHOW; i++) {
+        const w600_ent *e = &g_w600[i];
+        if (e->frame > frame) continue;
+        MLOG("[writer600] frame %llu kind=%s pass=%llu key=%s", (unsigned long long)e->frame, e->kind, (unsigned long long)e->pass, e->key);
+        shown++;
+    }
+    g_w600_n = keep;
+}
+
+// ---------- S2Arm #427 壳内置诊断 [bytgt]：按「尺寸 + 格式」统计 1600x900 RGBA16Float 的颜色目标 ----------
+// 上一轮（[w600x]）的结论：上屏遍的第一个绑定每帧轮换（600 / 6 / 203 / 636 / 412 / 43874 …，fmt 0x46 / 0x98 混着），
+//   write_submit=none 也说明它不是普通 render pass 写的；所以 [litdbg] 学到的「上屏源」平均 0.1–0.2 不是场景色。
+//   [intsweep] 里后期链的中间目标常是 1600x900、fmt 0x46（RGBA16Float），例如 278 / 279 / 273。
+//   这一版不再猜序号 / key，也不跟上屏纹理：每一遍开遍时枚举它的**全部**颜色附件，只留下
+//     (a) 画布尺寸 = 当前 3D 渲染分辨率（默认 1600x900，S2A_BYTGT_SIZE=WxH 可改；S2A_RES_SCALE 时按画布比，不按缩小后的存储）
+//     (b) 颜色附件是 float 类（mtl_pf_dpf == NVN_DPF_FLOAT，排除 Uint / Sint 的 G-buffer；可再收窄，见下）
+//   的目标，按 serial 去重，记下「最后写它的 pass 号」和「那一遍第一笔片元的 key」（和 [writer600] 同一套补 key 的时机）。
+//   格式口径（重要）：[intsweep] 的 out= / [litback] 的 fmt= 打的是 Metal 像素格式，本引擎的对照表（nv n_fmt_mtl.c）里
+//   0x46 = RGBA8Unorm、0x5c = RG11B10Float、0x41 = RG16Float、0x73 = RGBA16Float。所以「1600x900、fmt 0x46」其实是
+//   RGBA8Unorm 的后期目标，真正的 RGBA16Float 是 0x73；只认 0x73 一帧都筛不到。默认按 float 类收（0x46 / 0x5c / 0x41 / 0x73
+//   都在内，正好是 [intsweep] 里 278 / 279 / 273 那条链），每行打真实 fmt；S2A_BYTGT_FMT=0x46 / 0x5c / 0x73 只留一种，
+//   =any 连整数目标也要。
+//   帧末（和 [writer600] / [w600x] / [intsweep] 同一个点）取最后被写的 BYT_SHOW(3) 个，走 [litdbg] 那条安全读回
+//   （pass 都结束、GPU 已做完 → rp_end → mtl_finish_gpu → q_cb 一次 blit 到共享缓冲 → CPU 统计 RGB），每个打一行：
+//     [bytgt] frame <f> ser=<s> fmt=0x.. <w>x<h> writer_pass=<n> writer_key=<k> nonzero=<n> mean=<v> max=<v> rgb_only=1
+//   每个 serial 第一次出现时另打一行（排在该帧的统计行之前）：
+//     [bytgt] first ser=<s> writer_pass=<n> key=<k> fmt=0x.. <w>x<h>
+//   一帧一个都筛不到时打 [bytgt] frame <f> none（确认这段代码在跑）。
+//   安全约束和 [litdbg] / [intsweep] 相同：pass 内只读附件表，零拷贝、不进命令缓冲、不建纹理；唯一的 GPU 拷贝在帧末、
+//   旧队列的一次提交里（不在任何 pass 内，也不往 Metal 4 回放流里塞拷贝，不会重演 2385dabd4d91f5ba 的 MTL4 队列错误）。
+//   开关跟 [litdbg] 一起：S2A_LIT_DEBUG=0 整条关；S2A_BYTGT_DEBUG=0 只关本条。
+enum { BYT_MAX = 16, BYT_SHOW = 3, BYT_SEEN = 64 };
+typedef struct {
+    uint64_t frame, pass;          // frame：正在收集的帧号；pass：最后一次写它的 render pass 号
+    uint64_t ser; uint32_t pf;     // 目标序号 / 附件像素格式（Metal，0x46 = RGBA16Float）
+    NSUInteger w, h, lv, sl;       // 附件（存储）尺寸 / mip 级 / 层（帧末读回用）
+    char key[24];                  // 那一遍第一笔片元的 key（draw 里补；空 = 这一遍没有 draw / 还没补到）
+} byt_ent;
+static byt_ent g_byt[BYT_MAX];
+static __strong id<MTLTexture> g_byt_tex[BYT_MAX];   // 开遍时的附件（帧末读回用；同一 serial 后写的覆盖先前的）
+static int g_byt_n;
+static uint64_t g_byt_seen[BYT_SEEN]; static int g_byt_nseen;
+static int g_byt_on = -1, g_byt_halt_logged, g_byt_submit_fail, g_byt_tw, g_byt_th;
+static int g_byt_fmt = -2;   // -2 未初始化；-1 = float 类（默认）；-3 = 任意（含整数）；≥0 = 只认这个 Metal 像素格式
+static int bytgt_on(void) {
+    if (g_byt_on < 0) {
+        const char *e = getenv("S2A_BYTGT_DEBUG");
+        g_byt_on = lit_on() && !(e && !strcmp(e, "0"));
+        if (!g_byt_on) MLOG("S2A_BYTGT_DEBUG=0 / S2A_LIT_DEBUG=0: [bytgt] 1600x900 RGBA16Float 颜色目标统计关");
+    }
+    return g_byt_on;
+}
+static int bytgt_fmt_ok(uint32_t pf) {   // 格式口径（见块首）：默认 float 类；S2A_BYTGT_FMT=<0x..> 只留一种，=any 含整数
+    if (g_byt_fmt == -2) {
+        const char *e = getenv("S2A_BYTGT_FMT");
+        g_byt_fmt = -1;
+        if (e && *e) {
+            if (!strcmp(e, "any")) g_byt_fmt = -3;
+            else { char *end = NULL; unsigned long v = strtoul(e, &end, 0);
+                   if (end && *end == 0 && v > 0 && v <= 0xffff) g_byt_fmt = (int)v; }
+        }
+        if (g_byt_fmt == -1)
+            MLOG("[bytgt] 格式 = float 类（mtl_pf_dpf == NVN_DPF_FLOAT，排除 Uint / Sint 的 G-buffer）；每行打真实 fmt"
+                 "（本引擎 0x46 = RGBA8Unorm、0x5c = RG11B10Float、0x41 = RG16Float、0x73 = RGBA16Float；"
+                 "S2A_BYTGT_FMT=0x46/0x5c/0x73 只留一种，=any 含整数）");
+        else if (g_byt_fmt == -3) MLOG("[bytgt] 格式 = any（含整数颜色目标；S2A_BYTGT_FMT=any）");
+        else MLOG("[bytgt] 格式 = 只留 Metal 像素格式 %#x（S2A_BYTGT_FMT）", (unsigned)g_byt_fmt);
+    }
+    if (g_byt_fmt == -3) return 1;
+    if (g_byt_fmt >= 0) return (int)pf == g_byt_fmt;
+    return mtl_pf_dpf((MTLPixelFormat)pf) == NVN_DPF_FLOAT;
+}
+static void bytgt_size(NSUInteger *w, NSUInteger *h) {
+    if (!g_byt_tw) {
+        int a = 1600, b = 900;
+        const char *e = getenv("S2A_BYTGT_SIZE");
+        if (e && *e) { int x = 0, y = 0; if (sscanf(e, "%dx%d", &x, &y) == 2 && x > 0 && y > 0) { a = x; b = y; } }
+        g_byt_tw = a; g_byt_th = b;
+        MLOG("[bytgt] 目标尺寸 %dx%d（%s；格式过滤见下一行）", a, b,
+             e && *e ? "S2A_BYTGT_SIZE" : "默认 = 本作 3D 渲染分辨率，S2A_RES_SCALE 时按画布比");
+    }
+    *w = (NSUInteger)g_byt_tw; *h = (NSUInteger)g_byt_th;
+}
+// 开遍时（rp_begin_ex_ 里，和 w600_rec_att 同一个点）：这一遍的颜色附件里尺寸 + 格式都对上的，记下 / 更新「最后写者」。
+//   只读附件表与 R.rt（submit 线程）；不开命令缓冲、不建纹理、不取锁。
+static void bytgt_att_note(MTL4RenderPassDescriptor *pd, NSUInteger nc) {
+    if (!bytgt_on() || !pd) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    NSUInteger tw, th; bytgt_size(&tw, &th);
+    for (NSUInteger i = 0; i < nc && i < 8; i++) {
+        id<MTLTexture> mt = pd.colorAttachments[i].texture; if (!mt) continue;
+        const tex_t *tt = i < (NSUInteger)R.rt.n ? R.rt.color[i] : NULL;
+        if (!tt || !tt->serial) continue;
+        uint32_t pf = (uint32_t)mt.pixelFormat;
+        if (!bytgt_fmt_ok(pf)) continue;   // 默认 float 类（0x46 / 0x5c / 0x41 / 0x73…）；S2A_BYTGT_FMT 可收窄
+        NSUInteger cw, ch; rs_canvas(mt, 0, &cw, &ch);   // S2A_RES_SCALE：按画布比，不按缩小后的存储
+        if (cw != tw || ch != th) continue;
+        int k = -1;
+        for (int j = 0; j < g_byt_n; j++) if (g_byt[j].frame == f && g_byt[j].ser == tt->serial) { k = j; break; }
+        if (k < 0) {
+            if (g_byt_n >= BYT_MAX) continue;   // 一帧最多记 BYT_MAX 个（候选本来就少，溢出不常见）
+            k = g_byt_n++;
+            g_byt[k].frame = f; g_byt[k].ser = tt->serial; g_byt[k].key[0] = 0;
+        }
+        byt_ent *e = &g_byt[k];
+        if (e->pass != g_pass.serial) e->key[0] = 0;   // 换了一遍写它：key 由这一遍的第一笔 draw 重新补
+        e->pass = g_pass.serial;
+        e->pf = pf; e->w = mt.width; e->h = mt.height;
+        e->lv = pd.colorAttachments[i].level;
+        e->sl = mt.textureType == MTLTextureType2DArray ? pd.colorAttachments[i].slice : 0;
+        g_byt_tex[k] = mt;
+    }
+}
+// draw 里（每一遍的每一笔画都看，和 w600_draw_scan 同一个点）：把这一遍第一笔片元的 key 补进本遍记下的目标。
+static void bytgt_draw_scan(NvShader *fs) {
+    if (!bytgt_on() || !fs) return;
+    uint64_t f = atomic_load_explicit(&g_cur_frame, memory_order_relaxed);
+    for (int i = 0; i < g_byt_n; i++) {
+        byt_ent *e = &g_byt[i];
+        if (e->frame != f || e->pass != g_stat_pass || e->key[0]) continue;   // 只补「这一遍、还没有 key」的
+        snprintf(e->key, sizeof e->key, "%s", fs->key[0] ? fs->key : "-");
+    }
+}
+// 交出某一帧的条目：更晚帧的条目留着（开遍钩子在 td_note 之后跑，下一次 dump 前不会有；保险起见不丢）
+static void bytgt_retire(uint64_t frame) {
+    int keep = 0;
+    for (int i = 0; i < g_byt_n; i++) {
+        if (g_byt[i].frame == frame) { g_byt_tex[i] = nil; continue; }
+        if (keep != i) { g_byt[keep] = g_byt[i]; g_byt_tex[keep] = g_byt_tex[i]; g_byt_tex[i] = nil; }
+        keep++;
+    }
+    g_byt_n = keep;
+}
+// 帧末：先给本帧第一次出现的 serial 打 first 行（每个 serial 全场一次），再挑最后被写的 3 个读回并打统计行。
+//   读回路径与 [litdbg] / [intsweep] 完全相同：只在这里、pass 都结束之后、旧队列一次提交。
+static void bytgt_dump(uint64_t frame) {
+    if (!bytgt_on() || frame == ~0ull) return;   // ~0 = 还没有上一帧（第一遍之前）
+    int np = 0, pick[BYT_SHOW];
+    for (int k = 0; k < BYT_SHOW; k++) {
+        int best = -1;
+        for (int i = 0; i < g_byt_n; i++) {
+            const byt_ent *e = &g_byt[i];
+            if (e->frame != frame) continue;
+            int used = 0; for (int j = 0; j < np; j++) if (pick[j] == i) { used = 1; break; }
+            if (used) continue;
+            if (best < 0 || e->pass > g_byt[best].pass) best = i;   // 最后被写的 pass 号越大越新；同号取先记的
+        }
+        if (best >= 0) pick[np++] = best;
+    }
+    if (!np) {   // 这一帧一个 1600x900 RGBA16Float 颜色目标都没有（确认这段代码在跑）
+        MLOG("[bytgt] frame %llu none", (unsigned long long)frame);
+        bytgt_retire(frame);
+        return;
+    }
+    for (int i = 0; i < g_byt_n; i++) {   // first 行：候选里每个 serial 第一次出现（不限于下面挑中的 3 个）
+        const byt_ent *e = &g_byt[i];
+        if (e->frame != frame) continue;
+        int seen = 0; for (int j = 0; j < g_byt_nseen; j++) if (g_byt_seen[j] == e->ser) { seen = 1; break; }
+        if (seen || g_byt_nseen >= BYT_SEEN) continue;
+        g_byt_seen[g_byt_nseen++] = e->ser;
+        MLOG("[bytgt] first ser=%llu writer_pass=%llu key=%s fmt=%#x %lux%lu",
+             (unsigned long long)e->ser, (unsigned long long)e->pass, e->key[0] ? e->key : "-",
+             (unsigned)e->pf, (unsigned long)e->w, (unsigned long)e->h);
+    }
+    if (mtl_gpu_halted()) {   // GPU 已安全停：不在这条路上再提交命令缓冲
+        if (!g_byt_halt_logged) { g_byt_halt_logged = 1;
+            MLOG("【红】[bytgt] GPU 已安全停：1600x900 RGBA16Float 目标不再读回（原因看 [gpuerr] 那行）"); }
+        for (int k = 0; k < np; k++) { const byt_ent *e = &g_byt[pick[k]];
+            MLOG("[bytgt] frame %llu ser=%llu fmt=%#x %lux%lu writer_pass=%llu writer_key=%s readback=none",
+                 (unsigned long long)frame, (unsigned long long)e->ser, (unsigned)e->pf, (unsigned long)e->w,
+                 (unsigned long)e->h, (unsigned long long)e->pass, e->key[0] ? e->key : "-"); }
+        bytgt_retire(frame);
+        return;
+    }
+    // 1) 规划：只读 2D / 2DArray、非多重采样；单张 ≤ 64 MB（1600x900 RGBA16F = 11.5 MB）
+    id<MTLBuffer> buf[BYT_SHOW]; size_t rows[BYT_SHOW], bpp[BYT_SHOW];
+    NSUInteger rw[BYT_SHOW], rh[BYT_SHOW]; int ok[BYT_SHOW];
+    for (int k = 0; k < np; k++) {
+        const byt_ent *e = &g_byt[pick[k]];
+        id<MTLTexture> t = g_byt_tex[pick[k]];
+        buf[k] = nil; rows[k] = 0; bpp[k] = 0; rw[k] = rh[k] = 0; ok[k] = 0;
+        if (!t) continue;
+        if (t.textureType != MTLTextureType2D && t.textureType != MTLTextureType2DArray) continue;
+        if (t.sampleCount != 1) continue;
+        bpp[k] = mtl_pf_bytes(t.pixelFormat); if (!bpp[k]) continue;
+        NSUInteger lv = e->lv; if (lv > 16) continue;
+        NSUInteger w = MAX(t.width >> lv, (NSUInteger)1), h = MAX(t.height >> lv, (NSUInteger)1);
+        if ((uint64_t)w * (uint64_t)h * (uint64_t)bpp[k] > (64ull << 20)) continue;
+        rw[k] = w; rh[k] = h; rows[k] = (size_t)w * bpp[k];
+        buf[k] = [g_dev newBufferWithLength:rows[k] * (size_t)h options:MTLResourceStorageModeShared];
+        if (!buf[k]) { rows[k] = 0; continue; }
+        ok[k] = 1;
+    }
+    int need = 0; for (int k = 0; k < np; k++) if (ok[k]) need = 1;
+    int ran = 0;
+    if (need) {
+        rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+        mtl_finish_gpu();   // 上一帧的提交必须已经在 GPU 上做完，旧队列的拷贝才读得到这一帧的内容
+        id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        for (int k = 0; k < np; k++) {
+            if (!ok[k]) continue;
+            [b copyFromTexture:g_byt_tex[pick[k]] sourceSlice:g_byt[pick[k]].sl sourceLevel:g_byt[pick[k]].lv
+                  sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(rw[k], rh[k], 1)
+                      toBuffer:buf[k] destinationOffset:0 destinationBytesPerRow:rows[k] destinationBytesPerImage:rows[k] * rh[k]];
+        }
+        [b endEncoding];
+        ran = cb_run(cb);
+        if (!ran && !g_byt_submit_fail) { g_byt_submit_fail = 1;
+            MLOG("【红】[bytgt] frame %llu: 帧末读回没提交（GPU 已安全停 / 提交被拒），这一帧的数值不可信", (unsigned long long)frame); }
+    }
+    // 2) 打行：每个挑中的目标一行（格式固定；读不回时只把统计段换成 readback=none）
+    for (int k = 0; k < np; k++) {
+        const byt_ent *e = &g_byt[pick[k]];
+        if (ran && ok[k]) {
+            uint64_t nz = 0, mx = 0; double mean = 0.0;
+            lit_stats((const uint8_t *)buf[k].contents, rows[k], rw[k], rh[k], bpp[k], g_byt_tex[pick[k]].pixelFormat, &nz, &mean, &mx);
+            MLOG("[bytgt] frame %llu ser=%llu fmt=%#x %lux%lu writer_pass=%llu writer_key=%s nonzero=%llu mean=%.1f max=%llu rgb_only=1",
+                 (unsigned long long)frame, (unsigned long long)e->ser, (unsigned)e->pf, (unsigned long)e->w,
+                 (unsigned long)e->h, (unsigned long long)e->pass, e->key[0] ? e->key : "-",
+                 (unsigned long long)nz, mean, (unsigned long long)mx);
+        } else {
+            MLOG("[bytgt] frame %llu ser=%llu fmt=%#x %lux%lu writer_pass=%llu writer_key=%s readback=none",
+                 (unsigned long long)frame, (unsigned long long)e->ser, (unsigned)e->pf, (unsigned long)e->w,
+                 (unsigned long)e->h, (unsigned long long)e->pass, e->key[0] ? e->key : "-");
+        }
+    }
+    // 3) 交出这一帧的条目（下一帧重新收集；更晚帧的条目留着）
+    bytgt_retire(frame);
+}
+
+// ---------- S2Arm #427 壳内置诊断 [dark2]：定点看「有画面 → 纯 0」的那两个 writer ----------
+// 上一轮 [bytgt]（1600x900 浮点颜色目标的整张统计）的结论：
+//   ser=270（writer ba5f5df42d8f1686_b）和 ser=271（writer 99ab00b0dd1815b0_b）有画面（最高 mean 126.1）；
+//   这一族正是上屏源（[w600x] 的 present_tex 轮换到 600 / 636 / 623 …）。而 ser=623（writer b3bfb3a8e019475d_b）、
+//   ser=630 / 631（writer edfae07aedacdcec_b）恒为 0。也就是说这两个 key 把有画面的上游变成了纯 0：黑屏点就在这里。
+// 这一版只盯这两支（key 前缀匹配，后缀 _b / _bf / _u 都算；S2A_DARK2_KEYS 可换）：
+//   * 每帧每个 key 最多记 1 个 pass（这一遍的第一笔画；之后的重画不再记）；
+//   * pass 内只读状态、零拷贝、不进命令缓冲、不建私有纹理：
+//       输入 = 片元阶段绑的每个 NVN_RB_TEX（reg / tid / serial / Metal fmt / kind / 尺寸），
+//       UBO  = 该阶段绑定的最大 NVN_RB_CBUF（帧末读回 ≤ 256 B，打前 8 个 float），
+//       管线 = writeMask（每个颜色槽，和 pso_desc 同一套算法）/ blend 开关 / discard（反射或源码），
+//       输出 = 颜色附件的 serial + Metal fmt（开遍时先留 pd 已有的纹理引用；key 要到第一笔画才知道）；
+//   * 帧末（和 [bytgt] / [litin] 同一个点：下一帧第一遍之前 rp_end → mtl_finish_gpu → 旧队列 q_cb 一次
+//     blit 到共享缓冲 → CPU 统计）对 ≤3 张输入各取正中 4×4，对颜色附件整张（≤ 64 MB，和 [bytgt] 同口径）
+//     算 nonzero / mean / max，然后打：
+//       [dark2] frame <f> pass <n> key=<k> in=<n> ubo reg=<r> len=<l> f0..f7=<…> wmask=<c0:0x..,c1:0x..> blend=<c0:0/1,...> discard=<0/1> dsrc=<json|metal|none> out=<ser:fmt>
+//       [dark2] frame <f> pass <n> in tex reg=<r> tid=<t> ser=<s> fmt=0x.. kind=<k> <w>x<h> nonzero=<n> mean=<v> max=<v>
+//       [dark2] frame <f> pass <n> out ser=<s> nonzero=<n> mean=<v> max=<v>
+//   读不回的段分别换成 readback=none（不打错数字）。一帧一个都没命中时只在第一次与每 300 帧打一行 none，
+//   用来确认这段代码在跑。
+//   开关：S2A_DARK2_DEBUG=0 关；S2A_DARK2_KEYS=<前缀,前缀> 换 key；S2A_LIT_DEBUG=0 整条关。
+enum { D2_KEYS = 4, D2_MAX = 8, D2_IN = 16, D2_STAT = 3, D2_UBO_MAXB = 256, D2_PX = 4 };
+typedef struct {
+    uint64_t frame, pass;
