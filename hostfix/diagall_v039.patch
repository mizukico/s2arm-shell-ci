+    }
+    if (ran && cbuf && cpx) {   // IBL / 环境：每面 4×4 像素的 RGB 统计 + 面 0 的第一个像素
+        uint64_t nz = 0, mx = 0; double mean = 0.0;
+        lit_stats((const uint8_t *)cbuf.contents, crow, (size_t)cpx, (size_t)cube_faces * (size_t)cpx, cube_bpp,
+                  cube.pixelFormat, &nz, &mean, &mx);
+        uint8_t q[3]; lit_px8((const uint8_t *)cbuf.contents, cube_bpp, cube.pixelFormat, q);
+        MLOG("[litin] frame %llu cube ser=%llu faces=%d nonzero=%llu mean=%.1f max=%llu face0_sample=%u,%u,%u fmt=%#lx",
+             (unsigned long long)f, (unsigned long long)g_litin_cube_ser, cube_faces,
+             (unsigned long long)nz, mean, (unsigned long long)mx, q[0], q[1], q[2], (unsigned long)cube.pixelFormat);
+    }
+    if (ran && sbuf && spx) {   // 阴影：每层 16×16 像素的 RGB 统计 + 层 0 的第一个像素
+        uint64_t nz = 0, mx = 0; double mean = 0.0;
+        lit_stats((const uint8_t *)sbuf.contents, srow, (size_t)spx, (size_t)shd_layers * (size_t)spx, shd_bpp,
+                  shd.pixelFormat, &nz, &mean, &mx);
+        uint8_t q[3]; lit_px8((const uint8_t *)sbuf.contents, shd_bpp, shd.pixelFormat, q);
+        MLOG("[litin] frame %llu shadow ser=%llu layers=%d nonzero=%llu mean=%.1f max=%llu layer0=%u,%u,%u fmt=%#lx",
+             (unsigned long long)f, (unsigned long long)g_litin_shadow_ser, shd_layers,
+             (unsigned long long)nz, mean, (unsigned long long)mx, q[0], q[1], q[2], (unsigned long)shd.pixelFormat);
+    }
+    litin_clear();
+}
+// ---------- S2Arm #427 壳内置诊断 [litback]：沿上屏链往回退，找真正写场景色的那一遍 ----------
+// 上一轮 [litin] 的结论：上屏遍读的源 serial 是 271 / 623 / 636 等（[litdbg] 学到），但抓到的两个「光照遍」都不对——
+//   f46313c22380f38f_b 的 UBO 1280 B 是单位矩阵形态，ba5f5df42d8f1686_b 的 UBO 256 B 是 1/屏幕尺寸（后处理参数）。
+//   真正写场景色的那一遍还没找到；这一版把「写者」找出来，再沿它的输入往回退，直到输入里出现整数纹理（G-buffer）。
+// 做法（安全版，和 [litdbg] / [litin] 同一套约束：帧末读回、pass 内零拷贝）：
+//   1. 每遍第一笔画时（挂点 litback_note(pr->sh[1])）把这一遍的 pass 号 / 片元 key / 颜色附件（serial + 槽 + 格式）/
+//      该阶段最大的 NVN_RB_CBUF / 片元阶段绑定的纹理（reg + serial + 格式 + 类型）记进固定大小的快照表；
+//      只读已有的绑定状态：不建纹理、不拷贝、不进命令缓冲。
+//   2. 帧末（和 [litdbg] / [litin] 同一点）从 lit_src_note 学到的「上屏源」serial 开始（= 上屏遍采样的那张场景色；
+//      1 / 3 是 drawable / 轮换上屏，写它们的就是上屏遍自己，明确排除），找本帧最后一次写它的那一遍：
+//        [litback] writer ser=<s> pass=<n> key=<k> c<slot> fmt=0x..
+//      还没学到（g_lit_present_seen==0，或 g_lit_src_ser 为 0/1/3）时退回 S2A_LIT_SER 里第一个非 1/3 的序号；
+//      都没有就只打一行「还没有可回溯的场景色序号」，不打链（避免噪声）。
+//      再打这一遍的 UBO 前 8 个 float + 绑定的每张纹理（reg / ser / fmt / kind / type），
+//      并对整数格式（G-buffer）的纹理各做一次 4×4 帧末读回统计（nonzero / mean / max）。
+//   3. 若这一遍的输入里没有整数纹理（说明它也是后处理），就从它的输入里挑一张本帧还有写者的颜色纹理，再往回一级
+//      （最多 3 级），每级一行 [litback] level=<i> …，直到输入含整数纹理的那一遍或到顶。每帧只走一条链。
+//      某一级的写者若是上屏遍（key ec8ccd7a1791a3a6_b），跳过这一遍、继续用它的输入往回退，不算一级、也不停。
+//   4. 预算：每帧 ≤ 3 级 ×（256 B UBO + 8 张 × 4×4 像素），累计 256 MB。
+//      S2A_LIT_DEBUG=0 整条关；本诊断默认关，S2A_LITBACK_DEBUG=1 才开（避免每帧刷屏）；S2A_LITBACK_ALL=1 每帧都重打纹理清单 / 结论。
+enum { LITB_PASS_MAX = 1024, LITB_TEX_MAX = 16, LITB_LEVEL_MAX = 3, LITB_INT_PER_LV = 8,
+       LITB_UBO_MAXB = 256, LITB_PX = 4, LITB_JOB_MAX = LITB_LEVEL_MAX * LITB_INT_PER_LV,
+       LITB_BUDGET_MB = 256 };
+typedef struct { unsigned reg; int tid; uint64_t ser; uint32_t pf; uint16_t kind, tt, isint; uint32_t w, h, depth; } litb_tex;
+typedef struct {
+    uint64_t pass; char key[24]; int ncol;
+    struct { uint64_t ser; uint32_t pf; uint8_t slot; } col[8];
+    int ubo_reg; uint64_t ubo_addr, ubo_len;
+    int ntex; litb_tex tex[LITB_TEX_MAX];
+} litb_snap;
+static litb_snap g_litb_snap[LITB_PASS_MAX];
+static int g_litb_n;                    // 本帧已记的快照数（帧末用完由 lit_td_note 清 0）
+static uint64_t g_litb_frame = ~0ull;   // 正在收集的帧号（帧末那几行打的就是它）
+static uint64_t g_litb_pass = ~0ull;    // 每遍只看第一笔画（这时的绑定状态属于这一遍）
+static uint64_t g_litb_bytes;           // 累计读回的字节数（预算 LITB_BUDGET_MB）
+static int g_litb_on = -1;
+static int g_litb_all = -1;
+static int g_litb_ovf, g_litb_budget_logged, g_litb_halt_logged, g_litb_fail_logged, g_litb_nostart_logged;
+static char g_litb_sig[LITB_LEVEL_MAX][24];   // 每级上一次打「纹理清单 + 结论」时的 writer key（变了才重打，免得刷屏）
+static int g_litb_sig_n[LITB_LEVEL_MAX];
+static int litback_on(void) {   // 默认关：只在 S2A_LITBACK_DEBUG=1 时启用（避免每帧刷屏）；S2A_LIT_DEBUG=0 仍整条关
+    if (g_litb_on < 0) {
+        const char *e = getenv("S2A_LITBACK_DEBUG"), *a = getenv("S2A_LITBACK_ALL");
+        g_litb_on = lit_on() && e && !strcmp(e, "1");
+        g_litb_all = a && !strcmp(a, "1");
+        if (!g_litb_on) MLOG("S2A_LITBACK_DEBUG 未设（默认关）: [litback] 上屏链回溯关；S2A_LITBACK_DEBUG=1 打开");
+    }
+    return g_litb_on;
+}
+static const char *litb_ttype(int t) {   // 纹理类型（NVN target）
+    switch (t) {
+        case NVN_TEXTURE_TARGET_1D: return "1d";
+        case NVN_TEXTURE_TARGET_2D: return "2d";
+        case NVN_TEXTURE_TARGET_3D: return "3d";
+        case NVN_TEXTURE_TARGET_1D_ARRAY: return "1darr";
+        case NVN_TEXTURE_TARGET_2D_ARRAY: return "2darr";
+        case NVN_TEXTURE_TARGET_2D_MULTISAMPLE: return "2dms";
+        case NVN_TEXTURE_TARGET_2D_MULTISAMPLE_ARRAY: return "2dmsarr";
+        case NVN_TEXTURE_TARGET_RECTANGLE: return "rect";
+        case NVN_TEXTURE_TARGET_CUBEMAP: return "cube";
+        case NVN_TEXTURE_TARGET_CUBEMAP_ARRAY: return "cubearr";
+        case NVN_TEXTURE_TARGET_BUFFER: return "buf";
+        default: return "?";
+    }
+}
+static int litb_present_key(const char *k) {   // 上屏遍（present_now 交 drawable 的那一遍）：写 1 / 轮换的 3，不是场景色
+    return k && !strcmp(k, "ec8ccd7a1791a3a6_b");
+}
+static uint64_t litb_start_ser(void) {   // 链头：lit_src_note 学到的最新上屏源（= 上屏遍采样的场景色）→ S2A_LIT_SER 第一个非 1/3
+    if (g_lit_present_seen && g_lit_src_ser && g_lit_src_ser != 1 && g_lit_src_ser != 3) return g_lit_src_ser;
+    const char *e = getenv("S2A_LIT_SER");
+    if (e && *e) {   // 还没学到：按显式表找第一个不是上屏（1 = drawable / 3 = 轮换上屏）的序号
+        char b[96]; snprintf(b, sizeof b, "%s", e);
+        for (char *p = b; *p; ) {
+            char *c = strchr(p, ','); if (c) *c = 0;
+            unsigned long long v = strtoull(p, NULL, 0);
+            if (v && v != 1 && v != 3) return (uint64_t)v;
+            if (!c) break; p = c + 1;
+        }
+    }
+    return 0;   // 没有场景色可回溯：帧末只打一行提示，不打印链（避免噪声）
+}
+// draw 里（每一遍的第一笔画）：把这一遍的写者信息记进快照表（只读绑定状态；不建纹理、不拷贝、不进命令缓冲）
+static void litback_note(NvShader *fs) {
+    if (!litback_on() || !fs) return;
+    uint64_t pass = g_stat_pass;
+    if (g_litb_pass == pass) return;   // 每遍只看第一笔画：这时的附件 / 绑定状态属于这一遍
+    g_litb_pass = pass;
+    if (R.rt.n <= 0 || R.rt.n > 8) return;   // 只记写颜色附件的遍（深度遍没有颜色写者，也不是链上的节点）
+    if (g_litb_n >= LITB_PASS_MAX) {
+        if (!g_litb_ovf) { g_litb_ovf = 1; MLOG("[litback] 本帧 pass 快照表满（%d）：之后的遍不再记，链可能不完整", LITB_PASS_MAX); }
+        return;
+    }
+    litb_snap *sp = &g_litb_snap[g_litb_n++];
+    memset(sp, 0, sizeof *sp);
+    sp->pass = pass; sp->ubo_reg = -1;
+    snprintf(sp->key, sizeof sp->key, "%s", fs->key);
+    for (int i = 0; i < R.rt.n && i < 8; i++) {
+        const tex_t *t = R.rt.color[i]; if (!t || !t->serial) continue;
+        int k = sp->ncol++;
+        sp->col[k].ser = t->serial; sp->col[k].slot = (uint8_t)i;
+        int nf = R.rt.has_cview[i] && R.rt.cview[i].set_format ? (int)R.rt.cview[i].format : (int)t->d.format;
+        uint32_t mpf = 0; uint8_t sw[4];
+        sp->col[k].pf = nvn_fmt_to_mtl(nf, &mpf, sw) && mpf ? mpf : 0;
+    }
+    pthread_mutex_lock(&g_rmu);
+    for (int i = 0; i < fs->rf.nb; i++) {
+        const nvn_rbind *b = &fs->rf.b[i];
+        if (b->kind == NVN_RB_CBUF) {   // 该阶段最大的常量缓冲（和 [litin] 取法一样）
+            if (b->reg >= 16) continue;
+            const p_bind_buf *u = &S.ubo[1][b->reg];
+            if (u->addr && u->size && u->size > sp->ubo_len) { sp->ubo_addr = u->addr; sp->ubo_len = u->size; sp->ubo_reg = (int)b->reg; }
+            continue;
+        }
+        if (b->kind != NVN_RB_TEX && b->kind != NVN_RB_IMG) continue;   // G-buffer 是普通纹理；image 槽也记（kind 区分）
+        if (sp->ntex >= LITB_TEX_MAX) break;
+        uint64_t h = b->kind == NVN_RB_IMG ? (b->reg < 32 ? S.img[1][b->reg] : 0) : tex_slot_h(S.tex[1], S.img[1], b->reg);
+        int id_ = (int)(h & 0xfffff);
+        if (id_ <= 0 || id_ >= g_ntreg || !g_treg[id_].ok) continue;
+        const treg_t *r = &g_treg[id_];
+        if (!r->t.serial) continue;
+        litb_tex *e = &sp->tex[sp->ntex];
+        int nf = r->has_v && r->v.set_format ? (int)r->v.format : (int)r->t.d.format;
+        uint32_t mpf = 0; uint8_t sw[4];
+        if (!nvn_fmt_to_mtl(nf, &mpf, sw)) mpf = 0;
+        e->reg = b->reg; e->tid = id_; e->ser = r->t.serial; e->pf = mpf;
+        e->kind = (uint16_t)b->kind;
+        e->tt = (uint16_t)(r->has_v && r->v.set_target ? (int)r->v.target : (int)r->t.d.target);
+        e->isint = (uint16_t)(mpf && mtl_pf_dpf((MTLPixelFormat)mpf) != NVN_DPF_FLOAT);
+        e->w = r->t.d.width; e->h = r->t.d.height; e->depth = r->t.d.depth;
+        sp->ntex++;
+    }
+    pthread_mutex_unlock(&g_rmu);
+}
+static int litb_writer(uint64_t ser, int *slot, uint32_t *pf) {   // 本帧最后一次写这个 serial 的那一遍（快照倒序）
+    for (int i = g_litb_n - 1; i >= 0; i--) {
+        const litb_snap *sp = &g_litb_snap[i];
+        for (int k = 0; k < sp->ncol; k++) if (sp->col[k].ser == ser) {
+            if (slot) *slot = sp->col[k].slot;
+            if (pf) *pf = sp->col[k].pf;
+            return i;
+        }
+    }
+    return -1;
+}
+// 下一级挑哪张：这一遍的输入里、本帧还有写者、不是整数（已经找到 G-buffer 就不退了）、不是自己的附件（反馈采样）、没走过；
+// 颜色优先于深度、2D 优先于 cube / array / 3D、大的优先。
+static uint64_t litb_next(const litb_snap *sp, uint64_t cur, const uint64_t *vis, int nvis) {
+    uint64_t best = 0, bs = 0;
+    for (int i = 0; i < sp->ntex; i++) {
+        const litb_tex *e = &sp->tex[i];
+        if (!e->ser || e->isint || e->ser == cur) continue;
+        int dup = 0;
+        for (int v = 0; v < nvis; v++) if (vis[v] == e->ser) { dup = 1; break; }
+        for (int k = 0; k < sp->ncol && !dup; k++) if (sp->col[k].ser == e->ser) dup = 1;
+        int sl; uint32_t pf;
+        if (dup || litb_writer(e->ser, &sl, &pf) < 0) continue;   // 本帧没有写者：回不去
+        uint64_t score = (uint64_t)(mtl_fmt_depth((MTLPixelFormat)e->pf) ? 1 : 3) << 40;
+        if (e->tt == NVN_TEXTURE_TARGET_2D) score += 1ull << 36;
+        score += (uint64_t)e->w * (uint64_t)e->h;
+        if (score > bs) { bs = score; best = e->ser; }
+    }
+    return best;
+}
+static void litb_ubo_floats(id<MTLBuffer> b, NSUInteger len, char *lab, size_t labn, char *val, size_t valn) {
+    lab[0] = 0; val[0] = 0;
+    if (!b) return;
+    NSUInteger nf = len / 4; if (nf > 8) nf = 8;
+    if (!nf) return;
+    if (nf == 1) snprintf(lab, labn, "f0="); else snprintf(lab, labn, "f0..f%u=", (unsigned)(nf - 1));
+    const float *v = (const float *)b.contents; size_t o = 0;
+    for (NSUInteger i = 0; i < nf && o < valn; i++) o += snprintf(val + o, valn - o, "%s%.6g", i ? "," : "", (double)v[i]);
+}
+// 帧末（下一帧第一遍之前，和 [litdbg] / [litin] 同一个点）：纯 CPU 走完这一帧的链，再一次性读回 UBO + 整数纹理 4×4，统计后打行。
+// 这是 [litback] 唯一的 GPU 工作：pass 都结束、GPU 已做完、旧队列上一次提交，不在任何 pass 里。
+static void litback_dump(void) {
+    int n = g_litb_n; uint64_t f = g_litb_frame;
+    if (n <= 0) return;
+    if (mtl_gpu_halted()) {
+        if (!g_litb_halt_logged) { g_litb_halt_logged = 1; MLOG("【红】[litback] GPU 已安全停：上屏链不再回溯（原因看 [gpuerr] 那行）"); }
+        return;
+    }
+    uint64_t start = litb_start_ser();
+    if (!start) {   // 还没学到上屏源 / S2A_LIT_SER 里只有 1 和 3：不打印链，只提示一次（等 lit_src_note 学到）
+        if (!g_litb_nostart_logged) { g_litb_nostart_logged = 1;
+            MLOG("[litback] 还没有可回溯的场景色序号（等 lit_src_note 学到）"); }
+        return;
+    }
+    // 1) 沿「场景色 → 它的写者 → 写者输入里还有写者的那张 → …」走，最多 LITB_LEVEL_MAX 级。
+    //    上屏遍（写 drawable 1 / 轮换 3 的那一遍，key ec8ccd7a1791a3a6_b）本身不是场景色：只借它的输入继续退，不算一级。
+    uint64_t lser[LITB_LEVEL_MAX], lpass[LITB_LEVEL_MAX], lnx[LITB_LEVEL_MAX];
+    int lsnap[LITB_LEVEL_MAX], lslot[LITB_LEVEL_MAX], lint[LITB_LEVEL_MAX];
+    uint32_t lpf[LITB_LEVEL_MAX];
+    int nlv = 0; uint64_t visited[LITB_LEVEL_MAX * 2 + 2]; int nvis = 0;
+    uint64_t cur = start;
+    int skip = 0;
+    for (int lev = 0; lev < LITB_LEVEL_MAX; ) {
+        int slot = 0; uint32_t pf = 0;
+        int wi = litb_writer(cur, &slot, &pf);
+        if (wi < 0) {
+            static uint64_t nw_last; static int nw_n;
+            if (nw_last != cur || nw_n < 2) { nw_last = cur; nw_n++;
+                MLOG("[litback] level=%d ser=%llu: 本帧没有一遍写过它（写者不在本帧 / 序号变了），链到此为止", lev, (unsigned long long)cur); }
+            break;
+        }
+        visited[nvis++] = cur;
+        const litb_snap *sp = &g_litb_snap[wi];
+        if (litb_present_key(sp->key)) {   // 上屏遍写的就是 1 / 3 本身：跳过这一遍，继续用它的输入往回退（不算一级）
+            if (++skip > LITB_LEVEL_MAX) break;
+            uint64_t nx = litb_next(sp, cur, visited, nvis);
+            if (!nx) break;
+            cur = nx;
+            continue;
+        }
+        lser[lev] = cur; lsnap[lev] = wi; lslot[lev] = slot; lpf[lev] = pf;
+        lpass[lev] = sp->pass;
+        int ni = 0; for (int i = 0; i < sp->ntex; i++) if (sp->tex[i].isint) ni++;
+        lint[lev] = ni;
+        lev++; nlv = lev;
+        if (ni) { lnx[lev - 1] = 0; break; }   // 这一遍的输入里有整数纹理 = 找到读 G-buffer 的那一遍
+        uint64_t nx = litb_next(sp, cur, visited, nvis);
+        lnx[lev - 1] = nx;
+        if (!nx) break;
+        cur = nx;
+    }
+    if (!nlv) return;
+    // 2) 规划读回：每个写者遍的 UBO + 每个整数纹理各 4×4（同一 serial 只读一次）
+    int j_tid[LITB_JOB_MAX];
+    uint64_t j_ser[LITB_JOB_MAX];
+    int nj = 0;
+    int jmap[LITB_LEVEL_MAX][LITB_TEX_MAX];
+    for (int lv = 0; lv < LITB_LEVEL_MAX; lv++) for (int i = 0; i < LITB_TEX_MAX; i++) jmap[lv][i] = -1;
+    uint64_t need = 0;
+    for (int lv = 0; lv < nlv; lv++) {
+        const litb_snap *sp = &g_litb_snap[lsnap[lv]];
+        int taken = 0;
+        for (int i = 0; i < sp->ntex && taken < LITB_INT_PER_LV; i++) {
+            const litb_tex *e = &sp->tex[i];
+            if (!e->isint || !e->pf) continue;
+            size_t bpp = mtl_pf_bytes((MTLPixelFormat)e->pf);
+            if (!bpp) continue;
+            NSUInteger px = MIN((NSUInteger)LITB_PX, MIN((NSUInteger)e->w, (NSUInteger)e->h));
+            if (!px) continue;
+            int j = -1;
+            for (int q = 0; q < nj; q++) if (j_ser[q] == e->ser) { j = q; break; }
+            if (j < 0) {
+                if (nj >= LITB_JOB_MAX) break;
+                j = nj++; j_tid[j] = e->tid; j_ser[j] = e->ser;
+                need += (uint64_t)px * px * bpp;
+            }
+            jmap[lv][i] = j; taken++;
+        }
+        if (sp->ubo_reg >= 0 && sp->ubo_addr && sp->ubo_len >= 4) need += MIN(sp->ubo_len, (uint64_t)LITB_UBO_MAXB);
+    }
+    int do_read = need > 0 && !mtl_gpu_halted() && g_litb_bytes + need <= ((uint64_t)LITB_BUDGET_MB << 20);
+    if (need > 0 && !do_read && g_litb_bytes + need > ((uint64_t)LITB_BUDGET_MB << 20) && !g_litb_budget_logged) {
+        g_litb_budget_logged = 1;
+        MLOG("[litback] 读回预算 %d MB 用尽：之后只打链与纹理清单，不再读回（S2A_LITBACK_DEBUG=0 关）", LITB_BUDGET_MB);
+    }
+    // 3) 帧末一次提交：UBO 前 256 B + 每张整数纹理正中 4×4
+    id<MTLBuffer> ub[LITB_LEVEL_MAX]; id<MTLBuffer> jb[LITB_JOB_MAX]; id<MTLTexture> jt[LITB_JOB_MAX];
+    NSUInteger ubl[LITB_LEVEL_MAX], jpx[LITB_JOB_MAX], jrow[LITB_JOB_MAX];
+    size_t jbpp[LITB_JOB_MAX];
+    for (int i = 0; i < LITB_LEVEL_MAX; i++) { ub[i] = nil; ubl[i] = 0; }
+    for (int i = 0; i < LITB_JOB_MAX; i++) { jb[i] = nil; jt[i] = nil; jpx[i] = 0; jrow[i] = 0; jbpp[i] = 0; }
+    int ran = 0;
+    uint64_t copied = 0;
+    if (do_read) {
+        rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+        mtl_finish_gpu();   // 上一帧的提交必须已经在 GPU 上做完，旧队列的拷贝才读得到这一帧的内容
+        pthread_mutex_lock(&g_rmu);
+        for (int j = 0; j < nj; j++) {
+            if (j_tid[j] <= 0 || j_tid[j] >= g_ntreg || !g_treg[j_tid[j]].ok || g_treg[j_tid[j]].t.serial != j_ser[j]) continue;
+            id<MTLTexture> mt = tex_mtl(&g_treg[j_tid[j]].t);
+            if (mt && (mt.textureType == MTLTextureType2D || mt.textureType == MTLTextureType2DArray)) jt[j] = mt;
+        }
+        pthread_mutex_unlock(&g_rmu);
