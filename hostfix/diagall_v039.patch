+        [b copyFromTexture:shd sourceSlice:(NSUInteger)ly sourceLevel:0 sourceOrigin:MTLOriginMake(sox, soy, 0) sourceSize:MTLSizeMake(spx, spx, 1)
+                  toBuffer:sbuf destinationOffset:(NSUInteger)((uint64_t)ly * (uint64_t)srow * (uint64_t)spx)
