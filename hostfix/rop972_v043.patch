+        /// （不会跨出 st 之前开的那层括号）且 depth(st) 这一层上不出现 ';'（语句没被截断；for(;;) 的分号在更深一层，不算）。
+        /// 允许 as_type 嵌在更外层的调用里（如 float4(as_type&lt;uint&gt;(…))），只要求整条调用落在一条语句里</summary>
+        static bool InOneStatement(string masked, int[] pd, int start, int close)
+        {
+            if (close <= start || close > pd.Length) return false;
+            int st = 0;
+            for (int i = start - 1; i >= 0; i--)
+            {
+                char c = masked[i];
+                if (c == ';' || c == '{' || c == '}') { st = i + 1; break; }
+            }
+            int d0 = pd[st];
+            for (int i = st; i < close; i++)
+            {
+                if (pd[i] < d0) return false;
+                if (masked[i] == ';' && pd[i] == d0) return false;
+            }
+            return pd[close] >= d0;
+        }
+
+        /// <summary>as_type&lt;…&gt;( … ) 里那条约表达式读的是哪张贴图：最后一处 .read( / .sample( 的接收者标识符
+        /// （spvDescriptorSet0.NAME 时取 NAME）。expr 是掩码稿（注释 / 字面量已空）</summary>
+        static string UintReadRecv(string expr)
+        {
+            string name = null;
+            foreach (Match m in All(@"\.\s*(?:read|sample)\s*\(", expr))
+            {
+                int i = m.Index;
+                while (i > 0 && char.IsWhiteSpace(expr[i - 1])) i--;
+                int e = i;
+                while (i > 0 && (char.IsLetterOrDigit(expr[i - 1]) || expr[i - 1] == '_')) i--;
+                if (e > i) name = expr[i..e];
+            }
+            return name;
+        }
+
+        /// <summary>#427 [uint-read]：MSL 里 `as_type&lt;uint|int&gt;(&lt;贴图&gt;.read(…))` 这种「按位取整数」的读法，要的是宿主把整数纹理
+        /// 原样绑上来（apple10 上「整数纹理按 float 声明读」是 UB，读到 0：空之轨迹 the 1st 的 G-buffer 后期光照全黑）。生成 MSL 后做一次
